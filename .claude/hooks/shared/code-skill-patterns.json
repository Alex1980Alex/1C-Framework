  "post_verification": {
    "description": "Post-write verification rules. Checked in POST mode Level E.",
    "rules": [
      {
        "name": "langgraph-core",
        "file_pattern": "src/agents/.*\\.py",
        "must_contain": [
          "from langgraph",
          "StateGraph",
          "invoke\\s*\\(",
          "checkpointer\\s*="
        ],
        "must_not_contain": [
          "StateGraph\\s*\\(\\s*\\)",
          "node\\s*\\(\\s*\"\"",
          "edge\\s*\\(\\s*\\)"
        ],
        "error_message": "LangGraph agent missing required patterns: checkpointer, proper StateGraph initialization, or node/edge definitions."
      },
      {
        "name": "create-hook",
        "file_pattern": "\\.claude/hooks/.*\\.py",
        "must_contain": [
          "class\\s+\\w+Hook",
          "from.*BaseHook",
          "def\\s+run_hook"
        ],
        "must_not_contain": [
          "exit\\(1\\)",
          "print\\s*\\([^)]*\\)",
          "#\\s*TODO"
        ],
        "error_message": "Hook file missing required patterns: BaseHook inheritance, run_hook method, or contains anti-patterns (exit(1), print, TODO comments)."
      },
      {
        "name": "qdrant-operations",
        "file_pattern": "src/(vector_store|graph_store)/.*\\.py",
        "must_contain": [
          "QdrantClient",
          "upsert|search|query",
          "collection_name\\s*="
        ],
        "must_not_contain": [
          "QdrantClient\\s*\\(\\s*\\)",
          "'|\"collection'",
          "async\\s+def.*await.*QdrantClient"
        ],
        "error_message": "Qdrant operations missing: client initialization, collection config, or has async/sync mixing issues."
      }
    ]
  },
