# === API Keys ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
VOYAGE_API_KEY=pa-...

# === Embedding (Phase 8 production switchover, 2026-04-30) ===
# Default: Qwen3-Embedding-8B 4096d via TEI HTTP backend (Docker pdf-rag-tei).
# 7 retrieval-коллекций мигрированы на эту модель (см. roadmap §26-§28):
#   bsl_code_v4 + bsl_code_v4_late, framework_code_v1, pdf_documents,
#   wiki_pages_v1, graph_embeddings, learned_patterns
EMBEDDING__PROVIDER=tei
EMBEDDING__MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING__DIMENSIONS=4096
EMBEDDING__TEI_BASE_URL=http://localhost:8080
EMBEDDING__BATCH_SIZE=16
# TEI server-side cap (MAX_CLIENT_BATCH_SIZE default = 32). Client sub-batches
# automatically; не меняй если не уверен что сервер пересобран с другим cap.
# EMBEDDING__TEI_CLIENT_BATCH=32

# --- Legacy: E5 multilingual (1024d, до Phase 8) ---
# Раскомменть если нужен E5 fallback (например для visual_grounding 768d). Не
# рекомендуется для новых коллекций — Qwen3 даёт +26% recall на BSL code.
# EMBEDDING__PROVIDER=local
# EMBEDDING__MODEL=intfloat/multilingual-e5-large
# EMBEDDING__DIMENSIONS=1024
# EMBEDDING__BACKEND=onnx           # torch | onnx | openvino — CPU speedup (Phase 43)

# --- Legacy: Jina v3 (Phase 47) ---
# EMBEDDING__PROVIDER=jina
# EMBEDDING__MODEL=jina-embeddings-v3
# EMBEDDING__JINA_API_KEY=jina_xxxxx
# EMBEDDING__JINA_TASK=retrieval.passage
# EMBEDDING__JINA_TRUNCATE_DIM=1024  # Matryoshka: 1024 | 512 | 256
# EMBEDDING__LATE_CHUNKING=true       # Phase 48: cross-chunk context (Jina v3 only)
# EMBEDDING__LATE_CHUNKING_MAX_TOKENS=7000

# === Vector Store ===
VECTOR_STORE__PROVIDER=qdrant
VECTOR_STORE__COLLECTION_NAME=pdf_documents
VECTOR_STORE__QDRANT_URL=http://localhost:6333

# === Graph Store ===
GRAPH_STORE__PROVIDER=networkx
# GRAPH_STORE__NEO4J_URI=bolt://localhost:7687
# GRAPH_STORE__NEO4J_USER=neo4j
# GRAPH_STORE__NEO4J_PASSWORD=

# === Agent ===
AGENT__MODEL=claude-sonnet-4-5-20250929
AGENT__TEMPERATURE=0.0

# === Reranking (Phase 25) ===
# Type: "llm" (Claude API, 1-3s) or "cross_encoder" (local model, 60-120s CPU)
AGENT__RERANKER_TYPE=llm
AGENT__RERANKER_LLM_MODEL=claude-sonnet-4-5-20250929
# AGENT__RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # For cross_encoder type
AGENT__RERANKER_TOP_K=20
# Z.AI proxy (required for LLM reranker if using Z.AI)
AGENT__BASE_URL=https://api.z.ai/v1

# === Logging ===
LOG_LEVEL=INFO

# === Observability — Langfuse (roadmap 260509 §3.1 Phase A, §5c Phase B) ===
# Phase A (infrastructure ready, default OFF):
#   - LangfuseCallbackHandler wired в src/pdf_framework/agents/rag/middleware.py:199
#   - Smoke tests pass без credentials (handler returns no-op)
# Phase B (production rollout) включается после регистрации Langfuse Cloud
# аккаунта (https://cloud.langfuse.com, free tier 50K observations/month) ИЛИ
# self-host через docker-compose. См. ADR-010 + roadmap §5c.
OBSERVABILITY__LANGFUSE_ENABLED=false
OBSERVABILITY__LANGFUSE_PUBLIC_KEY=pk-lf-...
OBSERVABILITY__LANGFUSE_SECRET_KEY=sk-lf-...
OBSERVABILITY__LANGFUSE_HOST=https://cloud.langfuse.com

# === PDF Loader (Phase 15.1) ===
# Available loaders: pymupdf, pdfplumber, unstructured, docling, smart
# smart — auto-selects best loader based on PDF characteristics
PDF__LOADER=smart

# === Docling Settings (Phase 15.1) ===
DOCLING__OCR_ENABLED=true
DOCLING__OCR_ENGINE=easyocr
DOCLING__OCR_LANGUAGES=["ru","en"]
DOCLING__TABLE_STRUCTURE_ENABLED=true
DOCLING__TABLE_MODE=accurate
DOCLING__DOCUMENT_TIMEOUT=300

# === Smart Router Settings (Phase 15.1) ===
SMART_ROUTER__FAST_LOADER=pymupdf4llm
SMART_ROUTER__FULL_LOADER=docling
SMART_ROUTER__MIN_TEXT_CHARS_PER_PAGE=100
SMART_ROUTER__TABLE_HEAVY_THRESHOLD=0.3

# === BSL Development (Phase 44: Migration from 1C-Enterprise_Framework) ===

# BSL Semantic Search
BSL_QDRANT_COLLECTION=bsl_code_v2
BSL_EMBEDDING_MODEL=nomic-embed-text
BSL_EMBEDDING_DIM=768

# Auto-Documenter (Z.AI GLM-5)
DEEP_REASONING_API_KEY=
DEEP_REASONING_BASE_URL=https://api.z.ai/api/anthropic
DEEP_REASONING_MODEL=glm-5

# Auto-Documenter (AI providers)
AUTODOC_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LLM Rotation
LLM_ROTATION_PRIMARY=mistral
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Google Gemini Embeddings (vector-memory)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# AI Memory (TimescaleDB)
TIMESCALE_URL=postgresql://memory:memory_pass@localhost:5433/ai_memory

# Java (bsl-platform-context)
JAVA_HOME=C:\Program Files\Zulu\zulu-17

# BSL Platform
BSL_PLATFORM_PATH=C:\Program Files\1cv8\8.3.27.1859

# Delegation routing (roadmap 260509 §4.5.3 A/B canary, 2026-05-16)
# 0.0 = LinUCB bandit only (default), 1.0 = TrainedRouter only.
# Intermediate values (e.g. 0.1) split traffic deterministically per prompt
# via sha256-seeded RNG — reproducible A/B comparison.
# Each routing decision emits Langfuse span `delegation.routing.decision`.
DELEGATION_ROUTER_CANARY_PCT=0.0
