# === API Keys ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
VOYAGE_API_KEY=pa-...

# === Embedding ===
EMBEDDING__PROVIDER=local
EMBEDDING__MODEL=intfloat/multilingual-e5-large
# ONNX backend for CPU speedup (Phase 43)
# EMBEDDING__BACKEND=onnx           # torch | onnx | openvino

# --- Jina Embeddings v3 (Phase 47) ---
# Uncomment to switch to Jina API (~$0.02/1M tokens, 10M free per key)
# EMBEDDING__PROVIDER=jina
# EMBEDDING__MODEL=jina-embeddings-v3
# EMBEDDING__JINA_API_KEY=jina_xxxxx
# EMBEDDING__JINA_TASK=retrieval.passage
# EMBEDDING__JINA_TRUNCATE_DIM=1024  # Matryoshka: 1024 | 512 | 256
# EMBEDDING__LATE_CHUNKING=true       # Phase 48: cross-chunk context (Jina v3 only)
# EMBEDDING__LATE_CHUNKING_MAX_TOKENS=7000  # Max tokens per window (8192 model limit)

# === Vector Store ===
VECTOR_STORE__PROVIDER=chroma
VECTOR_STORE__COLLECTION_NAME=pdf_documents

# === Graph Store ===
GRAPH_STORE__PROVIDER=networkx
# GRAPH_STORE__NEO4J_URI=bolt://localhost:7687
# GRAPH_STORE__NEO4J_USER=neo4j
# GRAPH_STORE__NEO4J_PASSWORD=

# === Agent ===
AGENT__MODEL=claude-sonnet-4-5-20250929
AGENT__TEMPERATURE=0.0

# === Reranking (Phase 25) ===
# Type: "llm" (Claude API, 1-3s) or "cross_encoder" (local model, 60-120s CPU)
AGENT__RERANKER_TYPE=llm
AGENT__RERANKER_LLM_MODEL=claude-sonnet-4-5-20250929
# AGENT__RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # For cross_encoder type
AGENT__RERANKER_TOP_K=20
# Z.AI proxy (required for LLM reranker if using Z.AI)
AGENT__BASE_URL=https://api.z.ai/v1

# === Logging ===
LOG_LEVEL=INFO

# === PDF Loader (Phase 15.1) ===
# Available loaders: pymupdf, pdfplumber, unstructured, docling, smart
# smart — auto-selects best loader based on PDF characteristics
PDF__LOADER=smart

# === Docling Settings (Phase 15.1) ===
DOCLING__OCR_ENABLED=true
DOCLING__OCR_ENGINE=easyocr
DOCLING__OCR_LANGUAGES=["ru","en"]
DOCLING__TABLE_STRUCTURE_ENABLED=true
DOCLING__TABLE_MODE=accurate
DOCLING__DOCUMENT_TIMEOUT=300

# === Smart Router Settings (Phase 15.1) ===
SMART_ROUTER__FAST_LOADER=pymupdf4llm
SMART_ROUTER__FULL_LOADER=docling
SMART_ROUTER__MIN_TEXT_CHARS_PER_PAGE=100
SMART_ROUTER__TABLE_HEAVY_THRESHOLD=0.3

# === BSL Development (Phase 44: Migration from 1C-Enterprise_Framework) ===

# BSL Semantic Search
BSL_QDRANT_COLLECTION=bsl_code_v2
BSL_EMBEDDING_MODEL=nomic-embed-text
BSL_EMBEDDING_DIM=768

# Auto-Documenter (Z.AI GLM-5)
DEEP_REASONING_API_KEY=
DEEP_REASONING_BASE_URL=https://api.z.ai/api/anthropic
DEEP_REASONING_MODEL=glm-5

# Auto-Documenter (AI providers)
AUTODOC_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LLM Rotation
LLM_ROTATION_PRIMARY=mistral
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Google Gemini Embeddings (vector-memory)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# AI Memory (TimescaleDB)
TIMESCALE_URL=postgresql://memory:memory_pass@localhost:5433/ai_memory

# Java (bsl-platform-context)
JAVA_HOME=C:\Program Files\Zulu\zulu-17

# BSL Platform
BSL_PLATFORM_PATH=C:\Program Files\1cv8\8.3.27.1859
