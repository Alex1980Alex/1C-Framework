# Шаблон секретов тяжёлого пути OTel→Langfuse (260718 H-P2, ADR-052).
# Копия → .env.otel (gitignored). langfuse_up.py генерит недостающие секреты сам.
# Все сервисы биндятся на 127.0.0.1 — телеметрия (вкл. user.email в resource attrs) не
# выходит за машину. Меняй дефолты перед реальным использованием.

# ── Инфраструктурные пароли Langfuse-стека ──────────────────────────────────
POSTGRES_PASSWORD=changeme-postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=changeme-clickhouse
REDIS_AUTH=changeme-redis
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme-minio

# ── Секреты приложения (langfuse_up.py генерит криптостойкие, если пусто) ────
# ENCRYPTION_KEY — РОВНО 64 hex-символа: openssl rand -hex 32
ENCRYPTION_KEY=
SALT=
NEXTAUTH_SECRET=

# ── Headless-инициализация проекта → сразу pk/sk без клика в UI ──────────────
LANGFUSE_INIT_ORG_ID=framework
LANGFUSE_INIT_ORG_NAME=Framework
LANGFUSE_INIT_PROJECT_ID=tool-observability
LANGFUSE_INIT_PROJECT_NAME=Tool Observability
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=

# ── Проводка коллектора → Langfuse (langfuse_up.py вычисляет из pk/sk) ───────
# endpoint OTLP-ingest Langfuse + Basic-auth base64(pk:sk) для otel-collector-langfuse.yaml
LANGFUSE_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
LANGFUSE_OTLP_AUTH=
