{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.mcp.schema.json",
  "mcpServers": {
    "auto-documenter": {
      "command": "node",
      "args": [
        "mcp-start.js"
      ],
      "cwd": "C:\\1С-Framework\\tools\\auto-documenter",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "DEEP_REASONING_API_KEY": "${DEEP_REASONING_API_KEY}",
        "DEEP_REASONING_BASE_URL": "https://api.z.ai/api/anthropic",
        "DEEP_REASONING_MODEL": "glm-5"
      },
      "timeout": 180000
    },
    "bsl-semantic-search": {
      "command": "C:\\1С-Framework\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "src.bsl.semantic_search.mcp"
      ],
      "cwd": "C:\\1С-Framework",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "timeout": 60000
    },
    "bsl-debugger": {
      "command": "node",
      "args": [
        "dist/index.js"
      ],
      "cwd": "C:\\1С-Framework\\tools\\bsl-debugger",
      "env": {
        "NODE_ENV": "production"
      },
      "timeout": 60000
    },
    "bsl-platform-context": {
      "command": "C:\\Program Files\\1C\\1CE\\components\\axiom-jdk-full-17.0.16+12-x86_64\\bin\\java.exe",
      "args": [
        "-Dfile.encoding=UTF-8",
        "-jar",
        "C:\\1С-Framework\\tools\\mcp-jars\\mcp-bsl-context-0.3.1.jar",
        "--platform-path",
        "C:\\Program Files\\1cv8\\8.3.27.2214",
        "--verbose"
      ],
      "env": {
        "JAVA_HOME": "C:\\Program Files\\1C\\1CE\\components\\axiom-jdk-full-17.0.16+12-x86_64"
      },
      "timeout": 30000
    },
    "ast-grep-mcp": {
      "command": "C:\\1С-Framework\\tools\\ast-grep-mcp\\.venv\\Scripts\\python.exe",
      "args": [
        "main.py"
      ],
      "cwd": "C:\\1С-Framework\\tools\\ast-grep-mcp",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      },
      "timeout": 60000
    },
    "mcp-onec-test-runner": {
      "command": "C:\\1С-Framework\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\1С-Framework\\scripts\\onec_test_runner_launch.py"
      ],
      "env": {
        "JAVA_HOME": "C:\\Program Files\\1C\\1CE\\components\\axiom-jdk-full-17.0.16+12-x86_64"
      },
      "timeout": 120000,
      "cwd": "C:\\1С-Framework"
    }
  }
}
