{
  "version": "1.0.0",
  "description": "Lazy MCP Server Configuration - On-demand loading",
  "categories": {
    "1c-development": {
      "description": "1C/BSL Development tools",
      "servers": [
        "bsl-semantic-search",
        "bsl-platform-context",
        "serena",
        "ast-grep-mcp"
      ],
      "keywords": [
        "BSL",
        "1С",
        "модуль",
        "процедура",
        "конфигурация",
        "справочник",
        "документ"
      ]
    },
    "documentation": {
      "description": "Documentation generation + live version-specific library docs (Context7)",
      "servers": [
        "auto-documenter",
        "markitdown",
        "context7"
      ],
      "keywords": [
        "документация",
        "documentation",
        "описание",
        "README",
        "api docs",
        "library docs",
        "version-specific",
        "context7",
        "актуальная документация"
      ]
    },
    "memory": {
      "description": "Memory and context systems",
      "servers": [
        "memory-ai",
        "vector-memory",
        "conversation-memory",
        "memory-orchestrator"
      ],
      "keywords": [
        "память",
        "memory",
        "контекст",
        "запомнить"
      ]
    },
    "learning": {
      "description": "Skill learning and improvement",
      "servers": [
        "skill-learning"
      ],
      "keywords": [
        "обучение",
        "learning",
        "skill",
        "улучшить"
      ]
    },
    "file-operations": {
      "description": "File system operations",
      "servers": [
        "filesystem",
        "ripgrep"
      ],
      "keywords": [
        "файл",
        "file",
        "найти",
        "search",
        "grep"
      ]
    },
    "reasoning": {
      "description": "Deep reasoning and analysis",
      "servers": [
        "deep-code-reasoning"
      ],
      "keywords": [
        "анализ",
        "reasoning",
        "deep",
        "сложный"
      ]
    },
    "web": {
      "description": "Web and HTTP operations",
      "servers": [
        "http-client",
        "web-reader"
      ],
      "keywords": [
        "web",
        "http",
        "url",
        "сайт"
      ]
    },
    "utils": {
      "description": "Utility tools",
      "servers": [
        "calculator",
        "datetime"
      ],
      "keywords": [
        "калькулятор",
        "дата",
        "время"
      ]
    },
    "routing": {
      "description": "Request routing and optimization",
      "servers": [
        "zai-router"
      ],
      "keywords": [
        "router",
        "routing",
        "оптимизация"
      ]
    },
    "code-quality": {
      "description": "Code quality / SonarQube (BSL/1C static analysis via official MCP)",
      "servers": [
        "sonarqube"
      ],
      "keywords": [
        "sonar",
        "sonarqube",
        "качество кода",
        "code quality",
        "quality gate",
        "issues",
        "BLOCKER",
        "CRITICAL",
        "статанализ",
        "code smell"
      ]
    }
  },
  "serverDefinitions": {
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp@3.2.0"
      ],
      "env": {},
      "timeout": 60000
    },
    "bsl-semantic-search": {
      "command": "C:\\1С-Framework\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "src.bsl.semantic_search.mcp"
      ],
      "cwd": "C:\\1С-Framework",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "timeout": 60000
    },
    "bsl-platform-context": {
      "command": "java",
      "args": [
        "-Dfile.encoding=UTF-8",
        "-jar",
        "C:\\1С-Framework\\tools\\mcp-jars\\mcp-bsl-context-0.3.1.jar",
        "--platform-path",
        "C:\\Program Files\\1cv8\\8.3.27.2214",
        "--verbose"
      ],
      "env": {
        "JAVA_HOME": "C:\\Program Files\\Zulu\\zulu-17"
      },
      "timeout": 30000
    },
    "serena": {
      "command": "C:\\1С-Framework\\tools\\serena\\.venv\\Scripts\\serena.exe",
      "args": [
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "cwd": "C:\\1С-Framework\\tools\\serena",
      "timeout": 180000
    },
    "ast-grep-mcp": {
      "command": "C:\\1С-Framework\\tools\\ast-grep-mcp\\.venv\\Scripts\\python.exe",
      "args": [
        "main.py"
      ],
      "cwd": "C:\\1С-Framework\\tools\\ast-grep-mcp",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      },
      "timeout": 60000
    },
    "auto-documenter": {
      "command": "node",
      "args": [
        "mcp-start.js"
      ],
      "cwd": "C:\\1С-Framework\\tools\\auto-documenter",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "timeout": 180000
    },
    "memory-ai": {
      "command": "C:\\1С-Framework\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "src.memory.ai_memory.server"
      ],
      "cwd": "C:\\1С-Framework",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "timeout": 60000
    },
    "vector-memory": {
      "command": "C:\\1С-Framework\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "src.memory.vector_memory.server"
      ],
      "cwd": "C:\\1С-Framework",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "timeout": 60000
    },
    "deep-code-reasoning": {
      "command": "node",
      "args": [
        "index.js"
      ],
      "cwd": "C:\\1С-Framework\\tools\\deep-code-reasoning",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "timeout": 180000
    },
    "ripgrep": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/ripgrep-mcp"
      ],
      "timeout": 30000
    },
    "markitdown": {
      "command": "npx",
      "args": [
        "-y",
        "markitdown-mcp"
      ],
      "timeout": 120000
    },
    "memory-orchestrator": {
      "command": "C:\\1С-Framework\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "src.memory.orchestrator.memory_orchestrator"
      ],
      "cwd": "C:\\1С-Framework",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "timeout": 60000
    },
    "sonarqube": {
      "command": "C:\\1С-Framework\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\1С-Framework\\scripts\\sonar_mcp_launch.py"
      ],
      "cwd": "C:\\1С-Framework",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "timeout": 120000
    }
  }
}