#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСценарииПоУмолчанию();
	ПодобратьЗаказОбразец();
	ПодобратьДатуОтгрузки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ШагПервый(Команда)

	ВыполнитьШагНаКлиенте(1);

КонецПроцедуры

&НаКлиенте
Процедура ШагВторой(Команда)

	ВыполнитьШагНаКлиенте(2);

КонецПроцедуры

&НаКлиенте
Процедура УбратьЗаСобой(Команда)

	ПоказатьВопрос(
		Новый ОписаниеОповещения("УбратьЗаСобойЗавершение", ЭтотОбъект),
		НСтр("ru = 'Пометить на удаление все заказы, созданные прогоном?'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УбратьЗаСобойЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УбратьЗаСобойНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьШагНаКлиенте(Шаг)

	Если Не ЗначениеЗаполнено(ЗаказОбразец) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Укажите заказ-образец: с него берутся организация, контрагент, договор, номенклатура и станции.'"),
			, "ЗаказОбразец");
		Возврат;
	КонецЕсли;

	ВыполнитьШагНаСервере(Шаг);

КонецПроцедуры

&НаСервере
Процедура ВыполнитьШагНаСервере(Шаг)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	ТаблицаСценариев = ОбработкаОбъект.НоваяТаблицаСценариев();
	Для Каждого СтрокаФормы Из Сценарии Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаСценариев.Добавить(), СтрокаФормы);
	КонецЦикла;

	Если Шаг = 1 Тогда
		Результат = ОбработкаОбъект.ВыполнитьШаг1(
			ЗаказОбразец, ДатаОтгрузки, ТаблицаСценариев, ПроставитьDirectumID);
	Иначе
		Результат = ОбработкаОбъект.ВыполнитьШаг2(
			ЗаказОбразец, ДатаОтгрузки, ТаблицаСценариев, ПроставитьDirectumID);
	КонецЕсли;

	Если Результат.Проблемы.Количество() > 0 Тогда
		Для Каждого Проблема Из Результат.Проблемы Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Проблема);
		КонецЦикла;
		Лог = СтрСоединить(Результат.Проблемы, Символы.ПС + Символы.ПС);
		Возврат;
	КонецЕсли;

	// Предупреждения (напр. «шаг 2 без шага 1») не отменяют прогон остальных сценариев,
	// поэтому результаты применяются в любом случае.
	Для Каждого Предупреждение Из Результат.Предупреждения Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Предупреждение);
	КонецЦикла;

	ЗначениеВРеквизитФормы(Результат.Результаты, "Сценарии");

	Лог = Результат.Лог;
	Если Шаг = 2 Тогда
		Лог = Лог + Символы.ПС + ИтогПрогона(Результат.Результаты);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УбратьЗаСобойНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	ТаблицаСценариев = ОбработкаОбъект.НоваяТаблицаСценариев();
	Для Каждого СтрокаФормы Из Сценарии Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаСценариев.Добавить(), СтрокаФормы);
	КонецЦикла;

	// УбратьЗаСобой сбрасывает состояние убранных строк - возвращаем таблицу в форму,
	// иначе «шаг 2 сделан» продолжал бы указывать на удалённый заказ.
	Лог = ОбработкаОбъект.УбратьЗаСобой(ТаблицаСценариев);
	ЗначениеВРеквизитФормы(ТаблицаСценариев, "Сценарии");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСценарииПоУмолчанию()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ЗначениеВРеквизитФормы(ОбработкаОбъект.СценарииВстречи(), "Сценарии");

КонецПроцедуры

// Подбирает заказ-образец: сперва любой ранее загруженный из CRM (у него точно
// заполнены реквизиты, которые ждёт обмен), иначе любой проведённый.
&НаСервере
Процедура ПодобратьЗаказОбразец()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Заявка.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.гкс_ЗаявкаНаОтгрузку КАК Заявка
		|ГДЕ
		|	Заявка.Проведен
		|	И НЕ Заявка.ПометкаУдаления
		|	И Заявка.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|	И Заявка.Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|УПОРЯДОЧИТЬ ПО
		|	Заявка.ЗагруженИзCRM УБЫВ,
		|	Заявка.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаказОбразец = Выборка.Ссылка;
	КонецЕсли;

КонецПроцедуры

// Дата отгрузки обязана попадать в существующий финансовый год, иначе обязательный
// реквизит «Период из спецификации» останется пустым (загрузка вычисляет его из
// ПериодОтгрузкиПо, а не получает из CRM). Берём начало последнего доступного ФГ.
&НаСервере
Процедура ПодобратьДатуОтгрузки()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Периоды.ДатаНачала КАК ДатаНачала,
		|	Периоды.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	Справочник.гкс_Периоды КАК Периоды
		|ГДЕ
		|	Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|	И Периоды.Произвольный
		|	И МЕСЯЦ(Периоды.ДатаНачала) = 7
		|	И МЕСЯЦ(Периоды.ДатаОкончания) = 6
		|УПОРЯДОЧИТЬ ПО
		|	Периоды.ДатаОкончания УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	// Внутрь финансового года, с запасом на сдвиг дат строк (каждая следующая +1 день).
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	Если ТекущаяДата >= Выборка.ДатаНачала И ТекущаяДата < Выборка.ДатаОкончания - 10 * 86400 Тогда
		ДатаОтгрузки = ТекущаяДата;
	Иначе
		ДатаОтгрузки = Выборка.ДатаНачала;
	КонецЕсли;

КонецПроцедуры

// Итог считается по строкам, у которых ЕСТЬ результат шага 2, а не по всей таблице:
// шаги прогоняются по помеченным строкам и по одной, поэтому «из всего» врало бы.
&НаСервереБезКонтекста
Функция ИтогПрогона(Результаты)

	Всего = 0;
	КоличествоPASS = 0;
	Для Каждого Строка Из Результаты Цикл
		Если Не ЗначениеЗаполнено(Строка.Итог) Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Если Строка.Итог = "PASS" Тогда
			КоличествоPASS = КоличествоPASS + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'ИТОГ: PASS %1 из %2 (сценарии с результатом).'"),
		КоличествоPASS, Всего);

КонецФункции

#КонецОбласти
