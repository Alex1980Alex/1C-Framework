#Область ПрограммныйИнтерфейс

// Возвращает пустую таблицу сценариев перенумерации.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Колонки:
//   * Пометка   - Булево - сценарий отобран для прогона (кнопки шагов работают только по помеченным);
//   * Имя       - Строка - имя сценария;
//   * Шаг1      - Строка - буквы строк, которые CRM шлёт при первом приходе (напр. "A,B");
//   * Шаг2      - Строка - буквы строк, которые CRM шлёт при повторном приходе;
//   * Ожидание  - Строка - ожидаемые пары "буква=ИндЗаказа" через запятую. Относится ТОЛЬКО к шагу 2:
//                          на первом приходе нумерация тривиальна (по порядку строк CRM), проверять нечего;
//   * Факт1     - Строка - фактический результат первого прихода (шаг 1);
//   * Факт      - Строка - фактический результат повторного прихода (шаг 2), сверяется с Ожидание;
//   * Итог      - Строка - PASS / FAIL / ОШИБКА (итог шага 2);
//   * Состояние - Строка - пусто / "шаг 1 сделан" / "шаг 2 сделан";
//   * Заказ     - ДокументСсылка.гкс_ЗаявкаНаОтгрузку - созданный заказ. Он же CRMID заказа:
//                 загрузка мапит CRMID на ссылку через ПолучитьСсылку(GUID), отдельно хранить не нужно.
//
Функция НоваяТаблицаСценариев() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Пометка",   Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Имя",       Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Шаг1",      Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Шаг2",      Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Ожидание",  Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Факт1",     Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Факт",      Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Итог",      Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Заказ",     Новый ОписаниеТипов("ДокументСсылка.гкс_ЗаявкаНаОтгрузку"));

	Возврат Таблица;

КонецФункции

// Значение колонки Состояние после успешного шага 1. Шаг 2 разрешён только для таких строк.
Функция СостояниеШаг1Сделан() Экспорт

	Возврат НСтр("ru = 'шаг 1 сделан'");

КонецФункции

// Значение колонки Состояние после успешного шага 2.
Функция СостояниеШаг2Сделан() Экспорт

	Возврат НСтр("ru = 'шаг 2 сделан'");

КонецФункции

// Сценарии перенумерации, продиктованные постановщиком на встрече 13.07.2026
// (файл «Встреча в Телемосте 13.07.26 10-32-13 — запись.txt», таймкоды 08:44-10:55).
//
// Правило для новых строк со слов постановщика — «начиная со свободного» [08:59],
// «прыгаем от единицы» [10:18], «отсчёт начинается с пустой» [10:37],
// то есть новая строка занимает МИНИМАЛЬНЫЙ свободный номер, а не Макс+1.
//
// Возвращаемое значение:
//  ТаблицаЗначений - См. НоваяТаблицаСценариев
//
Функция СценарииВстречи() Экспорт

	Сценарии = НоваяТаблицаСценариев();

	// [09:20] «даже если они его перепровели, должна быть проверка: изменился ли заказ.
	//          Если не изменился — ничего дополнительного не нужно».
	Стр = Сценарии.Добавить();
	Стр.Имя      = "S1. Ре-обмен без изменений";
	Стр.Шаг1     = "A,B";
	Стр.Шаг2     = "A,B";
	Стр.Ожидание = "A=1,B=2";

	// [10:27] «если 1, 2, они добавили — всё равно будет 1, 2, 3, 4».
	Стр = Сценарии.Добавить();
	Стр.Имя      = "S2. Добавили 2 строки";
	Стр.Шаг1     = "A,B";
	Стр.Шаг2     = "A,B,C,D";
	Стр.Ожидание = "A=1,B=2,C=3,D=4";

	// [10:32] «двойку удалили, единичку оставили — получается 1, новая строка, 2, 3».
	Стр = Сценарии.Добавить();
	Стр.Имя      = "S3. Удалили 2-ю строку, добавили 2 новых";
	Стр.Шаг1     = "A,B";
	Стр.Шаг2     = "A,C,D";
	Стр.Ожидание = "A=1,C=2,D=3";

	// [10:37] «удалили первую, оставили вторую — двойка остаётся 100%, а отсчёт
	//          начинается с пустой: будет 1 (новая), 2 (старая), и там 3, 4, 5 дальше».
	Стр = Сценарии.Добавить();
	Стр.Имя      = "S4. Удалили 1-ю строку, оставили 2-ю";
	Стр.Шаг1     = "A,B";
	Стр.Шаг2     = "C,B";
	Стр.Ожидание = "C=1,B=2";

	Возврат Сценарии;

КонецФункции

// Считывает НСИ с заказа-образца, чтобы эмулированное сообщение CRM было валидным
// на любой базе (жёстко зашитых идентификаторов нет).
//
// Параметры:
//  ЗаказОбразец - ДокументСсылка.гкс_ЗаявкаНаОтгрузку - источник НСИ.
//
// Возвращаемое значение:
//  Структура - НСИ для сборки сообщения + Проблемы (Массив из Строка).
//
Функция НСИПоЗаказуОбразцу(ЗаказОбразец) Экспорт

	НСИ = Новый Структура;
	НСИ.Вставить("Проблемы", Новый Массив);

	Если Не ЗначениеЗаполнено(ЗаказОбразец) Тогда
		НСИ.Проблемы.Добавить(НСтр("ru = 'Не указан заказ-образец.'"));
		Возврат НСИ;
	КонецЕсли;

	ИменаРеквизитов = "Организация, Контрагент, Грузополучатель, ТипТС, ЦФО, ВидПеревозки,
		|Договор, Валюта, СтанцияОтправления, СтанцияНазначения, Номенклатура, Толеранс, СуммаВключаетНДС";
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказОбразец, ИменаРеквизитов);

	НСИ.Вставить("Организация",       Реквизиты.Организация);
	НСИ.Вставить("Контрагент",        Реквизиты.Контрагент);
	НСИ.Вставить("Грузополучатель",   Реквизиты.Грузополучатель);
	НСИ.Вставить("ТипТС",             Реквизиты.ТипТС);
	НСИ.Вставить("ЦФО",               Реквизиты.ЦФО);
	НСИ.Вставить("ВидПеревозки",      Реквизиты.ВидПеревозки);
	НСИ.Вставить("Договор",           Реквизиты.Договор);
	НСИ.Вставить("Валюта",            Реквизиты.Валюта);
	НСИ.Вставить("СтанцияОтправления", Реквизиты.СтанцияОтправления);
	НСИ.Вставить("СтанцияНазначения",  Реквизиты.СтанцияНазначения);
	НСИ.Вставить("Номенклатура",      Реквизиты.Номенклатура);
	НСИ.Вставить("Толеранс",          Реквизиты.Толеранс);
	НСИ.Вставить("СуммаВключаетНДС",  Реквизиты.СуммаВключаетНДС);

	// Договор ищется загрузкой ТОЛЬКО по гкс_DirectumID (см. НайтиДоговор).
	// Без него договор не найдётся, и это тихий сбой: ветка «не найден» в НайтиДоговор
	// не присваивает текст ошибки, поэтому загрузка промолчит.
	DirectumID = "";
	Если ЗначениеЗаполнено(Реквизиты.Договор) Тогда
		DirectumID = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.Договор, "гкс_DirectumID");
	КонецЕсли;
	НСИ.Вставить("DirectumID", СокрЛП(DirectumID));

	Если Не ЗначениеЗаполнено(НСИ.DirectumID) Тогда
		НСИ.Проблемы.Добавить(НСтр("ru = 'У договора заказа-образца пуст реквизит гкс_DirectumID.
			|Загрузка из CRM ищет договор только по нему, поэтому договор не будет найден (молча).
			|Включите флаг «Проставить DirectumID договору» или выберите другой заказ.'"));
	КонецЕсли;

	// Ставка НДС: в сообщении CRM передаётся имя значения Перечисление.СтавкиНДС,
	// а в строке заказа лежит СправочникСсылка.СтавкиНДС — ищем обратное соответствие.
	НСИ.Вставить("ИмяСтавкиНДС", ИмяСтавкиНДСПоЗаказу(ЗаказОбразец));
	Если Не ЗначениеЗаполнено(НСИ.ИмяСтавкиНДС) Тогда
		НСИ.Проблемы.Добавить(НСтр("ru = 'Не удалось определить ставку НДС по заказу-образцу.'"));
	КонецЕсли;

	Возврат НСИ;

КонецФункции

// ШАГ 1: первый приход заказа из CRM по помеченным сценариям.
//
// Создаёт новый заказ (CRMID = новый UUID), шлёт строки Шаг1, заполняет Факт1, Заказ
// и Состояние. Ожидание НЕ проверяется: на первом приходе нумерация тривиальна
// (по порядку строк CRM). Результат смотрится глазами — заказ открывается по ссылке
// в колонке «Заказ».
//
// Эмулируется только транспорт (XML -> XDTO -> Структура); вся бизнес-логика —
// настоящая: гкс_ЗагрузкаЗаявокНаОтгрузкуИзСRMTrading.ЗагрузитьДокументЗаявкаНаОтгрузку
// замещает табличную часть через ГрафикОтгрузки.Загрузить() (отсюда ИндЗаказа = 0)
// и проводит документ, что и запускает проверяемую логику присвоения.
//
// Параметры:
//  ЗаказОбразец - ДокументСсылка.гкс_ЗаявкаНаОтгрузку - источник НСИ;
//  ДатаОтгрузки - Дата - дата отгрузки строк. ОБЯЗАНА попадать в существующий
//                        финансовый год Справочника гкс_Периоды, иначе «Период из
//                        спецификации» останется пустым (реквизит обязателен к заполнению);
//  Сценарии - ТаблицаЗначений - См. НоваяТаблицаСценариев. Неопределено = СценарииВстречи();
//  ПроставитьDirectumID - Булево - проставить договору образца гкс_DirectumID, если он пуст.
//
// Возвращаемое значение:
//  Структура - См. НовыйРезультатШага.
//
Функция ВыполнитьШаг1(ЗаказОбразец, ДатаОтгрузки, Сценарии = Неопределено,
	ПроставитьDirectumID = Ложь) Экспорт

	Возврат ВыполнитьШагПоСценариям(1, ЗаказОбразец, ДатаОтгрузки, Сценарии, ПроставитьDirectumID);

КонецФункции

// ШАГ 2: повторный приход (ре-обмен) на ТОТ ЖЕ заказ по помеченным сценариям.
//
// CRMID берётся из уже созданного заказа (Заказ.УникальныйИдентификатор()), поэтому
// загрузка попадает в существующий документ и запускает перенумерацию. Заполняет Факт,
// Итог (PASS/FAIL против Ожидание) и Состояние.
//
// Сценарии, по которым шаг 1 не выполнялся, ПРОПУСКАЮТСЯ с предупреждением: новый заказ
// молча не создаётся.
//
// Параметры:
//  ЗаказОбразец - ДокументСсылка.гкс_ЗаявкаНаОтгрузку - источник НСИ;
//  ДатаОтгрузки - Дата - дата отгрузки строк (См. ВыполнитьШаг1);
//  Сценарии - ТаблицаЗначений - См. НоваяТаблицаСценариев. Неопределено = СценарииВстречи();
//  ПроставитьDirectumID - Булево - проставить договору образца гкс_DirectumID, если он пуст.
//
// Возвращаемое значение:
//  Структура - См. НовыйРезультатШага.
//
Функция ВыполнитьШаг2(ЗаказОбразец, ДатаОтгрузки, Сценарии = Неопределено,
	ПроставитьDirectumID = Ложь) Экспорт

	Возврат ВыполнитьШагПоСценариям(2, ЗаказОбразец, ДатаОтгрузки, Сценарии, ПроставитьDirectumID);

КонецФункции

// Результат прогона шага.
//
// Возвращаемое значение:
//  Структура:
//   * Результаты     - ТаблицаЗначений - См. НоваяТаблицаСценариев (с заполненными колонками результата);
//   * Лог            - Строка - подробный лог прогона;
//   * Проблемы       - Массив из Строка - блокирующие проблемы (прогон не состоялся);
//   * Предупреждения - Массив из Строка - непрогонные сценарии (прочие отработали).
//
Функция НовыйРезультатШага() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Лог", "");
	Результат.Вставить("Проблемы", Новый Массив);
	Результат.Вставить("Предупреждения", Новый Массив);

	Возврат Результат;

КонецФункции

// Помечает на удаление заказы, созданные прогоном сценариев (по ВСЕМ строкам, не только
// помеченным — иначе созданные заказы осели бы мусором). У убранных строк сбрасывается
// состояние и результаты: заказа больше нет, значит шаг 1 надо делать заново.
//
// Параметры:
//  Сценарии - ТаблицаЗначений - См. НоваяТаблицаСценариев (колонка Заказ). Изменяется.
//
// Возвращаемое значение:
//  Строка - лог уборки.
//
Функция УбратьЗаСобой(Сценарии) Экспорт

	Лог = "";
	Для Каждого Сценарий Из Сценарии Цикл
		Если Не ЗначениеЗаполнено(Сценарий.Заказ) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ЗаказОбъект = Сценарий.Заказ.ПолучитьОбъект();
			ЗаказОбъект.УстановитьПометкуУдаления(Истина);
			Лог = Лог + СтрШаблон(НСтр("ru = 'Помечен на удаление: %1'"), Сценарий.Заказ) + Символы.ПС;
			Сценарий.Заказ = Документы.гкс_ЗаявкаНаОтгрузку.ПустаяСсылка();
			Сценарий.Состояние = "";
			Сценарий.Факт1 = "";
			Сценарий.Факт = "";
			Сценарий.Итог = "";
		Исключение
			Лог = Лог + СтрШаблон(НСтр("ru = 'Не удалось пометить %1: %2'"),
				Сценарий.Заказ, ОписаниеОшибки()) + Символы.ПС;
		КонецПопытки;
	КонецЦикла;

	Возврат Лог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общий прогон шага по помеченным сценариям: подготовка НСИ и периода — один раз,
// затем шаг по каждой помеченной строке.
Функция ВыполнитьШагПоСценариям(Шаг, ЗаказОбразец, ДатаОтгрузки, Сценарии, ПроставитьDirectumID)

	Результат = НовыйРезультатШага();

	РабочиеСценарии = ?(Сценарии = Неопределено, СценарииВстречи(), Сценарии);
	Результат.Вставить("Результаты", РабочиеСценарии);

	Отобранные = РабочиеСценарии.НайтиСтроки(Новый Структура("Пометка", Истина));
	Если Отобранные.Количество() = 0 Тогда
		Результат.Проблемы.Добавить(
			НСтр("ru = 'Не помечен ни один сценарий: кнопки шагов работают только по помеченным строкам.'"));
		Возврат Результат;
	КонецЕсли;

	НСИ = НСИПоЗаказуОбразцу(ЗаказОбразец);

	Если ПроставитьDirectumID И ЗначениеЗаполнено(НСИ.Договор) И Не ЗначениеЗаполнено(НСИ.DirectumID) Тогда
		НСИ.DirectumID = "TEST-CRM-" + Строка(Новый УникальныйИдентификатор());
		ДоговорОбъект = НСИ.Договор.ПолучитьОбъект();
		ДоговорОбъект.гкс_DirectumID = НСИ.DirectumID;
		ДоговорОбъект.Записать();
		Результат.Лог = Результат.Лог + СтрШаблон(
			НСтр("ru = '[НСИ] Договору «%1» проставлен гкс_DirectumID = %2'"),
			НСИ.Договор, НСИ.DirectumID) + Символы.ПС;
		НСИ.Проблемы.Очистить();
	КонецЕсли;

	Для Каждого Проблема Из НСИ.Проблемы Цикл
		Результат.Проблемы.Добавить(Проблема);
	КонецЦикла;

	Если Результат.Проблемы.Количество() > 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПроверкаПериода = ПроверитьПериодОтгрузки(ДатаОтгрузки);
	Если Не ПроверкаПериода.Успешно Тогда
		Результат.Проблемы.Добавить(ПроверкаПериода.Текст);
		Возврат Результат;
	КонецЕсли;
	Результат.Лог = Результат.Лог + ПроверкаПериода.Текст + Символы.ПС;

	Для Каждого Сценарий Из Отобранные Цикл
		ВыполнитьШаг(Сценарий, Шаг, НСИ, ДатаОтгрузки, Результат);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Один шаг по одному сценарию. Результат пишется прямо в строку Сценарий.
Процедура ВыполнитьШаг(Сценарий, Шаг, НСИ, ДатаОтгрузки, Результат)

	Результат.Лог = Результат.Лог + СтрШаблон(
		НСтр("ru = '======== %1 (шаг %2) ========'"), Сценарий.Имя, Шаг) + Символы.ПС;

	Если Шаг = 1 Тогда
		// CRMID заказа = UUID ссылки документа: загрузка делает
		// Документы.гкс_ЗаявкаНаОтгрузку.ПолучитьСсылку(GUID), отдельного поля соответствия нет.
		Сценарий.Заказ = Документы.гкс_ЗаявкаНаОтгрузку.ПолучитьСсылку(Новый УникальныйИдентификатор());
		Сценарий.Факт1 = "";
		Сценарий.Факт = "";
		Сценарий.Итог = "";
		Сценарий.Состояние = "";
	ИначеЕсли Сценарий.Состояние <> СостояниеШаг1Сделан() Тогда
		// Гейт: без успешного шага 1 заказа нет, и повторный приход создал бы НОВЫЙ заказ
		// вместо ре-обмена — это молча подменило бы смысл проверки.
		Предупреждение = СтрШаблон(
			НСтр("ru = '%1: шаг 2 пропущен — шаг 1 не выполнен (заказ не создан).'"), Сценарий.Имя);
		Результат.Предупреждения.Добавить(Предупреждение);
		Результат.Лог = Результат.Лог + "  " + Предупреждение + Символы.ПС;
		Возврат;
	КонецЕсли;

	ИменаСтрок = ?(Шаг = 1, Сценарий.Шаг1, Сценарий.Шаг2);
	CRMIDЗаказа = Сценарий.Заказ.УникальныйИдентификатор();

	Сообщение = СообщениеCRM(Строка(CRMIDЗаказа), ИменаСтрок, НСИ, ДатаОтгрузки, Сценарий.Имя, Шаг);

	ЗагруженныеОбъекты = Новый Массив;
	ОшибкаЗагрузки = "";
	Попытка
		гкс_ЗагрузкаЗаявокНаОтгрузкуИзСRMTrading.ЗагрузитьДокументЗаявкаНаОтгрузку(
			Сообщение, ЗагруженныеОбъекты, ОшибкаЗагрузки);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сценарий.Итог = "ОШИБКА";
		Если Шаг = 1 Тогда
			Сценарий.Факт1 = ТекстОшибки;
		Иначе
			Сценарий.Факт = ТекстОшибки;
		КонецЕсли;
		Результат.Лог = Результат.Лог + СтрШаблон(
			НСтр("ru = '  шаг %1: ИСКЛЮЧЕНИЕ %2'"), Шаг, ТекстОшибки) + Символы.ПС;
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(ОшибкаЗагрузки) Тогда
		// Загрузка не блокирует запись на этих ошибках — фиксируем в лог как предупреждение.
		Результат.Лог = Результат.Лог + СтрШаблон(
			НСтр("ru = '  шаг %1: предупреждения загрузки: %2'"), Шаг, ОшибкаЗагрузки) + Символы.ПС;
	КонецЕсли;

	Факт = ФактПоЗаказу(Сценарий.Заказ);
	Результат.Лог = Результат.Лог + СтрШаблон(
		НСтр("ru = '  шаг %1: CRM шлёт [%2] -> факт: %3'"), Шаг, ИменаСтрок, Факт) + Символы.ПС;

	Если Шаг = 1 Тогда
		Сценарий.Факт1 = Факт;
		Сценарий.Состояние = СостояниеШаг1Сделан();
		Результат.Лог = Результат.Лог + СтрШаблон(
			НСтр("ru = '  заказ создан: %1 — откройте его по ссылке в колонке «Заказ».'"),
			Сценарий.Заказ) + Символы.ПС;
	Иначе
		Сценарий.Факт = Факт;
		Сценарий.Итог = ?(Факт = Сценарий.Ожидание, "PASS", "FAIL");
		Сценарий.Состояние = СостояниеШаг2Сделан();
		Результат.Лог = Результат.Лог + СтрШаблон(
			НСтр("ru = '  ожидание встречи: %1 -> %2'"), Сценарий.Ожидание, Сценарий.Итог) + Символы.ПС;
	КонецЕсли;

КонецПроцедуры

// Собирает структуру сообщения ровно в том виде, в каком её отдаёт
// гкс_ИнтеграцияСRMTrading.ОбъектXDTOВСтруктуру после разбора XML.
// XDTO читается без указания типа, поэтому ВСЕ листовые значения — строки,
// и загрузка парсит их сама (XMLЗначение / СтрокаВДату).
Функция СообщениеCRM(CRMIDЗаказа, ИменаСтрок, НСИ, ДатаОтгрузки, ИмяСценария, Шаг)

	ЗаявкаCRM = Новый Структура;
	ЗаявкаCRM.Вставить("CRMID", CRMIDЗаказа);
	ЗаявкаCRM.Вставить("OurCompany", СтруктураGUID(НСИ.Организация));
	ЗаявкаCRM.Вставить("Account",    СтруктураGUID(НСИ.Контрагент));
	ЗаявкаCRM.Вставить("Consignee",  СтруктураGUID(НСИ.Грузополучатель));
	ЗаявкаCRM.Вставить("Specification", Новый Структура("DirectumID", НСИ.DirectumID));
	ЗаявкаCRM.Вставить("Comment", СтрШаблон(НСтр("ru = 'GMFM-6470 тест: %1, шаг %2'"), ИмяСценария, Шаг));

	Если ЗначениеЗаполнено(НСИ.ТипТС) Тогда
		ЗаявкаCRM.Вставить("TransportType", СтруктураGUID(НСИ.ТипТС));
	КонецЕсли;
	Если ЗначениеЗаполнено(НСИ.ЦФО) Тогда
		ЗаявкаCRM.Вставить("FinancialResponsibilityCenter", СтруктураGUID(НСИ.ЦФО));
	КонецЕсли;
	Если ЗначениеЗаполнено(НСИ.ВидПеревозки) Тогда
		// В сообщении вид перевозки приходит ИМЕНЕМ значения перечисления
		// (СсылкаНаЗначениеПеречисления сопоставляет по Имени ИЛИ Синониму).
		ЗаявкаCRM.Вставить("OpportunityDeliveryType",
			Новый Структура("TransportKindMFM", ИмяЗначенияПеречисления(НСИ.ВидПеревозки)));
	КонецЕсли;

	Возможность = Новый Структура;
	Возможность.Вставить("Tolerance", Формат(НСИ.Толеранс, "ЧРД=.; ЧГ=0"));
	Возможность.Вставить("IsNDSIncludeInPrice", ?(НСИ.СуммаВключаетНДС, "true", "false"));
	Если ЗначениеЗаполнено(НСИ.Валюта) Тогда
		Возможность.Вставить("Currency", Новый Структура("Code",
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НСИ.Валюта, "Код")));
	КонецЕсли;
	ЗаявкаCRM.Вставить("Opportunity", Возможность);

	Если ЗначениеЗаполнено(НСИ.СтанцияОтправления) Тогда
		ЗаявкаCRM.Вставить("DepartureStation", СтруктураСтанции(НСИ.СтанцияОтправления));
	КонецЕсли;
	Если ЗначениеЗаполнено(НСИ.СтанцияНазначения) Тогда
		ЗаявкаCRM.Вставить("DestinationStation", СтруктураСтанции(НСИ.СтанцияНазначения));
	КонецЕсли;

	СтрокиCRM = Новый Массив;
	СдвигДней = 0;
	Для Каждого Литера Из СтрРазделить(ИменаСтрок, ",") Цикл
		СтрокиCRM.Добавить(СтрокаCRM(СокрЛП(Литера), НСИ, ДатаОтгрузки + СдвигДней * 86400));
		СдвигДней = СдвигДней + 1;
	КонецЦикла;
	// Порядок массива = порядок строк табличной части = порядок из CRM.
	ЗаявкаCRM.Вставить("ShipmentPeriodInShipmentRequest",
		Новый Структура("ShipmentPeriod", СтрокиCRM));

	Сообщение = Новый Структура;
	// Header.CreationDate парсится через XMLЗначение(Тип("Дата")) — нужен ISO С «T».
	Сообщение.Вставить("Header",
		Новый Структура("CreationDate", ЗаписьXML_Дата(ДатаОтгрузки)));
	Сообщение.Вставить("Body", Новый Структура("ShipmentRequest", ЗаявкаCRM));

	Возврат Сообщение;

КонецФункции

Функция СтрокаCRM(Литера, НСИ, ДатаСтроки)

	Строка = Новый Структура;
	// CRMID строки -> ИдентификаторСтроки. Реквизит = Строка(36): более длинный
	// идентификатор загрузка молча обрежет, строки схлопнутся и заказ не проведётся.
	Строка.Вставить("CRMID", "GMFM6470-" + Литера + "-" + Строка(Новый УникальныйИдентификатор()));
	Строка.Вставить("Product", СтруктураGUID(НСИ.Номенклатура));
	// Даты строк парсятся через СтроковыеФункцииКлиентСервер.СтрокаВДату,
	// которая на ISO с «T» молча возвращает пустую дату — нужен формат «ГГГГ-ММ-ДД».
	Строка.Вставить("ShipmentPeriodStartDate", Формат(ДатаСтроки, "ДФ=yyyy-MM-dd"));
	Строка.Вставить("ShipmentPeriodEndDate",   Формат(ДатаСтроки, "ДФ=yyyy-MM-dd"));
	Строка.Вставить("ProductQuantityShipment", "100");
	Строка.Вставить("Price",  "49000");
	Строка.Вставить("Amount", "4900000");
	Если ЗначениеЗаполнено(НСИ.ИмяСтавкиНДС) Тогда
		Строка.Вставить("Tax", Новый Структура("Name1C", НСИ.ИмяСтавкиНДС));
	КонецЕсли;

	Возврат Строка;

КонецФункции

Функция СтруктураGUID(Ссылка)
	Возврат Новый Структура("GUID1C", Строка(Ссылка.УникальныйИдентификатор()));
КонецФункции

Функция СтруктураСтанции(Станция)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Станция, "Код, Наименование");
	// НайтиЖДСтанцию требует ОБА тега — и Code, и Name.
	Возврат Новый Структура("Code, Name", СокрЛП(Реквизиты.Код), СокрЛП(Реквизиты.Наименование));

КонецФункции

Функция ЗаписьXML_Дата(Дата)
	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

Функция ИмяЗначенияПеречисления(ЗначениеПеречисления)

	МетаданныеПеречисления = ЗначениеПеречисления.Метаданные();
	Для Каждого ЗначениеМетаданных Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
		Если Перечисления[МетаданныеПеречисления.Имя][ЗначениеМетаданных.Имя] = ЗначениеПеречисления Тогда
			Возврат ЗначениеМетаданных.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИмяСтавкиНДСПоЗаказу(ЗаказОбразец)

	СтавкаСправочник = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	График.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Документ.гкс_ЗаявкаНаОтгрузку.ГрафикОтгрузки КАК График
		|ГДЕ
		|	График.Ссылка = &Заказ
		|	И График.СтавкаНДС <> ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Заказ", ЗаказОбразец);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтавкаСправочник = Выборка.СтавкаНДС;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтавкаСправочник) Тогда
		Возврат "";
	КонецЕсли;

	// Обратный поиск: в сообщении CRM ставка приходит именем значения
	// Перечисление.СтавкиНДС, а загрузка мапит его в справочник через
	// гкс_УчетНДС.СтавкаНДСПоЗначениюПеречисления.
	Для Каждого ЗначениеМетаданных Из Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления Цикл
		ЗначениеПеречисления = Перечисления.СтавкиНДС[ЗначениеМетаданных.Имя];
		Если гкс_УчетНДС.СтавкаНДСПоЗначениюПеречисления(ЗначениеПеречисления) = СтавкаСправочник Тогда
			Возврат ЗначениеМетаданных.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// «Период из спецификации» в сообщении CRM не передаётся — загрузка вычисляет его
// из ПериодОтгрузкиПо функцией БлижайшийПериодФинансовыйГод. Если подходящего
// финансового года в справочнике нет, реквизит останется пустым, а он обязателен
// к заполнению (fillChecking = ShowError) — форма заказа покажет его красным.
Функция ПроверитьПериодОтгрузки(ДатаОтгрузки)

	Проверка = Новый Структура("Успешно, Текст", Ложь, "");

	Если Не ЗначениеЗаполнено(ДатаОтгрузки) Тогда
		Проверка.Текст = НСтр("ru = 'Не указана дата отгрузки.'");
		Возврат Проверка;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МИНИМУМ(Периоды.ДатаОкончания) КАК ДатаОкончания
		|ИЗ
		|	Справочник.гкс_Периоды КАК Периоды
		|ГДЕ
		|	Периоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год)
		|	И Периоды.Произвольный
		|	И МЕСЯЦ(Периоды.ДатаНачала) = 7
		|	И МЕСЯЦ(Периоды.ДатаОкончания) = 6
		|	И Периоды.ДатаОкончания >= &ДатаОтгрузки";
	Запрос.УстановитьПараметр("ДатаОтгрузки", ДатаОтгрузки);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ДатаОкончания) Тогда
		Проверка.Успешно = Истина;
		Проверка.Текст = СтрШаблон(
			НСтр("ru = '[Период] Дата отгрузки %1 попадает в финансовый год, «Период из спецификации» заполнится.'"),
			Формат(ДатаОтгрузки, "ДЛФ=D"));
	Иначе
		Проверка.Текст = СтрШаблон(
			НСтр("ru = 'Для даты отгрузки %1 нет подходящего финансового года в справочнике «Периоды»
				|(нужен элемент с периодичностью «Год», признаком «Произвольный», началом в июле и
				|окончанием в июне, у которого дата окончания не раньше даты отгрузки).
				|Обязательный реквизит «Период из спецификации» останется пустым.
				|Выберите дату внутри существующего финансового года или заведите новый.'"),
			Формат(ДатаОтгрузки, "ДЛФ=D"));
	КонецЕсли;

	Возврат Проверка;

КонецФункции

Функция ФактПоЗаказу(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	График.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	График.ИндЗаказа КАК ИндЗаказа
		|ИЗ
		|	Документ.гкс_ЗаявкаНаОтгрузку.ГрафикОтгрузки КАК График
		|ГДЕ
		|	График.Ссылка = &Заказ
		|УПОРЯДОЧИТЬ ПО
		|	График.НомерСтроки";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();

	Пары = Новый Массив;
	Пока Выборка.Следующий() Цикл
		// Идентификатор строки собран как «GMFM6470-<Литера>-<UUID>» — вынимаем литеру.
		Части = СтрРазделить(Выборка.ИдентификаторСтроки, "-");
		Литера = ?(Части.Количество() > 1, Части[1], Выборка.ИдентификаторСтроки);
		Пары.Добавить(Литера + "=" + Формат(Выборка.ИндЗаказа, "ЧГ=0"));
	КонецЦикла;

	Возврат СтрСоединить(Пары, ",");

КонецФункции

#КонецОбласти

#КонецЕсли
