  <attributes>
    <name>СписокНоменклатуры</name>
    <title>
      <key>ru</key>
      <value>Список номенклатуры</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
