#Область ПрограммныйИнтерфейс

// Определяет регистрацию в группу по усиленному контролю,
// если регистрация уже принадлежит группе, то возвращает ссылку на существующую.
// Если группы нет, то пытыемся создать новую
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК -Документ регистрации
//  ПроизводственныеСутки - Дата - Производственные сутки
//  КоличествоТС - Число - количество транспортных средсв для новой группы
// 
// Возвращаемое значение:
//  СправочникСсылка.гкс_ГруппыТС - группа в которую попала регистрация
//
Функция ОпределитьРегистрациюВГруппу(ДокументРегистрации, ПроизводственныеСутки, КоличествоТС) Экспорт
	
	ГруппаРегистрации = ГруппаРегистрации(ДокументРегистрации);
	
	Если ЗначениеЗаполнено(ГруппаРегистрации) Тогда
	    Возврат ГруппаРегистрации;	
	КонецЕсли;
	
	ПодборГруппы = ПодборГруппыТС(ДокументРегистрации, ПроизводственныеСутки, КоличествоТС);
		
	Если Не (ЗначениеЗаполнено(ПодборГруппы.Текущая)
		И ВозможноДобавлениеВГруппуПоРазмеру(ПодборГруппы.Текущая)) Тогда  												// первая группа           
		
		ГруппаРегистрации = НоваяГруппаУсиленногоКонтроля(ДокументРегистрации, ПроизводственныеСутки, 
														ПодборГруппы.Текущая, КоличествоТС);		
	Иначе
		ГруппаРегистрации = ПодборГруппы.Текущая;												
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГруппаРегистрации) Тогда 
		ДобавитьВСоставГруппы(ДокументРегистрации, ГруппаРегистрации);
	КонецЕсли;	

	Возврат ГруппаРегистрации;
	
КонецФункции

// Подбор группы транспортных средств для регистрации по условиям.
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - Документ регистрации транспорта
//  ПроизводственныеСутки - Дата - Производственные сутки
//  КоличествоТС - Число - Количество ТС
// 
// Возвращаемое значение:
//  Структура:
//		*Текущая - СправочникСсылка.гкс_ГруппыТС - подобранная группа
//		*Предыдущая - СправочникСсылка.гкс_ГруппыТС - группа перед подобранной
//
Функция ПодборГруппыТС(ДокументРегистрации, ПроизводственныеСутки, КоличествоТС) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Текущая", ПустаяСсылка());
	Результат.Вставить("Предыдущая", ПустаяСсылка());
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	ГруппыТС.Ссылка КАК Ссылка,
		|	ГруппыТС.ДатаСоздания КАК ДатаСоздания,
		|	ГруппыТС.ГоловаГруппы КАК ГоловаГруппы,
		|	ГруппыТС.МаксимальныйРазмерГруппы КАК МаксимальныйРазмерГруппы
		|ИЗ
		|	Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.гкс_ГруппыТС КАК ГруппыТС
		|		ПО РегистрацияНаПЛК.Контрагент = ГруппыТС.Контрагент
		|			И РегистрацияНаПЛК.ТочкаМаршрута = ГруппыТС.ТочкаМаршрута
		|			И РегистрацияНаПЛК.Номенклатура = ГруппыТС.Номенклатура
		|			И (РегистрацияНаПЛК.Ссылка = &ДокументРегистрации)
		|			И (ГруппыТС.ПроизводственныеСутки = &ПроизводственныеСутки)
		|			И (ГруппыТС.МаксимальныйРазмерГруппы <= &МаксимальныйРазмерГруппы)
		|ГДЕ
		|	ГруппыТС.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСоздания УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.УстановитьПараметр("ПроизводственныеСутки", ПроизводственныеСутки); 
	Запрос.УстановитьПараметр("МаксимальныйРазмерГруппы", КоличествоТС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
		ВыборкаДетальныеЗаписи.Следующий();
		Результат.Текущая = ВыборкаДетальныеЗаписи.Ссылка;
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Результат.Предыдущая = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

// Возвращает текущую группу регистрации
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - Документ регистрации
// 
// Возвращаемое значение:
//  СправочникСсылка.гкс_ГруппыТС - Группа регистрации
//
Функция ГруппаРегистрации(ДокументРегистрации) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоставГруппТранспорта.ГруппаТС КАК ГруппаТС
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|ГДЕ
		|	СоставГруппТранспорта.РегистрацияТранспорта = &РегистрацияТранспорта";
	
	Запрос.УстановитьПараметр("РегистрацияТранспорта", ДокументРегистрации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат ВыборкаДетальныеЗаписи.ГруппаТС;
	Иначе
		Возврат ПустаяСсылка();
	КонецЕсли;

КонецФункции

// Возвращает все регистрации группы документа
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - Документ регистрации
// 
// Возвращаемое значение:
//  Массив из ДокументСсылка.гкс_РегистрацияНаПЛК - ссылки на все документы группы
//
Функция СоставГруппыПоРегистрации(ДокументРегистрации) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоставГруппТранспорта.ГруппаТС КАК ГруппаТС
		|ПОМЕСТИТЬ ВТ_ГруппыТС
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|ГДЕ
		|	СоставГруппТранспорта.РегистрацияТранспорта = &ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоставГруппТранспорта.РегистрацияТранспорта КАК РегистрацияТранспорта
		|ИЗ
		|	ВТ_ГруппыТС КАК ВТ_ГруппыТС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|		ПО ВТ_ГруппыТС.ГруппаТС = СоставГруппТранспорта.ГруппаТС";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("РегистрацияТранспорта");
	Иначе
		Результат = Новый Массив;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Определяет текущее количество участников группы.
// 
// Параметры:
//  ГруппаТС - СправочникСсылка.гкс_ГруппыТС - Группа ТС
// 
// Возвращаемое значение:
//  Число - Текущий размер группы
Функция ТекущийРазмерГруппы(ГруппаТС) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоставГруппТранспорта.РегистрацияТранспорта) КАК РазмерГруппы
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|ГДЕ
		|	СоставГруппТранспорта.ГруппаТС = &ГруппаТС";
	
	Запрос.УстановитьПараметр("ГруппаТС", ГруппаТС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	Иначе
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат ВыборкаДетальныеЗаписи.РазмерГруппы;
	КонецЕсли;

КонецФункции

// Вовзращает максимальный размер группы.
// 
// Параметры:
//  ГруппаТС - СправочникСсылка.гкс_ГруппыТС - Группа ТС
// 
// Возвращаемое значение:
//  Число - Максимальный размер группы
//
Функция МаксимальныйРазмерГруппы(ГруппаТС) Экспорт
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаТС, "МаксимальныйРазмерГруппы");
	
КонецФункции

// Проверка на возможное добавление в группу по размеру группы.
// 
// Параметры:
//  ГруппаТС - СправочникСсылка.гкс_ГруппыТС - ссылка на группу ТС
// 
// Возвращаемое значение:
//  Булево - Возможно добавление в группу
//
Функция ВозможноДобавлениеВГруппуПоРазмеру(ГруппаТС) Экспорт 
	
	Если Не ЗначениеЗаполнено(ГруппаТС) Тогда	
		ВызватьИсключение "Не указана группа для определения размера";	
	КонецЕсли;
	
	МаксимальныйРазмер = МаксимальныйРазмерГруппы(ГруппаТС);
	
	Если МаксимальныйРазмер = 0 
		ИЛИ ТекущийРазмерГруппы(ГруппаТС) < МаксимальныйРазмер Тогда
			
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет регистрацию на ПЛК в состав группы.
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - Документ регистрации
//  ГруппаТС - СправочникСсылка.гкс_ГруппыТС - группа ТС для включения
//
Процедура ДобавитьВСоставГруппы(ДокументРегистрации, ГруппаТС) Экспорт
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("ГруппаТС", ГруппаТС);
	СтруктураЗаписи.Вставить("РегистрацияТранспорта", ДокументРегистрации);
	СтруктураЗаписи.Вставить("ТранспортноеСредство", 
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументРегистрации, "ТранспортноеСредство"));
	СтруктураЗаписи.Вставить("МестнаяДата", ТекущаяДатаСеанса());
	
	гкс_ОбменДаннымиСервер.ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "гкс_СоставГруппТранспорта");
	
КонецПроцедуры

// проверяет завершенность промежуточный композит предыдущей группы регистрации изавершен.
// 
// Параметры:
//  ГруппаТС - ДокументСсылка.гкс_РегистрацияНаПЛК - регистраия транспорта
// 
// Возвращаемое значение:
//  Булево - Истина, если промежуточный композит группы не завершен
//
Функция ПромежуточныйКомпозитПредыдущейГруппыРегистрацииНеЗавершен(ДокументРегистрации) Экспорт
	
	ГруппаТС = Справочники.гкс_ГруппыТС.ГруппаРегистрации(ДокументРегистрации);
		
	// проверка на наличие завершенного промежуточного композита на группу
	Если ЗначениеЗаполнено(ГруппаТС) Тогда
		
		ПредыдущаяГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаТС, "ПредыдущаяГруппа");
		
		Результат = ЗначениеЗаполнено(ПредыдущаяГруппа) 
			И Не ПромежуточныйКомпозитГруппыЗавершен(ПредыдущаяГруппа);
	Иначе		
		Результат = Ложь;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	
	
// проверяет завершенность промежуточный композит группы завершен.
// 
// Параметры:
//  ГруппаТС - СправочникСсылка.гкс_ГруппыТС, Неопределено - Группа ТС
// 
// Возвращаемое значение:
//  Булево - Истина, если промежуточный композит группы завершен
//
Функция ПромежуточныйКомпозитГруппыЗавершен(ГруппаТС) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоставГруппТранспорта.РегистрацияТранспорта КАК РегистрацияТранспорта
		|ПОМЕСТИТЬ ВТ_СоставГруппы
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|ГДЕ
		|	СоставГруппТранспорта.ГруппаТС = &ГруппаТС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СоставГруппы.РегистрацияТранспорта КАК РегистрацияТранспорта,
		|	ВЫБОР
		|		КОГДА ДокументЛабораторныйАнализ.Статус ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК АнализЗавершен
		|ИЗ
		|	ВТ_СоставГруппы КАК ВТ_СоставГруппы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроляПоРегистрации
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ КАК ДокументЛабораторныйАнализ
		|			ПО ПоказателиУсиленногоКонтроляПоРегистрации.ЛабораторныйАнализ = ДокументЛабораторныйАнализ.Ссылка
		|				И (ДокументЛабораторныйАнализ.Статус = ЗНАЧЕНИЕ(Перечисление.гкс_СтатусыЛабораторногоАнализа.Выполнен))
		|		ПО ВТ_СоставГруппы.РегистрацияТранспорта = ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
		|			И (ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит))
		|			И (ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная))
		|ИТОГИ
		|	МАКСИМУМ(АнализЗавершен)
		|ПО
		|	ОБЩИЕ";
	
	Запрос.УстановитьПараметр("ГруппаТС", ГруппаТС);
	
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда
		
		ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаОбщийИтог.Следующий();		// Общий итог
		Результат = ВыборкаОбщийИтог.АнализЗавершен;
		
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;	

КонецФункции

