// Вызывается для формирования состава полей, из которых формируется 
// представление справочника транспортных средств.
//
// Параметры:
//  Поля                 - Массив Из Строка - массив, содержащий имена полей, 
//  						которые нужны для формирования представления объекта или ссылки.
//  						
//  СтандартнаяОбработка - Булево - в данный параметр передается признак выполнения стандартной 
//  								(системной) обработки события.
//                                	Если в теле процедуры-обработчика установить данному параметру значение Ложь,
//                                  стандартная обработка события производиться не будет.
//
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка) Экспорт 
	
	Поля.Добавить("НомерГруппыПоставщика");
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

// Вызывается при получении представления справочника транспортных средств.
//
// Параметры:
//  Данные               - Структура - содержит значения полей, из которых формируется представление.
//  Представление        - Строка - в данный параметр нужно поместить сформированное представление.
//  СтандартнаяОбработка - Булево - в данный параметр передается признак формирования стандартного представления.
//
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка) Экспорт
	
	ДанныеДляПредставления = Новый Массив;
	
	ДобавитьПоле(ДанныеДляПредставления, СтрШаблон("группа: %1", Данные.НомерГруппыПоставщика));
		
	Представление = СтрСоединить(ДанныеДляПредставления, ";");
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создать группу усиленного контроля.
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - Документ регистрации
//  ПроизводственныеСутки - Дата - Производственные сутки
//  РазмерГруппы - Число - Размер группы
//  ПредыдущаяГруппа - СправочникСсылка.гкс_ГруппыТС - ссылка на предыдущую группу по поставщику и номенклатуре
// 
// Возвращаемое значение:
//  СправочникСсылка.гкс_ГруппыТС - ссылка на созданный элемент справочника
//
Функция НоваяГруппаУсиленногоКонтроля(ДокументРегистрации, ПроизводственныеСутки, 
		ПредыдущаяГруппа, РазмерГруппы = 0)
		
	ДанныеЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРегистрации,
		"ТочкаМаршрута, Контрагент, Номенклатура");
	
	НомерГруппы = КоличествоГруппПоставщикаЗаСутки(ПроизводственныеСутки, ДанныеЗаполнения.Контрагент, 
		ДанныеЗаполнения.Номенклатура, ДанныеЗаполнения.ТочкаМаршрута) + 1;
		
	ДанныеЗаполнения.Вставить("ПроизводственныеСутки", ПроизводственныеСутки);
	ДанныеЗаполнения.Вставить("МаксимальныйРазмерГруппы", РазмерГруппы);
	ДанныеЗаполнения.Вставить("ГоловаГруппы", ДокументРегистрации);
	ДанныеЗаполнения.Вставить("ПредыдущаяГруппа", ПредыдущаяГруппа);
	ДанныеЗаполнения.Вставить("ДатаСоздания", ТекущаяУниверсальнаяДата());
	ДанныеЗаполнения.Вставить("НомерГруппыПоставщика", НомерГруппы);
	
    ГруппаТС = СоздатьЭлемент();
	ГруппаТС.Заполнить(ДанныеЗаполнения);
	ГруппаТС.Записать();
	
	Возврат ГруппаТС.Ссылка;
		
КонецФункции

Функция КоличествоГруппПоставщикаЗаСутки(ПроизводственныеСутки, Контрагент, Номенклатура, ТочкаМаршрута)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГруппыТС.Ссылка) КАК КоличествоГрупп
	|ИЗ
	|	Справочник.гкс_ГруппыТС КАК ГруппыТС
	|ГДЕ
	|	ГруппыТС.ПроизводственныеСутки = &ПроизводственныеСутки
	|	И ГруппыТС.Контрагент = &Контрагент
	|	И ГруппыТС.Номенклатура = &Номенклатура
	|	И ГруппыТС.ТочкаМаршрута = &ТочкаМаршрута";
	
	Запрос.УстановитьПараметр("ПроизводственныеСутки", ПроизводственныеСутки);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТочкаМаршрута", ТочкаМаршрута);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		Результат = 0;	
	Иначе	
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Результат = ВыборкаДетальныеЗаписи.КоличествоГрупп;	
	КонецЕсли;
	
    Возврат Результат;
	
КонецФункции	

Процедура ДобавитьПоле(МассивСтрок, ЗначениеПоля)
	
	Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
		МассивСтрок.Добавить(ЗначениеПоля);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли