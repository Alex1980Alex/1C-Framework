Функция ДополнитьАдреснуюСтрокуПараметрами(Ресурс, УРЛРесурса, ЗначенияПараметров)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РесурсыВебСервисовПараметры.ИмяПараметра КАК ИмяПараметра
		|ИЗ
		|	Справочник.гкс_РесурсыВебСервисов.Параметры КАК РесурсыВебСервисовПараметры
		|ГДЕ
		|	РесурсыВебСервисовПараметры.Ссылка = &Ссылка
		|	И РесурсыВебСервисовПараметры.ТипПараметра = ЗНАЧЕНИЕ(Перечисление.гкс_ТипПараметраЗапроса.path)";
	
	Запрос.УстановитьПараметр("Ссылка", Ресурс);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗначениеПараметра = Неопределено;
		ЗначенияПараметров.Свойство(ВыборкаДетальныеЗаписи.ИмяПараметра, ЗначениеПараметра);
		
		Если ЗначенияПараметров <> Неопределено Тогда
			СтрокаПоиска = СтрШаблон("{%1}", ВыборкаДетальныеЗаписи.ИмяПараметра);
			УРЛРесурса = СтрЗаменить(УРЛРесурса, СтрокаПоиска, Строка(ЗначениеПараметра));
		КонецЕсли;
	КонецЦикла;
	
	Возврат УРЛРесурса;
	
КонецФункции

