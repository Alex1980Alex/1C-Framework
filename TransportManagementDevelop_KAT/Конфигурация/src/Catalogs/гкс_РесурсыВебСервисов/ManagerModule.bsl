// Полный адрес
// 
// Параметры:
//  Ресурс - СправочникСсылка.гкс_РесурсыВебСервисов - Сервис
//  ЗначенияПараметров - Структура - Значение параметров для заполнения
//
// Возвращаемое значение:
//  Строка - полный адрес ресурса, включая родительские адреса
//
Функция ПолныйАдрес(Ресурс, ЗначенияПараметров = Неопределено) Экспорт
	
	УРЛРесурса = "";

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ресурс);
	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   Сервисы.Родитель КАК КорневойУзел,
		|	ЕстьNull(Сервисы.Родитель.URL, """") КАК РодительURL,
		|	Сервисы.URL КАК URL
		|ИЗ
		|	Справочник.гкс_РесурсыВебСервисов КАК Сервисы
		|ГДЕ
		|	Сервисы.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Пока Не РезультатЗапроса.Пустой() Цикл
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		УРЛРесурса = СтрШаблон("/%1%2", Выборка.URL, УРЛРесурса);
		
		Запрос.УстановитьПараметр("Ссылка", Выборка.КорневойУзел);
		РезультатЗапроса = Запрос.Выполнить();	
			
	КонецЦикла;
	
	// заполнение параметров в пути
	Если ЗначениеЗаполнено(ЗначенияПараметров) Тогда
        УРЛРесурса = ДополнитьАдреснуюСтрокуПараметрами(Ресурс, УРЛРесурса, ЗначенияПараметров);
	КонецЕсли;	
	
	Подключение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ресурс, "Подключение");
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ВызватьИсключение НСтр("ru='Не заполнено подключение. Вызов невозможен'");
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подключение, "Сервер,Порт,ИспользоватьЗащищенноеСоединение,");
	
	Схема = "http";
	Если Реквизиты.ИспользоватьЗащищенноеСоединение Тогда
		Схема = "https";
	КонецЕсли;
	
	Результат = СтрШаблон("%1://%2:%3%4", Схема, Реквизиты.Сервер, Реквизиты.Порт, УРЛРесурса);
	
	Возврат Результат;
	
КонецФункции
	
// Подключение к сервису.
// 
// Параметры:
//  Сервис - СправочникСсылка.гкс_РесурсыВебСервисов - Сервис
// 
// Возвращаемое значение:
//  СправочникСсылка.гкс_ПодключениеКВебСервисам - Подключение к сервису
//
Функция ПодключениеКСервису(Ресурс) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ресурс);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВсеСервисы.Подключение КАК Подключение
	|ИЗ
	|	Справочник.гкс_РесурсыВебСервисов КАК ВсеСервисы
	|ГДЕ
	|	ВсеСервисы.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Подключение;
	Иначе
		Результат = Справочники.гкс_ПодключениеКВебСервисам.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на предопределенный элемент справочника ресурсов веб-сервисов по имени предопределенных данных.
//
// Параметры:
//   ИмяПредопределенного - Строка - Имя предопределенных данных
//
// Возвращаемое значение:
//   СправочникСсылка.гкс_РесурсыВебСервисов - Ссылка на предопределенный элемент
//   Неопределено - Элемент не найден
//
Функция ОписаниеПоИмениПредопределенного(ИмяПредопределенного) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РесурсыВебСервисов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.гкс_РесурсыВебСервисов КАК РесурсыВебСервисов
		|ГДЕ
		|	РесурсыВебСервисов.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных";
	
	Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", ИмяПредопределенного);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий(); 
		Результат = ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
