#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Обновляет данные справочника из Warehouse по идентификатору
//
Процедура ОбновитьДанныеССервера(ИдентификаторWarehouse) Экспорт
	
	РесурсВебСервиса = Справочники.гкс_РесурсыВебСервисов.Stations_GetById;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить(ИмяКлючевогоСвойстваВWarehouse(), ИдентификаторWarehouse);
	
	ПараметрыПреобразованияJSON = Новый Структура;
	ПараметрыПреобразованияJSON.Вставить("ПрочитатьВСоответствие", Ложь);
	ПараметрыПреобразованияJSON.Вставить("ИменаСвойствСоЗначениямиДата", "updatedOn");
	
	ДанныеОтветаВСтруктуре = гкс_ИнтеграцияWarehouse.ВыполнитьЗапросКWarehouse(
		РесурсВебСервиса, ПараметрыЗапроса, ПараметрыПреобразованияJSON);
		
	Ссылка = Справочники.гкс_СтанцииWarehouse.ПустаяСсылка();
	
	// обертка для того чтобы был один алгоритм обработки
	ПолученныеДанные = Новый Массив;
	ПолученныеДанные.Добавить(ДанныеОтветаВСтруктуре);
	гкс_ОбменДаннымиWarehouse.ОбработатьПолученныеДанные(ПолученныеДанные, Ссылка);
			
КонецПроцедуры

Функция СтанцияWarehouseПоИдентификатору(ИдентификаторWarehouse) Экспорт
	
	Результат = ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ИдентификаторWarehouse) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтанцииWarehouse.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.гкс_СтанцииWarehouse КАК СтанцииWarehouse
		|ГДЕ
		|	СтанцииWarehouse.ИдентификаторWarehouse = &ИдентификаторWarehouse";
	
	Запрос.УстановитьПараметр("ИдентификаторWarehouse", ИдентификаторWarehouse);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	    ВыборкаДетальныеЗаписи.Следующий();
		Результат = ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Попытка
			ОбновитьДанныеССервера(ИдентификаторWarehouse);
		Исключение
			ТекстСообщенияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,,,
				ТекстСообщенияОбОшибке);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияОбОшибке);
		
			Возврат Результат;
		КонецПопытки;
		Результат = СтанцияWarehouseПоИдентификатору(ИдентификаторWarehouse);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции	

