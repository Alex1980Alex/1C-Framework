// Устанавливает соотвествие имен реквизитов объекта 1с и полей ответа от Warehouse 
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица описания конвертации реквизитов:
// 		* СвойствоКонфигурации - Строка
// 		* СвойствоИсточника - Строка
// 		* ИспользуетсяАлгоритмКонвертации - Число 
// 		* ПравилоКонвертацииСвойства - Строка
// 		* ЭтоТабличнаяЧасть - Булево
//
Функция ИнициализацияПравилКонвертацийСвойств() Экспорт
	
	ПравилаКонвертации = гкс_ОбменДаннымиWarehouse.ИнициализацияПравилКонвертацийСвойств();

	гкс_ОбменДаннымиWarehouse.ДобавитьПКС(ПравилаКонвертации, ИмяКлючевогоСвойства(), ИмяКлючевогоСвойстваВWarehouse());
	гкс_ОбменДаннымиWarehouse.ДобавитьПКС(ПравилаКонвертации, "Наименование",		"name");
	гкс_ОбменДаннымиWarehouse.ДобавитьПКС(ПравилаКонвертации, "КодЕСР",				"code");
	гкс_ОбменДаннымиWarehouse.ДобавитьПКС(ПравилаКонвертации, "ДатаИзменения",		"updatedOn");
	гкс_ОбменДаннымиWarehouse.ДобавитьПКС(ПравилаКонвертации, "ПометкаУдаления", 	"isDeleted");
	
	Возврат ПравилаКонвертации;
		
КонецФункции

Функция СтанцияКлассификатор(СтанцияWarehouse) Экспорт
	
	Если Не ЗначениеЗаполнено(СтанцияWarehouse) Тогда
		Возврат Справочники.гкс_КлассификаторСтанцийЖД.ПустаяСсылка();
	КонецЕсли;	
	
	Станция = РегистрыСведений.гкс_СоответствиеОбъектовWarehouse.
				СсылкаОбъектаПоСсылкеWarehouse(СтанцияWarehouse);
				
	Если Не ЗначениеЗаполнено(Станция) Тогда
		КодСтанции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтанцияWarehouse, "КодЕСР");
		Если ЗначениеЗаполнено(КодСтанции) Тогда
			Станция = ЖДСтанцияПоКоду(КодСтанции);
			РегистрыСведений.гкс_СоответствиеОбъектовWarehouse.УстановитьСоответствие(СтанцияWarehouse, Станция);
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Станция;	
	
КонецФункции	

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает локализованное имя события журнала регистрации для интеграции.
//
// Параметры:
//   СобытиеВторогоУровня - Строка - имя события, добавляемое через точку к имени события по умолчанию.
//
// Возвращаемое значение:
//   Строка - Интеграция с Warehouse
//        или Интеграция с Warehouse.<ИмяСобытияВторогоУровня>.
//
Функция ИмяСобытияЖурналаРегистрации(СобытиеВторогоУровня = "")
	
	Если СобытиеВторогоУровня = "" Тогда
		Возврат НСтр("ru = 'Интеграция с Warehouse'",
			ОбщегоНазначения.КодОсновногоЯзыка());
	Иначе
		Возврат СтрШаблон("%1.%2",
			НСтр("ru = 'Интеграция с Warehouse'",
				ОбщегоНазначения.КодОсновногоЯзыка()), СобытиеВторогоУровня);
	КонецЕсли;
	
КонецФункции

// Возвращает ЖД станцию по коду ECP станции
//
// Параметры: 
//   КодСтанции - Строка 
//
// Возвращаемое значение:
//  СправочникСсылка.гкс_КлассификаторСтанцийЖД 
//
Функция ЖДСтанцияПоКоду(КодСтанции) Экспорт
	
	СтанцияЖД = Неопределено;
	Если Не ЗначениеЗаполнено(КодСтанции) Тогда 
		Возврат СтанцияЖД;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КлассификаторСтанцийЖД.Ссылка КАК СтанцияЖД
		|ИЗ
		|	Справочник.гкс_КлассификаторСтанцийЖД КАК КлассификаторСтанцийЖД
		|ГДЕ
		|	КлассификаторСтанцийЖД.Наименование = &КодСтанции";
	
	Запрос.УстановитьПараметр("КодСтанции", КодСтанции);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СтанцияЖД;	
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.СтанцияЖД;
	
КонецФункции

#КонецОбласти

