		|ИЗ
		|	ВТ_ТекущаяРегистрацииНаПЛК КАК ТекущаяРегистрацииНаПЛК
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПравилаУсиленногоКонтроляПоРегистрации КАК ПравилаТекущегоТС
		|		ПО ТекущаяРегистрацииНаПЛК.ДокументРегистрации = ПравилаТекущегоТС.ДокументРегистрации
		|		И ТекущаяРегистрацииНаПЛК.Показатель = ПравилаТекущегоТС.Показатель
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛКПервоеТСПоказатель КАК ВТ_РегистрацииНаПЛКПервоеТСПоказатель
		|		ПО ТекущаяРегистрацииНаПЛК.ДокументРегистрации = ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ДокументРегистрации
		|		И ТекущаяРегистрацииНаПЛК.Показатель = ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ПоказательПервоеТС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СоставПредыдущаяГруппа КАК СоставПредыдущаяГруппы
		|		ПО ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ПредыдущаяГруппа = СоставПредыдущаяГруппы.ГруппаТС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛКТекущаяГруппаТС КАК ВТ_РегистрацииНаПЛКТекущаяГруппаТС
		|		ПО ТекущаяРегистрацииНаПЛК.ДокументРегистрации = ВТ_РегистрацииНаПЛКТекущаяГруппаТС.ДокументРегистрации
		|		И ТекущаяРегистрацииНаПЛК.Показатель = ВТ_РегистрацииНаПЛКТекущаяГруппаТС.Показатель
		|ГДЕ
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ТипВходногоКонтроля,
		|		ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ГруппыТС)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ПоказательПервоеТС,
		|		ЗНАЧЕНИЕ(Справочник.гкс_ПоказателиАнализовНоменклатуры.ПустаяСсылка)),
		|	ТекущаяРегистрацииНаПЛК.ДокументРегистрации,
		|	ЕСТЬNULL(ПравилаТекущегоТС.ТипВходногоКонтроля,
		|		ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ПустаяСсылка)),
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ЭтоПервоеТС, ЛОЖЬ),
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ТипВходногоКонтроля,
		|		ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ПустаяСсылка)),
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ДокументРегистрацииПервоеТС,
		|		ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)),
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.СостояниеКачестваПервоеТС,
		|		ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.ПустаяСсылка)),
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ЗначениеПоказателяМин, 0),
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ЗначениеПоказателяМакс, 0),
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.Базис, 0),
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	ВТ_ТекущаяРегистрацииНаПЛК КАК ТекущаяРегистрацииНаПЛК
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПравилаУсиленногоКонтроляПоРегистрации КАК ПравилаТекущегоТС
		|		ПО ТекущаяРегистрацииНаПЛК.ДокументРегистрации = ПравилаТекущегоТС.ДокументРегистрации
		|		И ТекущаяРегистрацииНаПЛК.Показатель = ПравилаТекущегоТС.Показатель
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛКПервоеТСПоказатель КАК ВТ_РегистрацииНаПЛКПервоеТСПоказатель
		|		ПО ТекущаяРегистрацииНаПЛК.ДокументРегистрации = ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ДокументРегистрации
		|ГДЕ
		|	ЕСТЬNULL(ВТ_РегистрацииНаПЛКПервоеТСПоказатель.ТипВходногоКонтроля,
		|		ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ПервоеТС)";
	
КонецФункции

Функция ТекстЗапросаПолучитьДанныеБлокировкиДляРегистраций()
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации КАК ДокументРегистрации
	|ПОМЕСТИТЬ ВТ_РегистрацииНаПЛК
	|ИЗ
	|	РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК ТранспортныеСредстваПоставщика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК
	|			гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля
	|		ПО ТранспортныеСредстваПоставщика.Контрагент = гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.Контрагент
	|		И ТранспортныеСредстваПоставщика.Номенклатура = гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.Номенклатура
	|		И
	|			ТранспортныеСредстваПоставщика.ПроизводственныеСутки = гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ПроизводственныеСутки
	|		И НЕ гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ЭтоПервоеТС
	|ГДЕ
	|	ТранспортныеСредстваПоставщика.ДокументРегистрации В (&МассивРегистраций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставГруппТранспортаПромежуточныйКомпозит.ГруппаТС КАК Группа,
	|	ПоказателиУКПромежуточныйКомпозит.Показатель КАК Показатель
	|ПОМЕСТИТЬ ВТ_ПоказателиГруппа
	|ИЗ
	|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспортаПромежуточныйКомпозит
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК
	|			ПоказателиУКПромежуточныйКомпозит
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛКПромежуточныйКомпозит
	|			ПО ВТ_РегистрацииНаПЛКПромежуточныйКомпозит.ДокументРегистрации = ПоказателиУКПромежуточныйКомпозит.ДокументРегистрации
	|		ПО СоставГруппТранспортаПромежуточныйКомпозит.РегистрацияТранспорта = ПоказателиУКПромежуточныйКомпозит.ДокументРегистрации
	|		И
	|			ПоказателиУКПромежуточныйКомпозит.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
	|		И ПоказателиУКПромежуточныйКомпозит.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Показатели.ДокументРегистрации КАК ДокументРегистрации,
	|	Показатели.Показатель КАК Показатель
	|ПОМЕСТИТЬ ВТ_Показатели
	|ИЗ
	|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК Показатели
	|ГДЕ
	|	Показатели.ДокументРегистрации В (&МассивРегистраций)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Заблокированные.БлокирующаяРегистрация КАК БлокирующаяРегистрация,
	|	Заблокированные.ДокументРегистрации КАК ЗаблокированноеТС
	|ПОМЕСТИТЬ ВТ_Заблокированные
	|ИЗ
	|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК Заблокированные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Показатели КАК Показатели
	|		ПО Заблокированные.БлокирующаяРегистрация = Показатели.ДокументРегистрации
	|		И Заблокированные.Показатель = Показатели.Показатель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Заблокированные.ДокументРегистрации КАК ЗаблокированноеТС,
	|	Заблокированные.БлокирующаяГруппаТС КАК БлокирующаяГруппаТС,
	|	ЕСТЬNULL(ГруппыТСБлокирующая.НомерГруппыПоставщика, 0) КАК НомерГруппыПоставщика
	|ПОМЕСТИТЬ ВТ_ЗаблокированныеГруппаТС
	|ИЗ
	|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК Заблокированные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПоказателиГруппа КАК ПоказателиГруппа
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СоставГруппТранспорта КАК гкс_СоставГруппТранспорта
	|			ПО ПоказателиГруппа.Группа = гкс_СоставГруппТранспорта.ГруппаТС
	|		ПО Заблокированные.БлокирующаяГруппаТС = ПоказателиГруппа.Группа
	|		И Заблокированные.Показатель = ПоказателиГруппа.Показатель
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.гкс_ГруппыТС КАК ГруппыТСБлокирующая
	|		ПО Заблокированные.БлокирующаяГруппаТС = ГруппыТСБлокирующая.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗаблокированныеГруппаТС.ЗаблокированноеТС КАК ЗаблокированноеТС,
	|	ВТ_ЗаблокированныеГруппаТС.БлокирующаяГруппаТС КАК БлокирующаяГруппаТС,
	|	ВТ_ЗаблокированныеГруппаТС.НомерГруппыПоставщика КАК НомерГруппыПоставщика
	|ИЗ
	|	ВТ_ЗаблокированныеГруппаТС КАК ВТ_ЗаблокированныеГруппаТС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Показатели.ДокументРегистрации КАК ДокументРегистрации,
	|	ВТ_Показатели.Показатель КАК Показатель
	|ИЗ
	|	ВТ_Показатели КАК ВТ_Показатели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заблокированные.БлокирующаяРегистрация КАК БлокирующаяРегистрация,
	|	ВТ_Заблокированные.ЗаблокированноеТС КАК ЗаблокированноеТС
	|ИЗ
	|	ВТ_Заблокированные КАК ВТ_Заблокированные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Заблокированные.ЗаблокированноеТС КАК ЗаблокированноеТС
	|ИЗ
	|	ВТ_Заблокированные КАК Заблокированные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ КАК ЛА
	|		ПО ЛА.гкс_ДокументРегистрации = Заблокированные.ЗаблокированноеТС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ.КачественныеПоказатели КАК КП
	|		ПО КП.Ссылка = ЛА.Ссылка
	|ГДЕ
	|	КП.УсиленныйКонтроль = ЛОЖЬ
	|	И КП.ОтклонятьКачество = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаблокированныеГруппа.ЗаблокированноеТС
	|ИЗ
	|	ВТ_ЗаблокированныеГруппаТС КАК ЗаблокированныеГруппа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ КАК ЛАГруппа
	|		ПО ЛАГруппа.гкс_ДокументРегистрации = ЗаблокированныеГруппа.ЗаблокированноеТС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ.КачественныеПоказатели КАК КПГруппа
	|		ПО КПГруппа.Ссылка = ЛАГруппа.Ссылка
	|ГДЕ
	|	КПГруппа.УсиленныйКонтроль = ЛОЖЬ
	|	И КПГруппа.ОтклонятьКачество = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_РегистрацииНаПЛК.ДокументРегистрации КАК ДокументРегистрации,
	|	ПоказателиУК.Показатель КАК Показатель,
	|	ЕСТЬNULL(ГруппыТС.ПредыдущаяГруппа, ЗНАЧЕНИЕ(Справочник.гкс_ГруппыТС.ПустаяСсылка)) КАК БлокирующаяГруппаТС
	|ИЗ
	|	ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУК
	|		ПО ВТ_РегистрацииНаПЛК.ДокументРегистрации = ПоказателиУК.ДокументРегистрации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.гкс_ГруппыТС КАК ГруппыТС
	|			ПО СоставГруппТранспорта.ГруппаТС = ГруппыТС.Ссылка
	|		ПО ВТ_РегистрацииНаПЛК.ДокументРегистрации = СоставГруппТранспорта.РегистрацияТранспорта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеР
	|		ПО ВТ_РегистрацииНаПЛК.ДокументРегистрации = ЗаблокированныеР.ДокументРегистрации
	|		И ПоказателиУК.Показатель = ЗаблокированныеР.Показатель
	|ГДЕ
	|	ЗаблокированныеР.ДокументРегистрации ЕСТЬ NULL";
КонецФункции

#КонецОбласти 

#Область ХранениеЗаблокированныхТС

// При проведении ЛА первого ТС с КачествоНеПринято
// блокирует последующие ТС, которые ещё не заблокированы,
// отменяет композитные пробы и создаёт единичные.
//
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - регистрация первого ТС
//  ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - ЛА первого ТС
//  ТаблицаРегистраций - ТаблицаЗначений - результат основного запроса (все строки)
//  ДанныеБлокировки - Структура - предзагруженные данные блокировки
Процедура ЗаблокироватьПоследующиеТСПриОтказеПервого(ДокументРегистрации, ЛабораторныйАнализ,
		ТаблицаРегистраций, ДанныеБлокировки)
	
	ТочкаМаршрута = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛабораторныйАнализ, "ТочкаМаршрута");

	РезультатСбора = СобратьДанныеПоказателейТС(ТаблицаРегистраций);
	ДанныеПоказателейТС = РезультатСбора.ДанныеПоказателей;
	СостоянияПоПоказателям = РезультатСбора.СостоянияПоПоказателям;
	БлокирующиеДанные = РезультатСбора.БлокирующиеДанные;

	Если ДанныеПоказателейТС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Обрабатываем каждое незаблокированное последующее ТС
	ОбработанныеТС = Новый Соответствие;
	ДанныеДляОбработки = Новый Структура;
	ДанныеДляОбработки.Вставить("ОбработанныеТС", ОбработанныеТС);
	ДанныеДляОбработки.Вставить("ДанныеПоказателейТС", ДанныеПоказателейТС);
	ДанныеДляОбработки.Вставить("СостоянияПоПоказателям", СостоянияПоПоказателям);
	ДанныеДляОбработки.Вставить("БлокирующиеДанные", БлокирующиеДанные);
	ДанныеДляОбработки.Вставить("ДанныеБлокировки", ДанныеБлокировки);
	ДанныеДляОбработки.Вставить("ДокументРегистрации", ДокументРегистрации);
	ДанныеДляОбработки.Вставить("ТочкаМаршрута", ТочкаМаршрута);
	
	Для Каждого ДанныеТС Из ДанныеБлокировки.НезаблокированныеПоследующиеТС Цикл
		ДанныеДляОбработки.Вставить("ДанныеТС", ДанныеТС);
		ОбработатьБлокировкуПоследующегоТС(ДанныеДляОбработки);
	КонецЦикла;

КонецПроцедуры

// Обрабатывает одно последующее ТС: пропускает дубль, фиксирует блокировку,
// при КачествоНеПринято - отменяет композиты и создаёт единичные пробы.
// 
// Параметры: ДанныеТС - Структура - данные одного незаблокированного последующего ТС
// ОбработанныеТС - Соответствие - кэш уже обработанных ключей "ТС|Показатель"
// ДанныеПоказателейТС - Соответствие - данные показателей для регистрации единичных проб
// СостоянияПоПоказателям - Соответствие - состояние качества первого ТС по показателям
// БлокирующиеДанные - Структура - данные блокирующего (первого) ТС
// ДанныеБлокировки - Структура - предзагруженные данные блокировки
// ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - регистрация первого ТС
// ТочкаМаршрута - СправочникСсылка.гкс_ТочкиМаршрута - точка маршрута ЛА первого ТС
//  ДанныеДляОбработки - Структура - Данные для обработки:
// * ОбработанныеТС - Соответствие - 
// * ДанныеПоказателейТС - Соответствие - 
// * СостоянияПоПоказателям - Соответствие - 
// * БлокирующиеДанные - Структура - :
// ** ЭтоПервоеТС 
// ** ТекущаяГруппаТС 
// * ДанныеБлокировки - Структура - :
// ** ПоказателиПоРегистрациям - Соответствие - 
// ** ЗаблокированныеТСПоРегистрациям - Соответствие - 
// ** ГруппыПоРегистрациям - Соответствие - 
// ** ТСНеПрошедшиеВходнойКонтроль - Массив - 
// ** НезаблокированныеПоследующиеТС - Массив - 
// * ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - 
// * ТочкаМаршрута - СправочникСсылка.гкс_ТочкиМаршрута - 
// * ДанныеТС - Произвольный - 
Процедура ОбработатьБлокировкуПоследующегоТС(ДанныеДляОбработки)

	ДанныеТС = ДанныеДляОбработки.ДанныеТС; 
	ОбработанныеТС = ДанныеДляОбработки.ОбработанныеТС; 
	ДанныеПоказателейТС = ДанныеДляОбработки.ДанныеПоказателейТС;
	СостоянияПоПоказателям = ДанныеДляОбработки.СостоянияПоПоказателям; 
	БлокирующиеДанные = ДанныеДляОбработки.БлокирующиеДанные; 
	ДанныеБлокировки = ДанныеДляОбработки.ДанныеБлокировки;
	ДокументРегистрации = ДанныеДляОбработки.ДокументРегистрации; 
	ТочкаМаршрута = ДанныеДляОбработки.ТочкаМаршрута;

	КлючТС = СтрШаблон("%1|%2", ДанныеТС.ДокументРегистрации, ДанныеТС.Показатель);
	Если ОбработанныеТС.Получить(КлючТС) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбработанныеТС.Вставить(КлючТС, Истина);

	// Определяем состояние качества первого ТС по данному показателю
	СостояниеКачестваБлокирующегоТС = СостоянияПоПоказателям.Получить(ДанныеТС.Показатель);
	Если СостояниеКачестваБлокирующегоТС = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяНомерГруппы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		БлокирующиеДанные.ТекущаяГруппаТС, "НомерГруппыПоставщика");
	БлокирующаяНомерГруппы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДанныеТС.БлокирующаяГруппаТС, "НомерГруппыПоставщика");

	ЗаписатьБлокировкуТС(ДанныеТС, ДокументРегистрации, СостояниеКачестваБлокирующегоТС,
		БлокирующиеДанные, ТекущаяНомерГруппы, БлокирующаяНомерГруппы);

	// КачествоНеПринято → полный Сценарий B (отмена композитов + единичные пробы)
	// РезультатыПробПолучены → только блокировка (шаги 2-3 не нужны)
	Если СостояниеКачестваБлокирующегоТС <> Перечисления.гкс_СостоянияКачества.КачествоНеПринято Тогда
		Возврат;
	КонецЕсли;

	Если ТСЗаблокированоПредыдущейГруппой(ДанныеТС, БлокирующиеДанные,
			ТекущаяНомерГруппы, БлокирующаяНомерГруппы) Тогда
		Возврат;
	КонецЕсли;

	ПрименитьСценарийОтказаКачества(ДанныеТС, ДанныеПоказателейТС, ДанныеБлокировки, ТочкаМаршрута);


КонецПроцедуры

// Шаги 2-3 сценария B: помечает показатель как отклоняемый,
// отменяет композитные пробы и (при необходимости) создаёт единичные.
//
// Параметры:
//  ДанныеТС - Структура - данные одного незаблокированного последующего ТС
//  ДанныеПоказателейТС - Соответствие - данные показателей для регистрации единичных проб
//  ДанныеБлокировки - Структура - предзагруженные данные блокировки
//  ТочкаМаршрута - СправочникСсылка.гкс_ТочкиМаршрута - точка маршрута ЛА первого ТС
Процедура ПрименитьСценарийОтказаКачества(ДанныеТС, ДанныеПоказателейТС, ДанныеБлокировки, ТочкаМаршрута)

	ДанныеПоказателейТС[ДанныеТС.Показатель].Вставить("ОтклонятьКачество",
		Перечисления.гкс_СостоянияКачества.КачествоНеПринято);

	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(ДанныеТС.Показатель);

	// 2. Отменить композитные пробы
	РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.УстановитьПробыНеТребуютсяДляКомпозитных(
		ДанныеТС.ДокументРегистрации, МассивПоказателей,
		Перечисления.гкс_ТипыПроб.Композитная,
		Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит);

	// 3. Создать единичные пробы (если ТС прошло входной контроль)
	Если ДанныеБлокировки.ТСНеПрошедшиеВходнойКонтроль.Найти(ДанныеТС.ДокументРегистрации) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ДобавитьПоказателиУКДляЗаблокированногоТС(
		ДанныеТС.ДокументРегистрации, МассивПоказателей, ТочкаМаршрута,
		Перечисления.гкс_ТипыПроб.Единичная,
		Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит,
		ДанныеПоказателейТС);

КонецПроцедуры

// Истина, если последующее ТС уже заблокировано предыдущей (по номеру) группой
// и текущая регистрация не является первой в текущей группе. В этом случае
// сценарий отказа качества (отмена композитов + единичные пробы) не применяется,
// чтобы не перезаписывать решение, принятое в более раннем контексте.
//
// Параметры:
//  ДанныеТС - Структура - данные одного незаблокированного последующего ТС
//  БлокирующиеДанные - Структура - данные блокирующего (первого) ТС
//  ТекущаяНомерГруппы - Число - номер группы первого (блокирующего) ТС
//  БлокирующаяНомерГруппы - Число - номер блокирующей группы последующего ТС
//
// Возвращаемое значение:
//  Булево
Функция ТСЗаблокированоПредыдущейГруппой(ДанныеТС, БлокирующиеДанные,
		ТекущаяНомерГруппы, БлокирующаяНомерГруппы)

	Возврат ЗначениеЗаполнено(ДанныеТС.БлокирующаяГруппаТС)
		И Не БлокирующиеДанные.ЭтоПервоеТС
		И БлокирующаяНомерГруппы < ТекущаяНомерГруппы;

КонецФункции

// Собирает данные показателей первого ТС с КачествоНеПринято или РезультатыПробПолучены.
//
// Параметры:
//  ТаблицаРегистраций - ТаблицаЗначений - результат основного запроса
//
// Возвращаемое значение:
//  Структура - ДанныеПоказателей (Соответствие), СостоянияПоПоказателям (Соответствие)
//
// (включая переименование БлокирующииДанные -> БлокирующиеДанные)
Функция СобратьДанныеПоказателейТС(ТаблицаРегистраций)

	ДанныеПоказателей = Новый Соответствие;
	СостоянияПоПоказателям = Новый Соответствие;
	БлокирующиеДанные = Новый Структура;
	Для Каждого СтрокаРегистрации Из ТаблицаРегистраций Цикл
		Если СтрокаРегистрации.ЭтоПервоеТС
			И (СтрокаРегистрации.СостояниеКачестваПервоеТС =
				Перечисления.гкс_СостоянияКачества.КачествоНеПринято
			Или СтрокаРегистрации.СостояниеКачестваПервоеТС =
				Перечисления.гкс_СостоянияКачества.РезультатыПробПолучены) Тогда
			ДанныеПоказателя = Новый Структура("ЗначениеПоказателяМин, ЗначениеПоказателяМакс, Базис",
				СтрокаРегистрации.ЗначениеПоказателяМин, СтрокаРегистрации.ЗначениеПоказателяМакс,
				СтрокаРегистрации.Базис);
			ДанныеПоказателей.Вставить(СтрокаРегистрации.Показатель, ДанныеПоказателя);
			СостоянияПоПоказателям.Вставить(СтрокаРегистрации.Показатель,
				СтрокаРегистрации.СостояниеКачестваПервоеТС);
			БлокирующиеДанные = Новый Структура("ЭтоПервоеТС, ТекущаяГруппаТС", 
				СтрокаРегистрации.ЭтоПервоеТС, СтрокаРегистрации.ТекущаяГруппаТС); 
	
		ИначеЕсли Не СтрокаРегистрации.ЭтоПервоеТС 
			 И (СтрокаРегистрации.СостояниеКачестваТекущейГруппы = 
			     Перечисления.гкс_СостоянияКачества.КачествоНеПринято
			 Или СтрокаРегистрации.СостояниеКачестваТекущейГруппы =
			     Перечисления.гкс_СостоянияКачества.РезультатыПробПолучены) Тогда 
				 
			ДанныеПоказателя = Новый Структура("ЗначениеПоказателяМин, ЗначениеПоказателяМакс, Базис",
				 СтрокаРегистрации.ЗначениеПоказателяМин, СтрокаРегистрации.ЗначениеПоказателяМакс,
				 СтрокаРегистрации.Базис);
			ДанныеПоказателей.Вставить(СтрокаРегистрации.Показатель, ДанныеПоказателя);
			СостоянияПоПоказателям.Вставить(СтрокаРегистрации.Показатель,
				 СтрокаРегистрации.СостояниеКачестваТекущейГруппы);
            БлокирующиеДанные = Новый Структура("ЭтоПервоеТС, ТекущаяГруппаТС", 
				СтрокаРегистрации.ЭтоПервоеТС, СтрокаРегистрации.ТекущаяГруппаТС); 			
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("ДанныеПоказателей, СостоянияПоПоказателям, БлокирующиеДанные",
		ДанныеПоказателей, СостоянияПоПоказателям, БлокирующиеДанные);

КонецФункции

// Записывает блокировку ТС с учётом источника блокировки.
// БлокирующаяГруппаТС заполнена → блокирует предыдущая группа.
// БлокирующаяГруппаТС пуста → блокирует первая регистрация.
// 
// Параметры:
//  ДанныеТС - Структура - данные блокируемого ТС
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - регистрация первого ТС
//  СостояниеКачестваПервоеТС - ПеречислениеСсылка.гкс_СостоянияКачества - 
//  БлокирующиеДанные - Структура - Блокирующие данные:
// * ЭтоПервоеТС 
// * ТекущаяГруппаТС 
//  ТекущаяНомерГруппы - Произвольный - Текущая номер группы
//  БлокирующаяНомерГруппы - Произвольный - Блокирующая номер группы

Процедура ЗаписатьБлокировкуТС(ДанныеТС, ДокументРегистрации, СостояниеКачестваПервоеТС, 
	БлокирующиеДанные, ТекущаяНомерГруппы, БлокирующаяНомерГруппы)
	
	БлокирующаяГруппаЗаполнена = ЗначениеЗаполнено(ДанныеТС.БлокирующаяГруппаТС);
	РегистрацияНаПЛКПустаяСсылка = Документы.гкс_РегистрацияНаПЛК.ПустаяСсылка();

	Если БлокирующаяГруппаЗаполнена
		И (БлокирующаяНомерГруппы >= ТекущаяНомерГруппы Или БлокирующиеДанные.ЭтоПервоеТС) Тогда

		РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ЗаписатьБлокировкуСОтказомКачества(
			ДанныеТС.ДокументРегистрации, ДанныеТС.Показатель,
			РегистрацияНаПЛКПустаяСсылка, ДанныеТС.БлокирующаяГруппаТС,
			СостояниеКачестваПервоеТС);
		
	ИначеЕсли Не БлокирующаяГруппаЗаполнена И БлокирующиеДанные.ЭтоПервоеТС Тогда 
			
		РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ЗаписатьБлокировкуСОтказомКачества(
			ДанныеТС.ДокументРегистрации, ДанныеТС.Показатель,
			ДокументРегистрации, Справочники.гкс_ГруппыТС.ПустаяСсылка(),
			СостояниеКачестваПервоеТС);
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Определяет, требуется ли блокировка по правилу "Первое ТС".
// Блокировка нужна, если есть первое ТС другой регистрации и качество ещё не принято.
//
// Параметры:
//  ЕстьПервоеТСДругойРегистрации - Булево - признак наличия первого ТС другой регистрации
//  СостояниеКачества - ПеречислениеСсылка.гкс_СостоянияКачества - текущее состояние качества
//
// Возвращаемое значение:
//  Булево - Истина, если блокировка требуется
Функция ТребуетсяБлокировкаПервоеТС(ЕстьПервоеТСДругойРегистрации, СостояниеКачества)

	Возврат ЕстьПервоеТСДругойРегистрации
		И (СостояниеКачества = Перечисления.гкс_СостоянияКачества.ОтборПроб
		Или СостояниеКачества = Перечисления.гкс_СостоянияКачества.ПустаяСсылка());

КонецФункции

// Проверить блокирование транспортного средства для разгрузки.
// 
// Параметры: ТранспортноеСредство Транспортное средство
//  ДокументРегистрации - 
// Документ регистрации
// 
// Возвращаемое значение:
//  Булево - Проверить блокирование транспортного средства для разгрузки
Функция ПроверитьБлокированиеТранспортногоСредстваДляРазгрузки(ДокументРегистрации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаблокированныеТранспортныеСредства.ДокументРегистрации КАК ДокументРегистрации
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеТранспортныеСредства
		|ГДЕ
		|	ЗаблокированныеТранспортныеСредства.ДокументРегистрации = &ДокументРегистрации
		|	И НЕ ЗаблокированныеТранспортныеСредства.Разблокировано";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

// Проверить блокирование транспортного средства по статусу.
// 
// Параметры: ТранспортноеСредство Транспортное средство
//  ДокументРегистрации - 
// Документ регистрации
// 
// Возвращаемое значение:
//  Булево - Проверить блокирование транспортного средства по статусу
Функция ПроверитьБлокированиеТранспортногоСредстваПоСтатусу(ДокументРегистрации) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаблокированныеТранспортныеСредства.ДокументРегистрации КАК ДокументРегистрации
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеТранспортныеСредства
		|ГДЕ
		|	ЗаблокированныеТранспортныеСредства.ДокументРегистрации = &ДокументРегистрации
		|	И НЕ ЗаблокированныеТранспортныеСредства.Разблокировано";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
КонецФункции

// Проверяет статус качества первого ТС для блокировки последующих
// 
// Параметры: ПервоеПоступлениеПоставщика - ДокументСсылка.гкс_РегистрацияНаПЛК - первое ТС поставщика
//  ДокументРегистрации Документ регистрации
//  ПроверятьСтатусКачеств - Булево - Проверять статус качеств
// 
// Возвращаемое значение:
//  Булево - Истина, если требуется блокировка (статус = Пустое ИЛИ ВзятыПробы)
Функция ПроверитьПоказателиУсиленногоКонтроляПоРегистрации(ДокументРегистрации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоказателиУсиленногоКонтроля.СостояниеКачества КАК СостояниеКачества
	|ИЗ
	|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроля
	|ГДЕ
	|	ПоказателиУсиленногоКонтроля.ДокументРегистрации = &ДокументРегистрации";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции


// Проверяет блокировку ТС для создания направления на разгрузку.
// Возвращает детализированную структуру с информацией о типе блокировки.
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - документ регистрации
// 
// Возвращаемое значение:
//  Структура - Проверить блокировку для создания нн Р:
// * ЕстьБлокировка - Булево - есть хотя бы одна неразблокированная запись
// * ЕстьКачествоНеПринято - Булево - есть блокировка со статусом КачествоНеПринято
// * ТекстСообщения - Строка - текст сообщения для пользователя
Функция ПроверитьБлокировкуДляСозданияНнР(ДокументРегистрации) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ЕстьБлокировка", Ложь);
	Результат.Вставить("ЕстьКачествоНеПринято", Ложь);
	Результат.Вставить("ЕстьПредупреждение", Ложь);
	Результат.Вставить("ТекстСообщения", "");

	Если Не ПолучитьФункциональнуюОпцию("гкс_ИспользоватьЗаблокированныеТС") Тогда
		Возврат Результат;
	КонецЕсли;

	// Прямая проверка: КачествоНеПринято + композитный анализ не сделан по показателю.
	// Пакет 1: ВТ с показателями, по которым сделан промежуточный композит ЛА.
	// Пакет 2: Левое Соединение блокирующих записей к ВТ для определения наличия композита.
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПоказателиУК.ДокументРегистрации КАК ДокументРегистрации,
		|	ПоказателиУК.Показатель КАК Показатель
		|ПОМЕСТИТЬ ВТ_КомпозитПоПоказателям
		|ИЗ
		|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУК
		|ГДЕ
		|	ПоказателиУК.ДокументРегистрации = &ДокументРегистрации
		|	И
		|		ПоказателиУК.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|	И ПоказателиУК.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная)
		|	И ПоказателиУК.СостояниеКачества В (&СостояниеКачестваПоказателяУК)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаблокированныеТС.БлокирующееСостояниеКачества КАК БлокирующееСостояниеКачества,
		|	ЗаблокированныеТС.Показатель КАК Показатель,
		|	ВЫБОР
		|		КОГДА ВТ_КомпозитПоПоказателям.ДокументРегистрации ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК КомпозитСделан
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеТС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомпозитПоПоказателям КАК ВТ_КомпозитПоПоказателям
		|		ПО ЗаблокированныеТС.ДокументРегистрации = ВТ_КомпозитПоПоказателям.ДокументРегистрации
		|		И ЗаблокированныеТС.Показатель = ВТ_КомпозитПоПоказателям.Показатель
		|ГДЕ
		|	ЗаблокированныеТС.ДокументРегистрации = &ДокументРегистрации
		|	И НЕ ЗаблокированныеТС.Разблокировано";

	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	СостояниеКачестваПоказателяУК = Новый Массив();
    СостояниеКачестваПоказателяУК.Добавить(Перечисления.гкс_СостоянияКачества.РезультатыПробПолучены);
    СостояниеКачестваПоказателяУК.Добавить(Перечисления.гкс_СостоянияКачества.КачествоНеПринято);
    СостояниеКачестваПоказателяУК.Добавить(Перечисления.гкс_СостоянияКачества.КачествоПринято);
    
    Запрос.УстановитьПараметр("СостояниеКачестваПоказателяУК", СостояниеКачестваПоказателяУК);
    
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	РезультатЗапроса = РезультатыЗапроса[РезультатыЗапроса.ВГраница()];

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;

	// ЕстьБлокировка = Истина ТОЛЬКО при КачествоНеПринято без композита.
	// РезультатыПробПолучены или КачествоНеПринято 
	// + композит - предупреждение (ЕстьПредупреждение), не блокировка.
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.БлокирующееСостояниеКачества = Перечисления.гкс_СостоянияКачества.КачествоНеПринято
			И Не Выборка.КомпозитСделан Тогда

			Результат.ЕстьБлокировка = Истина;
			Результат.ЕстьКачествоНеПринято = Истина;
			
			Результат.ТекстСообщения = НСтр(
			"ru = 'Транспортное средство заблокировано по усиленному контролю. Качество не принято. Создание 
			|направления на разгрузку запрещено.'");
			
			Прервать;

		ИначеЕсли Выборка.КомпозитСделан 
			И (Выборка.БлокирующееСостояниеКачества = Перечисления.гкс_СостоянияКачества.КачествоНеПринято
			Или Выборка.БлокирующееСостояниеКачества = Перечисления.гкс_СостоянияКачества.РезультатыПробПолучены) Тогда
            
            // РезультатыПробПолучены - предупреждение 
			Результат.ЕстьПредупреждение = Истина;	

			Результат.ТекстСообщения = НСтр(
			"ru = 'Транспортное средство заблокировано по усиленному контролю. Продолжить создание 
			|направления на разгрузку?'");
			
			Прервать;
		КонецЕсли;
	КонецЦикла;


	Возврат Результат;

КонецФункции

// Разблокирует транспортные средства при принятии качества.
// Устанавливает Разблокировано = Истина для всех записей по регистрации.
//
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - документ регистрации
//
Процедура РазблокироватьТСПриПринятииКачества(ДокументРегистрации) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("гкс_ИспользоватьЗаблокированныеТС") Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаблокированныеТС.ДокументРегистрации КАК ДокументРегистрации,
		|	ЗаблокированныеТС.Показатель КАК Показатель,
		|	ЗаблокированныеТС.БлокирующаяРегистрация КАК БлокирующаяРегистрация,
		|	ЗаблокированныеТС.БлокирующаяГруппаТС КАК БлокирующаяГруппаТС
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеТС
		|ГДЕ
		|	ЗаблокированныеТС.ДокументРегистрации = &ДокументРегистрации
		|	И НЕ ЗаблокированныеТС.Разблокировано";

	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		НаборЗаписей = РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументРегистрации.Установить(Выборка.ДокументРегистрации);
		НаборЗаписей.Отбор.Показатель.Установить(Выборка.Показатель);
		НаборЗаписей.Отбор.БлокирующаяРегистрация.Установить(Выборка.БлокирующаяРегистрация);
		НаборЗаписей.Отбор.БлокирующаяГруппаТС.Установить(Выборка.БлокирующаяГруппаТС);
		НаборЗаписей.Прочитать();

		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.Разблокировано = Истина;
		КонецЦикла;

		НаборЗаписей.Записать();

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПоказателиУсиленногоКонтроляПоРегистрации(ДокументРегистрации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоказателиУсиленногоКонтроля.Показатель КАК Показатель
	|ИЗ
	|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроля
	|ГДЕ
	|	ПоказателиУсиленногоКонтроля.ДокументРегистрации = &ДокументРегистрации";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("Показатель");
	
КонецФункции

Функция ЭтоБлокирующиеТранспортноеСредство(ПервоеПоступлениеПоставщика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ПоказателиУсиленногоКонтроля.СостояниеКачества КАК СостояниеКачества 
		|ИЗ
		|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроля
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПравилаУсиленногоКонтроляПоРегистрации КАК Правила
		|		ПО ПоказателиУсиленногоКонтроля.ДокументРегистрации = Правила.ДокументРегистрации
		|			И ПоказателиУсиленногоКонтроля.Показатель = Правила.Показатель
		|ГДЕ
		|	ПоказателиУсиленногоКонтроля.ДокументРегистрации = &ДокументРегистрации
		|	И Правила.ТипВходногоКонтроля = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ПервоеТС)";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ПервоеПоступлениеПоставщика);
	
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

Функция ПолучитьСписокЗаблокированныеТранспортныеСредства(ДокументРегистрации, Показатели) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументРегистрации) Или Показатели.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаблокированныеТранспортныеСредства.ДокументРегистрации КАК ДокументРегистрации
	|ИЗ
	|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК
	|		ЗаблокированныеТранспортныеСредства
	|ГДЕ
	|	ЗаблокированныеТранспортныеСредства.БлокирующаяРегистрация = &ДокументРегистрации
	|	И ЗаблокированныеТранспортныеСредства.Показатель В (&Показатели)";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.УстановитьПараметр("Показатели", Показатели);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("ДокументРегистрации");
	
КонецФункции

// Получает список заблокированных групп ТС по регистрации и показателям.
//
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - заблокированная регистрация
//  Показатели - Массив из СправочникСсылка.гкс_ПоказателиАнализовНоменклатуры - показатели контроля
//
// Возвращаемое значение:
//  Массив из Соответствие - элементы с ключами "БлокирующаяГруппаТС", "ЗаблокированноеТС"
Функция ПолучитьСписокЗаблокированныхГруппТС(ДокументРегистрации, Показатели)

	Если НЕ ЗначениеЗаполнено(ДокументРегистрации) Или Показатели.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Заблокированные.БлокирующаяГруппаТС КАК БлокирующаяГруппаТС,
	|	Заблокированные.ДокументРегистрации КАК ЗаблокированноеТС
	|ИЗ
	|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК Заблокированные
	|ГДЕ
	|	Заблокированные.ДокументРегистрации = &ДокументРегистрации
	|	И Заблокированные.Показатель В(&Показатели)
	|	И Заблокированные.БлокирующаяГруппаТС <> ЗНАЧЕНИЕ(Справочник.гкс_ГруппыТС.ПустаяСсылка)";

	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.УстановитьПараметр("Показатели", Показатели);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(ЗаполнитьЗаблокированное(Выборка.БлокирующаяГруппаТС, Выборка.ЗаблокированноеТС));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выполняет проеврку на наличия правила "по группам ТС" и формирует группу по необходимости
// 
// Параметры:
//  ТаблицаПравил - ТаблицаЗначений - Таблица правил
//
Процедура ИнициализироватьГруппуТС(Знач ТаблицаПравил)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПравил", ТаблицаПравил);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаПравил.ДокументРегистрации КАК ДокументРегистрации,
		|	ТаблицаПравил.ИдентификаторПравила КАК ИдентификаторПравила,
		|	ТаблицаПравил.Показатель КАК Показатель,
		|	ТаблицаПравил.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ТаблицаПравил.ТипВходногоКонтроля КАК ТипВходногоКонтроля,
		|	ТаблицаПравил.МестнаяДата КАК МестнаяДата,
		|	ТаблицаПравил.ПроизводственныеСутки КАК ПроизводственныеСутки,
		|	ТаблицаПравил.КоличествоТС КАК КоличествоТС
		|ПОМЕСТИТЬ ВТ_ТаблицаПравил
		|ИЗ
		|	&ТаблицаПравил КАК ТаблицаПравил
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаПравил.ДокументРегистрации КАК ДокументРегистрации,
		|	МАКСИМУМ(ВТ_ТаблицаПравил.ПроизводственныеСутки) КАК ПроизводственныеСутки,
		|	МИНИМУМ(ВТ_ТаблицаПравил.КоличествоТС) КАК КоличествоТС
		|ИЗ
		|	ВТ_ТаблицаПравил КАК ВТ_ТаблицаПравил
		|ГДЕ
		|	ВТ_ТаблицаПравил.ТипВходногоКонтроля = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыУсиленногоКонтроляКачества.ГруппыТС)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТаблицаПравил.ДокументРегистрации";
	
	РезультатЗапроса = Запрос.Выполнить();
	
