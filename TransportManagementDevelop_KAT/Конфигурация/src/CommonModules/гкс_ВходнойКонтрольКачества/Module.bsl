#Область ПрограммныйИнтерфейс
 
// Регистрирует данные для усиленного входного контроля
//
// Параметры:
// 		ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
//
Процедура ЗарегистрироватьТранспортноеСредствоДляУсиленногоКонтроля(ДокументРегистрации, МестнаяДата) Экспорт
	
	// регистрация проходит только единожды
	Если ТранспортноеСредствоЗарегистрировано(ДокументРегистрации) Тогда
		Возврат;	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
		
	РеквизитыРегистрации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументРегистрации, "Контрагент, Номенклатура");
			
	ДокументРегистрацииПервогоТС = ПерваяРегистрацияТСПоставщика(РеквизитыРегистрации.Контрагент,
		РеквизитыРегистрации.Номенклатура, МестнаяДата);
		
	ЭтоПервоеТС = ЭтоПервоеТСПоставщикаЗаСутки(ДокументРегистрации, ДокументРегистрацииПервогоТС);	
			
	ДанныеПоказателей = РегистрыСведений.гкс_НастройкиУсиленногоКонтроляКачества.
		НайтиПоказателиКачестваДляУсиленногоВходногоКонтроля(ДокументРегистрации, МестнаяДата);
			
	НачатьТранзакцию();
		
	Попытка	
		Если ЗначениеЗаполнено(ДанныеПоказателей.ПоказателиКонтроля) Тогда
			
			ЗаписатьДанныеПоУсиленномуКонтролюДляРегистрации(ДокументРегистрации, ДанныеПоказателей.ПоказателиКонтроля);	
			ЗаписатьПравилаПоУсиленномуКонтролюДляРегистрации(ДокументРегистрации, ДанныеПоказателей.ПравилаКонтроля);
			
			Для Каждого ПравилоКонтроляТС Из ДанныеПоказателей.ПравилаКонтроляТС Цикл	
				РегистрыСведений.гкс_НастройкиУсиленногоКонтроляКачества.
					УстановитьАктивность(ПравилоКонтроляТС.ИдентификаторПравила, Ложь);	
			КонецЦикла;		
			
			Если Не ЭтоПервоеТС Тогда	
				ИнициализироватьГруппуТС(ДанныеПоказателей.ПравилаКонтроля);			
			КонецЕсли;		
		КонецЕсли;
		
		ЗаписатьДанныеПоМашинеПоставщика(ДокументРегистрации, МестнаяДата, ЭтоПервоеТС);
		ЗафиксироватьТранзакцию();
				
	Исключение
		
		ОтменитьТранзакцию();
		
		ШаблонОписания = НСтр("ru = 'Ошибка регистрации по усиленному контролю.'");
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Комментарий = СтрШаблон("%1%2%3", ШаблонОписания, Символы.ПС, ПодробноеПредставлениеОшибки);
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Усиленный контроль'"), 
			УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			
		ВызватьИсключение ШаблонОписания;
		
	КонецПопытки;
			                  	
КонецПроцедуры 

// Процедура заполняет лаб. анализ и статус прохождения анализа
// Параметры:
// 		ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ 
// 		ДокументРегистрации - ДокументССылка.гкс_РегистрацияНаПЛК
//		НазначениеИспользования - ПеречислениеСсылка.гкс_НазначенияИспользованияКачества
//
Процедура ЗаполнитьРегистрПоказателейУсиленногоКонтроляЛабАнализом(ЛабораторныйАнализ, 
															ДокументРегистрации, НазначениеИспользования) Экспорт
		
	УстановитьПривилегированныйРежим(Истина);
	
	// построчные результаты УК лаб анализа
	РезультатУсиленногоКонтроля = РезультатУсиленногоКонтроляЛабораторногоАнализаПострочно(ЛабораторныйАнализ);
	Если РезультатУсиленногоКонтроля.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;	
				
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ ВТ_РегистрацииНаПЛК
		|ИЗ
		|	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
		|ГДЕ
		|	ФормированиеНомераПробыСписокРегистраций.Ссылка = &ДокументРегистрации
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РегистрацияНаПЛК.Ссылка
		|ИЗ
		|	Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		|ГДЕ
		|	РегистрацияНаПЛК.Ссылка = &ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РегистрацииНаПЛК.ДокументРегистрации КАК ДокументРегистрации,
		|	ПоказателиУсиленногоКонтроляПоРегистрации.Показатель КАК Показатель,
		|	ПоказателиУсиленногоКонтроляПоРегистрации.ЛабораторныйАнализ КАК ЛабораторныйАнализ,
		|	ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования КАК НазначениеИспользования,
		|	ПоказателиУсиленногоКонтроляПоРегистрации.СостояниеКачества КАК СостояниеКачества,
		|	&ТипПробы КАК ТипПробы,
		|	ВЫБОР
		|		КОГДА ПоказателиУсиленногоКонтроляПоРегистрации.ЛабораторныйАнализ = &ЛабораторныйАнализ
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьЗаписиПоЛабАнализу
		|ИЗ
		|	ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроляПоРегистрации
		|		ПО (ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации = ВТ_РегистрацииНаПЛК.ДокументРегистрации)
		|			И (ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы = &ТипПробы)
		|			И (ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования = &НазначениеИспользования)";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.УстановитьПараметр("ЛабораторныйАнализ", ЛабораторныйАнализ);
	Запрос.УстановитьПараметр("НазначениеИспользования", НазначениеИспользования);
	Запрос.УстановитьПараметр("ТипПробы", ТипПробыПоДокументуРегистрации(ДокументРегистрации));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеДляОтбора = РезультатЗапроса.Выбрать();
	
	Пока ДанныеДляОтбора.Следующий() Цикл
		
		ДанныеПоказателя = РезультатУсиленногоКонтроля.Найти(ДанныеДляОтбора.Показатель, "Показатель");
		Если Не ЗначениеЗаполнено(ДанныеПоказателя) Тогда
			Продолжить;	
		КонецЕсли;
					
		НаборЗаписей = РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.СоздатьНаборЗаписей();	
		НаборЗаписей.Отбор.ДокументРегистрации.Установить(ДанныеДляОтбора.ДокументРегистрации);
		НаборЗаписей.Отбор.Показатель.Установить(ДанныеДляОтбора.Показатель);
		НаборЗаписей.Отбор.НазначениеИспользования.Установить(ДанныеДляОтбора.НазначениеИспользования);
		НаборЗаписей.Отбор.ТипПробы.Установить(ДанныеДляОтбора.ТипПробы);
		
		Если ДанныеДляОтбора.ЕстьЗаписиПоЛабАнализу Тогда                
			НаборЗаписей.Отбор.ЛабораторныйАнализ.Установить(ЛабораторныйАнализ);
		КонецЕсли;
		
		НаборЗаписей.Прочитать();
				
		Для Каждого Запись Из НаборЗаписей Цикл 
				
			Если Не ЗначениеЗаполнено(Запись.ЛабораторныйАнализ) Тогда
				Запись.ЛабораторныйАнализ = ЛабораторныйАнализ;      
			КонецЕсли;
			
			Если Запись.СостояниеКачества <> ДанныеПоказателя.СтатусКачества Тогда
				Запись.СостояниеКачества = ДанныеПоказателя.СтатусКачества; 
			КонецЕсли;	
										
		КонецЦикла;
	
		Если НаборЗаписей.Модифицированность() Тогда
			НаборЗаписей.Записать();
		КонецЕсли; 
			
	КонецЦикла;
	
	ОбработкаОтклоненияПоКачествуУсиленногоКонтроля(ЛабораторныйАнализ);	
		
КонецПроцедуры

// Заполнить регистр показателей усиленного контроля состоянием качества.
// 
// Параметры:
// 		ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ 
// 		ДокументРегистрации - ДокументССылка.гкс_РегистрацияНаПЛК
Процедура ЗаполнитьРегистрПоказателейУсиленногоКонтроляСостояниемКачества(ЛабораторныйАнализ, 
		ДокументРегистрации) Экспорт

    УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЛАСоответствуетНормативу();

	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.УстановитьПараметр("ЛабораторныйАнализ", ЛабораторныйАнализ);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ЛАКачествоПринято = Ложь;
	ЛАКачествоНеПринято = Ложь;

	Показатели = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЛАКачествоПринято = ВыборкаДетальныеЗаписи.ЛАКачествоПринято;
		ЛАКачествоНеПринято = ВыборкаДетальныеЗаписи.ЛАКачествоНеПринято;
		Показатели.Добавить(ВыборкаДетальныеЗаписи.Показатель);
	КонецЦикла;

	Если Показатели.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЛАКачествоНеПринято Тогда
		РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.УстановитьПробыНеТребуютсяДляКомпозитных(
			ДокументРегистрации, Показатели, Перечисления.гкс_ТипыПроб.Композитная,
			Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит);
	ИначеЕсли ЛАКачествоПринято Тогда 
		РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ОчиститьСостояниеКачестваДляКомпозитных(
			ДокументРегистрации, Показатели, Перечисления.гкс_ТипыПроб.Композитная,
			Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит);
	КонецЕсли;
        
КонецПроцедуры

// Процедура заполняет лаб. анализ и статус прохождения анализа
// 
// Параметры:
//  ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - 
//  ДокументРегистрации - ДокументСcылка.гкс_РегистрацияНаПЛК - 
//  НазначениеИспользования - ПеречислениеСсылка.гкс_НазначенияИспользованияКачества - 
Процедура ЗаполнитьЗаблокированныеРегистрацииУсиленныйКонтроль(ЛабораторныйАнализ, 
															ДокументРегистрации, НазначениеИспользования) Экспорт
																	
	УстановитьПривилегированныйРежим(Истина);
			
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЗаблокированныхРегистрацийУК();
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.УстановитьПараметр("ЛабораторныйАнализ", ЛабораторныйАнализ);

	ТаблицаРегистраций = Запрос.Выполнить().Выгрузить();
	
    // Пакетная предзагрузка данных блокировки для оптимизации
	ДанныеБлокировки = 
		ПолучитьДанныеБлокировкиДляРегистраций(ТаблицаРегистраций.ВыгрузитьКолонку("ДокументРегистрации"));
	
	// Набор уже обработанных регистраций для однократного вызова обновления блокировки
	ОбработанныеРегистрации = Новый Соответствие;
	
	Для каждого ДанныеДляОтбора из ТаблицаРегистраций цикл
		
		Если ДанныеДляОтбора.БлокирующийТипВходногоКонтроля	= Перечисления.гкс_ТипыУсиленногоКонтроляКачества.КаждоеТС 
			Или ДанныеДляОтбора.ТипВходногоКонтроляТекущегоТС = 
				Перечисления.гкс_ТипыУсиленногоКонтроляКачества.КаждоеТС Тогда
			Продолжить;
		КонецЕсли;
		
		// Блокировка и обновление заблокированных ТС 
		ЕстьПервоеТСДругойРегистрации = (ЗначениеЗаполнено(ДанныеДляОтбора.ДокументРегистрацииПервоеТС)
		    Или ЗначениеЗаполнено(ДанныеДляОтбора.ПредыдущаяГруппа))
			И Не ДанныеДляОтбора.ЭтоПервоеТС;

		Если Не ДанныеДляОтбора.БлокирующийТипВходногоКонтроля 
			= Перечисления.гкс_ТипыУсиленногоКонтроляКачества.ГруппыТС Тогда
				

			// Запись блокировки по правилу "Первое ТС"
			// Блокируем только если ЛА текущего (последующего) ТС выполнен
			Если ТребуетсяБлокировкаПервоеТС(ЕстьПервоеТСДругойРегистрации, 
				ДанныеДляОтбора.СостояниеКачестваПервоеТС) Тогда
				
				РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ЗаписатьБлокировкуТС(
					ДанныеДляОтбора.ДокументРегистрации, ДанныеДляОтбора.ДокументРегистрацииПервоеТС,
					ДанныеДляОтбора.Показатель);
			КонецЕсли;

		Иначе 
 			
 			// Блокируем только если ЛА текущего (последующего) ТС выполнен и есть первое ТС другой регистрации
			Если ЕстьПервоеТСДругойРегистрации Тогда						
				// Запись блокировки по правилу "Группа ТС"			
				РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ЗаписатьБлокировкуГруппыТС(				
					ДанныеДляОтбора.ДокументРегистрации, 				
					ДанныеДляОтбора.ДокументРегистрацииПервоеТС,				
					ДанныеДляОтбора.СостояниеКачестваПервоеТС,				
					ДанныеДляОтбора.ПредыдущаяГруппа,				
					ДанныеДляОтбора.АнализПредыдущейГруппаЗавершен,				
					ДанныеДляОтбора.СостояниеКачестваПредыдущейГруппы,				
					ДанныеДляОтбора.Показатель);			
			КонецЕсли;
		КонецЕсли;	
		
		// Обновление заблокированных ТС - один раз на каждую уникальную регистрацию
		ДокументРегистрацииСтроки = ДанныеДляОтбора.ДокументРегистрации;
		Если ОбработанныеРегистрации.Получить(ДокументРегистрацииСтроки) = Неопределено Тогда
			ОбработанныеРегистрации.Вставить(ДокументРегистрацииСтроки, Истина);
			
			СтрокиРегистрации = ТаблицаРегистраций.НайтиСтроки(
				Новый Структура("ДокументРегистрации", ДокументРегистрацииСтроки));
			
			ОбновитьЗаблокированныеТСПриЗавершенииЛА(
				ДокументРегистрацииСтроки, ЛабораторныйАнализ, СтрокиРегистрации, ДанныеБлокировки);
		КонецЕсли;
		
	КонецЦикла;
	
	// При проведении ЛА первого ТС с КачествоНеПринято / РезультатыПробПолучены
	// заблокировать последующие ТС, которые ещё не заблокированы
	Если ДанныеБлокировки.НезаблокированныеПоследующиеТС.Количество() > 0 Тогда
		ЗаблокироватьПоследующиеТСПриОтказеПервого(
			ДокументРегистрации, ЛабораторныйАнализ, ТаблицаРегистраций, ДанныеБлокировки);
	КонецЕсли;
	
		
КонецПроцедуры

// Процедура заполняет лаб. анализ и статус прохождения анализа
// Параметры:
// 		ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ 
//
Процедура ОбработкаОтклоненияПоКачествуУсиленногоКонтроля(ЛабораторныйАнализ) Экспорт
	
	СтатусКачестваУсиленногоКонтроляЛабАнализа = СтатусКачестваЛабораторногоАнализа(ЛабораторныйАнализ, 
		Перечисления.гкс_ТипыКонтроляКачества.УсиленныйКонтроль);

	Если СтатусКачестваУсиленногоКонтроляЛабАнализа <> Перечисления.гкс_СостоянияКачества.КачествоНеПринято Тогда
		Возврат;
	КонецЕсли;
		
	ОтклонятьКачествоУсиленногоКонтроля = 
					РезультатУсиленногоКонтроляЛабораторногоАнализаПострочно(ЛабораторныйАнализ, Истина);					
	ПоказателиКачествоНеПринято = ОтклонятьКачествоУсиленногоКонтроля.ВыгрузитьКолонку("Показатель");
	
	ДокументыРегистрацииНаПЛК = ДокументыРегистрацииЛабАнализа(ЛабораторныйАнализ);
	
	// для первого ТС
	ИдентификаторыПравилКонтроля = НастройкиУсиленногоКонтроляПоТипуКонтроля(
									Перечисления.гкс_ТипыУсиленногоКонтроляКачества.ПервоеТС, 
									ДокументыРегистрацииНаПЛК, ПоказателиКачествоНеПринято); 																	
	// для групп
	РегистрацииГруппы = Новый Массив;
	Для Каждого РегистрацияНаПЛК Из ДокументыРегистрацииНаПЛК Цикл
		
		СоставГруппы = Справочники.гкс_ГруппыТС.СоставГруппыПоРегистрации(РегистрацияНаПЛК);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РегистрацииГруппы, СоставГруппы);
		
		// для первой регистрации группы также надо менять правило
		Если ЭтоПерваяРегистрацияТСПоставщика(РегистрацияНаПЛК) Тогда
			РегистрацииГруппы.Добавить(РегистрацияНаПЛК);
		КонецЕсли;	
		
	КонецЦикла;	
		
	ИдентификаторыПравилГруппыТС = НастройкиУсиленногоКонтроляПоТипуКонтроля(
									Перечисления.гкс_ТипыУсиленногоКонтроляКачества.ГруппыТС, 
									РегистрацииГруппы, ПоказателиКачествоНеПринято);
									
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
								ИдентификаторыПравилКонтроля, ИдентификаторыПравилГруппыТС, Истина); 								
								
	УстановитьТипВНастройкахУсиленногоКонтроля(ИдентификаторыПравилКонтроля, 
											Перечисления.гкс_ТипыУсиленногоКонтроляКачества.КаждоеТС);				
																						
КонецПроцедуры	

// Первая регистрация ТСПоставщика.
// 
// Параметры:
//  Поставщик - СправочникСсылка.Контрагенты - Поставщик
//  Номенклатура - СправочникСсылка.Номенклатура - Номенклатура
//  МестнаяДата - Дата - Местная дата формирования проб
// 
// Возвращаемое значение:
//  ДокументСсылка.гкс_РегистрацияНаПЛК - ссылка на первая регистрацию поставщика в производственных сутках по номенклатуре
//
Функция ПерваяРегистрацияТСПоставщика(Поставщик, Номенклатура, МестнаяДата) Экспорт

	ПроизводственныеСутки = гкс_ПриемкаТранспорта.ПроизводственныеСуткиПоДата(МестнаяДата);
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Контрагент", Поставщик);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ПроизводственныеСутки", ПроизводственныеСутки);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации КАК ДокументРегистрации
	               |ИЗ
	               |	РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК ТранспортныеСредстваПоставщикаУсиленногоКонтроля
	               |ГДЕ
	               |	ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ПроизводственныеСутки = &ПроизводственныеСутки
	               |	И ТранспортныеСредстваПоставщикаУсиленногоКонтроля.Контрагент = &Контрагент
	               |	И ТранспортныеСредстваПоставщикаУсиленногоКонтроля.Номенклатура = &Номенклатура
	               |	И ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ЭтоПервоеТС";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.ДокументРегистрации;
	Иначе
		Результат = Документы.гкс_РегистрацияНаПЛК.ПустаяСсылка();	
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

// Определяет, что Лаб. анализ относится к усиленному контролю
// 
// Параметры: 
// 		ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ
// 		
// Возвращаемое значение:
// 		Булево - Истина, если относится к усиленному контролю
//
Функция ЛабораторныйАнализУсиленногоКонтроля(ЛабораторныйАнализ) Экспорт
	НазначениеИспользования = 
		гкс_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛабораторныйАнализ, "гкс_НазначениеИспользованияКачества");
	
	Возврат
		НазначениеИспользования = Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит;	
	
КонецФункции	

// Регистрации без промежуточного композита за производственные сутки.
// 
// Параметры:
//  ПроизводственныеСутки - Дата - Производственные сутки
// 
// Возвращаемое значение:
//  Неопределено, Массив - Регистрации без промежуточного композита за дату
//
Функция РегистрацииБезПромежуточногоКомпозитаЗаДату(ПроизводственныеСутки) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СоставГруппТранспорта.РегистрацияТранспорта КАК РегистрацияНаПЛК
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.гкс_ГруппыТС КАК ГруппыТС
		|		ПО СоставГруппТранспорта.ГруппаТС = ГруппыТС.Ссылка
		|			И (ГруппыТС.ПроизводственныеСутки = &ПроизводственныеСутки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ КАК ЛабораторныйАнализ
		|			ПО ФормированиеНомераПробыСписокРегистраций.Ссылка = ЛабораторныйАнализ.гкс_ДокументРегистрации
		|				И (ЛабораторныйАнализ.гкс_НазначениеИспользованияКачества = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит))
		|		ПО СоставГруппТранспорта.РегистрацияТранспорта = ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации
		|ГДЕ
		|	ЛабораторныйАнализ.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ПроизводственныеСутки", ПроизводственныеСутки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ДанныеЗапроса = РезультатЗапроса.Выгрузить();
		Результат = ДанныеЗапроса.ВыгрузитьКолонку("РегистрацияНаПЛК");
	Иначе
		Результат = Неопределено;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификаторы правил усиленного контроля для документов группы
// 
// Параметры:
// 		ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - Ссылка на документ регистрации на ПЛК
// 
// Возвращаемое значение:
// 		Массив из УникальныйИдентификатор - идентификаторы правил
//
Функция НастройкиУсиленногоКонтроляГруппы(ДокументРегистрации) Экспорт
	
	СоставГруппы = Справочники.гкс_ГруппыТС.СоставГруппыПоРегистрации(ДокументРегистрации);
		
	Возврат НастройкиУсиленногоКонтроляПоТипуКонтроля(
		Перечисления.гкс_ТипыУсиленногоКонтроляКачества.ГруппыТС, СоставГруппы);
	
КонецФункции

// Возвращает статус лабораторного анализа
// 
// Параметры:
// 		ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - Ссылка на документ
//		ТипКонтроляКачества - ПеречислениеСсылка.гкс_ТипыКонтроляКачества - тип контроля
// 
// Возвращаемое значение:
// 		ПеречислениеСсылка.гкс_СостоянияКачества - состояние качества лаб. анализа
//
Функция СтатусКачестваЛабораторногоАнализа(ЛабораторныйАнализ, ТипКонтроляКачества = Неопределено) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(ЛабораторныйАнализКачественныеПоказатели.СоответствуетНормативу) КАК СоответствуетНормативу,
		|	МАКСИМУМ(ЛабораторныйАнализКачественныеПоказатели.ОтклонятьКачество) КАК ОтклонятьКачество,
		|	ЛабораторныйАнализКачественныеПоказатели.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ДанныеАнализа
		|ИЗ
		|	Документ.гкс_ЛабораторныйАнализ.КачественныеПоказатели КАК ЛабораторныйАнализКачественныеПоказатели
		|ГДЕ
		|	ЛабораторныйАнализКачественныеПоказатели.Ссылка = &Ссылка
		|	И &УсловиеТипКонтроляКачества
		|
		|СГРУППИРОВАТЬ ПО
		|	ЛабораторныйАнализКачественныеПоказатели.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВТ_ДанныеАнализа.ОтклонятьКачество
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоНеПринято)
		|		КОГДА НЕ ВТ_ДанныеАнализа.СоответствуетНормативу
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.РезультатыПробПолучены)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоПринято)
		|	КОНЕЦ КАК СтатусКачества
		|ИЗ
		|	ВТ_ДанныеАнализа КАК ВТ_ДанныеАнализа";
	
	Запрос.УстановитьПараметр("Ссылка", ЛабораторныйАнализ);
	
	Если ЗначениеЗаполнено(ТипКонтроляКачества) Тогда
		
		Если ТипКонтроляКачества = Перечисления.гкс_ТипыКонтроляКачества.УсиленныйКонтроль Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТипКонтроляКачества", 
				"ЛабораторныйАнализКачественныеПоказатели.УсиленныйКонтроль");  
		Иначе	
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТипКонтроляКачества", 
				"НЕ ЛабораторныйАнализКачественныеПоказатели.УсиленныйКонтроль");
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр("УсловиеТипКонтроляКачества", Истина);
	КонецЕсли;
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Перечисления.гкс_СостоянияКачества.ПустаяСсылка();
	Иначе	
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Результат = ВыборкаДетальныеЗаписи.СтатусКачества;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

// Возвращает таблицу показателей усиленного контроля лабанализа с результатами
// 
// Параметры:
// 		ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - Ссылка на документ
//		ТолькоОтклонятьКачество - Булево - если Истина, то получать строки где установлен 
//											признак "отклонять качество"
// 
// Возвращаемое значение:
// 		ТаблицаЗначений - состояние качества лаб. анализа
//			- Показатель
//			- СоответствуетНормативу
//			- ОтклонятьКачество
//			- СтатусКачества
//
Функция РезультатУсиленногоКонтроляЛабораторногоАнализаПострочно(ЛабораторныйАнализ, 
																ТолькоОтклонятьКачество = Ложь) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛабораторныйАнализКачественныеПоказатели.Показатель КАК Показатель,
		|	ЛабораторныйАнализКачественныеПоказатели.СоответствуетНормативу КАК СоответствуетНормативу,
		|	ЛабораторныйАнализКачественныеПоказатели.ОтклонятьКачество КАК ОтклонятьКачество,
		|	ВЫБОР
		|		КОГДА ЛабораторныйАнализКачественныеПоказатели.ОтклонятьКачество
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоНеПринято)
		|		КОГДА НЕ ЛабораторныйАнализКачественныеПоказатели.СоответствуетНормативу
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.РезультатыПробПолучены)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоПринято)
		|	КОНЕЦ КАК СтатусКачества
		|ИЗ
		|	Документ.гкс_ЛабораторныйАнализ.КачественныеПоказатели КАК ЛабораторныйАнализКачественныеПоказатели
		|ГДЕ
		|	ЛабораторныйАнализКачественныеПоказатели.Ссылка = &Ссылка
		|	И ЛабораторныйАнализКачественныеПоказатели.УсиленныйКонтроль
		|	И &УсловиеОтклонятьКачество";
	
	Запрос.УстановитьПараметр("Ссылка", ЛабораторныйАнализ);
	
	Если ТолькоОтклонятьКачество Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтклонятьКачество", 
			"ЛабораторныйАнализКачественныеПоказатели.ОтклонятьКачество");
	Иначе
		Запрос.УстановитьПараметр("УсловиеОтклонятьКачество", Истина);
	КонецЕсли;
		
	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить();
		
КонецФункции

// Документы регистрации на ПЛК.
// 
// Параметры:
//  ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - ссылка на лаб анализ
// 
// Возвращаемое значение:
//  Массив из ДокументСсылка.гкс_РегистрацияНаПЛК - Документы регистрации на ПЛК
//
Функция ДокументыРегистрацииЛабАнализа(ЛабораторныйАнализ) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛабораторныйАнализ.гкс_ДокументРегистрации КАК Документ
		|ПОМЕСТИТЬ ВТ_ДокументыРегистрацииЛабАнализ
		|ИЗ
		|	Документ.гкс_ЛабораторныйАнализ КАК ЛабораторныйАнализ
		|ГДЕ
		|	ЛабораторныйАнализ.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации КАК ДокументРегистрации
		|ИЗ
		|	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыРегистрацииЛабАнализ КАК ВТ_ДокументыРегистрацииЛабАнализ
		|		ПО (ВТ_ДокументыРегистрацииЛабАнализ.Документ = ФормированиеНомераПробыСписокРегистраций.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РегистрацияНаПЛК.Ссылка
		|ИЗ
		|	Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыРегистрацииЛабАнализ КАК ВТ_ДокументыРегистрацииЛабАнализ
		|		ПО (ВТ_ДокументыРегистрацииЛабАнализ.Документ = РегистрацияНаПЛК.Ссылка)";
	
	Запрос.УстановитьПараметр("Ссылка", ЛабораторныйАнализ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда		
		МассивРегистраций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ДокументРегистрации");
	Иначе
		МассивРегистраций = Новый Массив;	
	КонецЕсли;
	                                                                                          
	Возврат МассивРегистраций;
	
КонецФункции 

// Функция возвращает значения по качестве по регистраици в целом и по показателям
//
//	Параметры:
//		ДокументРегистрации - ДокументСсылка.гсс_РегистрацияНаПЛК
//
// Возвращаемое значение:
// 	Структура
//		*КачествоРегистрации - ПеречислениеСсылка.гкс_СостоянияКачества
//		*КачествоПоказателей - 
//
Функция КачествоУсиленногоКонтроляПредыдущейГруппы(ДокументРегистрации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	НомераТаблиц = Новый Структура;
	Запрос.Текст = ТекстЗапросОпределенияКачестваПредшествующейГруппы(НомераТаблиц); 
	Результаты = Запрос.ВыполнитьПакет();
	
	ДанныеПоКачеству = Новый Структура("КачествоРегистрации, КачествоПоказателей");
	КачествоРегистарации = Результаты[НомераТаблиц.СостояниеРегистрации].Выгрузить();
	КачествоПоказателей = Результаты[НомераТаблиц.СостояниеПоказателей].Выгрузить();
	ДанныеПоКачеству.КачествоПоказателей = КачествоПоказателей;
	
	Если КачествоРегистарации.Количество() = 0 Тогда
		ДанныеПоКачеству.КачествоРегистрации = Перечисления.гкс_СостоянияКачества.КачествоНеПринято;
	Иначе     
		ДанныеПоКачеству.КачествоРегистрации = КачествоРегистарации[0].СостояниеКачества;
	КонецЕсли;	
	
	Возврат ДанныеПоКачеству;
	
КонецФункции

// Процедура вычисляет состояние регистрации для заблокированных ТС и записывает по ним данные В РС Состояние регистрации
// Параметры:
// ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ
// ДокументРегистрации - ДокументСсылка.гксРегистрацияНаПЛК, ДокументСсылка.гкс_ФормированиеНомераПроб
// ДанныеДляРазгрузкиРазблокированныхТС - ТаблицаЗначений
Процедура ЗаписатьСостоянияРегистрацииЗаблокированныхТС(ЛабораторныйАнализ, ДокументРегистрации, ДанныеДляРазгрузкиРазблокированныхТС) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	НомераТаблиц = Новый Структура;
	Запрос.Текст = ТекстЗапросаСостоянияРегистрацииЗаблокированныхТС(НомераТаблиц);
	Запрос.УстановитьПараметр("ЛабораторныйАнализ", ЛабораторныйАнализ);
	Запрос.УстановитьПараметр("ДокументРегистрации" , ДокументРегистрации);
	Запрос.УстановитьПараметр("Пользователь" , Пользователи.ТекущийПользователь());
	СписокСостоянийКачества = Новый СписокЗначений;
	СписокСостоянийКачества.Добавить(Перечисления.гкс_СостоянияРегистрации.КачествоНеПринято);
	СписокСостоянийКачества.Добавить(Перечисления.гкс_СостоянияРегистрации.РезультатыПробПолучены);
	СписокСостоянийКачества.Добавить(Перечисления.гкс_СостоянияРегистрации.КачествоПринято);
	Запрос.УстановитьПараметр("СписокСостоянийКачества" , СписокСостоянийКачества);         
	
	Комментарий = "Лабораторный анализ по заблокированным ТС";                                
	Запрос.УстановитьПараметр("КомментарийЗаблокированныеТС" , Комментарий);         
	Результаты = Запрос.ВыполнитьПакет();
	
	ТаблицаСостоянийРегистраций = Результаты[НомераТаблиц.СостонияРегистрацииТаблицаДвижений].Выгрузить(); 
	ДанныеДляРазгрузкиРазблокированныхТС = Результаты[НомераТаблиц.ЗаблокированныеТСКачествоПринято].Выгрузить();
	
	Если ТаблицаСостоянийРегистраций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьДанныеПоРегистрацииНаПЛК(ТаблицаСостоянийРегистраций);
		
КонецПроцедуры

// Возвращает признак того, является ли Регистрация на ПЛК первой в производственные сутки
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
// Возвращаемое значение:
//  - Булево
Функция ЭтоПерваяРегистрацияТСПоставщика(ДокументРегистрации) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации КАК ДокументРегистрации
		|ИЗ
		|	РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК ТранспортныеСредстваПоставщикаУсиленногоКонтроля
		|ГДЕ
		|	ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ЭтоПервоеТС
		|	И ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации = &ДокументРегистрации";
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Возврат Не РезультатЗапроса.Пустой(); 
	
КонецФункции

// Определяет, есть ли данные по УК для документа
// Параметры:
// ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
// ВозвращаемоеЗначение
// - Булево
Функция ЕстьДанныеПоУсиленномуКонтролю(ДокументРегистрации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
		
   	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ ВТ_РегистрацииНаПЛК
		|ИЗ
		|	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
		|ГДЕ
		|	ФормированиеНомераПробыСписокРегистраций.Ссылка = &ДокументРегистрации
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РегистрацияНаПЛК.Ссылка
		|ИЗ
		|	Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		|ГДЕ
		|	РегистрацияНаПЛК.Ссылка = &ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации КАК ДокументРегистрации
		|ИЗ
		|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроляПоРегистрации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛК
		|		ПО ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации = ВТ_РегистрацииНаПЛК.ДокументРегистрации
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаблокированныеРегистрацииУсиленныйКонтроль.ДокументРегистрации
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеРегистрацииУсиленныйКонтроль
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛК
		|		ПО ЗаблокированныеРегистрацииУсиленныйКонтроль.ДокументРегистрации = ВТ_РегистрацииНаПЛК.ДокументРегистрации";
	
	Результат = Запрос.Выполнить();
	
    Возврат Не Результат.Пустой();
	
КонецФункции

// Поиск и запись Правил усиленного контроля на основе Регистраций на ПЛК
// Параметры:
// ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК  
// ТочкаМаршрута - СправочникСсылка.гкс_ТочкиМаршрута
Процедура ЗарегистрироватьПравилаУсиленногоКонтроля(ДокументРегистрации, ТочкаМаршрута) Экспорт
	
	
	МестнаяДата = Справочники.гкс_ТочкиМаршрута.ПолучитьМестнуюДатуПоТочкеМаршрута(ТочкаМаршрута);
	ПроизводственныеСутки = гкс_ПриемкаТранспорта.ПроизводственныеСуткиПоДата(МестнаяДата);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.УстановитьПараметр("ПроизводственныеСутки", ПроизводственныеСутки);
	Комментарий = НСтр("ru = 'Создан автоматически по параметрам для Настроек усиленного контроля.'");
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
	Запрос.Текст = ТекстЗапросаНастройкиУсиленногоКонтроляДляРегистрации();
	
	Результат = Запрос.Выполнить();                                       
	Если Не Результат.Пустой() Тогда
		ТаблицаДанных = Результат.Выгрузить();
		РегистрыСведений.гкс_НастройкиУсиленногоКонтроляКачества.ЗаписатьНастройкиПоказателейУсиленногоКонтроля(
			ТаблицаДанных);
	КонецЕсли;	
	
КонецПроцедуры

//Функция возвращает признак тог, что на текущую регистрацию композитный анализ не пройден
// Параметры:
// ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
// СостояниеКачества - ПеречислениеСсылка.гкс_СостоянияКачества
// ВозвращаемоеЗначение
// - Булкво
Функция ТекущийКомпозитныйАнализНеПройденПоКачеству(ДокументРегистрации, СостояниеКачества = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("гкс_ИспользоватьУсиленныйКонтрольКачества") Тогда
		Возврат Ложь;
	КонецЕсли;	     
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации КАК ДокументРегистратор,
		|	ПоказателиУсиленногоКонтроляПоРегистрации.СостояниеКачества КАК СостояниеКачества
		|ИЗ
		|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроляПоРегистрации
		|ГДЕ
		|	ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации = &ДокументРегистрации
		|	И ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|	И ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
		|	И ПоказателиУсиленногоКонтроляПоРегистрации.СостояниеКачества В(&СписокСостояний)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоказателиУсиленногоКонтроляПоРегистрации.СостояниеКачества";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	СписокСостояний = Новый СписокЗначений;
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияКачества.КачествоНеПринято);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияКачества.РезультатыПробПолучены);
	Запрос.УстановитьПараметр("СписокСостояний", СписокСостояний);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Значение = Ложь;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
	    СостояниеКачества = Выборка.СостояниеКачества;
		Значение = Истина;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Возвращает Истина, если для документа регистрации необходимо вводить удостоверение качества и безопасности.
//
// Параметры:
//  Номенклатура   - СправочникСсылка.Номенклатура - номенклатура документа регистрации
//  ВидПеревозки   - ПеречислениеСсылка.гкс_ТипыТранспортныхСредствДоставки
//  ТипРегистрации - ПеречислениеСсылка.гкс_ТипРегистрации
//
// Возвращаемое значение:
//  Булево - Истина, если ТипРегистрации=Приёмка И ВидПеревозки=ЖДТранспорт И Номенклатура контролируется
//
Функция ТребуетсяУдостоверениеКачества(Номенклатура, ВидПеревозки, ТипРегистрации) Экспорт
	
	Если ПроверкаЗаполненияУдостоверениеКачества(ТипРегистрации, ВидПеревозки, Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НоменклатураКонтролируетсяУдостоверением(Номенклатура);
	
КонецФункции

// Возвращает Истина, если по документу регистрации заведено заполненное удостоверение качества.
//
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
//
// Возвращаемое значение:
//  Булево - Истина, если запись в РС существует и все 4 ресурса заполнены
//
Функция УдостоверениеКачестваЗаполнено(ДокументРегистрации) Экспорт
	
	ДанныеУдостоверенияКачества = ДанныеУдостоверенияКачества(ДокументРегистрации); 
	
	Если ДанныеУдостоверенияКачества = Неопределено Тогда 
		Возврат Ложь;	
	КонецЕсли;
	
	Возврат ДанныеУдостоверенияКачества.НомерУдостоверения > 0
		И ЗначениеЗаполнено(ДанныеУдостоверенияКачества.ДатаУдостоверения)
		И ЗначениеЗаполнено(ДанныеУдостоверенияКачества.ДатаВыработкиКонец)
		И ДанныеУдостоверенияКачества.СрокХраненияМесяцев > 0
		И ЗначениеЗаполнено(ДанныеУдостоверенияКачества.СрокГодности);
	
КонецФункции

// Возвращает структуру с данными удостоверения качества для документа регистрации.
//
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
//
// Возвращаемое значение:
//  Структура - { НомерУдостоверения, ДатаУдостоверения, ДатаВыработкиКонец, СрокХраненияМесяцев, СрокГодности } 
//              или Неопределено, если записи нет
//
Функция ДанныеУдостоверенияКачества(ДокументРегистрации) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаУдостоверенияКачества();
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Результат = Новый Структура();
	Результат.Вставить("НомерУдостоверения");
	Результат.Вставить("ДатаУдостоверения");
	Результат.Вставить("ДатаВыработкиКонец");
	Результат.Вставить("СрокХраненияМесяцев");
	Результат.Вставить("СрокГодности");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Возврат Результат;
	
КонецФункции

// Возвращает назначения использования по которым определяется прохождение по качеству
// 		
// Возвращаемое значение:
// 	Массив из ПеречислениеСсылка.гкс_НазначенияИспользованияКачества 
//
Функция НазначенияИспользованияПроверкиКачества() Экспорт
	
	НазначенияИспользования = Новый Массив;
	НазначенияИспользования.Добавить(Перечисления.гкс_НазначенияИспользованияКачества.Приемка);
	НазначенияИспользования.Добавить(Перечисления.гкс_НазначенияИспользованияКачества.ПерепроверкаВнешнихПроб);

	Возврат НазначенияИспользования;

КонецФункции

#Область ОбработчикиПодписокНаСобытия

// Процедура, вызываемая при срабатывании подписки на событие "гкс_ЛабораторныйАнализОбработкаПроведения"
//	
//	Параметры:
//		Источник - ДокументОбъект.гкс_ЛабораторныйАнализ
//		Отказ - Булево - параметр, определяющий будет ли проводиться объект;
//		РежимПроведения - Булево - режим проведения документа.
//
Процедура ПриПроведенииЛабораторногоАнализа(Источник, Отказ, РежимПроведения) Экспорт
	
	ЭтоПерепроверкаВнешнихПроб = Перечисления.гкс_НазначенияИспользованияКачества
									.ЭтоПерепроверкаВнешнихПроб(Источник.гкс_НазначениеИспользованияКачества);
									
	Если ЭтоПерепроверкаВнешнихПроб Тогда
		
		РегистрацииНаПЛК = Документы.гкс_ФормированиеНомераПробы
			.ДокументыРегистрацииФормированияНомераПроб(Источник.гкс_ДокументРегистрации);
				
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ФактическиеПоказателиКачества.Регистратор КАК ЛабораторныйАнализ,
			|	ФактическиеПоказателиКачества.РегистрацияНаПЛК КАК РегистрацияНаПЛК,
			|	МИНИМУМ(ФактическиеПоказателиКачества.СоответствуетНормативу) КАК СоответствуетНормативу	
			|ИЗ
			|	РегистрСведений.гкс_ФактическиеПоказателиКачества КАК ФактическиеПоказателиКачества
			|ГДЕ
			|	ФактическиеПоказателиКачества.РегистрацияНаПЛК В(&СписокРегистраций)
			|	И ФактическиеПоказателиКачества.НазначениеИспользованияКачества = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.Приемка)
			|
			|СГРУППИРОВАТЬ ПО
			|	ФактическиеПоказателиКачества.Регистратор,
			|	ФактическиеПоказателиКачества.РегистрацияНаПЛК
			|
			|УПОРЯДОЧИТЬ ПО
			|	СоответствуетНормативу";
		
		Запрос.УстановитьПараметр("СписокРегистраций", РегистрацииНаПЛК);
				
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат;	
		КонецЕсли;	
		
		Выборка = РезультатЗапроса.Выбрать(); 			
		Пока Выборка.Следующий() Цикл
			
			Если Не Выборка.СоответствуетНормативу Тогда
				Продолжить;
			КонецЕсли; 	
			
			НаправлениеНаРазгрузку = Документы.гкс_НаправлениеНаРазгрузку.ПолучитьПоРегистрации(Выборка.РегистрацияНаПЛК);
			
			Если Не ЗначениеЗаполнено(НаправлениеНаРазгрузку) Тогда 
				ЛабораторныйАнализ = Выборка.ЛабораторныйАнализ.ПолучитьОбъект();
				ЛабораторныйАнализ.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		КонецЦикла;
						
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

