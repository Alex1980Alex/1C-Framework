КонецФункции	

Процедура ЗаписатьДанныеПоРегистрацииНаПЛК(ТаблицаСостоянийРегистраций)
	
	СостоянияРегистрации = РегистрыСведений.гкс_СостоянияРегистрации;	
	
	Для Каждого ДанныеРегистрации из ТаблицаСостоянийРегистраций цикл
		Если СостоянияРегистрации.УжеУбыл(ДанныеРегистрации.ДокументРегистрации) Тогда
			Продолжить;
		КонецЕсли;    
		
		ДанныеДляЗаписи = 
			ОтфильтроватьДанныеПоДокументуРегистрации(
				ТаблицаСостоянийРегистраций, ДанныеРегистрации.ДокументРегистрации);
				
		ЗаписатьСостояниеРегистрации(ДанныеРегистрации.Период, ДанныеРегистрации.ДокументРегистрации, ДанныеДляЗаписи);
  		
	КонецЦикла;	
	
КонецПроцедуры	 

Функция ОтфильтроватьДанныеПоДокументуРегистрации(ТаблицаДанных, ДокументРегистрации)
	
	ОтборПоДокументу = Новый Структура;
	ОтборПоДокументу.Вставить("ДокументРегистрации", ДокументРегистрации);
	
	ОтфильтрованныеСтроки = ТаблицаДанных.НайтиСтроки(ОтборПоДокументу);
	РезультатТаблица = ТаблицаДанных.СкопироватьКолонки();

	Для Каждого Строка Из ОтфильтрованныеСтроки Цикл
		ЗаполнитьЗначенияСвойств(РезультатТаблица.Добавить(), Строка);
	КонецЦикла;

	Возврат РезультатТаблица;
	
КонецФункции

Процедура ЗаписатьСостояниеРегистрации(ДатаНабора, ДокументРегистрации, ТаблицаДанных)
	
		Набор = РегистрыСведений.гкс_СостоянияРегистрации.СоздатьНаборЗаписей();
		Набор.Отбор.Период.Установить(ДатаНабора);
		Набор.Отбор.ДокументРегистрации.Установить(ДокументРегистрации);
		Набор.Загрузить(ТаблицаДанных);
		
		Если РегистрыСведений.гкс_СостоянияРегистрации.ВозможностьИзмененияСтатуса(Набор) Тогда
			Набор.Записать();		
			РегистрыСведений.гкс_АРМПриемкиНаПЛКСписокРегистраций.ЗарегистрироватьВАРМПриемкиНаПЛК(ДокументРегистрации);
			гкс_НапоминанияПользователяСервер.ЗарегистрироватьНапоминаниеПользователя(ДокументРегистрации);
		КонецЕсли;	
		
КонецПроцедуры	

Функция ТекстЗапросаСостоянияРегистрацииЗаблокированныхТС(НомераТаблиц)
	
	НомераТаблиц.Вставить("ЗаблокированныеТС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПоказателиЗаблокированныхТС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КачествоПоЗаблокированнымТС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДанныеЛабАнализа", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТекущиеСостоянияРегистраций", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СостоянияРегистрацииПоЗаблокированнымТС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СостоянияРегистрацииИтог", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СостонияРегистрацииТаблицаДвижений", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ЗаблокированныеТСКачествоПринято", НомераТаблиц.Количество());
	
	Возврат
	
		"ВЫБРАТЬ
		|	ЗаблокированныеРегистрацииУсиленныйКонтроль.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ ЗаблокированныеТС
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеРегистрацииУсиленныйКонтроль
		|ГДЕ
		|	ЗаблокированныеРегистрацииУсиленныйКонтроль.БлокирующаяРегистрация = &ДокументРегистрации
		|	И НЕ ЗаблокированныеРегистрацииУсиленныйКонтроль.Разблокировано
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаблокированныеРегистрацииУК.ДокументРегистрации
		|ИЗ
		|	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК РегистрацииФПН
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеРегистрацииУК
		|			ПО СоставГруппТранспорта.ГруппаТС = ЗаблокированныеРегистрацииУК.БлокирующаяГруппаТС
		|		ПО РегистрацииФПН.ДокументРегистрации = СоставГруппТранспорта.РегистрацияТранспорта
		|			И (РегистрацииФПН.Ссылка = &ДокументРегистрации)
		|ГДЕ
		|	НЕ ЗаблокированныеРегистрацииУК.Разблокировано
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФактическиеПоказателиКачества.РегистрацияНаПЛК КАК ДокументРегистрации,
		|	ФактическиеПоказателиКачества.Показатель КАК Показатель,
		|	ФактическиеПоказателиКачества.СоответствуетНормативу КАК СоответствуетНормативу,
		|	ФактическиеПоказателиКачества.ОтклонятьКачество КАК ОтклонятьКачество
		|ПОМЕСТИТЬ ПоказателиЗаблокированныхТС
		|ИЗ
		|	РегистрСведений.гкс_ФактическиеПоказателиКачества КАК ФактическиеПоказателиКачества
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗаблокированныеТС КАК ЗаблокированныеТС
		|		ПО ФактическиеПоказателиКачества.РегистрацияНаПЛК = ЗаблокированныеТС.ДокументРегистрации
		|			И (ФактическиеПоказателиКачества.НазначениеИспользованияКачества = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.Приемка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаблокированныеТС.ДокументРегистрации,
		|	ФактическиеПоказателиКачества.Показатель,
		|	ФактическиеПоказателиКачества.СоответствуетНормативу,
		|	ФактическиеПоказателиКачества.ОтклонятьКачество
		|ИЗ
		|	ЗаблокированныеТС КАК ЗаблокированныеТС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ФактическиеПоказателиКачества КАК ФактическиеПоказателиКачества
		|		ПО (ФактическиеПоказателиКачества.УсиленныйКонтроль)
		|			И (ФактическиеПоказателиКачества.Регистратор = &ЛабораторныйАнализ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ПоказателиЗаблокированныхТС.СоответствуетНормативу) КАК СоответствуетНормативу,
		|	МАКСИМУМ(ПоказателиЗаблокированныхТС.ОтклонятьКачество) КАК ОтклонятьКачество,
		|	ПоказателиЗаблокированныхТС.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ КачествоПоЗаблокированнымТС
		|ИЗ
		|	ПоказателиЗаблокированныхТС КАК ПоказателиЗаблокированныхТС
		|
		|СГРУППИРОВАТЬ ПО
		|	ПоказателиЗаблокированныхТС.ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА гкс_ЛабораторныйАнализ.гкс_ДатаПолученияАнализа = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА гкс_ЛабораторныйАнализ.Дата
		|		ИНАЧЕ гкс_ЛабораторныйАнализ.гкс_ДатаПолученияАнализа
		|	КОНЕЦ КАК Период,
		|	гкс_ЛабораторныйАнализ.ТочкаМаршрута КАК ТочкаМаршрута,
		|	гкс_ЛабораторныйАнализ.гкс_МестнаяДата КАК МестнаяДата,
		|	гкс_ЛабораторныйАнализ.гкс_ВидПеревозки КАК ВидПеревозки
		|ПОМЕСТИТЬ ДанныеЛабАнализа
		|ИЗ
		|	Документ.гкс_ЛабораторныйАнализ КАК гкс_ЛабораторныйАнализ
		|ГДЕ
		|	гкс_ЛабораторныйАнализ.Ссылка = &ЛабораторныйАнализ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	гкс_СостоянияРегистрацииСрезПоследних.ДокументРегистрации КАК ДокументРегистрации,
		|	гкс_СостоянияРегистрацииСрезПоследних.Состояние КАК Состояние
		|ПОМЕСТИТЬ ТекущиеСостоянияРегистраций
		|ИЗ
		|	РегистрСведений.гкс_СостоянияРегистрации.СрезПоследних(
		|			,
		|			ДокументРегистрации В
		|				(ВЫБРАТЬ
		|					Регистрации.ДокументРегистрации
		|				ИЗ
		|					ЗаблокированныеТС КАК Регистрации)) КАК гкс_СостоянияРегистрацииСрезПоследних
		|ГДЕ
		|	гкс_СостоянияРегистрацииСрезПоследних.Состояние В(&СписокСостоянийКачества)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА КачествоПоЗаблокированнымТС.ОтклонятьКачество
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияРегистрации.КачествоНеПринято)
		|		КОГДА НЕ КачествоПоЗаблокированнымТС.СоответствуетНормативу
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияРегистрации.РезультатыПробПолучены)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияРегистрации.КачествоПринято)
		|	КОНЕЦ КАК СостояниеРегистрации,
		|	КачествоПоЗаблокированнымТС.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ СостоянияРегистрацииПоЗаблокированнымТС
		|ИЗ
		|	КачествоПоЗаблокированнымТС КАК КачествоПоЗаблокированнымТС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостоянияРегистрацииПоЗаблокированнымТС.ДокументРегистрации КАК ДокументРегистрации,
		|	СостоянияРегистрацииПоЗаблокированнымТС.СостояниеРегистрации КАК Состояние
		|ПОМЕСТИТЬ СостоянияРегистрацииИтог
		|ИЗ
		|	СостоянияРегистрацииПоЗаблокированнымТС КАК СостоянияРегистрацииПоЗаблокированнымТС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТекущиеСостоянияРегистраций КАК ТекущиеСостоянияРегистраций
		|		ПО СостоянияРегистрацииПоЗаблокированнымТС.ДокументРегистрации = ТекущиеСостоянияРегистраций.ДокументРегистрации
		|ГДЕ
		|	ТекущиеСостоянияРегистраций.Состояние <> СостоянияРегистрацииПоЗаблокированнымТС.СостояниеРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостоянияРегистрацииИтог.ДокументРегистрации КАК ДокументРегистрации,
		|	СостоянияРегистрацииИтог.Состояние КАК Состояние,
		|	ДанныеЛабАнализа.Период КАК Период,
		|	ДанныеЛабАнализа.ТочкаМаршрута КАК ТочкаМаршрута,
		|	ДанныеЛабАнализа.МестнаяДата КАК МестнаяДата,
		|	ДанныеЛабАнализа.ВидПеревозки КАК ВидПеревозки,
		|	РегистрацияНаПЛК.ТипРегистрации КАК ТипРегистрации,
		|	РегистрацияНаПЛК.ТранспортноеСредство КАК ТранспортноеСредство,
		|	&Пользователь КАК Пользователь,
		|	&КомментарийЗаблокированныеТС КАК Комментарий
		|ИЗ
		|	СостоянияРегистрацииИтог КАК СостоянияРегистрацииИтог
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		|		ПО СостоянияРегистрацииИтог.ДокументРегистрации = РегистрацияНаПЛК.Ссылка,
		|	ДанныеЛабАнализа КАК ДанныеЛабАнализа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостоянияРегистрацииПоЗаблокированнымТС.ДокументРегистрации КАК ДокументРегистрации,
		|	ЛабораторныйАнализ.Ссылка КАК ЛабораторныйАнализ,
		|	ЛабораторныйАнализ.Дата КАК Дата
		|ИЗ
		|	СостоянияРегистрацииПоЗаблокированнымТС КАК СостоянияРегистрацииПоЗаблокированнымТС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ КАК ЛабораторныйАнализ
		|		ПО СостоянияРегистрацииПоЗаблокированнымТС.ДокументРегистрации = ЛабораторныйАнализ.гкс_ДокументРегистрации
		|			И (ЛабораторныйАнализ.гкс_НазначениеИспользованияКачества = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.Приемка))
		|			И (ЛабораторныйАнализ.Статус = ЗНАЧЕНИЕ(Перечисление.гкс_СтатусыЛабораторногоАнализа.Выполнен))
		|			И (ЛабораторныйАнализ.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_НаправлениеНаРазгрузку КАК НаправлениеНаРазгрузку
		|		ПО СостоянияРегистрацииПоЗаблокированнымТС.ДокументРегистрации = НаправлениеНаРазгрузку.ДокументРегистрации
		|			И (НаправлениеНаРазгрузку.Проведен)
		|ГДЕ
		|	НаправлениеНаРазгрузку.Ссылка ЕСТЬ NULL
		|	И СостоянияРегистрацииПоЗаблокированнымТС.СостояниеРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияРегистрации.КачествоПринято)";
	
КонецФункции	

Функция ТекстЗапросОпределенияКачестваПредшествующейГруппы(НомераТаблиц)
	
	НомераТаблиц.Вставить("ПоказателиДляГрупп", 		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОтборЗначенийПоказателей", 	НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КачествоПоПоказателям", 		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КачествоПоРегистрации",		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СостояниеПоказателей", 		НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СостояниеРегистрации", 		НомераТаблиц.Количество());
	
	Возврат
		"ВЫБРАТЬ
		|	ГруппыТС.ПредыдущаяГруппа КАК ПредыдущаяГруппа,
		|	ПоказателиУсиленногоКонтроляПоРегистрации.Показатель КАК Показатель,
		|	ГруппыТС.Номенклатура КАК Номенклатура,
		|	ГруппыТС.Контрагент КАК Контрагент,
		|	ГруппыТС.ПроизводственныеСутки КАК ПроизводственныеСутки
		|ПОМЕСТИТЬ ПоказателиДляГрупп
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.гкс_ГруппыТС КАК ГруппыТС
		|		ПО СоставГруппТранспорта.ГруппаТС = ГруппыТС.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУсиленногоКонтроляПоРегистрации
		|		ПО СоставГруппТранспорта.РегистрацияТранспорта = ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
		|			И (ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит))
		|			И (ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная))
		|ГДЕ
		|	СоставГруппТранспорта.РегистрацияТранспорта = &ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоказателиДляГрупп.Показатель КАК Показатель,
		|	СоставГруппТранспорта.РегистрацияТранспорта КАК РегистрацияТранспорта,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит) КАК НазначениеИспользования
		|ПОМЕСТИТЬ ОтборЗначенийПоказателей
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоказателиДляГрупп КАК ПоказателиДляГрупп
		|		ПО СоставГруппТранспорта.ГруппаТС = ПоказателиДляГрупп.ПредыдущаяГруппа
		|ГДЕ
		|	ПоказателиДляГрупп.ПредыдущаяГруппа <> ЗНАЧЕНИЕ(Справочник.гкс_ГруппыТС.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоказателиДляГрупп.Показатель,
		|	ТранспортныеСредстваПоставщика.ДокументРегистрации,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.Приемка)
		|ИЗ
		|	ПоказателиДляГрупп КАК ПоказателиДляГрупп
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК ТранспортныеСредстваПоставщика
		|		ПО ПоказателиДляГрупп.Номенклатура = ТранспортныеСредстваПоставщика.Номенклатура
		|			И ПоказателиДляГрупп.Контрагент = ТранспортныеСредстваПоставщика.Контрагент
		|			И ПоказателиДляГрупп.ПроизводственныеСутки = ТранспортныеСредстваПоставщика.ПроизводственныеСутки
		|			И (ТранспортныеСредстваПоставщика.ЭтоПервоеТС)
		|ГДЕ
		|	ТранспортныеСредстваПоставщика.ДокументРегистрации <> &ДокументРегистрации
		|	И ПоказателиДляГрупп.ПредыдущаяГруппа = ЗНАЧЕНИЕ(Справочник.гкс_ГруппыТС.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФактическиеПоказателиКачества.Показатель КАК Показатель,
		|	МИНИМУМ(ФактическиеПоказателиКачества.СоответствуетНормативу) КАК СоответствуетНормативу,
		|	МАКСИМУМ(ФактическиеПоказателиКачества.ОтклонятьКачество) КАК ОтклонятьКачество,
		|	&ДокументРегистрации КАК ДокументРегистрации,
		|	МАКСИМУМ(ФактическиеПоказателиКачества.Значение) КАК Значение
		|ПОМЕСТИТЬ КачествоПоПоказателям
		|ИЗ
		|	РегистрСведений.гкс_ФактическиеПоказателиКачества КАК ФактическиеПоказателиКачества
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборЗначенийПоказателей КАК ОтборЗначенийПоказателей
		|		ПО ФактическиеПоказателиКачества.РегистрацияНаПЛК = ОтборЗначенийПоказателей.РегистрацияТранспорта
		|			И ФактическиеПоказателиКачества.Показатель = ОтборЗначенийПоказателей.Показатель
		|			И ФактическиеПоказателиКачества.НазначениеИспользованияКачества = ОтборЗначенийПоказателей.НазначениеИспользования
		|			И (ФактическиеПоказателиКачества.УсиленныйКонтроль)
		|
		|СГРУППИРОВАТЬ ПО
		|	ФактическиеПоказателиКачества.Показатель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(КачествоПоПоказателям.СоответствуетНормативу) КАК СоответствуетНормативу,
		|	МАКСИМУМ(КачествоПоПоказателям.ОтклонятьКачество) КАК ОтклонятьКачество,
		|	КачествоПоПоказателям.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ КачествоПоРегистрации
		|ИЗ
		|	КачествоПоПоказателям КАК КачествоПоПоказателям
		|
		|СГРУППИРОВАТЬ ПО
		|	КачествоПоПоказателям.ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КачествоПоПоказателям.Показатель КАК Показатель,
		|	ВЫБОР
		|		КОГДА КачествоПоПоказателям.ОтклонятьКачество
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоНеПринято)
		|		КОГДА НЕ КачествоПоПоказателям.СоответствуетНормативу
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.РезультатыПробПолучены)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоПринято)
		|	КОНЕЦ КАК СостояниеКачества,
		|	КачествоПоПоказателям.СоответствуетНормативу КАК СоответствуетНормативу,
		|	КачествоПоПоказателям.ОтклонятьКачество КАК ОтклонятьКачество,
		|	КачествоПоПоказателям.Значение КАК Значение
		|ИЗ
		|	КачествоПоПоказателям КАК КачествоПоПоказателям
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА КачествоПоРегистрации.ОтклонятьКачество
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоНеПринято)
		|		КОГДА НЕ КачествоПоРегистрации.СоответствуетНормативу
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.РезультатыПробПолучены)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоПринято)
		|	КОНЕЦ КАК СостояниеКачества
		|ИЗ
		|	КачествоПоРегистрации КАК КачествоПоРегистрации"; 

КонецФункции

Функция ТипПробыПоДокументуРегистрации(ДокументРегистрации)
	
	Если ТипЗнч(ДокументРегистрации) = Тип("ДокументСсылка.гкс_РегистрацияНаПЛК") Тогда
		ТипПробы = Перечисления.гкс_ТипыПроб.Единичная;
	Иначе
		ТипПробы = Перечисления.гкс_ТипыПроб.Композитная;
	КонецЕсли;
	
	Возврат ТипПробы;
	
КонецФункции
                                          
Процедура УстановитьТипВНастройкахУсиленногоКонтроля(ИдентификаторыПравилКонтроля, ТипУсиленногоКонтроляКачества)
	
	СрокПравил = Константы.гкс_СрокУстановкиПравилКаждоеТС.Получить();
	Если СрокПравил <> 0 Тогда
		ДатаОкончания = гкс_ОбщегоНазначенияКлиентСервер.СдвигДаты(НачалоДня(ТекущаяДатаСеанса()), СрокПравил, "ДЕНЬ");
		ДатаНачалаНовыхПравил = гкс_ОбщегоНазначенияКлиентСервер.СдвигДаты(ДатаОкончания, 1, "ДЕНЬ");
	Иначе
		ДатаОкончания = Неопределено;
		ДатаНачалаНовыхПравил = Неопределено;
	КонецЕсли;	
	
	Для Каждого ИдентификаторПравила Из ИдентификаторыПравилКонтроля Цикл
		
		Если СрокПравил <> 0 Тогда
			РегистрыСведений.гкс_НастройкиУсиленногоКонтроляКачества.
				СоздатьКопиюПравилПоИдентификатору(ИдентификаторПравила, ДатаНачалаНовыхПравил);		
		КонецЕсли;		
			
		РегистрыСведений.гкс_НастройкиУсиленногоКонтроляКачества.
				УстановитьТипВходногоКонтроля(ИдентификаторПравила, ТипУсиленногоКонтроляКачества, ДатаОкончания);		
	КонецЦикла;	          
			
	
		
КонецПроцедуры                                                                                    
	
Функция НастройкиУсиленногоКонтроляПоТипуКонтроля(ТипВходногоКонтроля, 
													ДокументыРегистрации, ПоказателиКачества = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПравилаУсиленногоКонтроляДляТранспортногоСредства.ИдентификаторПравила КАК ИдентификаторПравила
		|ИЗ
		|	РегистрСведений.гкс_ПравилаУсиленногоКонтроляПоРегистрации КАК ПравилаУсиленногоКонтроляДляТранспортногоСредства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_НастройкиУсиленногоКонтроляКачества КАК НастройкиУсиленногоКонтроляКачества
		|		ПО ПравилаУсиленногоКонтроляДляТранспортногоСредства.ИдентификаторПравила = НастройкиУсиленногоКонтроляКачества.ИдентификаторПравила
		|			И (НастройкиУсиленногоКонтроляКачества.Активен)
		|			И (НастройкиУсиленногоКонтроляКачества.ТипВходногоКонтроля = &ТипВходногоКонтроля)
		|ГДЕ
		|	ПравилаУсиленногоКонтроляДляТранспортногоСредства.ДокументРегистрации В(&ДокументыРегистрации)
		|	И &УсловиеПоказатели";
	
	Запрос.УстановитьПараметр("ТипВходногоКонтроля", ТипВходногоКонтроля);
	Запрос.УстановитьПараметр("ДокументыРегистрации", ДокументыРегистрации);
	
	Если ЗначениеЗаполнено(ПоказателиКачества) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоказатели", 
			"ПравилаУсиленногоКонтроляДляТранспортногоСредства.Показатель В(&Показатели)");

		Запрос.УстановитьПараметр("Показатели", ПоказателиКачества);
		
	Иначе
		Запрос.УстановитьПараметр("Показатели", Истина);
	КонецЕсли;	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Новый Массив;
	Иначе	
		Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторПравила");
	КонецЕсли;	
	
	Возврат Результат;	
	
КонецФункции

Функция ТранспортноеСредствоЗарегистрировано(ДокументРегистрации)
	
	Запрос = Новый Запрос;                                                                          
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	Запрос.Текст =  
		"ВЫБРАТЬ
	    |	ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации КАК ДокументРегистрации
	    |ИЗ
	    |	РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК ТранспортныеСредстваПоставщикаУсиленногоКонтроля
	    |ГДЕ
	    |	ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации = &ДокументРегистрации";
	
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();
	
КонецФункции

Функция ИнициироватьТаблицуРегистрацииПоказателей()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДокументРегистрации");
	Таблица.Колонки.Добавить("Показатель");
	Таблица.Колонки.Добавить("ЗначениеПоказателяМин");
	Таблица.Колонки.Добавить("ЗначениеПоказателяМакс");  
	Таблица.Колонки.Добавить("Базис");  
	
	Возврат Таблица;
	
КонецФункции

Процедура ЗаписатьДанныеПоУсиленномуКонтролюДляРегистрации(ДокументРегистрации, ТаблицаПоказателей)
	
	НаборЗаписей = РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.СоздатьНаборЗаписей();	
	НаборЗаписей.Отбор.ДокументРегистрации.Установить(ДокументРегистрации);  
	НаборЗаписей.Загрузить(ТаблицаПоказателей);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ЗаписатьДанныеПоМашинеПоставщика(ДокументРегистрации, МестнаяДата, ЭтоПервоеТС)
		
	НаборЗаписей = РегистрыСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.СоздатьНаборЗаписей();	
	НаборЗаписей.Отбор.ДокументРегистрации.Установить(ДокументРегистрации);
	
	Запись = НаборЗаписей.Добавить();
	
	Реквизиты = "ТранспортноеСредство, Контрагент, Номенклатура";
	РеквизитыРегистрации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРегистрации, Реквизиты);
	ЗаполнитьЗначенияСвойств(Запись, РеквизитыРегистрации);
	
	Запись.МестнаяДата = МестнаяДата;
	Запись.ПроизводственныеСутки = гкс_ПриемкаТранспорта.ПроизводственныеСуткиПоДата(МестнаяДата);
	Запись.ЭтоПервоеТС = ЭтоПервоеТС;	
	Запись.ДокументРегистрации = ДокументРегистрации;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры   

Процедура ЗаписатьПравилаПоУсиленномуКонтролюДляРегистрации(ДокументРегистрации, ПравилаКонтроля)
	
	НаборЗаписей = РегистрыСведений.гкс_ПравилаУсиленногоКонтроляПоРегистрации.СоздатьНаборЗаписей();	
	НаборЗаписей.Отбор.ДокументРегистрации.Установить(ДокументРегистрации);                                         
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() <> 0 Тогда
		НаборЗаписей.Очистить();
	КонецЕсли;
	
	НаборЗаписей.Загрузить(ПравилаКонтроля);
	НаборЗаписей.Записать();
	
КонецПроцедуры	

Функция ЭтоПервоеТСПоставщикаЗаСутки(ДокументРегистрации, ДокументРегистрацииПервогоТС)
	
	Если Не ЗначениеЗаполнено(ДокументРегистрацииПервогоТС) 
		ИЛИ ДокументРегистрации = ДокументРегистрацииПервогоТС Тогда
		
		ЭтоПервоеТС = Истина;
	Иначе	
		ЭтоПервоеТС = Ложь;
	КонецЕсли;
	
	Возврат ЭтоПервоеТС;
	
КонецФункции

#Область БлокировкаРазблокировкаТС

// Получает данные о показателях и заблокированных ТС для массива регистраций
// одним пакетным запросом вместо N отдельных запросов (оптимизация)
// 
// Параметры:
//  МассивРегистраций - ТаблицаЗначений - Массив регистраций
// 
// Возвращаемое значение:
//  Структура - Получить данные блокировки для регистраций:
// * ПоказателиПоРегистрациям - Соответствие - 
// * ЗаблокированныеТСПоРегистрациям - Соответствие - 
Функция ПолучитьДанныеБлокировкиДляРегистраций(МассивРегистраций)

    Регистрация = Неопределено;
    
	Результат = Новый Структура;
	Результат.Вставить("ПоказателиПоРегистрациям", Новый Соответствие);
	Результат.Вставить("ЗаблокированныеТСПоРегистрациям", Новый Соответствие);
    Результат.Вставить("ГруппыПоРегистрациям", Новый Соответствие);
    Результат.Вставить("ТСНеПрошедшиеВходнойКонтроль", Новый Массив);
	Результат.Вставить("НезаблокированныеПоследующиеТС", Новый Массив);
	
	ЗаблокированныеТСПоГруппе = 5;
	ПоказателиПоРегистрациям = 6;
	ЗаблокированныеТСПоРегистрациям = 7;
	ТСНеПрошедшиеВходнойКонтроль = 8;
	НезаблокированныеПоследующиеТСПакет = 9;
	
	Если МассивРегистраций.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПолучитьДанныеБлокировкиДляРегистраций();
	Запрос.УстановитьПараметр("МассивРегистраций", МассивРегистраций);

	РезультатыЗапроса = Запрос.ВыполнитьПакет();

	// Заполняем показатели по регистрациям
	ВыборкаПоказатели = РезультатыЗапроса[ПоказателиПоРегистрациям].Выбрать();
	Пока ВыборкаПоказатели.Следующий() Цикл
		Регистрация = ВыборкаПоказатели.ДокументРегистрации;
		Показатели = Результат.ПоказателиПоРегистрациям.Получить(Регистрация);
		Если Показатели = Неопределено Тогда
			Показатели = Новый Массив;
			Результат.ПоказателиПоРегистрациям.Вставить(Регистрация, Показатели);
		КонецЕсли;
		Показатели.Добавить(ВыборкаПоказатели.Показатель);
	КонецЦикла;

	// Заполняем заблокированные ТС по регистрациям
	ВыборкаЗаблокированные = РезультатыЗапроса[ЗаблокированныеТСПоРегистрациям].Выбрать();
	Пока ВыборкаЗаблокированные.Следующий() Цикл
		Регистрация = ВыборкаЗаблокированные.БлокирующаяРегистрация;
		ЗаблокированныеТС = Результат.ЗаблокированныеТСПоРегистрациям.Получить(Регистрация);
		Если ЗаблокированныеТС = Неопределено Тогда
			ЗаблокированныеТС = Новый Массив;
			Результат.ЗаблокированныеТСПоРегистрациям.Вставить(Регистрация, ЗаблокированныеТС);
		КонецЕсли;
		Если ЗаблокированныеТС.Найти(ВыборкаЗаблокированные.ЗаблокированноеТС) = Неопределено Тогда
			ЗаблокированныеТС.Добавить(ВыборкаЗаблокированные.ЗаблокированноеТС);
		КонецЕсли;
	КонецЦикла;  

	// Заполняем заблокированные ТС по группе
	ВыборкаЗаблокированныеПоГруппе = РезультатыЗапроса[ЗаблокированныеТСПоГруппе].Выгрузить();
	Результат.ГруппыПоРегистрациям.Вставить("ТаблицаЗначений", ВыборкаЗаблокированныеПоГруппе);
	
	// Заполняем ТС не прошедшие входной контроль
	ВыборкаНеПрошедшие = РезультатыЗапроса[ТСНеПрошедшиеВходнойКонтроль].Выбрать();
	Пока ВыборкаНеПрошедшие.Следующий() Цикл
		Если Результат.ТСНеПрошедшиеВходнойКонтроль.Найти(ВыборкаНеПрошедшие.ЗаблокированноеТС) = Неопределено Тогда
			Результат.ТСНеПрошедшиеВходнойКонтроль.Добавить(ВыборкаНеПрошедшие.ЗаблокированноеТС);
		КонецЕсли;
	КонецЦикла;
	
	// Заполняем последующие ТС, которые ещё НЕ заблокированы
	ВыборкаНезаблокированные = РезультатыЗапроса[НезаблокированныеПоследующиеТСПакет].Выбрать();
	Пока ВыборкаНезаблокированные.Следующий() Цикл
		ДанныеТС = Новый Структура("ДокументРегистрации, Показатель, БлокирующаяГруппаТС",
			ВыборкаНезаблокированные.ДокументРегистрации,
			ВыборкаНезаблокированные.Показатель,
			ВыборкаНезаблокированные.БлокирующаяГруппаТС);
		Результат.НезаблокированныеПоследующиеТС.Добавить(ДанныеТС);
	КонецЦикла;
	
	Если Регистрация <> Неопределено 
		И Результат.ЗаблокированныеТСПоРегистрациям.Получить(Регистрация) = Неопределено Тогда
		
		ЗаблокированныеТС = Новый Массив;
		Результат.ЗаблокированныеТСПоРегистрациям.Вставить(Регистрация, ЗаблокированныеТС);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Добавляет запись о заблокированном ТС в группы регистрации.
// Если для регистрации ещё нет группы - создаёт и добавляет первый элемент.
// Если группа существует - добавляет элемент только при отсутствии идентичной пары.
//
// Параметры:
//  Результат           - Структура    - накапливаемый результат (ГруппыПоРегистрациям изменяется)
//  Регистрация         - ДокументСсылка - блокирующая регистрация (ключ соответствия)
//  БлокирующаяГруппаТС - СправочникСсылка - группа ТС, вызвавшая блокировку
//  ЗаблокированноеТС   - ДокументСсылка - заблокированная регистрация
Процедура ДобавитьЗаблокированноеВГруппыРегистрации(Результат, Регистрация, БлокирующаяГруппаТС, ЗаблокированноеТС)
	БлокируюшааяГруппы = Результат.ГруппыПоРегистрациям.Получить(Регистрация);
	Если БлокируюшааяГруппы = Неопределено Тогда
		БлокируюшааяГруппы = Новый Массив;
		БлокируюшааяГруппы.Добавить(ЗаполнитьЗаблокированное(БлокирующаяГруппаТС, ЗаблокированноеТС));
		Результат.ГруппыПоРегистрациям.Вставить(Регистрация, БлокируюшааяГруппы);
	КонецЕсли;
	Для Каждого БлокируюшаяГруппы Из БлокируюшааяГруппы Цикл
		Если БлокируюшаяГруппы["БлокирующаяГруппаТС"] <> БлокирующаяГруппаТС
			И БлокируюшаяГруппы["ЗаблокированноеТС"] <> ЗаблокированноеТС Тогда
			БлокируюшааяГруппы.Добавить(ЗаполнитьЗаблокированное(БлокирующаяГруппаТС, ЗаблокированноеТС));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЗаполнитьЗаблокированное(БлокирующаяГруппаТС, ЗаблокированноеТС) 
	Заблокированное = Новый Соответствие;
	Заблокированное.Вставить("БлокирующаяГруппаТС", БлокирующаяГруппаТС); 
	Заблокированное.Вставить("ЗаблокированноеТС", ЗаблокированноеТС);	
	Возврат Заблокированное;	
КонецФункции

// Обновляет записи заблокированных ТС при завершении лабораторного анализа
// Сценарий A Качество ПРИНЯТО разблокировка записей
// Сценарий B Качество НЕ ПРИНЯТО эскалация и создание показателей для заблокированных ТС
//
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - регистрация первого ТС
//  ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - завершённый ЛА
//  НаборЗаписейПоказателей - РегистрСведенийНаборЗаписей - набор записей показателей УК
//  ДанныеБлокировки - Структура, Неопределено - предзагруженные данные для оптимизации (опционально)
//      ПоказателиПоРегистрациям - Соответствие - показатели по ключу ДокументРегистрации
//      ЗаблокированныеТСПоРегистрациям - Соответствие - заблокированные ТС по ключу ДокументРегистрации
//
Процедура ОбновитьЗаблокированныеТСПриЗавершенииЛА(ДокументРегистрации, ЛабораторныйАнализ, НаборЗаписейПоказателей, 
	ДанныеБлокировки = Неопределено)

    РезультатСостояний = СобратьСостоянияКачестваИзНабораЗаписей(НаборЗаписейПоказателей);
    	
	ДанныеОбновления = ПолучитьДанныеДляОбновленияБлокировки(ДокументРегистрации, ДанныеБлокировки, 
		РезультатСостояний.ЭтоПервоеТС, РезультатСостояний.ТекущаяГруппаТС);
		
	Если ДанныеОбновления = Неопределено Тогда
		Возврат;
	КонецЕсли;

    ТСНеПрошедшиеВходнойКонтроль = Неопределено;
	Если ДанныеБлокировки <> Неопределено Тогда
		ТСНеПрошедшиеВходнойКонтроль = ДанныеБлокировки.ТСНеПрошедшиеВходнойКонтроль;
	КонецЕсли;
	
	// Обновляем записи РС ЗаблокированныеРегистрации для каждого заблокированного ТС
	Если ДанныеОбновления.ЗаблокированныеТС <> Неопределено Тогда
		Для Каждого ЗаблокированноеТС Из ДанныеОбновления.ЗаблокированныеТС Цикл
			ОбновитьБлокировкуДляТС(ЗаблокированноеТС, ДокументРегистрации,
				ДанныеОбновления.Показатели, РезультатСостояний.СоответствиеСостояний,
				РезультатСостояний.ПоказателиНеПринято,
				ЛабораторныйАнализ,
				РезультатСостояний.ДанныеПоказателейПервогоТС,
				ТСНеПрошедшиеВходнойКонтроль);
		КонецЦикла;
	КонецЕсли;		
		
	// Обновляем записи РС ЗаблокированныеРегистрации для каждого заблокированного ТС и группы ТС
	Если ДанныеОбновления.ЗаблокированныеГруппыТС <> Неопределено Тогда
		Для Каждого ЗаблокированнаяГруппаТС Из ДанныеОбновления.ЗаблокированныеГруппыТС Цикл
			// GKSTCPLK-2693: снимать блокировку разрешено только следующей группе -
			// той, которую блокирует именно текущая группа завершённого композита.
			РазблокироватьРазрешено =
				ЗаблокированнаяГруппаТС["БлокирующаяГруппаТС"] = РезультатСостояний.ТекущаяГруппаТС;
			ОбновитьБлокировкуГруппаТС(ЗаблокированнаяГруппаТС["ЗаблокированноеТС"],
				ЗаблокированнаяГруппаТС["БлокирующаяГруппаТС"],
				ДанныеОбновления.Показатели,
				РезультатСостояний.СоответствиеСостояний,
				РезультатСостояний.ПоказателиНеПринято,
				ЛабораторныйАнализ,
				РезультатСостояний.ДанныеПоказателейПервогоТС,
				ТСНеПрошедшиеВходнойКонтроль,
				РазблокироватьРазрешено);
		КонецЦикла;
     КонецЕсли;
КонецПроцедуры

// Получает показатели и заблокированные ТС из кэша или запросом
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - регистрация первого ТС
//  ДанныеБлокировки - Структура, Неопределено - предзагруженные данные
//  ЭтоПервоеТС - Булево - Это первое ТС
//  ТекущаяГруппаТС - Текущая группа ТС
// 
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено если нет данных, иначе структура с ключами:
// * Показатели - Массив - показатели усиленного контроля
// * ЗаблокированныеТС - Массив - заблокированные регистрации
Функция ПолучитьДанныеДляОбновленияБлокировки(ДокументРегистрации, ДанныеБлокировки, ЭтоПервоеТС, ТекущаяГруппаТС)

	Если ДанныеБлокировки <> Неопределено Тогда
		Показатели = ДанныеБлокировки.ПоказателиПоРегистрациям.Получить(ДокументРегистрации);
		ЗаблокированныеТС = ДанныеБлокировки.ЗаблокированныеТСПоРегистрациям.Получить(ДокументРегистрации);
		ЗаблокированныеГруппыТС = Неопределено;
		ВсеГруппы = ДанныеБлокировки.ГруппыПоРегистрациям.Получить("ТаблицаЗначений");
		
		Если ЗначениеЗаполнено(ТекущаяГруппаТС) И Не ЭтоПервоеТС Тогда
			ЗаблокированныеГруппыТС = ОтобратьГруппыНачинаяСНомера(ВсеГруппы, ТекущаяГруппаТС.НомерГруппыПоставщика);
		КонецЕсли;

	Иначе
		Показатели = ПолучитьПоказателиУсиленногоКонтроляПоРегистрации(ДокументРегистрации);
		ЗаблокированныеТС = ПолучитьСписокЗаблокированныеТранспортныеСредства(ДокументРегистрации, Показатели);
		ЗаблокированныеГруппыТС = ПолучитьСписокЗаблокированныхГруппТС(ДокументРегистрации, Показатели);
	КонецЕсли;

    ДанныеОбновления = ДанныеДляОбновленияБлокировки(Показатели, ЗаблокированныеТС, ЗаблокированныеГруппыТС);
    
    Если Не ДанныеОбновления Тогда
    	Возврат Неопределено;
    КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Показатели", Показатели);
	Результат.Вставить("ЗаблокированныеТС", ЗаблокированныеТС);
	Результат.Вставить("ЗаблокированныеГруппыТС", ЗаблокированныеГруппыТС);
	Возврат Результат;

КонецФункции

// Данные для обновления блокировки.
// 
// Параметры:
//  Показатели - Произвольный, Массив - Показатели
//  ЗаблокированныеТС - Произвольный, Массив - Заблокированные ТС
//  ЗаблокированныеГруппыТС - Произвольный, Массив, Неопределено - Заблокированные группы ТС
// 
// Возвращаемое значение:
//  Булево - Данные для обновления блокировки
Функция ДанныеДляОбновленияБлокировки(Показатели, ЗаблокированныеТС, ЗаблокированныеГруппыТС)
	ДанныеОбновления = Истина;
	
	Если Показатели = Неопределено Или Показатели.Количество() = 0 Тогда
		ДанныеОбновления = Ложь;
	КонецЕсли;

	ЕстьЗаблокированныеТС = ЗаблокированныеТС <> Неопределено И ЗаблокированныеТС.Количество() > 0;
	ЕстьЗаблокированныеГруппы = ЗаблокированныеГруппыТС <> Неопределено И ЗаблокированныеГруппыТС.Количество() > 0;

	Если Не ЕстьЗаблокированныеТС И Не ЕстьЗаблокированныеГруппы Тогда
		ДанныеОбновления = Ложь;
	КонецЕсли;
	
	Возврат ДанныеОбновления;
КонецФункции

// Отбирает из таблицы групп строки с НомерГруппыПоставщика >= указанного номера
//
// Параметры:
//  ВсеГруппы - ТаблицаЗначений - таблица с колонками ЗаблокированноеТС, БлокирующаяГруппаТС, НомерГруппыПоставщика
//  МинимальныйНомерГруппы - Число - минимальный номер группы (включительно)
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - отобранные строки
Функция ОтобратьГруппыНачинаяСНомера(ВсеГруппы, МинимальныйНомерГруппы)

	Результат = Новый Массив;
	Для Каждого СтрокаГруппы Из ВсеГруппы Цикл
		Если СтрокаГруппы.НомерГруппыПоставщика >= МинимальныйНомерГруппы Тогда
			Результат.Добавить(СтрокаГруппы);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Собирает соответствие состояний качества и список непринятых показателей
//
// Параметры:
//  НаборЗаписейПоказателей - РегистрСведенийНаборЗаписей - набор записей показателей УК
//
// Возвращаемое значение:
//  Структура:
//      * СоответствиеСостояний - Соответствие - показатель → состояние качества
//      * ПоказателиНеПринято - Массив - показатели с не принятым качеством
//      * ДанныеПоказателейПервогоТС - Соответствие - показатель → Структура(Мин, Макс, Базис)
//
Функция СобратьСостоянияКачестваИзНабораЗаписей(НаборЗаписейПоказателей)

	СоответствиеСостояний = Новый Соответствие;
	ПоказателиНеПринято = Новый Массив;
	ДанныеПоказателейПервогоТС = Новый Соответствие;
    ЭтоПервоеТС = Новый Соответствие;
	ТекущаяГруппаТС = Новый Соответствие;
    
	
	Для Каждого ЗаписьПоказателя Из НаборЗаписейПоказателей Цикл
		
		ЭтоПервоеТС = ЗаписьПоказателя.ЭтоПервоеТС;
		ТекущаяГруппаТС = ЗаписьПоказателя.ТекущаяГруппаТС;
		
		Если ЭтоПервоеТС Тогда

			СоответствиеСостояний.Вставить(ЗаписьПоказателя.Показатель, ЗаписьПоказателя.СостояниеКачестваПервоеТС);
			Если ЗаписьПоказателя.СостояниеКачестваПервоеТС = 
				Перечисления.гкс_СостоянияКачества.КачествоНеПринято Тогда
				
				ПоказателиНеПринято.Добавить(ЗаписьПоказателя.Показатель);
			КонецЕсли;

		ИначеЕсли Не ЭтоПервоеТС И ЗначениеЗаполнено(ЗаписьПоказателя.ТекущаяГруппаТС) Тогда

			СоответствиеСостояний.Вставить(ЗаписьПоказателя.Показатель, 
				ЗаписьПоказателя.СостояниеКачестваТекущейГруппы);
			Если ЗаписьПоказателя.СостояниеКачестваТекущейГруппы = 
				Перечисления.гкс_СостоянияКачества.КачествоНеПринято Тогда
					
				ПоказателиНеПринято.Добавить(ЗаписьПоказателя.Показатель);
			КонецЕсли;

		КонецЕсли;
		
		ДанныеПоказателя = Новый Структура;
		ДанныеПоказателя.Вставить("ЗначениеПоказателяМин", ЗаписьПоказателя.ЗначениеПоказателяМин);
		ДанныеПоказателя.Вставить("ЗначениеПоказателяМакс", ЗаписьПоказателя.ЗначениеПоказателяМакс);
		ДанныеПоказателя.Вставить("Базис", ЗаписьПоказателя.Базис);
		ДанныеПоказателя.Вставить("ОтклонятьКачество", ЗаписьПоказателя.ОтклонятьКачество);
				
		ДанныеПоказателейПервогоТС.Вставить(ЗаписьПоказателя.Показатель, ДанныеПоказателя);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("СоответствиеСостояний", СоответствиеСостояний);
	Результат.Вставить("ПоказателиНеПринято", ПоказателиНеПринято);
	Результат.Вставить("ДанныеПоказателейПервогоТС", ДанныеПоказателейПервогоТС);
	Результат.Вставить("ЭтоПервоеТС", ЭтоПервоеТС); 
	Результат.Вставить("ТекущаяГруппаТС", ТекущаяГруппаТС);
	
	Возврат Результат;


КонецФункции

// Обновляет состояние блокировки и показатели для одного заблокированного ТС
// 
// Параметры:
//  ЗаблокированноеТС - ДокументСсылка.гкс_РегистрацияНаПЛК - заблокированная регистрация
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - блокирующая регистрация
//  Показатели - Массив - показатели усиленного контроля
//  СоответствиеСостояний - Соответствие - показатель → состояние качества
//  ПоказателиНеПринято - Массив - показатели с не принятым качеством
//  ЛабораторныйАнализ - Соответствие - Лабораторный анализ
//  ДанныеПоказателейПервогоТС - Соответствие, Неопределено - показатель → Структура(Мин, Макс, Базис)
Процедура ОбновитьБлокировкуДляТС(ЗаблокированноеТС, ДокументРегистрации, Показатели, СоответствиеСостояний, 
		ПоказателиНеПринято, ЛабораторныйАнализ, ДанныеПоказателейПервогоТС = Неопределено,
		ТСНеПрошедшиеВходнойКонтроль = Неопределено)

	Для Каждого Показатель Из Показатели Цикл
		СостояниеКачества = СоответствиеСостояний.Получить(Показатель);
		Если СостояниеКачества = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ОбновитьСостояниеБлокировки(
			ЗаблокированноеТС, Показатель, СостояниеКачества, ДокументРегистрации, , Истина);
	КонецЦикла;

	// Сценарий B Качество НЕ ПРИНЯТО создаём показатели для заблокированного ТС
	Если ПоказателиНеПринято.Количество() > 0 Тогда

		НеПрошелВходнойКонтроль = ТСНеПрошедшиеВходнойКонтроль <> Неопределено И ТСНеПрошедшиеВходнойКонтроль.Найти(
			ЗаблокированноеТС) <> Неопределено;

		РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.УстановитьПробыНеТребуютсяДляКомпозитных(
			ЗаблокированноеТС, ПоказателиНеПринято, Перечисления.гкс_ТипыПроб.Композитная,
			Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит);
		
		Если Не НеПрошелВходнойКонтроль Тогда
			РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ДобавитьПоказателиУКДляЗаблокированногоТС(
				ЗаблокированноеТС, ПоказателиНеПринято, ЛабораторныйАнализ.ТочкаМаршрута,
				Перечисления.гкс_ТипыПроб.Единичная,
				Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит, ДанныеПоказателейПервогоТС);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Обновляет состояние блокировки и показатели для одной заблокированной группы ТС
// 
// Параметры:
//  ЗаблокированноеТС - ДокументСсылка.гкс_РегистрацияНаПЛК - заблокированная регистрация
// ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - блокирующая регистрация
//  БлокирующаяГруппаТС Блокирующая группа ТС
//  Показатели - Массив - показатели усиленного контроля
//  СоответствиеСостояний - Соответствие - показатель → состояние качества
// ПоказателиНеПринято - Массив - показатели с не принятым качеством
// ДанныеПоказателейПервогоТС - Соответствие, Неопределено - показатель → Структура(Мин, Макс, Базис)
Процедура ОбновитьБлокировкуГруппаТС(ЗаблокированноеТС, БлокирующаяГруппаТС, Показатели, СоответствиеСостояний,
		ПоказателиНеПринято = Неопределено, ЛабораторныйАнализ = Неопределено, 
		ДанныеПоказателейПервогоТС = Неопределено,
		ТСНеПрошедшиеВходнойКонтроль = Неопределено,
		РазблокироватьРазрешено = Истина)

	Для Каждого Показатель Из Показатели Цикл
		СостояниеКачества = СоответствиеСостояний.Получить(Показатель);
		Если СостояниеКачества = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// GKSTCPLK-2693: качество принято разблокирует только следующую группу;
		// эскалация отказа (не принято / РПП) сохраняет каскад по всем последующим.
		Если СостояниеКачества = Перечисления.гкс_СостоянияКачества.КачествоПринято
			И Не РазблокироватьРазрешено Тогда
			Продолжить;
		КонецЕсли;

		РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ОбновитьСостояниеБлокировки(
			ЗаблокированноеТС, Показатель, СостояниеКачества, , БлокирующаяГруппаТС, Истина);
	КонецЦикла;	
	
	// Сценарий B: Качество НЕ ПРИНЯТО - создаём индивидуальные показатели для заблокированного ТС (копируем с группы)
	Если ПоказателиНеПринято <> Неопределено И ПоказателиНеПринято.Количество() > 0 Тогда
		
		НеПрошелВходнойКонтроль = ТСНеПрошедшиеВходнойКонтроль <> Неопределено
			И ТСНеПрошедшиеВходнойКонтроль.Найти(ЗаблокированноеТС) <> Неопределено;
		
		РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.УстановитьПробыНеТребуютсяДляКомпозитных(
			ЗаблокированноеТС, ПоказателиНеПринято,
			Перечисления.гкс_ТипыПроб.Композитная,
			Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит);

		
		Если Не НеПрошелВходнойКонтроль Тогда
		РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ДобавитьПоказателиУКДляЗаблокированногоТС(
			ЗаблокированноеТС, ПоказателиНеПринято, ЛабораторныйАнализ.ТочкаМаршрута,
			Перечисления.гкс_ТипыПроб.Единичная,
			Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит,
			ДанныеПоказателейПервогоТС);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
// При проведении индивидуального ЛА (ПромежуточныйКомпозит) по заблокированному ТС
// обновляет состояние блокировки на основании результатов анализа.
//
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - регистрация заблокированного ТС
//  ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - текущий индивидуальный ЛА
//
Процедура ОбновитьБлокировкуТекущейРегистрации(ДокументРегистрации, ЛабораторныйАнализ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПоказателиУК.Показатель КАК Показатель,
		|	ПоказателиУК.СостояниеКачества КАК СостояниеКачества
		|ИЗ
		|	РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиУК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК Заблокированные
		|		ПО ПоказателиУК.ДокументРегистрации = Заблокированные.ДокументРегистрации
		|		И ПоказателиУК.Показатель = Заблокированные.Показатель
		|ГДЕ
		|	ПоказателиУК.ДокументРегистрации = &ДокументРегистрации
		|	И НЕ Заблокированные.Разблокировано
		|	И ПоказателиУК.СостояниеКачества = ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.КачествоПринято)
		|	И
		|		ПоказателиУК.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|	И ПоказателиУК.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная)";

	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);

	ТаблицаПоказателей = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаПоказателя Из ТаблицаПоказателей Цикл

		// Обновляем ВСЕ записи блокировки для данной регистрации + показатель
		РегистрыСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ОбновитьСостояниеБлокировки(
			ДокументРегистрации, СтрокаПоказателя.Показатель, СтрокаПоказателя.СостояниеКачества);

	КонецЦикла;

КонецПроцедуры

// Возвращает данные о причине блокировки регистрации для отображения в деталях АРМ Приемки.
// Определяет одну из 4 причин блокировки и ссылку на блокирующий ЛА.
// 
// Параметры:
//  ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - Регистрация для проверки
//  ДокументРегистрацииАнализов - ДокументСсылка.гкс_ЛабораторныйАнализ - Документ регистрации анализов
// 
// Возвращаемое значение:
//  Структура - ЕстьБлокировка (Булево), ТекстПричины (Строка), ЛабораторныйАнализ (ДокументСсылка)
Функция ПолучитьПричинуБлокировкиДляДеталей(ДокументРегистрации) Экспорт

Результат = Новый Структура;
	Результат.Вставить("ЕстьБлокировка", Ложь);
	Результат.Вставить("ТекстПричины", "");
	Результат.Вставить("ЛабораторныйАнализ", Документы.гкс_ЛабораторныйАнализ.ПустаяСсылка());
	
	Пакет1 = 0;
	Пакет2 = 4;
	
	// Пакетный запрос: 2 пакета
	// Пакет 1 Блокировка по "Первое ТС" (причины 1, 2)
	// Пакет 2 Блокировка по "Группа ТС" - промежуточный композит (причины 3, 4)
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросПолучитьПричинуБлокировкиДляДеталей();

	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);

	РезультатыПакета = Запрос.ВыполнитьПакет();
	
	Если НЕ РезультатыПакета[Пакет1].Пустой() Тогда
		Выборка = РезультатыПакета[Пакет1].Выбрать();
		Выборка.Следующий();

		Результат = РезультатБлокировкиПоКачеству(Выборка,
			НСтр("ru = 'Заблокировано: ждём результат по первому ТС'"),
			НСтр("ru = 'Заблокировано: анализ по первому ТС не прошёл,
					|ждём результата проверки на усиленный контроль текущей записи'"));

	ИначеЕсли НЕ РезультатыПакета[Пакет2].Пустой() Тогда
		Выборка = РезультатыПакета[Пакет2].Выбрать();
		Выборка.Следующий();

		Результат = РезультатБлокировкиПоКачеству(Выборка,
			НСтр("ru = 'Заблокировано: ждём результат на промежуточный
					|композит предыдущей группы'"),
			НСтр("ru = 'Заблокировано: не прошёл анализ на промежуточный
					|композит предыдущей группы, ждём результата проверки
					|на усиленный контроль текущей записи'"));

	КонецЕсли;

	Возврат Результат;

		
КонецФункции

// Формирует результат блокировки по состоянию качества.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - Выборка с данными блокировки
//  ТекстОжидания - Строка - Текст причины при ожидании результата анализа
//  ТекстНеПрошёл - Строка - Текст причины при непройденном анализе
//
// Возвращаемое значение:
//  Структура - ЕстьБлокировка (Булево), ТекстПричины (Строка), ЛабораторныйАнализ (ДокументСсылка)
Функция РезультатБлокировкиПоКачеству(Выборка, ТекстОжидания, ТекстНеПрошёл)

	Результат = Новый Структура;
	Результат.Вставить("ЕстьБлокировка", Истина);
	Результат.Вставить("ЛабораторныйАнализ", Выборка.БлокирующийЛабораторныйАнализ);

	Если БлокирующееСостояниеКачества(Выборка) Тогда
		Результат.Вставить("ТекстПричины", ТекстНеПрошёл);
	Иначе
		Результат.Вставить("ТекстПричины", ТекстОжидания);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Блокирующее состояние качества.
// 
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - Выборка
// 
// Возвращаемое значение:
//  Булево - Блокирующее состояние качества
Функция БлокирующееСостояниеКачества(Выборка)
	Возврат ЗначениеЗаполнено(Выборка.БлокирующееСостояниеКачества);
КонецФункции

// Текст запрос получить причину блокировки для деталей.
// 
// Возвращаемое значение:
//  Строка - Текст запрос получить причину блокировки для деталей
Функция ТекстЗапросПолучитьПричинуБлокировкиДляДеталей()
	
	Возврат
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаблокированныеРегистрацииУК.БлокирующаяРегистрация КАК БлокирующаяРегистрация,
		|	ЗаблокированныеРегистрацииУК.БлокирующееСостояниеКачества КАК БлокирующееСостояниеКачества,
		|	ЕСТЬNULL(Сопоставление.ЛабораторныйАнализ, ЗНАЧЕНИЕ(Документ.гкс_ЛабораторныйАнализ.ПустаяСсылка)) КАК
		|		БлокирующийЛабораторныйАнализ
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК ЗаблокированныеРегистрацииУК
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФНПРегистрации
		|		ПО ЗаблокированныеРегистрацииУК.БлокирующаяРегистрация = ФНПРегистрации.ДокументРегистрации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК Сопоставление
		|		ПО ФНПРегистрации.Ссылка = Сопоставление.ФормированиеНомераПробы
		|		И Сопоставление.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.Приемка)
		|ГДЕ
		|	ЗаблокированныеРегистрацииУК.ДокументРегистрации = &ДокументРегистрации
		|	И НЕ ЗаблокированныеРегистрацииУК.Разблокировано
		|	И ЗаблокированныеРегистрацииУК.БлокирующаяРегистрация <> ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ ВТ_РегистрацииНаПЛК
		|ИЗ
		|	РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК ТранспортныеСредстваПоставщика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля КАК
		|			гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля
		|		ПО ТранспортныеСредстваПоставщика.Контрагент = гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.Контрагент
		|		И ТранспортныеСредстваПоставщика.Номенклатура = гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.Номенклатура
		|		И
		|			ТранспортныеСредстваПоставщика.ПроизводственныеСутки = гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ПроизводственныеСутки
		|ГДЕ
		|	ТранспортныеСредстваПоставщика.ДокументРегистрации = &ДокументРегистрации
		|	И гкс_ТранспортныеСредстваПоставщикаУсиленногоКонтроля.ДокументРегистрации <> &ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоставГруппТранспортаПромежуточныйКомпозит.ГруппаТС КАК ГруппаТС,
		|	ПоказателиУКПромежуточныйКомпозит.Показатель КАК Показатель,
		|	ВТ_РегистрацииНаПЛКПромежуточныйКомпозит.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ ВТ_ПоказателиГруппа
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспортаПромежуточныйКомпозит
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК
		|			ПоказателиУКПромежуточныйКомпозит
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛКПромежуточныйКомпозит
		|			ПО ВТ_РегистрацииНаПЛКПромежуточныйКомпозит.ДокументРегистрации = ПоказателиУКПромежуточныйКомпозит.ДокументРегистрации
		|		ПО СоставГруппТранспортаПромежуточныйКомпозит.РегистрацияТранспорта = ПоказателиУКПромежуточныйКомпозит.ДокументРегистрации
		|		И
		|			ПоказателиУКПромежуточныйКомпозит.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|		И ПоказателиУКПромежуточныйКомпозит.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
		|ГДЕ
		|	ВТ_РегистрацииНаПЛКПромежуточныйКомпозит.ДокументРегистрации <> &ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТ_ПоказателиГруппа.ДокументРегистрации, ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)) КАК
		|		ДокументРегистрации,
		|	ЕСТЬNULL(ВТ_ПоказателиГруппа.ГруппаТС, ЗНАЧЕНИЕ(Справочник.гкс_ГруппыТС.ПустаяСсылка)) КАК ГруппаТС,
		|	ЕСТЬNULL(гкс_ПоказателиУсиленногоКонтроляПоРегистрации.СостояниеКачества,
		|		ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.ПустаяСсылка)) КАК СостояниеКачества
		|ПОМЕСТИТЬ ВТ_РегистрацииНаПЛКСостояниеКачества
		|ИЗ
		|	РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказателиГруппа КАК ВТ_ПоказателиГруппа
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК
		|				гкс_ПоказателиУсиленногоКонтроляПоРегистрации
		|			ПО ВТ_ПоказателиГруппа.ДокументРегистрации = гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
		|			И ВТ_ПоказателиГруппа.Показатель = гкс_ПоказателиУсиленногоКонтроляПоРегистрации.Показатель
		|		ПО гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.БлокирующаяГруппаТС = ВТ_ПоказателиГруппа.ГруппаТС
		|		И гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.Показатель = ВТ_ПоказателиГруппа.Показатель
		|ГДЕ
		|	гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.ДокументРегистрации = &ДокументРегистрации
		|	И НЕ гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.Разблокировано
		|	И
		|		гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль.БлокирующаяГруппаТС <> ЗНАЧЕНИЕ(Справочник.гкс_ГруппыТС.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_РегистрацииНаПЛКСостояниеКачества.ГруппаТС КАК БлокирующаяГруппаТС,
		|	ВТ_РегистрацииНаПЛКСостояниеКачества.СостояниеКачества КАК БлокирующееСостояниеКачества,
		|	МАКСИМУМ(ЕСТЬNULL(гкс_СопоставлениеФНПЛабАнализа.ЛабораторныйАнализ,
		|		ЗНАЧЕНИЕ(Документ.гкс_ЛабораторныйАнализ.ПустаяСсылка))) КАК БлокирующийЛабораторныйАнализ
		|ИЗ
		|	ВТ_РегистрацииНаПЛКСостояниеКачества КАК ВТ_РегистрацииНаПЛКСостояниеКачества
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК
		|			гкс_ФормированиеНомераПробыСписокРегистраций
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК гкс_СопоставлениеФНПЛабАнализа
		|			ПО гкс_ФормированиеНомераПробыСписокРегистраций.Ссылка = гкс_СопоставлениеФНПЛабАнализа.ФормированиеНомераПробы
		|			И
		|				гкс_СопоставлениеФНПЛабАнализа.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|		ПО ВТ_РегистрацииНаПЛКСостояниеКачества.ДокументРегистрации = гкс_ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации
		|СГРУППИРОВАТЬ ПО
		|	ВТ_РегистрацииНаПЛКСостояниеКачества.ГруппаТС,
		|	ВТ_РегистрацииНаПЛКСостояниеКачества.СостояниеКачества";
		
КонецФункции

// Возвращает текст запроса для определения заблокированных регистраций усиленного контроля.
// Параметр запроса: &ДокументРегистрации.
// 
// Возвращаемое значение:
//  Строка - текст запроса
Функция ТекстЗапросаЗаблокированныхРегистрацийУК()

	Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ ВТ_ДокументРегистрацииНаПЛК
		|ИЗ
		|	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
		|ГДЕ
		|	ФормированиеНомераПробыСписокРегистраций.Ссылка = &ДокументРегистрации
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РегистрацияНаПЛК.Ссылка
		|ИЗ
		|	Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		|ГДЕ
		|	РегистрацияНаПЛК.Ссылка = &ДокументРегистрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации КАК ДокументРегистрации
		|ПОМЕСТИТЬ ВТ_РегистрацииНаПЛК
		|ИЗ
		|	ВТ_ДокументРегистрацииНаПЛК КАК ВТ_ДокументРегистрацииНаПЛК
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК
		|			ФормированиеНомераПробыСписокРегистраций
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК СопоставлениеФНПЛабАнализа
		|			ПО ФормированиеНомераПробыСписокРегистраций.Ссылка = СопоставлениеФНПЛабАнализа.ФормированиеНомераПробы
		|		ПО ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации = ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации
		|ГДЕ
		|	СопоставлениеФНПЛабАнализа.ЛабораторныйАнализ = &ЛабораторныйАнализ
		|	И ВЫБОР
		|		КОГДА СопоставлениеФНПЛабАнализа.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная)
		|		И
		|			СопоставлениеФНПЛабАнализа.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоставГруппТранспорта.ГруппаТС КАК ТекущаяГруппаТС,
		|	СоставГруппТранспорта.РегистрацияТранспорта КАК РегистрацияТранспорта,
		|	ГруппыТС.Номенклатура КАК Номенклатура,
		|	ГруппыТС.Контрагент КАК Контрагент,
		|	ГруппыТС.ПроизводственныеСутки КАК ПроизводственныеСутки
		|ПОМЕСТИТЬ ВТ_ТекущаяГруппаТС
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.гкс_ГруппыТС КАК ГруппыТС
		|		ПО СоставГруппТранспорта.ГруппаТС = ГруппыТС.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК
		|			ПоказателиУсиленногоКонтроляПоРегистрации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛК
		|			ПО ВТ_РегистрацииНаПЛК.ДокументРегистрации = ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
		|		ПО СоставГруппТранспорта.РегистрацияТранспорта = ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
		|		И
		|			ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|		И ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГруппыТС.ПредыдущаяГруппа КАК ГруппаТС,
		|	ГруппыТС.Номенклатура КАК Номенклатура,
		|	ГруппыТС.Контрагент КАК Контрагент,
		|	ГруппыТС.ПроизводственныеСутки КАК ПроизводственныеСутки
		|ПОМЕСТИТЬ ВТ_ПредыдущаяГруппа
		|ИЗ
		|	РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппТранспорта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.гкс_ГруппыТС КАК ГруппыТС
		|		ПО СоставГруппТранспорта.ГруппаТС = ГруппыТС.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК
		|			ПоказателиУсиленногоКонтроляПоРегистрации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РегистрацииНаПЛК КАК ВТ_РегистрацииНаПЛК
		|			ПО ВТ_РегистрацииНаПЛК.ДокументРегистрации = ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
		|		ПО СоставГруппТранспорта.РегистрацияТранспорта = ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
		|		И
		|			ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
		|		И ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СоставГруппТранспорта.РегистрацияТранспорта КАК РегистрацияТранспорта,
		|	СоставГруппТранспорта.ГруппаТС КАК ГруппаТС
		|ПОМЕСТИТЬ ВТ_СоставПредыдущииГруппы
		|ИЗ
