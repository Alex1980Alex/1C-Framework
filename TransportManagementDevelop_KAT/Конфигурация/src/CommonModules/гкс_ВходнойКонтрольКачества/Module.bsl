Функция ПроверкаЗаполненияУдостоверениеКачества(ТипРегистрации, ВидПеревозки, Номенклатура)
	
	Возврат ТипРегистрации <> Перечисления.гкс_ТипРегистрации.Приемка 
			Или Не Перечисления.гкс_ТипыТранспортныхСредствДоставки.ЭтоЖДПеревозка(ВидПеревозки)
			Или Не ЗначениеЗаполнено(Номенклатура);
КонецФункции

Функция ТекстЗапросаУдостоверенияКачества()
	Возврат 
	"ВЫБРАТЬ
	|	Удостоверение.НомерУдостоверения КАК НомерУдостоверения,
	|	Удостоверение.ДатаУдостоверения КАК ДатаУдостоверения,
	|	Удостоверение.ДатаВыработкиКонец КАК ДатаВыработкиКонец,
	|	Удостоверение.СрокХраненияМесяцев КАК СрокХраненияМесяцев,
	|	Удостоверение.СрокГодности КАК СрокГодности
	|ИЗ
	|	РегистрСведений.гкс_УдостоверенияКачестваПоРегистрацииПЛК КАК Удостоверение
	|ГДЕ
	|	Удостоверение.ДокументРегистрации = &ДокументРегистрации";
КонецФункции

Функция НоменклатураКонтролируетсяУдостоверением(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контроль.Контролируется КАК Контролируется
	|ИЗ
	|	РегистрСведений.гкс_НоменклатураКонтроляУдостоверенияКачества КАК Контроль
	|ГДЕ
	|	Контроль.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Контролируется = Истина;
	
КонецФункции

Функция ТекстЗапросаЛАСоответствуетНормативу()
	
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации КАК ДокументРегистрации
	|ПОМЕСТИТЬ ВТ_ДокументРегистрацииНаПЛК
	|ИЗ
	|	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
	|ГДЕ
	|	ФормированиеНомераПробыСписокРегистраций.Ссылка = &ДокументРегистрации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РегистрацияНаПЛК.Ссылка
	|ИЗ
	|	Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
	|ГДЕ
	|	РегистрацияНаПЛК.Ссылка = &ДокументРегистрации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации КАК ДокументРегистрации,
	|	МИНИМУМ(НЕ КП.ОтклонятьКачество) КАК КачествоПринято
	|ПОМЕСТИТЬ ВТ_ДокументРегистрацииКачествоПринято
	|ИЗ
	|	ВТ_ДокументРегистрацииНаПЛК КАК ВТ_ДокументРегистрацииНаПЛК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ КАК ЛА
	|		ПО ЛА.гкс_ДокументРегистрации = ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации
	|		И ЛА.Ссылка = &ЛабораторныйАнализ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ.КачественныеПоказатели КАК КП
	|		ПО КП.Ссылка = ЛА.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации КАК ДокументРегистрации,
	|	гкс_ПоказателиУсиленногоКонтроляПоРегистрации.Показатель КАК Показатель,
	|	гкс_ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования КАК НазначениеИспользования,
	|	гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы КАК ТипПробы
	|ПОМЕСТИТЬ ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято
	|ИЗ
	|	ВТ_ДокументРегистрацииНаПЛК КАК ВТ_ДокументРегистрацииНаПЛК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК
	|			гкс_ПоказателиУсиленногоКонтроляПоРегистрации
	|		ПО ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации = гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ДокументРегистрации
	|		И
	|			гкс_ПоказателиУсиленногоКонтроляПоРегистрации.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
	|		И гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументРегистрацииКачествоПринято КАК ВТ_ДокументРегистрацииКачествоПринято
	|		ПО ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации = ВТ_ДокументРегистрацииКачествоПринято.ДокументРегистрации
	|ГДЕ
	|	НЕ ВТ_ДокументРегистрацииКачествоПринято.КачествоПринято
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоказателиКомпозитная.ДокументРегистрации КАК ДокументРегистрации,
	|	ПоказателиКомпозитная.Показатель КАК Показатель,
	|	ПоказателиКомпозитная.НазначениеИспользования КАК НазначениеИспользования,
	|	ПоказателиКомпозитная.ТипПробы КАК ТипПробы
	|ПОМЕСТИТЬ ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято
	|ИЗ
	|	ВТ_ДокументРегистрацииНаПЛК КАК ВТ_ДокументРегистрацииНаПЛК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиКомпозитная
	|		ПО ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации = ПоказателиКомпозитная.ДокументРегистрации
	|		И
	|			ПоказателиКомпозитная.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
	|		И ПоказателиКомпозитная.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
	|		И ПоказателиКомпозитная.СостояниеКачества = ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.ПробыНеТребуются)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ПоказателиЕдиничная
	|		ПО ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации = ПоказателиЕдиничная.ДокументРегистрации
	|		И
	|			ПоказателиЕдиничная.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
	|		И ПоказателиЕдиничная.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументРегистрацииКачествоПринято КАК ВТ_ДокументРегистрацииКачествоПринято
	|		ПО ВТ_ДокументРегистрацииНаПЛК.ДокументРегистрации = ВТ_ДокументРегистрацииКачествоПринято.ДокументРегистрации
	|ГДЕ
	|	ЕСТЬNULL(ПоказателиЕдиничная.ДокументРегистрации,
	|		ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)
	|	И ВТ_ДокументРегистрацииКачествоПринято.КачествоПринято
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.ДокументРегистрации КАК ДокументРегистрации,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.Показатель КАК Показатель,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.ТипПробы КАК ТипПробы,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.НазначениеИспользования КАК
	|		НазначениеИспользования
	|ПОМЕСТИТЬ ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит
	|ИЗ
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято КАК
	|		ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.ДокументРегистрации,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.Показатель,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.ТипПробы,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.НазначениеИспользования
	|ИЗ
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято КАК
	|		ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.ДокументРегистрации КАК ДокументРегистрации,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.Показатель КАК Показатель,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.ТипПробы КАК ТипПробы,
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.НазначениеИспользования КАК НазначениеИспользования,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.ДокументРегистрации,
	|			ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЛАКачествоПринято,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.ДокументРегистрации,
	|			ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЛАКачествоНеПринято
	|ИЗ
	|	ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит КАК ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято КАК
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято
	|		ПО ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.ДокументРегистрации = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.ДокументРегистрации
	|		И
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.Показатель = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.Показатель
	|		И
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.ТипПробы = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.ТипПробы
	|		И
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.НазначениеИспользования = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАКачествоПринято.НазначениеИспользования
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято КАК
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято
	|		ПО ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.ДокументРегистрации = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.ДокументРегистрации
	|		И
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.Показатель = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.Показатель
	|		И
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.ТипПробы = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.ТипПробы
	|		И
	|			ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозит.НазначениеИспользования = ВТ_ДокументРегистрацииНаПЛКПромежуточныйКомпозитЛАНеКачествоПринято.НазначениеИспользования";
		
КонецФункции

Функция ТекстЗапросаНастройкиУсиленногоКонтроляДляРегистрации()
	Возврат
	"ВЫБРАТЬ
	|	&ПроизводственныеСутки КАК Дата,
	|	РегистрацияНаПЛК.Номенклатура КАК Номенклатура,
	|	РегистрацияНаПЛК.ВидПеревозки КАК ВидПеревозки,
	|	РегистрацияНаПЛК.Контрагент КАК Контрагент,
	|	РегистрацияНаПЛК.ТочкаМаршрута КАК ТочкаМаршрута
	|ПОМЕСТИТЬ ДанныеРегистрации
	|ИЗ
