Функция СтатусПоСостояниюДокумента(ДанныеПробы, АнализПроведен)
		
	ТипПробы = ДанныеПробы.ТипПробы;
	ЭтоВыполененаПроба = АнализПроведен И СтатусЛабАнализаВыполненВыполняется(ДанныеПробы);
	
	Если ДанныеПробы.ТекущееСостояние = Перечисления.гкс_СостоянияРегистрации.ПринятыПробы Тогда		
		Статус = 1;
				
	ИначеЕсли ТипПробы = Перечисления.гкс_ТипыПроб.Единичная И ЭтоВыполененаПроба Тогда	
		Статус = 2;
					
	ИначеЕсли ТипПробы = Перечисления.гкс_ТипыПроб.Композитная Тогда
		
		Если ЭтоВыполененаПроба Тогда
			Статус = 5;
		Иначе
			Статус = 4;
		КонецЕсли;
		
	Иначе
		Статус  = 0;
	КонецЕсли;
		
	Возврат Статус;
	
КонецФункции

Функция СтатусЛабАнализаВыполненВыполняется(ДанныеПробы)

	Возврат ДанныеПробы.СтатусЛабАнализа = Перечисления.гкс_СтатусыЛабораторногоАнализа.Выполнен
		Или ДанныеПробы.СтатусЛабАнализа = Перечисления.гкс_СтатусыЛабораторногоАнализа.Выполняется;

КонецФункции

