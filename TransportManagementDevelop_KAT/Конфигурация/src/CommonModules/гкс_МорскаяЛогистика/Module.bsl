#Область ПрограммныйИнтерфейс

#Область Проведение

// Формирует параметры для проведения документа по регистрам учетного механизма через общий механизм проведения.
//
// Параметры:
//  Документ - ДокументОбъект - записываемый документ
//  Свойства - ФиксированнаяСтруктура - свойства документа (См. ПроведениеДокументов.СвойстваДокумента).
//
// Возвращаемое значение:
//  Структура - параметры учетного механизма (См. ПроведениеДокументов.ПараметрыУчетногоМеханизма()).
//
Функция ПараметрыДляПроведенияДокумента(Документ, Свойства) Экспорт
	
	Параметры = гкс_ПроведениеДокументов.ПараметрыУчетногоМеханизма();
	
	ТипЗнчДокумента = ТипЗнч(Документ);
	
	// Проведение
	Если Свойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если ТипЗнчДокумента = Тип("ДокументОбъект.гкс_УстановкаНастроекГруппировкиПоЛотам") Тогда
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыСведений.гкс_НастройкиГруппировкиПоЛотам);
		ИначеЕсли ТипЗнчДокумента = Тип("ДокументОбъект.гкс_Фрахт") Тогда
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыСведений.гкс_ПланыРазгрузкиСудов);
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыСведений.гкс_СостоянияФрахта);
		ИначеЕсли ТипЗнчДокумента = Тип("ДокументОбъект.гкс_РабочаяСмена") Тогда
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыСведений.гкс_СостоянияОбработкиСудов);
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыНакопления.гкс_ОбработкаСудов);
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыНакопления.гкс_ВыработкаСмены);
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыСведений.гкс_СостоянияФрахта);
		ИначеЕсли ТипЗнчДокумента = Тип("ДокументОбъект.гкс_ПрибытиеСуднаНаПЛК") Тогда
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыНакопления.гкс_ОбработкаСудов);
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыСведений.гкс_СостоянияФрахта);
			Параметры.ПодчиненныеРегистры.Добавить(
				Метаданные.РегистрыСведений.гкс_ТранспортныеДокументыФрахта);
		КонецЕсли;
		
	КонецЕсли;
	
	Параметры.ЕстьПроизводныеДвижения = Истина;
	
	Возврат Параметры;
	
КонецФункции

// Процедура формирования движений по подчиненным регистрам.
//
// Параметры:
//   ТаблицыДляДвижений - Структура - таблицы данных документа
//   Движения - КоллекцияДвижений - коллекция наборов записей движений документа
//   Отказ - Булево - признак отказа от проведения документа.
//
Процедура ОтразитьДвижения(ТаблицыДляДвижений, Движения, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	гкс_ПроведениеДокументов.ОтразитьДвижения(
		ТаблицыДляДвижений, Движения, "гкс_НастройкиГруппировкиПоЛотам");
	гкс_ПроведениеДокументов.ОтразитьДвижения(
		ТаблицыДляДвижений, Движения, "гкс_ПланыРазгрузкиСудов");
	гкс_ПроведениеДокументов.ОтразитьДвижения(
		ТаблицыДляДвижений, Движения, "гкс_СостоянияОбработкиСудов");
	гкс_ПроведениеДокументов.ОтразитьДвижения(
		ТаблицыДляДвижений, Движения, "гкс_ОбработкаСудов");
	гкс_ПроведениеДокументов.ОтразитьДвижения(
		ТаблицыДляДвижений, Движения, "гкс_ВыработкаСмены");
	гкс_ПроведениеДокументов.ОтразитьДвижения(
		ТаблицыДляДвижений, Движения, "гкс_СостоянияФрахта");
	гкс_ПроведениеДокументов.ОтразитьДвижения(
		ТаблицыДляДвижений, Движения, "гкс_ТранспортныеДокументыФрахта");
	
КонецПроцедуры

