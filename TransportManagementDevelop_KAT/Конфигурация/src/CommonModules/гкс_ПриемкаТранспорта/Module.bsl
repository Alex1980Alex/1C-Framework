// Определяет заявку на перевозку транспортного средства по транспортному документу.
// 
// Параметры:
//  - ТранспортныйДокумент - ДокументСсылка. гкс_ТранспортныйДокумент
//  - Транспорт -  СправочникСсылка.ТранспортныеСредства
//
Функция ЗаявкаНаПеревозкуПоТранспортномуДокументу(ТранспортныйДокумент, Транспорт) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТранспортныйДокументТранспортныеСредства.Заявка КАК Заявка
		|ИЗ
		|	Документ.гкс_ТранспортныйДокумент.ТранспортныеСредства КАК ТранспортныйДокументТранспортныеСредства
		|ГДЕ
		|	ТранспортныйДокументТранспортныеСредства.Ссылка = &Ссылка
		|	И ТранспортныйДокументТранспортныеСредства.ТранспортноеСредство = &ТранспортноеСредство";
	
	Запрос.УстановитьПараметр("Ссылка", ТранспортныйДокумент);
	Запрос.УстановитьПараметр("ТранспортноеСредство", Транспорт);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий(); 
		Результат = ВыборкаДетальныеЗаписи.Заявка;
	Иначе	
		Результат = Документы.гкс_ЗаявкаНаПеревозку.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

// Установить документы регистрации.
// 
// Параметры:
//  СтруктураЗаписи - Структура:
//   * ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
//   * ТранспортныйДокумент - ДокументСсылка.гкс_ТранспортныйДокумент
//   * ТранспортноеСредство - СправочникСсылка.ТранспортныеСредства
//   * ЗаявкаНаПеревозку - ДокументСсылка.гкс_ЗаявкаНаПеревозку 
//
Процедура УстановитьСвязьРегистрацииИТранспортногоДокумента(СтруктураЗаписи) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не(СтруктураЗаписи.Свойство("ЗаявкаНаПеревозку")
		И ЗначениеЗаполнено(СтруктураЗаписи.ЗаявкаНаПеревозку)) Тогда
			
		СтруктураЗаписи.Вставить("ЗаявкаНаПеревозку", ЗаявкаНаПеревозкуПоТранспортномуДокументу(
			СтруктураЗаписи.ТранспортныйДокумент, СтруктураЗаписи.ТранспортноеСредство));	
	КонецЕсли;	
	
	РегистрыСведений.гкс_СвязьРегистрацииИТранспортногоДокумента.ДобавитьЗапись(СтруктураЗаписи);
		
КонецПроцедуры

// Установить документы регистрации.
// 
// Параметры:
//  СтруктураЗаписи - Структура:
//   * ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК
//   * ЗаписьВОчередь - ДокументСсылка.гкс_ЗаписьВОчередьПриемкиПЛК
//
Процедура УстановитьСвязьРегистрацииИЗаписиВОчередь(СтруктураЗаписи) Экспорт
	
