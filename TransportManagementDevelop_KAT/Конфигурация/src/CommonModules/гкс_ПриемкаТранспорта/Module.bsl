//  Число - количество символов для поиска транспортного средства в справочнике
//
Функция КоличествоСимволовДляПоискаПоНомеру() Экспорт
	
	Возврат 6;
	
КонецФункции

// Возвращает строку для подстановки в запрос поиска транспорта по части номера
//
// Параметры:
//  НомерТранспорта - Строка - номер транспорта
//
//  ЧислоСимволов - Число - количество символов для сравнения
// 
// Возвращаемое значение:
//  Строка - строка для подстановки в текст запроса 
//
Функция ПолеПоискаГосНомер(НомерТранспорта, ЧислоСимволов) Экспорт
	
	СоставСтроки = Новый Массив;
	СоставСтроки.Добавить(Лев(НомерТранспорта, ЧислоСимволов));
	СоставСтроки.Добавить("%");
	
	Возврат СтрСоединить(СоставСтроки);
	
КонецФункции

// Разделяет номер тренспортного средства на номер головы и номер прицепа. Применяется для автоперевозки
//
// Параметры:
//  НомерТС - Строка - номер транспорта
// 
// Возвращаемое значение:
//  Структура:
//		*НомерЗерновоза - Строка - номер головы 
//		*НомерПрицепа - Строка - номер прицепа 
//
Функция НомерТранспортногоСредстваВСтруктуру(НомерТС) Экспорт
	
	Результат = Новый Структура("НомерЗерновоза, НомерПрицепа", "", "");
	
	МаксимальнаяДлинаНомераТС = 10;
	Если СтрДлина(НомерТС) <= МаксимальнаяДлинаНомераТС Тогда // одно ТС
		
        Результат.НомерЗерновоза = СтрЗаменить(НомерТС, " ", "");
		
	Иначе
		Прообраз = СтрЗаменить(НомерТС, "\", "/");
		ПозицияРазделителя = СтрНайти(Прообраз, "/");
		Если ПозицияРазделителя = 0 Тогда
			ПозицияРазделителя = СтрНайти(Прообраз, " ");		
		КонецЕсли;
		
		ЧислоСимволов = ПозицияРазделителя - 1;
		Результат.НомерЗерновоза = СтрЗаменить(Лев(Прообраз, ЧислоСимволов), " ", "");
		
		ЧислоСимволов = СтрДлина(Прообраз) - ПозицияРазделителя;
		Результат.НомерПрицепа = СтрЗаменить(Прав(Прообраз, ЧислоСимволов), " ", "");
		
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции

