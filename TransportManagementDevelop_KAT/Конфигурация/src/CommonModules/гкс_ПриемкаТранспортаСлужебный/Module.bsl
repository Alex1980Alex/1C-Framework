КонецФункции

#Область НастройкиНазначенияРазгрузки

Процедура СформироватьЭлементИнформацияНаправленияРазгрузки(Элементы, Родитель, Знач ТекстЭлемента)
	
	ШиринаЭлемента 		= 38;
	ВысотаКорректировка = 3;
	ВысотаЭлемента 		= Цел(СтрДлина(ТекстЭлемента) / ШиринаЭлемента) + ВысотаКорректировка;
	
	Ключ = "Ключ" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	НовыйЭлемент = Элементы.Добавить(
		Ключ + "Надпись", Тип("ДекорацияФормы"), Родитель);
	НовыйЭлемент.Вид		= ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок 	= ТекстЭлемента;
	НовыйЭлемент.Рамка		= РамкиСтиля.РамкаЭлементаУправления;
	НовыйЭлемент.Ширина		= ШиринаЭлемента;
	НовыйЭлемент.Высота		= ВысотаЭлемента;
	НовыйЭлемент.ГоризонтальноеПоложение	= ГоризонтальноеПоложениеЭлемента.Центр;
	НовыйЭлемент.ВертикальноеПоложение		= ВертикальноеПоложениеЭлемента.Центр;
	
КонецПроцедуры

Функция ПредставлениеНаправленияРазгрузкиПоНоменклатуре(НаправленияРазгрузки, Номенклатура)
	
	МассивСтрок	= Новый Массив;
	МассивСтрок.Добавить(
		Новый ФорматированнаяСтрока(Номенклатура + Символы.ПС, ШрифтыСтиля.гкс_ШрифтЗаголовкаНастройкиРазгрузки));
	ДанныеМассива = НаправленияРазгрузки.Получить(Номенклатура); 
	МассивПодстрок = Новый Массив;
	Для Каждого ЭлементМассива Из ДанныеМассива Цикл
		МассивПодстрок.Добавить(СтрШаблон("%1 - %2", ЭлементМассива.Силос, ЭлементМассива.СлужебнаяНоменклатура));
	КонецЦикла;
	
	МассивСтрок.Добавить(СтрСоединить(МассивПодстрок, Символы.ПС));
	
	Возврат Новый ФорматированнаяСтрока(МассивСтрок);
	
КонецФункции

Функция НаправленияРазгрузкиПоВидуПеревозки(ТочкаМаршрута, ВидПеревозки)
	
	НаправленияРазгрузки = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидПеревозки", ВидПеревозки);
	Запрос.УстановитьПараметр("ТочкаМаршрута", ТочкаМаршрута);
	Запрос.Текст = ТекстЗапросаНаправленияРазгрузкиПоВидуПеревозки();
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда

		Выборка	= РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			
			МассивСтрок 		= Новый Массив;
			ВыборкаДетальная 	= Выборка.Выбрать();
			Пока ВыборкаДетальная.Следующий() Цикл
				ДанныеОтображения = Новый Структура("Силос, СлужебнаяНоменклатура");
				ЗаполнитьЗначенияСвойств(ДанныеОтображения, ВыборкаДетальная);
				МассивСтрок.Добавить(ДанныеОтображения);
			КонецЦикла;
			
			НаправленияРазгрузки.Вставить(Выборка.Номенклатура, МассивСтрок);
			
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат НаправленияРазгрузки;
	
КонецФункции

Функция ТекстЗапросаНаправленияРазгрузкиПоВидуПеревозки()
	
	Возврат 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НастройкиНазначенияРазгрузки.Номенклатура КАК Номенклатура,
	|	НастройкиНазначенияРазгрузки.СлужебнаяНоменклатура КАК СлужебнаяНоменклатура,
	|	НастройкиНазначенияРазгрузки.Силос КАК Силос
	|ПОМЕСТИТЬ НастройкиНазначенияРазгрузки
	|ИЗ
	|	РегистрСведений.гкс_НастройкиНазначенияРазгрузки.СрезПоследних(, ТочкаМаршрута = &ТочкаМаршрута
	|	И ВидПеревозки = &ВидПеревозки) КАК НастройкиНазначенияРазгрузки
	|ГДЕ
	|	НастройкиНазначенияРазгрузки.Действует
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиНазначенияРазгрузки.Номенклатура,
	|	НастройкиНазначенияРазгрузки.СлужебнаяНоменклатура,
	|	НастройкиНазначенияРазгрузки.Силос
	|ИЗ
	|	РегистрСведений.гкс_ДополнительныеНастройкиНазначенияРазгрузки.СрезПоследних(, ТочкаМаршрута = &ТочкаМаршрута
	|	И ВидПеревозки = &ВидПеревозки) КАК НастройкиНазначенияРазгрузки
	|ГДЕ
	|	НастройкиНазначенияРазгрузки.Действует
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(НастройкиНазначенияРазгрузки.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(НастройкиНазначенияРазгрузки.СлужебнаяНоменклатура) КАК СлужебнаяНоменклатура,
	|	ПРЕДСТАВЛЕНИЕ(НастройкиНазначенияРазгрузки.Силос) КАК Силос
	|ИЗ
	|	НастройкиНазначенияРазгрузки КАК НастройкиНазначенияРазгрузки
	|ИТОГИ
	|ПО
	|	Номенклатура";
	
КонецФункции

#КонецОбласти

Процедура ЗаполнитьИнформациюОБлокировке(Форма, ДокументРегистрации, ДокументРегистрацииАнализов)
	
	Элементы = Форма.Элементы;
	Если Элементы.Найти("ГруппаИнформацияОБлокировке") = Неопределено 
		Или Не ПолучитьФункциональнуюОпцию("гкс_ИспользоватьЗаблокированныеТС") Тогда
		Возврат;
	КонецЕсли;

	ДанныеБлокировки = гкс_ВходнойКонтрольКачества.ПолучитьПричинуБлокировкиДляДеталей(ДокументРегистрации);

	Если ДанныеБлокировки.ЕстьБлокировка Тогда
		Элементы.ДекорацияТекстПричиныБлокировки.Заголовок = ДанныеБлокировки.ТекстПричины;
		Форма.ЛАБлокировки = ДанныеБлокировки.ЛабораторныйАнализ;
		Элементы.ЛАБлокировкиПоле.Видимость = ЗначениеЗаполнено(Форма.ЛАБлокировки);
		Элементы.ГруппаИнформацияОБлокировке.Видимость = Истина;
	Иначе
		Элементы.ГруппаИнформацияОБлокировке.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьИнформациюОБлокировке(Форма)
	
	Элементы = Форма.Элементы;
	Если Элементы.Найти("ГруппаИнформацияОБлокировке") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы.ГруппаИнформацияОБлокировке.Видимость = Ложь;
	Элементы.ДекорацияТекстПричиныБлокировки.Заголовок = "";
	Форма.ЛАБлокировки = Документы.гкс_ЛабораторныйАнализ.ПустаяСсылка();

КонецПроцедуры

#КонецОбласти