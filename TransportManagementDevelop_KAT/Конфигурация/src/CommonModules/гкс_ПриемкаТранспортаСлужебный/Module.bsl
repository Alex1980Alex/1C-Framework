
#Область СлужебныйПрограммныйИнтерфейс

Процедура ИнициализироватьОтборТочкаМаршрута(Форма) Экспорт
	
	ИспользоватьНесколькоАЛЦ = ПолучитьФункциональнуюОпцию("гкс_ИспользоватьНесколькоАЛЦ");
	Элементы = Форма.Элементы;
	Элементы.ОтборТочкаМаршрута.Доступность = ИспользоватьНесколькоАЛЦ;
	Элементы.ОтборТочкаМаршрута.РежимВыбораИзСписка = ИспользоватьНесколькоАЛЦ;
	
	АЛЦПользователя = Новый Массив;
	Форма.ОтборТочкаМаршрута = 
		гкс_ПриемкаТранспорта.ПЛКизНастроекБазыПользователя(ИспользоватьНесколькоАЛЦ, АЛЦПользователя);
	Если ИспользоватьНесколькоАЛЦ
		И ЗначениеЗаполнено(АЛЦПользователя) Тогда
		
		СписокВыбора = Элементы.ОтборТочкаМаршрута.СписокВыбора;
		СписокВыбора.ЗагрузитьЗначения(АЛЦПользователя);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьСтруктуруДоступов(Форма) Экспорт
	
	Если ЗначениеЗаполнено(Форма.ОтборТочкаМаршрута) И ЗначениеЗаполнено(Форма.ОтборВидПеревозки) Тогда
		Форма.СтруктураДоступов = ПолучитьСтруктуруДоступовНаСервере(Форма, Истина);
	Иначе
		Форма.СтруктураДоступов = ПолучитьСтруктуруДоступовНаСервере(Форма, Ложь);
	КонецЕсли;
		
КонецПроцедуры

Процедура ИнициализироватьРеквизитыПравПользователя(Форма) Экспорт
	
	Форма.ЕстьПравоНаРедактированиеРегистрации 	= ПравоНаРедактированияРегистрации(Форма.СтруктураДоступов);
	Форма.ЕстьПравоНаРедактированиеВзвешивания 	= ЕстьПравоНаРедактирование("гкс_Взвешивание");
	Форма.ЕстьПравоНаРедактированиеНомераПробы 	= ЕстьПравоНаРедактирование("гкс_ФормированиеНомераПробы");
	Форма.ЕстьПравоНаРедактированиеЛабАнализа 	= ЕстьПравоНаРедактирование("гкс_ЛабораторныйАнализ");
	Форма.ЕстьПравоНаРедактированиеНаправленияНаРазгрузку = ЕстьПравоНаРедактирование("гкс_НаправлениеНаРазгрузку");
	Форма.ЕстьПравоНаРедактированиеПриемкаТранспортаБезВходногоКонтроля 
		= ПравоДоступа("Изменение", Метаданные.РегистрыСведений["гкс_ПриемкаТранспортаБезВходногоКонтроля"]);
	
КонецПроцедуры

Процедура ОбновитьНаправленияРазгрузки(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	Пока Элементы.ГруппаНаправленияРазгрузкиЭлементы.ПодчиненныеЭлементы.Количество() > 0 Цикл
		Элементы.Удалить(Элементы.ГруппаНаправленияРазгрузкиЭлементы.ПодчиненныеЭлементы.Получить(0));
	КонецЦикла;
	
	// Новые группы для вывода декораций
	СвойстваГруппы = Новый Структура;
	СвойстваГруппы.Вставить("Вид", ВидГруппыФормы.ОбычнаяГруппа);
    СвойстваГруппы.Вставить("ОтображатьЗаголовок", Ложь);
	СвойстваГруппы.Вставить("Объединенная", Истина);
	СвойстваГруппы.Вставить("Группировка", ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	
	ГруппаНаправленияРазгрузкиЭлементыЛево = Элементы.Добавить(
		"ГруппаНаправленияРазгрузкиЭлементыЛево", Тип("ГруппаФормы"), Элементы.ГруппаНаправленияРазгрузкиЭлементы);
	ЗаполнитьЗначенияСвойств(ГруппаНаправленияРазгрузкиЭлементыЛево, СвойстваГруппы);	
	
	ГруппаНаправленияРазгрузкиЭлементыПраво = Элементы.Добавить(
		"ГруппаНаправленияРазгрузкиЭлементыПраво", Тип("ГруппаФормы"), Элементы.ГруппаНаправленияРазгрузкиЭлементы);
	ЗаполнитьЗначенияСвойств(ГруппаНаправленияРазгрузкиЭлементыПраво, СвойстваГруппы);
	
	// Создание декораций
	ВывестиВЛевуюГруппу = Истина;
	НаправленияРазгрузки = НаправленияРазгрузкиПоВидуПеревозки(Форма.ОтборТочкаМаршрута, Форма.ОтборВидПеревозки);
	Для Каждого КлючЗначение Из НаправленияРазгрузки Цикл
		
		ТекущаяГруппа = ?(ВывестиВЛевуюГруппу, 
			ГруппаНаправленияРазгрузкиЭлементыЛево, ГруппаНаправленияРазгрузкиЭлементыПраво);
		ВывестиВЛевуюГруппу = Не ВывестиВЛевуюГруппу;
		СформироватьЭлементИнформацияНаправленияРазгрузки(Элементы, ТекущаяГруппа,
			ПредставлениеНаправленияРазгрузкиПоНоменклатуре(НаправленияРазгрузки, КлючЗначение.Ключ));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьЗначенияДетальныхЗаписей(Форма) Экспорт
	
	Форма.ВесНетто 			= 0;
	Форма.ВесРазница 		= 0;
	Форма.ВесНаВъезде		= 0;
	Форма.ВесНаВыезде		= 0;
	Форма.ВесПоДокументам	= 0;
	
	Форма.СкладПлан 				= Неопределено;
	Форма.НомерПробы 				= Неопределено;
	Форма.КомментарийРегистрации 	= Неопределено;
	Форма.ДатаРегистрацииАнализов	= Неопределено;
	Форма.ДатаДокументаПоставщика 	= Неопределено;
	Форма.ЗаявкаНаПеревозку 		= Неопределено;
    Форма.ТранспортноеСредство 		= Неопределено;
	Форма.Номенклатура		 		= Неопределено;
	
	ОчиститьИнформациюОБлокировке(Форма);
	
КонецПроцедуры

Процедура УстановитьОтборыСпискаВнешниеПробы(Форма)
	
	// изменить отбор списка внешних проб		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокВнешниеПробы,
		"ВидПеревозки", Форма.ОтборВидПеревозки, ВидСравненияКомпоновкиДанных.Равно);	
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокВнешниеПробы,
		"Номенклатура", Форма.Номенклатура, ВидСравненияКомпоновкиДанных.Равно);
	
	Если ЗначениеЗаполнено(Форма.ЗаявкаНаПеревозку) Тогда
		НомерЗаявки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.ЗаявкаНаПеревозку, "Номер");	
	Иначе
		НомерЗаявки = "";
	КонецЕсли;
	
	Если Форма.ОтборВидПеревозки = Перечисления.гкс_ТипыТранспортныхСредствДоставки.Автомобиль Тогда 
		НомерТС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.ТранспортноеСредство, "НомерТранспортногоСредства");
		НомераАвтоИПрицепа = гкс_ПриемкаТранспорта.НомерТранспортногоСредстваВСтруктуру(НомерТС); 
	
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокВнешниеПробы,
			"НомерЗерновоза", НомераАвтоИПрицепа.НомерЗерновоза, ВидСравненияКомпоновкиДанных.Равно);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокВнешниеПробы,
			"ДатаПогрузки", Форма.ДатаДокументаПоставщика, ВидСравненияКомпоновкиДанных.Равно); 
		
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Форма.СписокВнешниеПробы, 
			"НомерЗаявки");
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Форма.СписокВнешниеПробы, 
			"ТранспортноеСредство");
		
	ИначеЕсли Форма.ОтборВидПеревозки = Перечисления.гкс_ТипыТранспортныхСредствДоставки.ЖДТранспорт Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокВнешниеПробы,
			"ТранспортноеСредство", Форма.ТранспортноеСредство, ВидСравненияКомпоновкиДанных.Равно);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.СписокВнешниеПробы,
			"НомерЗаявки", НомерЗаявки, ВидСравненияКомпоновкиДанных.Равно);  
		
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Форма.СписокВнешниеПробы, 
			"ДатаПогрузки");
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Форма.СписокВнешниеПробы, 
			"НомерЗерновоза");
	КонецЕсли;	
		
КонецПроцедуры

Процедура ТаблицаСписокПоказанийВесаЗаполнить(Форма) Экспорт
	
	Если Форма.ОтборТипРегистрации = Перечисления.гкс_ТипРегистрации.Приемка Тогда
		ВесРазницаБрутто	= Форма.ВесБруттоПоДокументам 	- Форма.ВесНаВъезде;
		ВесРазницаТара		= Форма.ВесТарыПоДокументам 	- Форма.ВесНаВыезде;
	Иначе
		ВесРазницаБрутто	= 0;
		ВесРазницаТара		= 0;
	КонецЕсли;
	
	Форма.ТаблицаСписокПоказанийВеса.Очистить();
	
	НоваяСтрока = Форма.ТаблицаСписокПоказанийВеса.Добавить();
	НоваяСтрока.ВидВеса			= "Брутто";
	НоваяСтрока.ПоДокументам	= Форма.ВесБруттоПоДокументам;
	НоваяСтрока.ПоВзвешиванию	= ?(Форма.ОтборТипРегистрации = Перечисления.гкс_ТипРегистрации.Приемка, 
									Форма.ВесНаВъезде, Форма.ВесНаВыезде);
	НоваяСтрока.РазницаВеса		= ВесРазницаБрутто;
	
	НоваяСтрока = Форма.ТаблицаСписокПоказанийВеса.Добавить();
	НоваяСтрока.ВидВеса			= "Тара";
	НоваяСтрока.ПоДокументам	= Форма.ВесТарыПоДокументам;
	НоваяСтрока.ПоВзвешиванию	= ?(Форма.ОтборТипРегистрации = Перечисления.гкс_ТипРегистрации.Приемка,
									Форма.ВесНаВыезде, Форма.ВесНаВъезде);
	НоваяСтрока.РазницаВеса		= ВесРазницаТара;
	
	НоваяСтрока = Форма.ТаблицаСписокПоказанийВеса.Добавить();
	НоваяСтрока.ВидВеса			= "Нетто";
	НоваяСтрока.ПоДокументам	= Форма.ВесПоДокументам;
	НоваяСтрока.ПоВзвешиванию	= Форма.ВесНетто;
	НоваяСтрока.РазницаВеса 	= Форма.ВесРазница;

КонецПроцедуры

Процедура РедактироватьПриемкуНаСервере(ПараметрыРедактирования, ДокументРегистрации, ДанныеРегистрации) Экспорт
	
	Если ПараметрыРедактирования.АвтоматическоеФормированиеДокументов Тогда
		СформироватьКомплектДокументовПриемкиИЗарегистрироватьУбытиеТранспорта(
			ДокументРегистрации, ДанныеРегистрации);
	Иначе
		ЗарегистрироватьНовоеСостояние(
			ПредопределенноеЗначение("Перечисление.гкс_СостоянияРегистрации.Убыл"), ДокументРегистрации);
	КонецЕсли;
	
	Если Не ЭтоПриемкаТранспорта(ПараметрыРедактирования.ОтборТипРегистрации) Тогда
		ЗаписатьСообщениеОтгрузкаАвтотранспортомВОчередьОповещений(ДокументРегистрации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДетальныеЗаписиРегистрацииНаСервере(Форма, ТекущиеДанные) Экспорт
	
	ИнициализироватьЗначенияДетальныхЗаписей(Форма);
	
	ДокументРегистрации 			= ТекущиеДанные.ДокументРегистрации;
	ДокументРегистрацииАнализов 	= ТекущиеДанные.ДокументРегистрацииАнализов;
	Форма.НомерПробы 				= ТекущиеДанные.НомерПробы;
	Форма.СкладПлан 				= ТекущиеДанные.СкладПлан;
	Форма.КомментарийРегистрации 	= ТекущиеДанные.Комментарий;
	
	Если Форма.ОтборТипРегистрации = Перечисления.гкс_ТипРегистрации.Приемка Тогда
		Форма.ВесНаВъезде	= ТекущиеДанные.ВесБрутто;
		Форма.ВесНаВыезде	= ТекущиеДанные.ВесТары;
		Форма.ВесНетто		= Форма.ВесНаВъезде 			- Форма.ВесНаВыезде;
		Форма.ВесРазница	= Форма.ВесНетто 				- Форма.ВесПоДокументам;
	Иначе	
		Форма.ВесНаВыезде 	= ТекущиеДанные.ВесБрутто;
		Форма.ВесНаВъезде	= ТекущиеДанные.ВесТары;
		Форма.ВесНетто		= Форма.ВесНаВыезде 			- Форма.ВесНаВъезде;
		Форма.ВесРазница	= 0;
	КонецЕсли;
				
	ДанныеДляДетальныхЗаписей = Обработки.гкс_ПриемкаТранспорта
		.ДанныеДляДетальныхЗаписей(ДокументРегистрации, ДокументРегистрацииАнализов);
	
	ЗаполнитьЗначенияСвойств(Форма, ДанныеДляДетальныхЗаписей.ДанныеРегистрации);
	ЗаполнитьЗначенияСвойств(Форма, ДанныеДляДетальныхЗаписей, "ТранспортныйДокумент, ЗаявкаНаПеревозку");
	
	Форма.КачественныеПоказатели.Очистить();
	Форма.КачественныеПоказатели.Загрузить(ДанныеДляДетальныхЗаписей.КачественныеПоказатели);
	
	Если ЗначениеЗаполнено(ДокументРегистрацииАнализов) Тогда
		Форма.ДатаРегистрацииАнализов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументРегистрацииАнализов, "Дата");
	КонецЕсли;
	
	Форма.ВесБруттоПоДокументам = ДанныеДляДетальныхЗаписей.ДанныеРегистрации.ВесБруттоПоДокументам;
	Форма.ВесТарыПоДокументам = ДанныеДляДетальныхЗаписей.ДанныеРегистрации.ВесТарыПоДокументам;
	
	ТаблицаСписокПоказанийВесаЗаполнить(Форма);
	УстановитьОтборыСпискаВнешниеПробы(Форма);
	ЗаполнитьИнформациюОБлокировке(Форма, ДокументРегистрации, ДокументРегистрацииАнализов);
	
КонецПроцедуры

Функция СлужебнаяНоменклатураДляФормированияНаправленияНаРагрузку(ЛабораторныйАнализ) Экспорт
	
	Если ЗначениеЗаполнено(ЛабораторныйАнализ) Тогда
		
		РеквизитыАнализа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ЛабораторныйАнализ, "Дата, гкс_ДокументРегистрации");
		
		Возврат 
			гкс_ПриемкаТранспорта.ПодходящаяСлужебнаяНоменклатураДляФормированияНаправленияНаРагрузку(
				РеквизитыАнализа.Дата, РеквизитыАнализа.гкс_ДокументРегистрации, ЛабораторныйАнализ);
	Иначе
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Только для внутреннего использования
Функция ПолучитьСтруктуруДоступовНаСервере(Форма, НужноЗаполнять)
	
	Если НужноЗаполнять Тогда
		СтруктураДоступов = гкс_ПриемкаНаПЛКСервер.ПолучитьРолиНаПЛК(
			Форма.ОтборТочкаМаршрута, Форма.ОтборВидПеревозки, Форма.Пользователь, Форма.ЭтоПолноправныйПользователь);
	Иначе
		СтруктураДоступов = гкс_ПриемкаНаПЛКСервер.ИнициализироватьСтруктуруДоступовПриемкаПЛК();
	КонецЕсли;

	Возврат СтруктураДоступов;
	
КонецФункции

// Только для внутреннего использования
Функция ПравоНаРедактированияРегистрации(СтруктураДоступов)
	
	Возврат СтруктураДоступов.Свойство("ДоступенРегистрация")
			И СтруктураДоступов.ДоступенРегистрация 
			И ЕстьПравоНаРедактирование("гкс_РегистрацияНаПЛК");
	
КонецФункции

// Только для внутреннего использования
Функция ЕстьПравоНаРедактирование(ИмяОбъекта)
	
	Возврат ПравоДоступа("Добавление", Метаданные.Документы[ИмяОбъекта]);
	
КонецФункции

Процедура СформироватьКомплектДокументовПриемкиИЗарегистрироватьУбытиеТранспорта(ДокументРегистрации, ДанныеРегистрации)
	
	Менеджер = Обработки.гкс_ПриемкаТранспорта;
	Менеджер.СформироватьКомплектДокументовПриемкиИЗарегистрироватьУбытиеТранспорта(
		ДокументРегистрации, ДанныеРегистрации);

КонецПроцедуры

Процедура ЗарегистрироватьНовоеСостояние(НовоеСостояние, ДокументРегистрации, Комментарий = "")
	
	гкс_ПриемкаТранспорта.ЗарегистрироватьНовоеСостояние(ДокументРегистрации, НовоеСостояние, Комментарий);
	
КонецПроцедуры

