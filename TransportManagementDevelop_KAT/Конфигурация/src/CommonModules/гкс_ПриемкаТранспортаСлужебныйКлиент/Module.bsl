
#Область СлужебныйПрограммныйИнтерфейс

Процедура ПодключитьОбработчикОжиданияОбновления(Форма, Подключать = Истина, Однократно = Истина) Экспорт

	Элементы = Форма.Элементы;
	Если Не Элементы.ГруппаОсновная.Видимость Тогда
		Возврат;
	КонецЕсли;
	
	Если Подключать Тогда
		ИнтервалОднократногоВыполнения 	= 0.1;
		ИнтервалМногократногоВыполнения = 7;
		Интервал = ?(Однократно, ИнтервалОднократногоВыполнения, ИнтервалМногократногоВыполнения);
		Форма.ПодключитьОбработчикОжидания("Подключаемый_ОбновитьДанныеНаФорме", Интервал, Однократно);
	Иначе
		Форма.ОтключитьОбработчикОжидания("Подключаемый_ОбновитьДанныеНаФорме");
	КонецЕсли;

КонецПроцедуры

Процедура ОбработчикОжиданияОбновитьФорму(Результат, ДополнительныеПараметры) Экспорт
	
	ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Истина, Истина);
	
КонецПроцедуры

Процедура УстановитьВидимостьДоступностьКомандФормы(Форма) Экспорт

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	
	Элементы.СписокРегистрацииСкопироватьРегистрацию.Видимость = СтруктураДоступов.ДоступенРегистрация;
	
	Элементы.СписокРегистрацииКнопкаДобавить.Видимость = 
		Форма.ЕстьПравоНаРедактированиеРегистрации Или Форма.ЭтоПолноправныйПользователь;
		
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Видимость = 
		СписокРегистрацииОтклонитьРегистрациюАвтоВидимость(СтруктураДоступов);
	
	Элементы.РедактироватьРегистрацию.Видимость =
		СтруктураДоступов.ДоступенРегистрация;
	
	Элементы.РедактироватьВесНаВъезде.Видимость = 
		СтруктураДоступов.ДоступенВзвешиваниеНаВъезде;

	ЭтоПриемкаТранспорта = ЭтоПриемкаТранспорта(Форма.ОтборТипРегистрации);
		
	Элементы.РедактироватьНомерПробы.Видимость = 
		СтруктураДоступов.ДоступенОтборПроб И ЭтоПриемкаТранспорта;
	
	Элементы.КомандаПробыПриняты.Видимость = 
		СтруктураДоступов.ДоступенПринятиеПроб И ЭтоПриемкаТранспорта;
	
	Элементы.РедактироватьАнализ.Видимость = 
		СтруктураДоступов.ДоступенЛабАнализ И ЭтоПриемкаТранспорта;
	
	Элементы.РедактироватьНаправлениеНаРазгрузку.Видимость = 
		СтруктураДоступов.ДоступенДиспетчер И ЭтоПриемкаТранспорта;
		
	Элементы.КомандаОтменитьРазрешение.Видимость = 
		СтруктураДоступов.ДоступенПодтверждениеРазгрузки И ЭтоПриемкаТранспорта;
	
	Элементы.КомандаПодтверждениеРазгрузки.Видимость = 
		СтруктураДоступов.ДоступенПодтверждениеРазгрузки;
	
	Элементы.РедактироватьВесНаВыезде.Видимость =
		СтруктураДоступов.ДоступенВзвешиваниеНаВыезде;
		
	Элементы.РедактированиеПриемка.Видимость = 
		СтруктураДоступов.ДоступенОформлениеПриемки;
			
КонецПроцедуры

Процедура УстановитьОбщиеОтборыСпискаРегистрации(Форма) Экспорт
	
	СписокРегистрации = Форма.СписокРегистрации;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"ТочкаМаршрута", Форма.ОтборТочкаМаршрута, ВидСравненияКомпоновкиДанных.Равно,,
		ЗначениеЗаполнено(Форма.ОтборТочкаМаршрута));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"ВидПеревозки", Форма.ОтборВидПеревозки, ВидСравненияКомпоновкиДанных.Равно,,
		ЗначениеЗаполнено(Форма.ОтборВидПеревозки));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"ТипРегистрации", Форма.ОтборТипРегистрации, ВидСравненияКомпоновкиДанных.Равно,,
		ЗначениеЗаполнено(Форма.ОтборТипРегистрации));
	
	// дополнительные фильтры
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"Номенклатура", Форма.ОтборНоменклатура, ВидСравненияКомпоновкиДанных.Равно,, 
		ЗначениеЗаполнено(Форма.ОтборНоменклатура));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"Состояние", Форма.ОтборСостояние, ВидСравненияКомпоновкиДанных.Равно,, 
		ЗначениеЗаполнено(Форма.ОтборСостояние));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"Контрагент", Форма.ОтборКонтрагент, ВидСравненияКомпоновкиДанных.Равно,, 
		ЗначениеЗаполнено(Форма.ОтборКонтрагент));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"ТранспортноеСредство", Форма.ОтборТранспорт, ВидСравненияКомпоновкиДанных.Равно,, 
		ЗначениеЗаполнено(Форма.ОтборТранспорт));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"ТранспортноеСредство.НомерТранспортногоСредства", Форма.ОтборНомерТС, ВидСравненияКомпоновкиДанных.Содержит,, 
		ЗначениеЗаполнено(Форма.ОтборНомерТС));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"НомерПробы", Форма.ОтборНомерПробы, ВидСравненияКомпоновкиДанных.Равно,, 
		ЗначениеЗаполнено(Форма.ОтборНомерПробы));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"ПунктПогрузки", Форма.ОтборПунктПогрузки, ВидСравненияКомпоновкиДанных.Равно,, 
		ЗначениеЗаполнено(Форма.ОтборПунктПогрузки));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокРегистрации,
		"НомерДокументаПоставщика", Форма.ОтборНомерДокументаПоставщика, ВидСравненияКомпоновкиДанных.Содержит,, 
		ЗначениеЗаполнено(Форма.ОтборНомерДокументаПоставщика));
	
КонецПроцедуры

Процедура ОбработатьИзменениеПометкиДляОднойСтроки(Пометка, РегистрацииВыбранные, РегистрацияНаПЛК) Экспорт
	
	ИндексПозиции = РегистрацииВыбранные.НайтиПоЗначению(РегистрацияНаПЛК);
	Если Пометка Тогда
		
		Если ИндексПозиции = Неопределено Тогда
			РегистрацииВыбранные.Добавить(РегистрацияНаПЛК);
		КонецЕсли;
		
	Иначе
		
		Если ИндексПозиции <> Неопределено Тогда
			РегистрацииВыбранные.Удалить(ИндексПозиции);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Проверяет возможность формирования номера пробы для указанных регистраций.
// Объединяет логику проверки состояний для группового и единичного режимов.
//
// Параметры:
//  ВыбранныеРегистрации - Массив из ДокументСсылка.гкс_РегистрацияНаПЛК - массив ссылок на документы регистрации.
//  РазрешитьВходнойКонтрольДоВзвешивания - Булево - влияет на состав валидных состояний.
//  ВыводитьСообщения    - Булево - выводить сообщения о некорректных состояниях.
//
// Возвращаемое значение:
//  Булево - Истина, если формирование номера пробы разрешено.
//
Функция ПроверитьВозможностьФормированияНомераПробы(
	ВыбранныеРегистрации, РазрешитьВходнойКонтрольДоВзвешивания, ВыводитьСообщения = Истина) Экспорт

	ВалидныеСостояния = гкс_ПриемкаТранспортаКлиентСервер.ВалидныеСостоянияДляФормированияНомераПробы(
		РазрешитьВходнойКонтрольДоВзвешивания);
	Возврат гкс_ПриемкаТранспортаСлужубныйВызовСервера.ПроверитьСостояниеРегистраций(
		ВыбранныеРегистрации, ВалидныеСостояния, ВыводитьСообщения);

КонецФункции

Процедура УстановитьЗаголовкиЭлементовПоТипуРегистрации(Форма, ТипРегистрацииТранспорта) Экспорт
	
	Элементы = Форма.Элементы;
	ЭтоОтгрузка = 
		ТипРегистрацииТранспорта = ПредопределенноеЗначение("Перечисление.гкс_ТипРегистрации.Отгрузка");
	
	Элементы.ОтправительПолучатель.Заголовок = 
		?(ЭтоОтгрузка, НСтр("ru='Грузополучатель'"), НСтр("ru='Грузоотправитель'"));
	Элементы.Организация.Заголовок = 
		?(ЭтоОтгрузка, НСтр("ru='Грузоотправитель'"), НСтр("ru='Грузополучатель'"));
	Элементы.Контрагент.Заголовок = 
		?(ЭтоОтгрузка, НСтр("ru='Покупатель'"), НСтр("ru='Поставщик'"));
	Элементы.РедактироватьНаправлениеНаРазгрузку.Заголовок = 
		?(ЭтоОтгрузка, НСтр("ru='На погрузку'"), НСтр("ru='На разгрузку'"));
	Элементы.КомандаПодтверждениеРазгрузки.Заголовок = 
		?(ЭтоОтгрузка, НСтр("ru='Погрузка'"), НСтр("ru='Разгрузка'"));
	Элементы.РедактированиеПриемка.Заголовок = 
		?(ЭтоОтгрузка, НСтр("ru='Отгрузка'"), НСтр("ru='Приемка'"));
	
	Элементы.ГруппаАнализы.Видимость = Не ЭтоОтгрузка;
	Элементы.ГруппаВнешниеПробы.Видимость = Не ЭтоОтгрузка;
	
КонецПроцедуры

Процедура СкрытьПанельДеталей(Форма) Экспорт

	Форма.РежимПросмотраДетальныхЗаписей = Не Форма.РежимПросмотраДетальныхЗаписей;
	Форма.Элементы.ГруппаДетальнаяИнформация.Видимость = Форма.РежимПросмотраДетальныхЗаписей;
	Если Форма.РежимПросмотраДетальныхЗаписей Тогда
		ИнтервалОбработки = 0.1;
		Форма.ПодключитьОбработчикОжидания(
			"Подключаемый_ОбновитьДетальныеЗаписиРегистрации", ИнтервалОбработки, Истина);
	Иначе
		Форма.ОтключитьОбработчикОжидания("Подключаемый_ОбновитьДетальныеЗаписиРегистрации");
	КонецЕсли;

КонецПроцедуры

Процедура РедактироватьРегистрацию(Форма) Экспорт
		
	ТекущиеДанные = Форма.Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыОткрываемойФормы = Новый Структура;
	ПараметрыОткрываемойФормы.Вставить("ИзАРМа", Истина);
	ПараметрыОткрываемойФормы.Вставить("Ключ", ТекущиеДанные.ДокументРегистрации);
		
	ОткрытьФорму("Документ.гкс_РегистрацияНаПЛК.ФормаОбъекта", 
		ПараметрыОткрываемойФормы, Форма, Форма.УникальныйИдентификатор, , , 
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура РедактироватьВесНаВъезде(Форма) Экспорт

	Элементы = Форма.Элементы;
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументРегистрацииВеса = ТекущиеДанные.ДокументРегистрацииВъезда;
	ДокументРегистрации = ТекущиеДанные.ДокументРегистрации;
	
	РедактироватьВесНаКлиенте(Форма,
		ПредопределенноеЗначение("Перечисление.гкс_ТипыВзвешивания.Въезд"),
		ДокументРегистрации, ДокументРегистрацииВеса, Ложь);
	
КонецПроцедуры

Процедура РедактироватьВесНаВыезде(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументРегистрацииВеса = ТекущиеДанные.ДокументРегистрацииВыезда;
	ДокументРегистрации = ТекущиеДанные.ДокументРегистрации;
	СостояниеКачествоНеПринято = ТекущиеДанные.Состояние = 
		ПредопределенноеЗначение("Перечисление.гкс_СостоянияРегистрации.КачествоНеПринято");
		
	РедактироватьВесНаКлиенте(Форма,
		ПредопределенноеЗначение("Перечисление.гкс_ТипыВзвешивания.Выезд"),
		ДокументРегистрации, ДокументРегистрацииВеса, СостояниеКачествоНеПринято);
		
КонецПроцедуры

Процедура РедактироватьВесНаКлиенте(Форма, ТипВзвешивания, ДокументРегистрации,
	ДокументРегистрацииВеса, КачествоНеПринято = Ложь) Экспорт
	
	ПараметрыФормы = Новый Структура;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ДокументРегистрации", ДокументРегистрации);
	ЗначенияЗаполнения.Вставить("ТипВзвешивания", ТипВзвешивания);
	ЗначенияЗаполнения.Вставить("ТочкаМаршрута", Форма.ОтборТочкаМаршрута);
	
	Если ЗначениеЗаполнено(ДокументРегистрацииВеса) Тогда
		ПараметрыФормы = Новый Структура("Ключ", ДокументРегистрацииВеса);
	Иначе
		ЗначенияЗаполнения.Вставить("КачествоНеПринято", КачествоНеПринято);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ИзАРМа", Истина);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ДополнительныеПараметры.Вставить("ТипВзвешивания", ТипВзвешивания);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"РедактироватьВесНаВыездеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.гкс_Взвешивание.ФормаОбъекта", 
		ПараметрыФормы, Форма, Форма.УникальныйИдентификатор, , , 
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура РедактироватьПриемку(Форма) Экспорт
	
	ТекущиеДанные = Форма.Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено
		Или Не ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации) Тогда
		Возврат;
	КонецЕсли;
	
	Если НеобходимостьВвестиПричинуОтклонения(ТекущиеДанные)Тогда
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ДокументРегистрации", ТекущиеДанные.ДокументРегистрации);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Контекст", Форма);
		ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
			"ПричинаОтклоненияПогрузкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ОткрытьФорму("Обработка.гкс_ПриемкаТранспорта.Форма.ФормаОтклонениеНормПогрузки", 
			ПараметрыОткрытия, Форма, Форма.УникальныйИдентификатор, , , 
			ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	Иначе
		
		ПродолжитьРедактированиеПриемка(Форма, ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КомандаПодтверждениеРазгрузки(Форма) Экспорт
	
	Элементы = Форма.Элементы;	
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если Не (ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации)) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументРегистрации = ТекущиеДанные.ДокументРегистрации;
	
	УИД = Строка(Новый УникальныйИдентификатор());
	ДополнительныеПараметры = Новый Структура("ДокументРегистрации, УИД", ДокументРегистрации, УИД);
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	Если ТекущиеДанные.ТипРегистрации = ПредопределенноеЗначение("Перечисление.гкс_ТипРегистрации.Приемка") Тогда
		
		Если гкс_ПриемкаТранспортаСлужубныйВызовСервера.ДоступноПодтверждениеРазгрузки(ДокументРегистрации) Тогда
			
			ДополнительныеПараметры.Вставить("Состояние", 
				ПредопределенноеЗначение("Перечисление.гкс_СостоянияРегистрации.Выгружен"));
			ТекстВопроса = СтрШаблон(НСтр("ru = 'Подтвердите, что транспорт с номером %1 разгружен'"), 
				ТекущиеДанные.ТранспортноеСредство);
				
		Иначе
			
			ОписаниеОповещения = НовыйОписаниеОповещения(
				"ПриНедоступностиПодтвержденияРазгрузки", ЭтотОбъект, ДополнительныеПараметры);
			ТекстПредупреждения = НСтр("ru = 'Для продолжения необходимо заполнить направление на разгрузку!
									   |Укажите Силос/Яму разгрузки/Служебную номенклатуру и повторите попытку.'");
			ПоказатьПредупреждение(ОписаниеОповещения, ТекстПредупреждения);
			
			Возврат;
			
		КонецЕсли;
		
	Иначе
		ДополнительныеПараметры.Вставить("Состояние",
			ПредопределенноеЗначение("Перечисление.гкс_СостоянияРегистрации.Погружен"));
			
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Подтвердите, что транспорт с номером %1 погружен'"), 
			ТекущиеДанные.ТранспортноеСредство); 
	КонецЕсли;
	
	ОписаниеОповещения = НовыйОписаниеОповещения(
		"ПодверждениеРазгрузки", ЭтотОбъект, ДополнительныеПараметры);

	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура КомандаОтменитьРазрешение(Форма) Экспорт
	
	ТекущиеДанные = Форма.Элементы.СписокРегистрации.ТекущиеДанные;
	Если Не (ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ДокументНаправлениеНаРазгрузку)) Тогда
		Возврат;
	КонецЕсли;	
	
	ОткрытьФормуНаправленияНаРазгрузку(Форма, ТекущиеДанные.ДокументНаправлениеНаРазгрузку);
		
КонецПроцедуры

Процедура СкопироватьРегистрацию(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации) Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Контекст", Форма);
		ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
			"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначениеКопирования", ТекущиеДанные.ДокументРегистрации);
		ПараметрыФормы.Вставить("ИзАРМа", Истина);
		
		ОткрытьФорму("Документ.гкс_РегистрацияНаПЛК.Форма.ФормаДокумента", 
			ПараметрыФормы, Форма, Форма.УникальныйИдентификатор,,, 
			ОписаниеОповещенияОЗакрытии);
		
	КонецЕсли;

КонецПроцедуры

Процедура ОтклонитьРегистрациюАвто(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	ВыделенныеСтроки = Элементы.СписокРегистрации.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивРегистрации = Новый Массив;
	Для Каждого НомерСтроки Из ВыделенныеСтроки Цикл
		
		ТекущиеДанные = Элементы.СписокРегистрации.ДанныеСтроки(НомерСтроки);
		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации) Тогда
			МассивРегистрации.Добавить(Новый Структура("ДокументРегистрации, ТранспортныйДокумент",
				ТекущиеДанные.ДокументРегистрации, ТекущиеДанные.ТранспортныйДокумент));
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивРегистрации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Комментарий = "";
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивРегистрации", МассивРегистрации);
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗавершении = НовыйОписаниеОповещения(
		"ОтклонитьРегистрациюПослеВводаКомментария", ЭтотОбъект, ДополнительныеПараметры);
		
	ТекстЗаголовка = НСтр("ru = 'Прокомментируйте причину отклонения'");
	ПоказатьВводСтроки(ОписаниеОповещенияОЗавершении, Комментарий, ТекстЗаголовка);
	
КонецПроцедуры

Процедура ГрупповаяОбработкаРегистраций(Форма) Экспорт
	
	ОчиститьСообщения();
	
	ПодключитьОбработчикОжиданияОбновления(Форма, Ложь);
	ВыбранныеРегистрации = Форма.РегистрацииВыбранные.ВыгрузитьЗначения();
	Если Не ЗначениеЗаполнено(ВыбранныеРегистрации) Тогда
		ТекстСообщения = НСтр("ru='Необходимо выбрать строки.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ГрупповаяНоменклатура = гкс_ПриемкаТранспортаСлужубныйВызовСервера.НоменклатураРегистраций(
		ВыбранныеРегистрации);
	Если Не ЗначениеЗаполнено(ГрупповаяНоменклатура) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", 		ГрупповаяНоменклатура);
	ПараметрыФормы.Вставить("ВыбранныеРегистрации", ВыбранныеРегистрации);
	
	ОткрытьФорму("Обработка.гкс_ПриемкаТранспорта.Форма.ГрупповоеИзменениеРегистраций",
		ПараметрыФормы, Форма, Форма.УникальныйИдентификатор, , , 
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ПропуститьКонтрольКачества(Форма) Экспорт
	
	ОчиститьСообщения();
	
	ПодключитьОбработчикОжиданияОбновления(Форма, Ложь);
	ВыбранныеРегистрации = Форма.РегистрацииВыбранные.ВыгрузитьЗначения();
	Элементы = Форма.Элементы;
	Если Не ЗначениеЗаполнено(ВыбранныеРегистрации) Тогда
		ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ВыбранныеРегистрации.Добавить(ТекущиеДанные.ДокументРегистрации);
		КонецЕсли;
	КонецЕсли;
	
	// Проверить состояние "Готов к отбору проб"
	ВалидныеСостояния = гкс_ПриемкаТранспортаКлиентСервер.ВалидныеСостоянияДляПропускаКонтроляКачества();
	СостояниеРегистрацийВалидно = гкс_ПриемкаТранспортаСлужубныйВызовСервера.ПроверитьСостояниеРегистраций(
		ВыбранныеРегистрации, ВалидныеСостояния, Истина);
	Если Не СостояниеРегистрацийВалидно Тогда
		ТекстСообщения = НСтр("ru='Невозможно изменить состояние регистраций'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеРегистрации.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Необходимо выбрать строки.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ДополнительныеПараметры.Вставить("ВыбранныеРегистрации", ВыбранныеРегистрации);
	ОписаниеОповещенияОЗавершении = НовыйОписаниеОповещения(
		"ПропуститьКонтрольКачестваПодтверждение", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстВопроса = НСтр("ru = 'Пропустить входной контроль для выбранных регистраций?'");
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	
КонецПроцедуры

Процедура РедактироватьНомерПробы(Форма) Экспорт
	
	ВыбранныеРегистрации = Форма.РегистрацииВыбранные.ВыгрузитьЗначения();
	Если ЗначениеЗаполнено(ВыбранныеРегистрации) Тогда
		ГрупповоеСозданиеНомерПробы(Форма, ВыбранныеРегистрации);
	Иначе
		РедактироватьЕдиничныйНомерПробы(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура РедактироватьНаправлениеНаРазгрузку(Форма) Экспорт

	ОчиститьСообщения();
	
	ВыбранныеРегистрации = Форма.РегистрацииВыбранные.ВыгрузитьЗначения();
	Если ЗначениеЗаполнено(ВыбранныеРегистрации) Тогда
		ГрупповоеНаправлениеНаРазгрузку(Форма, ВыбранныеРегистрации);
	Иначе
		НачатьРедактированиеЕдиничногоНаправленияНаРазгрузку(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуПринятыеТС(Форма) Экспорт
	
	ПараметрыФормы = Новый Структура;
	Если ЭтоАвтоПеревозка(Форма.ОтборВидПеревозки)
		И гкс_ПриемкаТранспортаВызовСервера.ФормироватьКомпозитныйЛабораторныйАнализ() Тогда
		
		ИмяНовойФормы = "Обработка.гкс_ПриемкаТранспорта.Форма.ФормаПринятыеТС_by";
		
		ПараметрыФормы.Вставить("ВидПеревозки", 
			ПредопределенноеЗначение("Перечисление.гкс_ТипРегистрации.Приемка"));
		ПараметрыФормы.Вставить("ТипРегистрации", 
			ПредопределенноеЗначение("Перечисление.гкс_ТипыТранспортныхСредствДоставки.Автомобиль"));
		
	Иначе
		
		ИмяНовойФормы = "Обработка.гкс_ПриемкаТранспорта.Форма.ФормаПринятыеТС";
		ПараметрыФормы.Вставить("ВидПеревозки", Форма.ОтборВидПеревозки);
		ПараметрыФормы.Вставить("ТипРегистрации", Форма.ОтборТипРегистрации);
		
	КонецЕсли;
	
	ОткрытьФорму(ИмяНовойФормы, ПараметрыФормы, Форма, Форма.УникальныйИдентификатор);
	
КонецПроцедуры

Процедура ОткрытьФормуУстановкиНастроекНазначенияРазгрузки(Форма) Экспорт
	
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения("НастройкаЯмРазгрузки_Завершение", Форма);
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ТочкаМаршрута", Форма.ОтборТочкаМаршрута);
	ЗначенияЗаполнения.Вставить("ВидПеревозки", Форма.ОтборВидПеревозки);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ИзАРМа"			, Истина);

	ОткрытьФорму("Документ.гкс_УстановкаНастроекНазначенияРазгрузки.ФормаОбъекта", 
		ПараметрыФормы, Форма, Форма.УникальныйИдентификатор, , ,
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура ОткрытьФормуНовогоДокументаРегистрацияНаПЛК(Форма, ЗначенияЗаполнения) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИзАРМа", 				Истина);
	ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", 	ЗначенияЗаполнения);
	
	Если ЗначенияЗаполнения.Свойство("ТранспортныйДокумент") Тогда
		ПараметрыОткрытия.Вставить("ТранспортныйДокумент", ЗначенияЗаполнения.ТранспортныйДокумент);
	КонецЕсли;
	
	ОткрытьФорму("Документ.гкс_РегистрацияНаПЛК.ФормаОбъекта", 
		ПараметрыОткрытия, Форма, Форма.УникальныйИдентификатор, , ,
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ОткрытьФормуНаправленияНаРазгрузку(Форма, ДокументНаправлениеНаРазгрузку) Экспорт
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Ключ", ДокументНаправлениеНаРазгрузку);
	ПараметрыОткрытия.Вставить("ИзАРМа", Истина);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.гкс_НаправлениеНаРазгрузку.ФормаОбъекта", 
		ПараметрыОткрытия, Форма, Форма.УникальныйИдентификатор, , , 
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура РедактироватьАнализ(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрацииАнализов) Тогда
		ПараметрыОткрытия.Вставить("Ключ", ТекущиеДанные.ДокументРегистрацииАнализов);
		ПараметрыОткрытия.Вставить("ИзАРМа", Истина);
	Иначе
		ДокументРегистрации = ТекущиеДанные.ДокументРегистрации;
		гкс_ПриемкаТранспортаСлужубныйВызовСервера.ДополнитьПараметрыОткрытияЛабАнализа(
			ДокументРегистрации, ПараметрыОткрытия);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.гкс_ЛабораторныйАнализ.ФормаОбъекта", 
		ПараметрыОткрытия, Форма, Форма.УникальныйИдентификатор, , , 
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

Процедура ПодтвердитьПробы(Форма) Экспорт
	
	ВыбранныеРегистрации = Форма.РегистрацииВыбранные.ВыгрузитьЗначения();
	Если ЗначениеЗаполнено(ВыбранныеРегистрации) Тогда
		ГрупповоеПодтверждениеПробы(Форма, ВыбранныеРегистрации);
	Иначе
		НачатьПодтверждениеЕдиничнойПробы(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКомандуПечатиЭтикетки(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеРегистрации = Форма.РегистрацииВыбранные.ВыгрузитьЗначения();
	Если ВыбранныеРегистрации.Количество() = 0 Тогда
		ВыбранныеРегистрации.Добавить(ТекущиеДанные.ДокументРегистрации);
	КонецЕсли;
	
	МассивОбъектов = гкс_ПриемкаТранспортаСлужубныйВызовСервера.ФормированияПробПоРегистрациям(ВыбранныеРегистрации);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДокументРегистрацияНаПЛК", ВыбранныеРегистрации);
	
	АвтоматическаяПечатьЭтикеток = гкс_ОбщегоНазначенияВызовСервера.ЗначениеКонстанты(
		"гкс_АвтоматическаяПечатьЭтикеток");
	
	Если АвтоматическаяПечатьЭтикеток Тогда
		
		ПараметрыПечати.Вставить("АвтоматическаяПечатьЭтикеток", АвтоматическаяПечатьЭтикеток);
		гкс_УправлениеПечатьюКлиент.ПечатьЭтикеткаНаПринтер("Документ.гкс_ФормированиеНомераПробы",
			"ПФ_MXL_Этикетка", МассивОбъектов, ПараметрыПечати);
		
	Иначе
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.гкс_ФормированиеНомераПробы",
			"ПФ_MXL_Этикетка", МассивОбъектов, Форма, ПараметрыПечати);
	КонецЕсли;
	
КонецПроцедуры

Функция ТребуетсяЗаписатьДанныеДляСАРА(Результат) Экспорт
	
	Возврат ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("ЗаписатьДанныеДляСАРА") 
		И Результат.ЗаписатьДанныеДляСАРА;
		
КонецФункции

Процедура ЗаписатьДанныеДляСАРАНаКлиенте(ПараметрыЗаписиДанныхСАРА) Экспорт
	
	Перем СсылкаНаПробу;
	
	Если Не ПараметрыЗаписиДанныхСАРА.Свойство("СсылкаНаСформированнуюПробу", СсылкаНаПробу) Тогда
		Возврат;
	КонецЕсли;
	
	гкс_ИнтеграцияСАРАКлиент.СформироватьФайлДляСАРА(СсылкаНаПробу);

КонецПроцедуры

Процедура УстановитьДоступностьКнопокУправленияПоУмолчанию(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	Элементы.РедактироватьРегистрацию.Доступность 				= Ложь;
	Элементы.КомандаПробыПриняты.Доступность 					= Ложь;
	Элементы.РедактироватьНаправлениеНаРазгрузку.Доступность 	= Ложь;
	Элементы.КомандаПодтверждениеРазгрузки.Доступность 			= Ложь;
	Элементы.РедактироватьАнализ.Доступность 					= Ложь;
	Элементы.РедактироватьВесНаВъезде.Доступность 				= Ложь;
	Элементы.РедактироватьНомерПробы.Доступность 				= Ложь;
	Элементы.РедактироватьВесНаВыезде.Доступность 				= Ложь;
	Элементы.РедактированиеПриемка.Доступность 					= Ложь;
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = Ложь;
	Элементы.КомандаОтменитьРазрешение.Доступность 				= Ложь; 
	Элементы.СписокРегистрацииПечатьЭтикетки.Доступность 		= Истина;
	
КонецПроцедуры

Функция ДанныеРегистрацииДляФормированияКомплектаДокументов(ВходящиеДанныеРегистрации) Экспорт
	
	ДанныеРегистрации = Новый Структура;

	ДанныеРегистрации.Вставить("ЛабораторныйАнализ", ВходящиеДанныеРегистрации.ДокументРегистрацииАнализов);
	
	ДанныеРегистрации.Вставить("ВесНеттоФакт",	ВходящиеДанныеРегистрации.ВесНетто);
	ДанныеРегистрации.Вставить("ВесНетто", 		ВходящиеДанныеРегистрации.ВесНеттоДокумент);
	
	ДанныеРегистрации.Вставить("ВесБруттоФакт", ВходящиеДанныеРегистрации.ВесБрутто);
	ДанныеРегистрации.Вставить("ВесБрутто", 	ВходящиеДанныеРегистрации.ВесБруттоДокумент);
	
	ДанныеРегистрации.Вставить("ВесТарыФакт", 	ВходящиеДанныеРегистрации.ВесТары);
	ДанныеРегистрации.Вставить("ВесТары", 		ВходящиеДанныеРегистрации.ВесТарыДокумент);
	
	ДанныеРегистрации.Вставить("ПунктРазгрузки", ВходящиеДанныеРегистрации.СкладПлан);

	Возврат ДанныеРегистрации;
	
КонецФункции

Функция НеобходимостьВвестиПричинуОтклонения(ТекущиеДанные) Экспорт

	ЕстьКомментарийОтклоненияПогрузки = 
		гкс_ПриемкаТранспортаСлужубныйВызовСервера.ЕстьКомментарийОтклоненияПогрузки(ТекущиеДанные.ДокументРегистрации);
	Возврат
		ТекущиеДанные.Свойство("ЕстьОтклонениеПоВремени")
		И ТекущиеДанные.ЕстьОтклонениеПоВремени
		И Не ЕстьКомментарийОтклоненияПогрузки;
	
КонецФункции

Процедура ОбновитьКнопки(Форма, ТекущиеДанные) Экспорт
	
	ТекущееСостояние = ТекущиеДанные.Состояние;
	Если гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюПрибыл(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияПрибыл(Форма);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюГотовКОтборуПроб(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияГотовКОтборуПроб(Форма);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюВзвешенБрутто(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияВзвешенБрутто(Форма, ТекущиеДанные);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюВзятыПробы(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияВзятыПробы(Форма, ТекущиеДанные);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюПринятыПробы(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияПринятыПробы(Форма);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюРезультатыПробПолучены(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияРезультатыПробПолучены(Форма);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюКачествоНеПринято(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияКачествоНеПринято(Форма, ТекущиеДанные);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюКачествоПринято(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияКачествоПринято(Форма, ТекущиеДанные);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюВыгрузкаПогрузкаРазрешена(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияВыгрузкаПогрузкаРазрешена(Форма);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюВыгруженПогружен(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияВыгруженПогружен(Форма);
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюНеПринято(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияНеПринято(Форма, ТекущиеДанные);	
		
	ИначеЕсли гкс_ПриемкаТранспортаКлиентСервер.СоотвествуетСостояниюВзвешенТара(ТекущееСостояние) Тогда
		ОбновитьДоступностьКомандУправленияДляСостоянияВзвешенТара(Форма, ТекущиеДанные);
	
	Иначе
		Возврат; // Исправление замечаний SonarQube 
	КонецЕсли;
	
КонецПроцедуры

Функция ЗначенияЗаполненияРегистрацииНаПЛК(Форма) Экспорт
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ТочкаМаршрута", 	Форма.ОтборТочкаМаршрута);
	ЗначенияЗаполнения.Вставить("ТипРегистрации", 	Форма.ОтборТипРегистрации);
	ЗначенияЗаполнения.Вставить("ВидПеревозки", 	Форма.ОтборВидПеревозки);
	ЗначенияЗаполнения.Вставить("Внутригрупповой", 	Истина);
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

// Открывает форму записи регистра «Удостоверения качества по регистрации ПЛК»
// для текущего документа открытой формы Регистрации на ПЛК.
//
// Параметры:
//  Форма                - ФормаКлиентскогоПриложения - форма документа Регистрация на ПЛК.
//  ОповещениеОЗакрытии  - ОписаниеОповещения - вызывается после закрытия формы записи (опционально).
//
Процедура ОткрытьФормуУдостоверения(Форма, ОповещениеОЗакрытии = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Сначала запишите документ, затем вносите данные удостоверения качества.'"));
		Возврат;
	КонецЕсли;
	
	Отбор              = Новый Структура("ДокументРегистрации", Форма.Объект.Ссылка);
	ЗначенияЗаполнения = Новый Структура("ДокументРегистрации", Форма.Объект.Ссылка);
	
	ОбменДаннымиКлиент.ОткрытьФормуЗаписиРегистраСведенийПоОтбору(
		Отбор,
		ЗначенияЗаполнения,
		"гкс_УдостоверенияКачестваПоРегистрацииПЛК",
		Форма,
		,
		,
		ОповещениеОЗакрытии);
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОписаниеОповещения(ИмяПроцедуры, Модуль, ДополнительныеПараметры = Неопределено)
	Возврат Новый ОписаниеОповещения(ИмяПроцедуры, Модуль, ДополнительныеПараметры);
КонецФункции

#Область ОбратныеВызовы

Процедура ПодверждениеПробыПриняты(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		гкс_ПриемкаТранспортаСлужубныйВызовСервера.ЗарегистрироватьНовоеСостояние(
			ПредопределенноеЗначение("Перечисление.гкс_СостоянияРегистрации.ПринятыПробы"),
			ДополнительныеПараметры.ДокументРегистрации);
		
		ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Истина, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПробыПринятыГрупповаяОбработкаПодверждение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Ложь);
		
		ДлительнаяОперация = гкс_ПриемкаТранспортаСлужубныйВызовСервера.ВыполнитьПробыПринятыНаСервере(
			ДополнительныеПараметры.ВыбранныеРегистрации);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ДополнительныеПараметры.Контекст);
		ПараметрыОжидания.Вставить("ВыводитьСообщения", Истина);
		
		ОписаниеОповещения = НовыйОписаниеОповещения(
			"ПробыПринятыГрупповаяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПробыПринятыГрупповаяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ТекстСообщения = НСтр("ru = 'Обработка документов завершена'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Произошла ошибка установки отметки принятия проб %1 %2'"), 
			Символы.ПС, Результат.КраткоеПредставлениеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	Иначе // Выполняется/Отменено 
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Истина, Истина);
	
КонецПроцедуры

Процедура ПодверждениеРазгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		гкс_ПриемкаТранспортаСлужубныйВызовСервера.ЗарегистрироватьНовоеСостояние(
			ДополнительныеПараметры.Состояние, 
			ДополнительныеПараметры.ДокументРегистрации);
		
		ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Истина, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РедактироватьВесНаВыездеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Контекст;
	ПодключитьОбработчикОжиданияОбновления(Форма, Истина, Истина);
	ТипВзвешивания = ДополнительныеПараметры.ТипВзвешивания;
	Если Не ЭтоЖДПеревозка(Форма.ОтборВидПеревозки)
		Или Не ТипВзвешивания = ПредопределенноеЗначение("Перечисление.гкс_ТипыВзвешивания.Выезд") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Форма.Элементы.СписокРегистрации.ТекущиеДанные;
	Если Не ТекущиеДанные = Неопределено
		И ВозможноАвтоЗавершениеПроцесса(Форма.ОтборТипРегистрации, ТекущиеДанные.Состояние) Тогда
		РедактироватьПриемку(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПричинаОтклоненияПогрузкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Контекст;
	ТекущиеДанные = Форма.Элементы.СписокРегистрации.ТекущиеДанные;
	Если Не ЭтоАвтоПеревозка(Форма.ОтборВидПеревозки)
		Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьКомментарийОтклоненияПогрузки = 
		гкс_ПриемкаТранспортаСлужубныйВызовСервера.ЕстьКомментарийОтклоненияПогрузки(ТекущиеДанные.ДокументРегистрации);
	Если ТекущиеДанные.ЕстьОтклонениеПоВремени
		И ЕстьКомментарийОтклоненияПогрузки Тогда
		
		ПродолжитьРедактированиеПриемка(Форма, ТекущиеДанные);
		
	КонецЕсли;

КонецПроцедуры

Процедура ПродолжитьРедактированиеПриемка(Форма, ТекущиеДанные)
	
	ИдентификаторЗамера = ОценкаПроизводительностиКлиент.ЗамерВремени(
		"ПриемкаТранспорта.ФормированиеКомплектаДокументовНаКлиенте", Истина);
	
	ДанныеРегистрации = ДанныеРегистрацииДляФормированияКомплектаДокументов(ТекущиеДанные);
	ПараметрыРедактирования = Новый Структура;
	ПараметрыРедактирования.Вставить(
		"АвтоматическоеФормированиеДокументов", Форма.АвтоматическоеФормированиеДокументов);
	ПараметрыРедактирования.Вставить(
		"ОтборТипРегистрации", Форма.ОтборТипРегистрации);
	гкс_ПриемкаТранспортаСлужубныйВызовСервера.РедактироватьПриемкуНаСервере(
		ПараметрыРедактирования, ТекущиеДанные.ДокументРегистрации, ДанныеРегистрации);
	
	ОценкаПроизводительностиКлиент.ЗавершитьЗамерВремени(ИдентификаторЗамера, Ложь);
	
	ПодключитьОбработчикОжиданияОбновления(Форма, Истина, Истина);
	
КонецПроцедуры

Процедура СозданиеНомеровПробГрупповаяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Контекст;
	Если Результат.Статус = "Выполнено" Тогда
		
		ТекстСообщения = НСтр("ru = 'Обработка документов завершена'");	
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
		АвтоматическаяПечатьЭтикеток = гкс_ОбщегоНазначенияВызовСервера.
			ЗначениеКонстанты("гкс_АвтоматическаяПечатьЭтикеток");
		
		Если АвтоматическаяПечатьЭтикеток Тогда 
			ВыполнитьКомандуПечатиЭтикетки(Форма);
		КонецЕсли;
	
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Произошла ошибка формирования номеров проб %1 %2'"),
			Символы.ПС, Результат.КраткоеПредставлениеОшибки);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	Иначе // Выполняется/Отменено 
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжиданияОбновления(Форма, Истина, Истина);
	
КонецПроцедуры

Процедура ПодтверждениеСозданияНаправленияНаРазгрузку(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ОткрытьФормуНаправленияНаРазгрузкуДляРегистрации(ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры

Процедура ОткрытьФормуНаправленияНаРазгрузкуДляРегистрации(ДополнительныеПараметры)

	Форма = ДополнительныеПараметры.Контекст;
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	НаправлениеНаРазгрузкуСсылка = гкс_ПриемкаТранспортаСлужубныйВызовСервера.НаправлениеНаРазгрузкуПоРегистрации(
		ТекущиеДанные.ДокументРегистрации);

	ПараметрыОткрытия = Новый Структура;

	Если Не ЗначениеЗаполнено(НаправлениеНаРазгрузкуСсылка) Тогда
		ЗначенияЗаполнения = СтруктураЗаполненияДанныхНаправлениеНаРазгрузку(Форма, ТекущиеДанные);
		ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	Иначе
		ПараметрыОткрытия.Вставить("Ключ", НаправлениеНаРазгрузкуСсылка);
		ПараметрыОткрытия.Вставить("ИзАРМа", Истина);
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);

	ОткрытьФорму("Документ.гкс_НаправлениеНаРазгрузку.ФормаОбъекта", 
		ПараметрыОткрытия, Форма, Форма.УникальныйИдентификатор, , ,
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура ПропуститьКонтрольКачестваПодтверждение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Форма = ДополнительныеПараметры.Контекст;
		ПодключитьОбработчикОжиданияОбновления(Форма, Ложь);
		
		ДлительнаяОперация = гкс_ПриемкаТранспортаСлужубныйВызовСервера.ВыполнитьПропускКонтроляКачестваНаСервере(
			ДополнительныеПараметры.ВыбранныеРегистрации);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
		ПараметрыОжидания.Вставить("ВыводитьСообщения", Истина);
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПропуститьКонтрольКачестваЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПропуститьКонтрольКачестваЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ТекстСообщения = НСтр("ru = 'Обработка документов завершена'");	
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Произошла ошибка пропуска контроля качества %1 %2'"), 
			Символы.ПС, Результат.КраткоеПредставлениеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	Иначе // Выполняется/Отменено 
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Истина, Истина);
	
КонецПроцедуры

#КонецОбласти

Функция СтруктураЗаполненияДанныхНаправлениеНаРазгрузку(Форма, ТекущиеДанные)

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Дата", 				ОбщегоНазначенияКлиент.ДатаСеанса());	
	ЗначенияЗаполнения.Вставить("ДокументРегистрации", 	ТекущиеДанные.ДокументРегистрации);
	ЗначенияЗаполнения.Вставить("ТочкаМаршрута", 		ТекущиеДанные.ТочкаМаршрута);
	ЗначенияЗаполнения.Вставить("ПервичныйСтатус", 		ТекущиеДанные.Состояние);
	
	// Определение силоса и ямы разгрузки 
	Если Форма.ОтборТипРегистрации = ПредопределенноеЗначение("Перечисление.гкс_ТипРегистрации.Приемка") Тогда
		
		ПропуститьИнициализациюМестаРазгрузки = 
			гкс_ПриемкаТранспортаВызовСервера.ПропуститьИнициализациюМестаРазгрузки(Форма.ОтборВидПеревозки);
		СостоянияПриемки = гкс_ПриемкаТранспортаКлиентСервер.ВалидныеСостоянияДляРазгрузки();
		Если СостоянияПриемки.Найти(ТекущиеДанные.Состояние) <> Неопределено 
			И Не ПропуститьИнициализациюМестаРазгрузки Тогда
			ЗначенияЗаполнения.Вставить("Склад", 		ТекущиеДанные.СкладПлан);
			ЗначенияЗаполнения.Вставить("ЯмаРазгрузки", ТекущиеДанные.ЯмаРазгрузки);
		КонецЕсли;
			
		СлужебнаяНоменклатура = 
			гкс_ПриемкаТранспортаСлужубныйВызовСервера.СлужебнаяНоменклатураДляФормированияНаправленияНаРагрузку(
				ТекущиеДанные.ДокументРегистрацииАнализов);
			
		Если ЗначениеЗаполнено(СлужебнаяНоменклатура) Тогда
			
			Если ПропуститьИнициализациюМестаРазгрузки Тогда
				ЗначенияЗаполнения.Вставить("СлужебнаяНоменклатура", 	СлужебнаяНоменклатура);
			Иначе
				
				ЯмаСилосРазгрузки = гкс_ПриемкаТранспортаВызовСервера.ЯмаСилосРазгрузки(
					ТекущиеДанные.ТочкаМаршрута, 
					Форма.ОтборВидПеревозки, 
					ТекущиеДанные.Номенклатура, 
					СлужебнаяНоменклатура);
					
				Если ЗначениеЗаполнено(ЯмаСилосРазгрузки) Тогда	
					ЗначенияЗаполнения.Вставить("Склад", 					ЯмаСилосРазгрузки.Силос);
					ЗначенияЗаполнения.Вставить("ЯмаРазгрузки", 			ЯмаСилосРазгрузки.ЯмаРазгрузки);
					ЗначенияЗаполнения.Вставить("СлужебнаяНоменклатура", 	СлужебнаяНоменклатура);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

Процедура РедактироватьЕдиничныйНомерПробы(Форма)
	
	Элементы = Форма.Элементы;
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ИзАРМа", Истина);
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументФормированиеНомераПробы) Тогда
		ПараметрыОткрытияФормы.Вставить("Ключ", ТекущиеДанные.ДокументФормированиеНомераПробы);
	Иначе
		
		ВыбранныеРегистрацииДляПроверки = Новый Массив;
		ВыбранныеРегистрацииДляПроверки.Добавить(ТекущиеДанные.ДокументРегистрации);
		ВозможноФормированиеНомераПробы = 
			ПроверитьВозможностьФормированияНомераПробы(ВыбранныеРегистрацииДляПроверки, 
			Форма.РазрешитьВходнойКонтрольДоВзвешивания); 
		Если Не ВозможноФормированиеНомераПробы Тогда
			ТекстСообщения = НСтр("ru = 'Невозможно создать документ формирования номера пробы. 
				|Регистрация находится в некорректном состоянии.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ТочкаМаршрута", Форма.ОтборТочкаМаршрута);
		ЗначенияЗаполнения.Вставить("ДокументРегистрации", ТекущиеДанные.ДокументРегистрации);
		ЗначенияЗаполнения.Вставить("ТипПробы", ПредопределенноеЗначение("Перечисление.гкс_ТипыПроб.Единичная"));
		
		ПараметрыОткрытияФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"РедактироватьНомерПробыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.гкс_ФормированиеНомераПробы.ФормаОбъекта", 
		ПараметрыОткрытияФормы, Форма, Форма.УникальныйИдентификатор, , , 
		ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура РедактироватьНомерПробыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	//@skip-warning
	Если ТребуетсяЗаписатьДанныеДляСАРА(Результат) Тогда
		ЗаписатьДанныеДляСАРАНаКлиенте(Результат);
	КонецЕсли;
	
	ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Истина, Истина);

КонецПроцедуры

Процедура ГрупповоеСозданиеНомерПробы(Форма, ВыбранныеРегистрации)
	
	ОчиститьСообщения();

	// Проверить состояния
	ВозможноФормированиеНомераПробы = ПроверитьВозможностьФормированияНомераПробы(
		ВыбранныеРегистрации, Форма.РазрешитьВходнойКонтрольДоВзвешивания);
	Если Не ВозможноФормированиеНомераПробы Тогда
		ТекстСообщения = НСтр("ru='Невозможно сделать групповое формирование номеров проб'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжиданияОбновления(Форма, Ложь);
	
	ДлительнаяОперация = 
		гкс_ПриемкаТранспортаСлужубныйВызовСервера.ВыполнитьСозданиеНомеровПробНаСервере(
			ВыбранныеРегистрации, Форма.ОтборТочкаМаршрута);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
	ПараметрыОжидания.Вставить("ВыводитьСообщения", Истина);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещения = НовыйОписаниеОповещения(
		"СозданиеНомеровПробГрупповаяЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

Процедура НачатьПодтверждениеЕдиничнойПробы(Форма)

	Элементы = Форма.Элементы;
	ТекущиеДанные = Элементы.СписокРегистрации.ТекущиеДанные;
	Если Не (ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.НомерПробы) Тогда
		
		ДополнительныеПараметры = гкс_ПриемкаТранспортаКлиентСервер.ДополнительныеПараметрыДляПробыПриняты(
			ТекущиеДанные.ДокументРегистрации);
		Если ДополнительныеПараметры <> Неопределено Тогда
			
			ДополнительныеПараметры.Вставить("Контекст", Форма);
			ОписаниеОповещенияОЗавершении = НовыйОписаниеОповещения(
				"ПодверждениеПробыПриняты", ЭтотОбъект, ДополнительныеПараметры);
			
			ТекстВопроса = СтрШаблон(
				НСтр("ru = 'Подтвердите, что проба с номером %1 принята'"), 
				ТекущиеДанные.НомерПробы);
			
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ГрупповоеПодтверждениеПробы(Форма, ВыбранныеРегистрации)
	
	ОчиститьСообщения();
	
	// Проверить состояние "Взяты пробы"
	ВалидныеСостояния = гкс_ПриемкаТранспортаКлиентСервер.ВалидныеСостоянияДляПодтвержденияПробы();
	СостояниеРегистрацийВалидно = гкс_ПриемкаТранспортаСлужубныйВызовСервера.ПроверитьСостояниеРегистраций(
		ВыбранныеРегистрации, ВалидныеСостояния, Истина);
	Если Не СостояниеРегистрацийВалидно Тогда
		ТекстСообщения = НСтр("ru='Невозможно изменить состояние регистраций'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ВыбранныеРегистрации", ВыбранныеРегистрации);
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗавершении = НовыйОписаниеОповещения(
		"ПробыПринятыГрупповаяОбработкаПодверждение", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстВопроса = НСтр("ru = 'Подтвердите, что все выбранные пробы будут приняты'");
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Функция НаправлятьНаРазгрузкуРазрешение(Регистрация)
	
	Возврат гкс_ПриемкаТранспортаСлужубныйВызовСервера.НаправлятьНаРазгрузкуРазрешение(Регистрация);
	
КонецФункции

Процедура ПриНедоступностиПодтвержденияРазгрузки(ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Контекст;
	НаправлениеНаРазгрузку = гкс_ПриемкаТранспортаСлужубныйВызовСервера.НаправлениеНаРазгрузкуПоРегистрации(
		ДополнительныеПараметры.ДокументРегистрации);
	ОткрытьФормуНаправленияНаРазгрузку(Форма, НаправлениеНаРазгрузку);
	
КонецПроцедуры

Процедура ГрупповоеНаправлениеНаРазгрузку(Форма, ВыбранныеРегистрации)
	
	ОчиститьСообщения();
	
	// Проверить состояния
	ВалидныеСостояния = гкс_ПриемкаТранспортаКлиентСервер.ВалидныеСостоянияДляГрупповоеНаправлениеНаРазгрузку();
	СостояниеРегистрацийВалидно = гкс_ПриемкаТранспортаСлужубныйВызовСервера.ПроверитьСостояниеРегистраций(
		ВыбранныеРегистрации, ВалидныеСостояния, Истина);
	Если Не (СостояниеРегистрацийВалидно
		И гкс_ПриемкаТранспортаСлужубныйВызовСервера.КонтрольПрохожденияНеобходимыхСтатусов(ВыбранныеРегистрации)) Тогда
		ТекстСообщения = НСтр("ru='Невозможно сделать групповое направление на разгрузку'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ГрупповаяНоменклатура = гкс_ПриемкаТранспортаСлужубныйВызовСервера.НоменклатураРегистраций(ВыбранныеРегистрации);
	Если Не ЗначениеЗаполнено(ГрупповаяНоменклатура) Тогда
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжиданияОбновления(Форма, Ложь);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ВыбранныеРегистрации", ВыбранныеРегистрации);
	ПараметрыОткрытияФормы.Вставить("Номенклатура", ГрупповаяНоменклатура);
	ПараметрыОткрытияФормы.Вставить("ТочкаМаршрута", Форма.ОтборТочкаМаршрута);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	ОписаниеОповещенияОЗакрытии = НовыйОписаниеОповещения(
		"ОбработчикОжиданияОбновитьФорму", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Обработка.гкс_ПриемкаТранспорта.Форма.ГрупповоеНаправлениеНаРазгрузку",
		ПараметрыОткрытияФормы, Форма, , , , ОписаниеОповещенияОЗакрытии,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура НачатьРедактированиеЕдиничногоНаправленияНаРазгрузку(Форма)
	
	ТекущиеДанные = Форма.Элементы.СписокРегистрации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);
	ДополнительныеПараметры.Вставить("Контекст", Форма);
	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументНаправлениеНаРазгрузку) Тогда
		ОткрытьФормуНаправленияНаРазгрузкуДляРегистрации(ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	РезультатБлокировки = гкс_ПриемкаТранспортаВызовСервера
		.ПроверитьБлокировкуДляСозданияНнР(ТекущиеДанные.ДокументРегистрации);
	СостояниеКачества = ПредопределенноеЗначение("Перечисление.гкс_СостоянияКачества.ПустаяСсылка");
	Если РезультатБлокировки.ЕстьБлокировка Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатБлокировки.ТекстСообщения);
	ИначеЕсли РезультатБлокировки.ЕстьПредупреждение
		Или гкс_ПриемкаТранспортаСлужубныйВызовСервера.ТекущийКомпозитныйАнализНеПройденПоКачеству(
			ТекущиеДанные.ДокументРегистрации, СостояниеКачества) Тогда
		
		Если РезультатБлокировки.ЕстьПредупреждение Тогда
			ТекстВопроса = РезультатБлокировки.ТекстСообщения;
		Иначе
			ТекстВопроса = 
			СтрШаблон(НСтр("ru = 'Текущий промежуточный композит на группу имеет результат - %1.
				|Продолжить создание направления на разгрузку?'"), СостояниеКачества);
		КонецЕсли;
		
		ОписаниеОповещения = НовыйОписаниеОповещения("ПодтверждениеСозданияНаправленияНаРазгрузку", ЭтотОбъект,
			ДополнительныеПараметры);

		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0,
			КодВозвратаДиалога.Нет);
	Иначе
		ОткрытьФормуНаправленияНаРазгрузкуДляРегистрации(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтклонитьРегистрациюПослеВводаКомментария(Комментарий, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Комментарий) Тогда
		
		гкс_ПриемкаТранспортаСлужубныйВызовСервера.ОтклонитьРегистрациюНаСервере(
			Комментарий, ДополнительныеПараметры.МассивРегистрации);
		ПодключитьОбработчикОжиданияОбновления(ДополнительныеПараметры.Контекст, Истина, Истина);
		Оповестить("ИзменениеОтклонитьРегистрацию");
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОбновлениеДоступностиКнопокПоСостоянию

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияПрибыл(Форма)
	
	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.СписокРегистрацииПечатьЭтикетки.Доступность = Ложь;
	
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = 
		СтруктураДоступов.ДоступенРегистрация 
		Или СтруктураДоступов.ДоступенВзвешиваниеНаВъезде 
		Или СтруктураДоступов.ДоступенДиспетчер;
	
	Элементы.РедактироватьРегистрацию.Доступность = СтруктураДоступов.ДоступенРегистрация 
		И Форма.ЕстьПравоНаРедактированиеРегистрации;
	
	Элементы.РедактироватьВесНаВъезде.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВъезде 
		И Форма.ЕстьПравоНаРедактированиеВзвешивания;
	
	Элементы.РедактироватьНомерПробы.Доступность = Форма.РазрешитьВходнойКонтрольДоВзвешивания
		И СтруктураДоступов.ДоступенОтборПроб
		И Форма.ЕстьПравоНаРедактированиеНомераПробы;
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияГотовКОтборуПроб(Форма)

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьВесНаВъезде.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВъезде
		И Форма.ЕстьПравоНаРедактированиеВзвешивания;
	
	Элементы.РедактироватьНомерПробы.Доступность = СтруктураДоступов.ДоступенОтборПроб 
		И Форма.ЕстьПравоНаРедактированиеНомераПробы;
	
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВъезде 
		Или СтруктураДоступов.ДоступенОтборПроб 
		Или СтруктураДоступов.ДоступенДиспетчер;

	Элементы.РедактироватьРегистрацию.Доступность = СтруктураДоступов.ДоступенРегистрация 
		И Форма.ЕстьПравоНаРедактированиеРегистрации;

КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияВзвешенБрутто(Форма, ТекущиеДанные)

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВъезде
		Или СтруктураДоступов.ДоступенОтборПроб 
		Или СтруктураДоступов.ДоступенДиспетчер;
		
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.ТипРегистрации = ПредопределенноеЗначение("Перечисление.гкс_ТипРегистрации.Приемка") Тогда
		
		Элементы.РедактироватьВесНаВъезде.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВъезде
			И Форма.ЕстьПравоНаРедактированиеВзвешивания;
		
		Элементы.РедактироватьРегистрацию.Доступность = СтруктураДоступов.ДоступенРегистрация
			И Форма.ЕстьПравоНаРедактированиеРегистрации;
		
	Иначе
		Элементы.РедактированиеПриемка.Доступность = СтруктураДоступов.ДоступенОформлениеПриемки;
	КонецЕсли;

КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияВзвешенТара(Форма, ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Если ЭтоПриемкаТранспорта(ТекущиеДанные.ТипРегистрации) Тогда
		
		Элементы.РедактироватьВесНаВыезде.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВыезде 
			И Форма.ЕстьПравоНаРедактированиеВзвешивания;
		Элементы.РедактированиеПриемка.Доступность = СтруктураДоступов.ДоступенОформлениеПриемки;
		Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенДиспетчер;
	
	ИначеЕсли ЭтоОтгрузкаТранспорта(ТекущиеДанные.ТипРегистрации) Тогда
		
		Элементы.РедактироватьВесНаВъезде.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВъезде
			И Форма.ЕстьПравоНаРедактированиеВзвешивания;
		Элементы.КомандаПодтверждениеРазгрузки.Доступность = СтруктураДоступов.ДоступенДиспетчер 
			И Форма.ЕстьПравоНаРедактированиеНаправленияНаРазгрузку;
	
	Иначе
		
		Элементы.РедактироватьВесНаВыезде.Доступность 					= Ложь;
		Элементы.РедактированиеПриемка.Доступность 						= Ложь;
		Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность 	= Ложь;
		Элементы.РедактироватьВесНаВъезде.Доступность 					= Ложь;
		Элементы.КомандаПодтверждениеРазгрузки.Доступность 				= Ложь; 	                                                
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияНеПринято(Форма, ТекущиеДанные)

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Если ЭтоПриемкаТранспорта(ТекущиеДанные.ТипРегистрации) Тогда
		
		Элементы.РедактироватьВесНаВыезде.Доступность = Ложь;
		Элементы.РедактированиеПриемка.Доступность = СтруктураДоступов.ДоступенОформлениеПриемки;
		Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенДиспетчер;
	
	Иначе
	
		Элементы.РедактироватьВесНаВыезде.Доступность 					= Ложь;
		Элементы.РедактированиеПриемка.Доступность 						= Ложь;
		Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность 	= Ложь;
		Элементы.РедактироватьВесНаВъезде.Доступность 					= Ложь;
		Элементы.КомандаПодтверждениеРазгрузки.Доступность 				= Ложь;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияВзятыПробы(Форма, ТекущиеДанные)
	
	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьНомерПробы.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		И Форма.ЕстьПравоНаРедактированиеНомераПробы;
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенОтборПроб 
		Или СтруктураДоступов.ДоступенЛабАнализ 
		Или СтруктураДоступов.ДоступенДиспетчер;

	Элементы.КомандаПробыПриняты.Доступность = СтруктураДоступов.ДоступенПринятиеПроб;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоАвтоПеревозка(ТекущиеДанные.ВидПеревозки) Тогда
		
		Элементы.РедактироватьАнализ.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
			И Форма.ЕстьПравоНаРедактированиеЛабАнализа;
		
	КонецЕсли;
	
	Элементы.РедактироватьВесНаВъезде.Доступность = ДоступностьКнопкиВесНаВъезде(Форма, СтруктураДоступов);
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияПринятыПробы(Форма)

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьАнализ.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		И Форма.ЕстьПравоНаРедактированиеЛабАнализа;
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		Или СтруктураДоступов.ДоступенДиспетчер;
	Элементы.РедактироватьВесНаВъезде.Доступность = ДоступностьКнопкиВесНаВъезде(Форма, СтруктураДоступов);
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияРезультатыПробПолучены(Форма)

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьАнализ.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		И Форма.ЕстьПравоНаРедактированиеЛабАнализа;
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		Или СтруктураДоступов.ДоступенДиспетчер;
	Элементы.РедактироватьНаправлениеНаРазгрузку.Доступность = СтруктураДоступов.ДоступенДиспетчер 
		И Форма.ЕстьПравоНаРедактированиеНаправленияНаРазгрузку;
	Элементы.РедактироватьВесНаВъезде.Доступность = ДоступностьКнопкиВесНаВъезде(Форма, СтруктураДоступов);
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияКачествоНеПринято(Форма, ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьАнализ.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		И Форма.ЕстьПравоНаРедактированиеЛабАнализа;
	
	Элементы.РедактироватьНаправлениеНаРазгрузку.Доступность = 
		ДоступностьКнопкиНаправлениеНаРазгрузку(Форма, ТекущиеДанные.ДокументРегистрации, СтруктураДоступов);
	
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенЛабАнализ
		Или СтруктураДоступов.ДоступенДиспетчер;
	Элементы.РедактироватьВесНаВыезде.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВыезде
		И Форма.ЕстьПравоНаРедактированиеВзвешивания;
	Элементы.РедактироватьВесНаВъезде.Доступность = ДоступностьКнопкиВесНаВъезде(Форма, СтруктураДоступов);
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияКачествоПринято(Форма, ТекущиеДанные)

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьАнализ.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		И Форма.ЕстьПравоНаРедактированиеЛабАнализа;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.РедактироватьНаправлениеНаРазгрузку.Доступность = 
		ДоступностьКнопкиНаправлениеНаРазгрузку(Форма, ТекущиеДанные.ДокументРегистрации, СтруктураДоступов);
	Элементы.РедактироватьВесНаВъезде.Доступность = 
		ДоступностьКнопкиВесНаВъезде(Форма, СтруктураДоступов);
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенЛабАнализ 
		Или СтруктураДоступов.ДоступенДиспетчер;

КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияВыгрузкаПогрузкаРазрешена(Форма)

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьНаправлениеНаРазгрузку.Доступность = СтруктураДоступов.ДоступенДиспетчер 
		И Форма.ЕстьПравоНаРедактированиеНаправленияНаРазгрузку;
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенДиспетчер;
	Элементы.КомандаПодтверждениеРазгрузки.Доступность = СтруктураДоступов.ДоступенПодтверждениеРазгрузки;
	Элементы.КомандаОтменитьРазрешение.Доступность = СтруктураДоступов.ДоступенПодтверждениеРазгрузки;
	
КонецПроцедуры

Процедура ОбновитьДоступностьКомандУправленияДляСостоянияВыгруженПогружен(Форма)

	Элементы = Форма.Элементы;
	СтруктураДоступов = Форма.СтруктураДоступов;
	Элементы.РедактироватьВесНаВыезде.Доступность = СтруктураДоступов.ДоступенВзвешиваниеНаВыезде 
		И Форма.ЕстьПравоНаРедактированиеВзвешивания;
	Элементы.СписокРегистрацииОтклонитьРегистрациюАвто.Доступность = СтруктураДоступов.ДоступенДиспетчер;

КонецПроцедуры

Функция ДоступностьКнопкиВесНаВъезде(Форма, СтруктураДоступов)
	Возврат 
		Форма.РазрешитьВходнойКонтрольДоВзвешивания
		И СтруктураДоступов.ДоступенВзвешиваниеНаВъезде
		И Форма.ЕстьПравоНаРедактированиеВзвешивания;
КонецФункции

Функция ДоступностьКнопкиНаправлениеНаРазгрузку(Форма, Регистрация, СтруктураДоступов)
	
	Возврат 
		СтруктураДоступов.ДоступенДиспетчер 
		И Форма.ЕстьПравоНаРедактированиеНаправленияНаРазгрузку
		И НаправлятьНаРазгрузкуРазрешение(Регистрация);
	
КонецФункции

Функция СписокРегистрацииОтклонитьРегистрациюАвтоВидимость(СтруктураДоступов)

	Возврат СтруктураДоступов.ДоступенРегистрация
		Или СтруктураДоступов.ДоступенДиспетчер
		Или СтруктураДоступов.ДоступенЛабАнализ
		Или СтруктураДоступов.ДоступенВзвешиваниеНаВъезде
		Или СтруктураДоступов.ДоступенОтборПроб;
		
КонецФункции

#КонецОбласти

