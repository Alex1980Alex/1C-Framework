Функция ВыбратьНеоформленныеДокументыПоСтатусу(Статус)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтатусыОформленияВагонов.Основание КАК Ссылка,
	|	СтатусыОформленияВагонов.КлючАналитикиСРПВ КАК КлючАналитикиСРПВ
	|ИЗ
	|	РегистрСведений.гкс_СРПВСтатусыОформленияВагонов КАК СтатусыОформленияВагонов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СРПВТранспортныеДокументыЖДПолученные КАК ТранспортныеДокументыЖДПолученные
	|		ПО СтатусыОформленияВагонов.КлючАналитикиСРПВ = ТранспортныеДокументыЖДПолученные.КлючАналитикиСРПВ
	|			И ТранспортныеДокументыЖДПолученные.ДатаПрибытия >= &ОграничениеНаДатуПрибытия
	|ГДЕ
	|	СтатусыОформленияВагонов.Оформлен = ЛОЖЬ
	|	И СтатусыОформленияВагонов.Статус = &Статус";
	
	Запрос.УстановитьПараметр("Статус", Статус);
	Запрос.УстановитьПараметр("ОграничениеНаДатуПрибытия", гкс_УчетВагоновСРПВ.ДатаНачалаВидимостиПрибывшихВагонов());
	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выбрать();
	
КонецФункции

// Проверяет оформленность реестра ЗПП-3 для документа регистрации.
//
// Параметры:
//  ДокументРегистрации	- ДокументСсылка.гкс_РегистрацияНаПЛК - ссылка на документ регистрации на ПЛК.
//
// Возвращаемое значение:
//  Булево - Истина, если реестр ЗПП-3 оформлен.
//
Функция РеестрЗПП3ОформленДляДокумента(ДокументРегистрации) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументРегистрации) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеестрНакладныхЗПП3.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.гкс_РеестрНакладныхЗПП3 КАК РеестрНакладныхЗПП3
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_РеестрНакладныхЗПП3.Накладные КАК РеестрНакладные
		|		ПО РеестрНакладныхЗПП3.Ссылка = РеестрНакладные.Ссылка
		|		И РеестрНакладные.ДокументРегистрации = &ДокументРегистрации
		|ГДЕ
		|	РеестрНакладныхЗПП3.Проведен";
	
	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
КонецФункции

// Параметры обновления веса по статусу.
//
// Параметры:
//  СтатусВзвешивания - ПеречислениеСсылка.гкс_СРПВСтатусыВагонов - статус взвешивания
//  ВесБрутто - Число - вес брутто
//  ДатаБрутто - Дата - дата взвешивания брутто
//  ВесТары - Число - вес тары
//  ДатаТары - Дата - дата взвешивания тары
//
// Возвращаемое значение:
//  Структура, Неопределено - Параметры обновления веса по статусу:
// * Вес - Число
// * Дата - Дата
//
Функция ПараметрыОбновленияВесаПоСтатусу(СтатусВзвешивания, ВесБрутто, ДатаБрутто, ВесТары, ДатаТары)
	РезультатОбновления = Неопределено;
	
	Если СтатусВзвешивания = Перечисления.гкс_СРПВСтатусыВагонов.ВзвешенБрутто
		И ВесЗаполнен(ВесБрутто, ДатаБрутто) Тогда 

		РезультатОбновления = ПараметрыОбновления(ВесБрутто, ДатаБрутто);
		
	ИначеЕсли СтатусВзвешивания = Перечисления.гкс_СРПВСтатусыВагонов.ВзвешенТара
		И ВесЗаполнен(ВесТары, ДатаТары) Тогда 

		РезультатОбновления = ПараметрыОбновления(ВесТары, ДатаТары);

	КонецЕсли;

	Возврат РезультатОбновления;
	
КонецФункции

// Проверяет заполнены ли вес и дата взвешивания.
//
// Параметры:
//  Вес - Число - вес (брутто или тары)
//  ДатаВеса - Дата - дата взвешивания
//
// Возвращаемое значение:
//  Булево - Истина, если вес и дата заполнены
//
Функция ВесЗаполнен(Вес, ДатаВеса)
	
	Возврат ЗначениеЗаполнено(Вес) И ЗначениеЗаполнено(ДатаВеса);
	
КонецФункции

// Создает структуру параметров обновления веса или возвращает Неопределено.
//
// Параметры:
//  Вес - Число - значение веса (необязательный, по умолчанию Неопределено)
//  Дата - Дата - дата взвешивания (необязательный, по умолчанию Неопределено)
//
// Возвращаемое значение:
//  Структура - структура с полями "Вес, Дата"
//
Функция ПараметрыОбновления(Вес, Дата)

	Возврат Новый Структура("Вес, Дата", Вес, Дата);
	
КонецФункции

