Процедура ОбновитьДанныеСостоянияРегистрации()

	НачатьТранзакцию();
	Попытка
		ДобавитьЗаписьВыгруженДляУбывшихВагонов();
		ЗафиксироватьТранзакцию();	
	Исключение
	 	ОтменитьТранзакцию();
		
		ТекстШаблона = НСтр("ru = 'Не удалось привязать документы регистрации на ПЛК к документу СРПВ по причине: %1'", 
						ОбщегоНазначения.КодОсновногоЯзыка());
		
		ТекстСообщения = СтрШаблон(ТекстШаблона, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		СобытиеЖР = НСтр("ru='СРПВ: Обновление данных состояний регистрации'", ОбщегоНазначения.КодОсновногоЯзыка());	
			
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(СобытиеЖР, 
														УровеньЖурналаРегистрации.Ошибка,
														Метаданные.РегистрыСведений.гкс_СостоянияРегистрации,
														,
														ТекстСообщения);
	КонецПопытки;		

