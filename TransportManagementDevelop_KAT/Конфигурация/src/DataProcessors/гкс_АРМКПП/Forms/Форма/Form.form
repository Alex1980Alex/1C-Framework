  <attributes>
    <name>ТаблицаРегистрацииТранспорта</name>
    <title>
      <key>ru</key>
      <value>Таблица регистрации транспорта</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВъездНаКПП.НачалоПериода КАК НачалоПериода,
	ВъездНаКПП.Номер КАК Номер,
	ВъездНаКПП.Контрагент КАК Контрагент,
	ВъездНаКПП.Номенклатура КАК Номенклатура,
	ВъездНаКПП.НомерТранспортногоСредства КАК НомерТранспортногоСредства,
	ВъездНаКПП.УсловиеПроезда КАК УсловиеПроезда,
	ВЫБОР
		КОГДА НЕ ВъездНаКПП.НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
				И НЕ ВъездНаКПП.ПометкаУдаления
			ТОГДА СТРОКА(ЦЕЛ(РАЗНОСТЬДАТ(ВъездНаКПП.НачалоПериода, &amp;ТекущаяДата, МИНУТА) / 60)) + &quot; ч &quot; + СТРОКА(РАЗНОСТЬДАТ(ВъездНаКПП.НачалоПериода, &amp;ТекущаяДата, МИНУТА) - ЦЕЛ(РАЗНОСТЬДАТ(ВъездНаКПП.НачалоПериода, &amp;ТекущаяДата, МИНУТА) / 60) * 60) + &quot; мин&quot;
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	КОНЕЦ КАК ВремяНахожденияНаПЛК,
	ВъездНаКПП.Ссылка КАК Ссылка
ИЗ
	Документ.гкс_ВъездНаКПП КАК ВъездНаКПП
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ВыездНаКПП КАК ВыездНаКПП
		ПО (ВыездНаКПП.ДокументОснование = ВъездНаКПП.Ссылка)
			И (НЕ ВыездНаКПП.ПометкаУдаления)
ГДЕ
	ВыездНаКПП.Ссылка ЕСТЬ NULL
	И НЕ ВъездНаКПП.ПометкаУдаления

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВъездНаКПППометка.НачалоПериода,
	ВъездНаКПППометка.Номер,
	ВъездНаКПППометка.Контрагент,
	ВъездНаКПППометка.Номенклатура,
	ВъездНаКПППометка.НомерТранспортногоСредства,
	ВъездНаКПППометка.УсловиеПроезда,
	ДАТАВРЕМЯ(1, 1, 1),
	ВъездНаКПППометка.Ссылка
ИЗ
	Документ.гкс_ВъездНаКПП КАК ВъездНаКПППометка
ГДЕ
	ВЫБОР
			КОГДА НЕ &amp;ПоказыватьОтмененные
				ТОГДА НЕ ВъездНаКПППометка.ПометкаУдаления
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВъездНаКПППометка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;ТекущаяДата, ДЕНЬ)
	И ВъездНаКПППометка.ПометкаУдаления</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Номер</dataPath>
        <field>Номер</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Контрагент</dataPath>
        <field>Контрагент</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Номенклатура</dataPath>
        <field>Номенклатура</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>НомерТранспортногоСредства</dataPath>
        <field>НомерТранспортногоСредства</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>УсловиеПроезда</dataPath>
        <field>УсловиеПроезда</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ВремяНахожденияНаПЛК</dataPath>
        <field>ВремяНахожденияНаПЛК</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Время нахождения на ПЛК</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
