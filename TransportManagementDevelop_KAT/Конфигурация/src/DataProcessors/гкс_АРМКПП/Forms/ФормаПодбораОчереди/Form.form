    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаписьВОчередьПриемкиПЛК.Ссылка КАК Ссылка,
	ЗаписьВОчередьПриемкиПЛК.Дата КАК Дата,
	ЗаписьВОчередьПриемкиПЛК.Номер КАК Номер,
	ЗаписьВОчередьПриемкиПЛК.Контрагент КАК Контрагент,
	ЗаписьВОчередьПриемкиПЛК.Номенклатура КАК Номенклатура,
	ЗаписьВОчередьПриемкиПЛК.НомерТранспортногоСредства КАК НомерТранспортногоСредства,
	ЗаписьВОчередьПриемкиПЛК.УсловиеПроезда КАК УсловиеПроезда,
	ЗаписьВОчередьПриемкиПЛК.НачалоПериода КАК НачалоПериода,
	ЗаписьВОчередьПриемкиПЛК.ОкончаниеПериода КАК ОкончаниеПериода
ИЗ
	Документ.гкс_ЗаписьВОчередьПриемкиПЛК КАК ЗаписьВОчередьПриемкиПЛК
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ВъездНаКПП КАК ВъездНаКПП
		ПО ЗаписьВОчередьПриемкиПЛК.Ссылка = ВъездНаКПП.ДокументОснование
ГДЕ
	ЗаписьВОчередьПриемкиПЛК.НачалоПериода > ДОБАВИТЬКДАТЕ(&amp;ТекущаяДата, МИНУТА, &amp;ВременнойРазбросДляКПП)
	И ВъездНаКПП.Ссылка ЕСТЬ NULL</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
