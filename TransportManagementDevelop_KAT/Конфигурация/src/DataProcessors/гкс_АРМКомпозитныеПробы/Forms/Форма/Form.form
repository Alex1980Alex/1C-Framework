  <attributes>
    <name>СписокРегистрацийКомпозитныеПробы</name>
    <title>
      <key>ru</key>
      <value>Список регистраций композитные пробы</value>
    </title>
    <id>13</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрацийКомпозитныеПробы.НомерДокументРегистрации</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрацийКомпозитныеПробы.ДокументРегистрации</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрацийКомпозитныеПробы.ЗПП3</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	КомпозитныеПробы.ДокументРегистрации КАК ДокументРегистрации
ПОМЕСТИТЬ ВТ_СписокРегистраций
ИЗ
	РегистрСведений.гкс_КомпозитныеПробы КАК КомпозитныеПробы
ГДЕ
	КомпозитныеПробы.ТочкаМаршрута = &amp;ТочкаМаршрута
	И КомпозитныеПробы.ПроизводственныеСуткиРегистрации = &amp;ПроизводственныеСутки
	И КомпозитныеПробы.ВидПеревозки = &amp;ВидПеревозки
	И КомпозитныеПробы.КомпозитнаяПроба = &amp;ДокументКомпозитнаяПроба
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РеестрНакладныхНакладные.Ссылка КАК ЗПП3,
	РеестрНакладныхНакладные.ДокументРегистрации КАК ДокументРегистрации
ПОМЕСТИТЬ ВТ_Реестр
ИЗ
	Документ.гкс_РеестрНакладныхЗПП3.Накладные КАК РеестрНакладныхНакладные
ГДЕ
	РеестрНакладныхНакладные.Ссылка.Анализ = &amp;ЛабораторныйАнализ
	И РеестрНакладныхНакладные.Ссылка.Проведен
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_СписокРегистраций.ДокументРегистрации КАК ДокументРегистрации,
	МАКСИМУМ(ЕСТЬNULL(ВТ_Реестр.ЗПП3, ЗНАЧЕНИЕ(Документ.гкс_РеестрНакладныхЗПП3.ПустаяСсылка))) КАК ЗПП3
ПОМЕСТИТЬ ВТ_Документы
ИЗ
	ВТ_СписокРегистраций КАК ВТ_СписокРегистраций
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Реестр КАК ВТ_Реестр
		ПО ВТ_СписокРегистраций.ДокументРегистрации = ВТ_Реестр.ДокументРегистрации

СГРУППИРОВАТЬ ПО
	ВТ_СписокРегистраций.ДокументРегистрации
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Документы.ДокументРегистрации КАК ДокументРегистрации,
	ВТ_Документы.ЗПП3 КАК ЗПП3
	ИЗ
	ВТ_Документы КАК ВТ_Документы</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
