  <attributes>
    <name>СписокРегистрации</name>
    <title>
      <key>ru</key>
      <value>Список регистрации</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.БруттоФакт</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ВзвешиваниеВъезд</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ВзвешиваниеВыезд</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ВидПеревозки</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.Грузоотправитель</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ДатаВыгрузки</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ДатаРегистрации</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ДокументКомпозитнаяПроба</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ДокументРегистрации</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.Контрагент</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.НаправлениеНаРазгрузку</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.НеттоФакт</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.Номенклатура</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.НомерКомпозитнойПробы</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.НомерПробы</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.Организация</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ПЛК</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.Силос</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.СтанцияОтправления</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.СтанцияОтправленияПредставление</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ТараФакт</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ТранспортноеСредство</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРегистрации.ФормированиеПробы</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СостоянияРегистрации.ДокументРегистрации КАК ДокументРегистрации,
	СостоянияРегистрации.Состояние КАК Состояние
ПОМЕСТИТЬ ВТ_Регистрации
ИЗ
	РегистрСведений.гкс_СостоянияРегистрации.СрезПоследних(
			{(&amp;КонецПериода)},
			ВидПеревозки = &amp;ВидПеревозки
				И ТипРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Приемка)
				И (Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода)
				И ТочкаМаршрута = &amp;ТочкаМаршрута) КАК СостоянияРегистрации
ГДЕ
	СостоянияРегистрации.Состояние В(&amp;СписокСостояний)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СостоянияРегистрации.ДокументРегистрации КАК ДокументРегистрации,
	СостоянияРегистрации.Период КАК ДатаВыгрузки
ПОМЕСТИТЬ ВТ_ДатыВыгрузки
ИЗ
	РегистрСведений.гкс_СостоянияРегистрации КАК СостоянияРегистрации
ГДЕ
	СостоянияРегистрации.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И СостоянияРегистрации.Состояние = ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияРегистрации.Выгружен)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СтатусыОформленияВагонов.Документ,
	СтатусыОформленияВагонов.ДатаОперации
ИЗ
	РегистрСведений.гкс_СРПВСтатусыОформленияВагонов КАК СтатусыОформленияВагонов
ГДЕ
	СтатусыОформленияВагонов.ДатаОперации МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И СтатусыОформленияВагонов.Статус = ЗНАЧЕНИЕ(Перечисление.гкс_СРПВСтатусыВагонов.Выгружен)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ДатыВыгрузки.ДокументРегистрации КАК ДокументРегистрации,
	МАКСИМУМ(ВТ_ДатыВыгрузки.ДатаВыгрузки) КАК ДатаВыгрузки
ПОМЕСТИТЬ ВТ_РегистрацииВыгруженные
ИЗ
	ВТ_ДатыВыгрузки КАК ВТ_ДатыВыгрузки

СГРУППИРОВАТЬ ПО
	ВТ_ДатыВыгрузки.ДокументРегистрации
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	КомпозитныеПробы.ДокументРегистрации КАК ДокументРегистрации,
	КомпозитныеПробы.КомпозитнаяПроба КАК КомпозитнаяПроба,
	ЕСТЬNULL(СправочникНомераПроб.Код, &quot;&quot;) КАК НомерПробы,
	КомпозитныеПробы.ПроизводственныеСуткиРегистрации КАК ПроизводственныеСутки
ПОМЕСТИТЬ ВТ_КомпозитныеПробы
ИЗ
	РегистрСведений.гкс_КомпозитныеПробы КАК КомпозитныеПробы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Регистрации КАК ВТ_Регистрации
		ПО (ВТ_Регистрации.ДокументРегистрации = КомпозитныеПробы.ДокументРегистрации)
			И (КомпозитныеПробы.ВидПеревозки = &amp;ВидПеревозки)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы КАК ДокументФормированиеНомераПробы
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.гкс_НомерПробы КАК СправочникНомераПроб
			ПО ДокументФормированиеНомераПробы.НомерПробы = СправочникНомераПроб.Ссылка
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК СопоставлениеФНПЛА
			ПО ДокументФормированиеНомераПробы.Ссылка = СопоставлениеФНПЛА.ФормированиеНомераПробы
		ПО (КомпозитныеПробы.КомпозитнаяПроба = ДокументФормированиеНомераПробы.Ссылка)
ГДЕ
	ЕСТЬNULL(СопоставлениеФНПЛА.НазначениеИспользования, ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПриемкаКомпозит)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Регистрации.ДокументРегистрации КАК ДокументРегистрации,
	ДокументФормированиеНомераПробы.Ссылка КАК ЕдиничнаяПроба,
	ЕСТЬNULL(СправочникНомераПроб.Код, &quot;&quot;) КАК НомерПробы

ПОМЕСТИТЬ ВТ_ЕдиничныеПробы
ИЗ
	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Регистрации КАК ВТ_Регистрации
		ПО (ВТ_Регистрации.ДокументРегистрации = ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы КАК ДокументФормированиеНомераПробы
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.гкс_НомерПробы КАК СправочникНомераПроб
			ПО ДокументФормированиеНомераПробы.НомерПробы = СправочникНомераПроб.Ссылка
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК гкс_СопоставлениеФНПЛабАнализа
			ПО ДокументФормированиеНомераПробы.Ссылка = гкс_СопоставлениеФНПЛабАнализа.ФормированиеНомераПробы
		ПО (ФормированиеНомераПробыСписокРегистраций.Ссылка = ДокументФормированиеНомераПробы.Ссылка)
			И (ДокументФормированиеНомераПробы.Проведен)
			И (ДокументФормированиеНомераПробы.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная))
ГДЕ
	ЕСТЬNULL(гкс_СопоставлениеФНПЛабАнализа.НазначениеИспользования, ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПустаяСсылка)) &lt;> ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РегистрацияНаПЛК.Ссылка КАК ДокументРегистрации,
	РегистрацияНаПЛК.Дата КАК ДатаРегистрации,
	РегистрацияНаПЛК.Организация КАК Организация,
	РегистрацияНаПЛК.ВидПеревозки КАК ВидПеревозки,
	РегистрацияНаПЛК.ТочкаМаршрута КАК ПЛК,
	РегистрацияНаПЛК.Контрагент КАК Контрагент,
	РегистрацияНаПЛК.Номенклатура КАК Номенклатура,
	РегистрацияНаПЛК.ТранспортноеСредство КАК ТранспортноеСредство,
	РегистрацияНаПЛК.ОтправительПолучатель КАК Грузоотправитель,
	РегистрацияНаПЛК.ПунктПогрузки КАК ПунктПогрузки,
	ВЫБОР
		КОГДА РегистрацияНаПЛК.Собственник ССЫЛКА Справочник.Контрагенты
			ТОГДА ВЫРАЗИТЬ(РегистрацияНаПЛК.Собственник КАК Справочник.Контрагенты)
		ИНАЧЕ ВЫРАЗИТЬ(РегистрацияНаПЛК.Собственник КАК Справочник.Организации).КонтрагентОрганизации
	КОНЕЦ КАК Собственник,
	ЕСТЬNULL(ВТ_РегистрацииВыгруженные.ДатаВыгрузки, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВыгрузки,
	ЕСТЬNULL(НаправлениеНаРазгрузку.Ссылка, ЗНАЧЕНИЕ(Документ.гкс_НаправлениеНаРазгрузку.ПустаяСсылка)) КАК НаправлениеНаРазгрузку,
	ЕСТЬNULL(НаправлениеНаРазгрузку.СлужебнаяНоменклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК СлужебнаяНоменклатура,
	ЕСТЬNULL(НаправлениеНаРазгрузку.Склад, НЕОПРЕДЕЛЕНО) КАК Силос,
	ЕСТЬNULL(ВТ_КомпозитныеПробы.КомпозитнаяПроба, ЗНАЧЕНИЕ(Документ.гкс_ФормированиеНомераПробы.ПустаяСсылка)) КАК ДокументКомпозитнаяПроба,
	ЕСТЬNULL(ВТ_КомпозитныеПробы.НомерПробы, NULL) КАК НомерКомпозитнойПробы,
	ЕСТЬNULL(ВТ_ЕдиничныеПробы.ЕдиничнаяПроба, ЗНАЧЕНИЕ(Документ.гкс_ФормированиеНомераПробы.ПустаяСсылка)) КАК ФормированиеПробы,
	ЕСТЬNULL(ВТ_ЕдиничныеПробы.НомерПробы, NULL) КАК НомерПробы,
	ЕСТЬNULL(СвязьРегистрацииИТранспортногоДокумента.ТранспортныйДокумент, ЗНАЧЕНИЕ(Документ.гкс_ТранспортныйДокумент.ПустаяСсылка)) КАК ТранспортныйДокумент,
	ЕСТЬNULL(СвязьРегистрацииИТранспортногоДокумента.ТранспортныйДокумент.ПунктПогрузки.КодСтанцииЖД, NULL) КАК СтанцияОтправления,
	ЕСТЬNULL(СвязьРегистрацииИТранспортногоДокумента.ТранспортныйДокумент.ПунктПогрузки.КодСтанцииЖД.НаименованиеПолное, NULL) КАК СтанцияОтправленияПредставление,
	ЕСТЬNULL(ВзвешиваниеВъезд.Ссылка, ЗНАЧЕНИЕ(Документ.гкс_Взвешивание.ПустаяСсылка)) КАК ВзвешиваниеВъезд,
	ЕСТЬNULL(ВзвешиваниеВъезд.Вес, 0) КАК БруттоФакт,
	ЕСТЬNULL(ВзвешиваниеВыезд.Ссылка, ЗНАЧЕНИЕ(Документ.гкс_Взвешивание.ПустаяСсылка)) КАК ВзвешиваниеВыезд,
	ЕСТЬNULL(ВзвешиваниеВыезд.Вес, 0) КАК ТараФакт,
	ВЫБОР
		КОГДА ВзвешиваниеВыезд.Ссылка ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ ЕСТЬNULL(ВзвешиваниеВъезд.Вес, 0) - ЕСТЬNULL(ВзвешиваниеВыезд.Вес, 0)
	КОНЕЦ КАК НеттоФакт,
	РегистрацияНаПЛК.Спецификация.Договор КАК Договор
ИЗ
	ВТ_Регистрации КАК ВТ_Регистрации
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		ПО ВТ_Регистрации.ДокументРегистрации = РегистрацияНаПЛК.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РегистрацииВыгруженные КАК ВТ_РегистрацииВыгруженные
		ПО ВТ_Регистрации.ДокументРегистрации = ВТ_РегистрацииВыгруженные.ДокументРегистрации
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_НаправлениеНаРазгрузку КАК НаправлениеНаРазгрузку
		ПО ВТ_Регистрации.ДокументРегистрации = НаправлениеНаРазгрузку.ДокументРегистрации
			И (НаправлениеНаРазгрузку.Проведен)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_Взвешивание КАК ВзвешиваниеВъезд
		ПО ВТ_Регистрации.ДокументРегистрации = ВзвешиваниеВъезд.ДокументРегистрации
			И (ВзвешиваниеВъезд.Проведен)
			И (ВзвешиваниеВъезд.ТипВзвешивания = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыВзвешивания.Въезд))
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_Взвешивание КАК ВзвешиваниеВыезд
		ПО ВТ_Регистрации.ДокументРегистрации = ВзвешиваниеВыезд.ДокументРегистрации
			И (ВзвешиваниеВыезд.Проведен)
			И (ВзвешиваниеВыезд.ТипВзвешивания = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыВзвешивания.Выезд))
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомпозитныеПробы КАК ВТ_КомпозитныеПробы
		ПО ВТ_Регистрации.ДокументРегистрации = ВТ_КомпозитныеПробы.ДокументРегистрации
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕдиничныеПробы КАК ВТ_ЕдиничныеПробы
		ПО ВТ_Регистрации.ДокументРегистрации = ВТ_ЕдиничныеПробы.ДокументРегистрации
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СвязьРегистрацииИТранспортногоДокумента КАК СвязьРегистрацииИТранспортногоДокумента
		ПО ВТ_Регистрации.ДокументРегистрации = СвязьРегистрацииИТранспортногоДокумента.ДокументРегистрации
ГДЕ
	ВЫБОР
			КОГДА НЕ ВТ_КомпозитныеПробы.ДокументРегистрации ЕСТЬ NULL
					И НЕ ВТ_КомпозитныеПробы.ПроизводственныеСутки = &amp;ПроизводственныеСутки
				ТОГДА ЛОЖЬ
			ИНАЧЕ ИСТИНА
		КОНЕЦ</queryText>
