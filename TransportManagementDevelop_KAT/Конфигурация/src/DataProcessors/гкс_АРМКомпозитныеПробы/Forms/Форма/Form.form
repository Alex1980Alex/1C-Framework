    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	РегистрСведенийгкс_КомпозитныеПробы.КомпозитнаяПроба КАК ДокументКомпозитнаяПроба,
	МАКСИМУМ(СопоставлениеФНПЛА.ЛабораторныйАнализ) КАК ЛабораторныйАнализ
ПОМЕСТИТЬ ВТ_ПервичныеДанные
ИЗ
	РегистрСведений.гкс_КомпозитныеПробы КАК РегистрСведенийгкс_КомпозитныеПробы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК СопоставлениеФНПЛА
		ПО РегистрСведенийгкс_КомпозитныеПробы.КомпозитнаяПроба = СопоставлениеФНПЛА.ФормированиеНомераПробы
ГДЕ
	РегистрСведенийгкс_КомпозитныеПробы.ТочкаМаршрута = &amp;ТочкаМаршрута
	И РегистрСведенийгкс_КомпозитныеПробы.ПроизводственныеСуткиРегистрации = &amp;ПроизводственныеСутки
	И РегистрСведенийгкс_КомпозитныеПробы.ВидПеревозки = &amp;ВидПеревозки
	И ЕСТЬNULL(СопоставлениеФНПЛА.НазначениеИспользования, ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПриемкаКомпозит)

СГРУППИРОВАТЬ ПО
	РегистрСведенийгкс_КомпозитныеПробы.КомпозитнаяПроба
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ПервичныеДанные.ДокументКомпозитнаяПроба КАК ДокументКомпозитнаяПроба,
	ВТ_ПервичныеДанные.ДокументКомпозитнаяПроба КАК Ссылка,
	ВТ_ПервичныеДанные.ЛабораторныйАнализ КАК ДокументЛабораторныйАнализ
ИЗ
	ВТ_ПервичныеДанные КАК ВТ_ПервичныеДанные</queryText>
