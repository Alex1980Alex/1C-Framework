

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда 
		Возврат;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаПечать(Команда)
		
	ДанныеПечати = ПодготовитьДанныеПечати(Лаборант, Кладовщик);
	Закрыть(Новый Структура("ДанныеПечати", ДанныеПечати));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПодготовитьДанныеПечати(Знач Лаборант, Знач Кладовщик)

	ДанныеПечати = Новый Структура;
	ДанныеПечати.Вставить("Лаборант", ПолучитьНаименованиеДляПечатиЛаборанта(Лаборант));
	ДанныеПечати.Вставить("Кладовщик", ПолучитьФамилиюИнициалыПодписанта(Кладовщик));
	ДанныеПечати.Вставить("ДолжностьКладовщика", ПолучитьДолжностьПодписанта(Кладовщик));

	ДанныеПечати.Вставить("ДолжностьЛаборанта", ПолучитьДолжностьПодписанта(Лаборант));
	ДанныеПечати.Вставить("ДолжностьВодителя", "Водитель");

Возврат ДанныеПечати;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНаименованиеДляПечатиЛаборанта(Лаборант)
	
	Возврат гкс_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Лаборант, "Наименование");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДолжностьПодписанта(Подписант)

	Если Не ЗначениеЗаполнено(Подписант) Тогда
		Возврат "";
	КонецЕсли;

	Возврат гкс_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подписант, "Должность");

КонецФункции

// Возвращает ФИО подписанта в формате «Фамилия И.О.» (как Лаборант/Водитель в ManagerModule).
&НаСервереБезКонтекста
Функция ПолучитьФамилиюИнициалыПодписанта(Подписант)

	Если Не ЗначениеЗаполнено(Подписант) Тогда
		Возврат "";
	КонецЕсли;

	Наименование = гкс_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подписант, "Наименование");
	Возврат гкс_ОбщегоНазначения.ФИОДляПечати(Наименование);

КонецФункции


#КонецОбласти