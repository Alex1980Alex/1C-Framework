&НаСервереБезКонтекста
Функция СтатусДопускаВВыбранныхСтроках(ВыбранныеРегистрации, ТипДопуска)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СписокРегистраций", ВыбранныеРегистрации);
	Запрос.УстановитьПараметр("ДопускКВскрытию", ТипДопуска);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СтатусыДопускаВагоновКВскрытию.ВскрытиеЗапрещено КАК ВскрытиеЗапрещено
	|ИЗ
	|	РегистрСведений.гкс_СтатусыДопускаВагоновКВскрытию.СрезПоследних(
	|			,
	|			ДокументРегистрации В (&СписокРегистраций)
	|				И ДопускКВскрытию = &ДопускКВскрытию) КАК СтатусыДопускаВагоновКВскрытию";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() = 1 Тогда
 		Выборка.Следующий();
		Результат = Выборка.ВскрытиеЗапрещено;
	Иначе
		
		ТекстСообщения = НСтр("ru = 'В выбранных строках у допуска ""%1"" установлены разные значения. 
							  |Не возможно применить групповую операцию.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ТипДопуска); 
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат = Неопределено;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция РегистрацииГрупповойОбработки()
	Возврат гкс_ПриемкаТранспортаСлужубныйВызовСервера.РегистрацииГрупповойОбработки(ЭтотОбъект);
КонецФункции

&НаСервереБезКонтекста
Функция КлючСтрокиСпискаРегистраций(ДокументРегистрации)
	
	ИсточникКлюча = Неопределено;
	Если ТипЗнч(ДокументРегистрации) = Тип("ДокументСсылка.гкс_РегистрацияНаПЛК") Тогда 
		РеквизитыРегистрации = Новый Структура;
		РеквизитыРегистрации.Вставить("ВидПеревозки"		, "ВидПеревозки");
		РеквизитыРегистрации.Вставить("ДокументРегистрации"	, "Ссылка");
		РеквизитыРегистрации.Вставить("ТипРегистрации"		, "ТипРегистрации");
		РеквизитыРегистрации.Вставить("ТочкаМаршрута"		, "ТочкаМаршрута");
		ИсточникКлюча = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРегистрации, РеквизитыРегистрации); 
	КонецЕсли;
	
	Возврат ИсточникКлюча;
	
КонецФункции

#Область ВагоныНаПЛК

&НаСервере
Процедура НачатьВыводИнформацииОВагонахНаПЛК()
	
	Обработка 		= РеквизитФормыВЗначение("Объект");
	Макет 			= Обработка.ПолучитьМакет("ВагоныНаПутях");
	ОбластиМакета = Новый Структура;
	ОбластиМакета.Вставить("ОбластьЗаголовок"	, Макет.ПолучитьОбласть("ИтогиЗаголовок"));
	ОбластиМакета.Вставить("ОбластьИтогиШапка"	, Макет.ПолучитьОбласть("ИтогиШапка"));
	ОбластиМакета.Вставить("ОбластьИтогиСтрока"	, Макет.ПолучитьОбласть("ИтогиСтрока"));
	ОбластиМакета.Вставить("ОбластьПуть"		, Макет.ПолучитьОбласть("Путь|КолонкаПуть"));
	ОбластиМакета.Вставить("ОбластьВагон"		, Макет.ПолучитьОбласть("Путь|КолонкаВагон"));
	ОбластиМакета.Вставить("ОбластьОтступ"		, Макет.ПолучитьОбласть("Путь|КолонкаОтступ"));
	ОбластиМакета.Вставить("ОбластьРазделитель"	, Макет.ПолучитьОбласть("Разделитель"));
	
	Запрос 			= Новый Запрос;
	Запрос.УстановитьПараметр("Неинициализировано"	, "Неизвестно");
	Запрос.УстановитьПараметр("ТочкаМаршрута"		, ОтборТочкаМаршрута);
	Запрос.УстановитьПараметр("ВидПеревозки"		, ОтборВидПеревозки);
	ТаблицыЗапроса	= ТаблицыЗапросаВыводаИнформацииОВагонахНаПЛК();
	Запрос.Текст 	= ТекстЗапросаВыводаИнформацииОВагонахНаПЛК();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВагоныНаПЛК.ФиксацияСлева = 1;
	ВагоныНаПЛК.Очистить();
	
	// Заголовок
	ВывестиЗаголовокДляВагоновНаПЛК(ОбластиМакета, РезультатЗапроса, ТаблицыЗапроса);
	
	// Пути-Вагоны
	ВывестиПутиДляВагоновНаПЛК(ОбластиМакета, РезультатЗапроса, ТаблицыЗапроса);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиЗаголовокДляВагоновНаПЛК(ОбластиМакета, РезультатЗапроса, ТаблицыЗапроса)
	
	УровеньОбластьЗаголовок = 1;
	УровеньОбластьИтоги 	= 2;
	ВагоныНаПЛК.НачатьАвтоГруппировкуСтрок();
	ВагоныНаПЛК.Вывести(ОбластиМакета.ОбластьЗаголовок, УровеньОбластьЗаголовок, "ИтогиЗаголовок", Ложь);
	ВагоныНаПЛК.Вывести(ОбластиМакета.ОбластьИтогиШапка, УровеньОбластьИтоги, "ИтогиШапка");
	
	ИтоговыеЗаписи 		= РезультатЗапроса[ТаблицыЗапроса.НоменклатураИтоги].Выгрузить();
	ИтогиПоСостоянию 	= РезультатЗапроса[ТаблицыЗапроса.СостоянияИтоги].Выгрузить();
	Для НПП = 0 По ИтогиПоСостоянию.Количество() - 1 Цикл 
		
		Если НПП >= ИтоговыеЗаписи.Количество() Тогда 
			СтрокаИтогов = ИтоговыеЗаписи.Добавить();
		Иначе 
			СтрокаИтогов = ИтоговыеЗаписи[НПП];
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаИтогов, ИтогиПоСостоянию[НПП]);
		
	КонецЦикла;
	
	ОбластьИтогиСтрока = ОбластиМакета.ОбластьИтогиСтрока;
	Для Каждого СтрокаИтогов Из ИтоговыеЗаписи Цикл 
		
		ОбластьИтогиСтрока.Параметры.Заполнить(СтрокаИтогов);
		ВагоныНаПЛК.Вывести(ОбластьИтогиСтрока, УровеньОбластьИтоги, "ИтогиСтрока");
		ОформлениеОбласти = ОформлениеВагонаПоСостоянию(СтрокаИтогов.Состояние);
		ОбластьНомерСтроки 	= ВагоныНаПЛК.ВысотаТаблицы;
		ОбластьНомерКолонки	= 4;
		Область = ВагоныНаПЛК.Область(
			ОбластьНомерСтроки, ОбластьНомерКолонки, ОбластьНомерСтроки, ОбластьНомерКолонки);
		ОформитьОбластьВагоновНаПЛК(Область, ОформлениеОбласти);
		
	КонецЦикла;
	
	ВагоныНаПЛК.ЗакончитьАвтогруппировкуСтрок();
	ВагоныНаПЛК.Вывести(ОбластиМакета.ОбластьРазделитель);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПутиДляВагоновНаПЛК(ОбластиМакета, РезультатЗапроса, ТаблицыЗапроса)
	
	ВагоныНаПЛК.НачатьАвтогруппировкуСтрок();
	
	ВыборкаПуть = РезультатЗапроса[ТаблицыЗапроса.ВагоныНаПутяхИтоги].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПуть.Следующий() Цикл
		
		// Путь
		ОбластиМакета.ОбластьПуть.Параметры.Заполнить(ВыборкаПуть);
		ВагоныНаПЛК.Вывести(ОбластиМакета.ОбластьПуть, ВыборкаПуть.Уровень());
		ВыборкаДетальныеЗаписи = ВыборкаПуть.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			// Вагон
			ОбластиМакета.ОбластьВагон.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
			ОбластиМакета.ОбластьВагон.Параметры.ВагонПозиция = СтрШаблон(
				"%1/%2", ВыборкаДетальныеЗаписи.WaggonIndexPark, ВыборкаПуть.WaggonIndexPark);
			
			ОформлениеОбласти = ОформлениеВагонаПоСостоянию(ВыборкаДетальныеЗаписи.Состояние);
			Область = ВагоныНаПЛК.Присоединить(ОбластиМакета.ОбластьВагон, ВыборкаДетальныеЗаписи.Уровень());
			ОформитьОбластьВагоновНаПЛК(Область, ОформлениеОбласти);
			
			ВагоныНаПЛК.Присоединить(ОбластиМакета.ОбластьОтступ, ВыборкаДетальныеЗаписи.Уровень());
			
		КонецЦикла;
		
		ВагоныНаПЛК.Вывести(ОбластиМакета.ОбластьРазделитель);
		// {Разделить пути
		Область = ВагоныНаПЛК.Область(ВагоныНаПЛК.ВысотаТаблицы, , ВагоныНаПЛК.ВысотаТаблицы);
		Область.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Двойная, 1);
		// Разделить пути}
		ВагоныНаПЛК.Вывести(ОбластиМакета.ОбластьРазделитель);
		
	КонецЦикла;
	
	ВагоныНаПЛК.ЗакончитьАвтогруппировкуСтрок();
	
КонецПроцедуры

&НаСервере
Процедура ОформитьОбластьВагоновНаПЛК(Область, ОформлениеОбласти)
	Область.ЦветФона = ОформлениеОбласти.ЦветФона;
	Область.ЦветРамки = ОформлениеОбласти.ЦветРамки;
	Область.Обвести(
		ОформлениеОбласти.Линия, ОформлениеОбласти.Линия, ОформлениеОбласти.Линия, ОформлениеОбласти.Линия);
КонецПроцедуры

&НаСервере
Функция ТаблицыЗапросаВыводаИнформацииОВагонахНаПЛК()
	
	ТаблицыЗапроса = Новый Структура;
	ТаблицыЗапроса.Вставить("ВагоныНаПутях", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("ВагоныНаПутяхРегистрации", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("СостоянияРегистрации", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("НастройкиНазначенияРазгрузкиОбщие", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("НастройкиНазначенияРазгрузки", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("ВагоныНаПутяхДетальные", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("ВагоныНаПутяхИтоги", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("НоменклатураИтоги", ТаблицыЗапроса.Количество());
	ТаблицыЗапроса.Вставить("СостоянияИтоги", ТаблицыЗапроса.Количество());
	Возврат ТаблицыЗапроса;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаВыводаИнформацииОВагонахНаПЛК()
	
	Возврат
	"ВЫБРАТЬ
	|	НахождениеВагоновНаПутяхСРПВ.Вагон КАК Вагон,
	|	НахождениеВагоновНаПутяхСРПВ.Путь КАК Путь,
	|	НахождениеВагоновНаПутяхСРПВ.WaggonIndexPark КАК WaggonIndexPark,
	|	ЕСТЬNULL(СтруктураПЛК.ТочкаМаршрута, ЗНАЧЕНИЕ(Справочник.гкс_ТочкиМаршрута.ПустаяСсылка)) КАК ПутьТочкаМаршрута,
	|	ЕСТЬNULL(КлючиАналитикиСРПВ.Ссылка, ЗНАЧЕНИЕ(Справочник.гкс_КлючиАналитикиСРПВ.ПустаяСсылка)) КАК КлючАналитики
	|ПОМЕСТИТЬ ВагоныНаПутях
	|ИЗ
	|	РегистрСведений.гкс_НахождениеВагоновНаПутяхСРПВ КАК НахождениеВагоновНаПутяхСРПВ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.гкс_КлючиАналитикиСРПВ КАК КлючиАналитикиСРПВ
	|		ПО НахождениеВагоновНаПутяхСРПВ.WaggonDispatchId = КлючиАналитикиСРПВ.ИдентификаторОтправкиВагона
	|		И КлючиАналитикиСРПВ.ТипОперации = ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Приемка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.гкс_СтруктураПЛК КАК СтруктураПЛК
	|		ПО НахождениеВагоновНаПутяхСРПВ.Путь = СтруктураПЛК.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагоныНаПутях.Вагон КАК Вагон,
	|	ВагоныНаПутях.Путь КАК Путь,
	|	ВагоныНаПутях.ПутьТочкаМаршрута КАК ПутьТочкаМаршрута,
	|	ВагоныНаПутях.WaggonIndexPark КАК WaggonIndexPark,
	|	ЕСТЬNULL(ДокументыРегистрацияНаПЛК.Ссылка, ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)) КАК
	|		ДокументРегистрации,
	|	ЕСТЬNULL(ДокументыРегистрацияНаПЛК.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ЕСТЬNULL(ДокументыРегистрацияНаПЛК.Номенклатура.НаименованиеПолное, &Неинициализировано) КАК НоменклатураНаименование
	|ПОМЕСТИТЬ ВагоныНаПутяхРегистрации
	|ИЗ
	|	ВагоныНаПутях КАК ВагоныНаПутях
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_СРПВПрибытиеНаПуть КАК СРПВПрибытиеНаПуть
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_РегистрацияНаПЛК КАК ДокументыРегистрацияНаПЛК
	|			ПО СРПВПрибытиеНаПуть.Ссылка = ДокументыРегистрацияНаПЛК.ДокументОснование
	|		ПО ВагоныНаПутях.КлючАналитики = СРПВПрибытиеНаПуть.ИдентификаторОтправки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СостоянияРегистрации.ДокументРегистрации КАК ДокументРегистрации,
	|	СостоянияРегистрации.Состояние КАК Состояние
	|ПОМЕСТИТЬ СостоянияРегистрации
	|ИЗ
	|	РегистрСведений.гкс_СостоянияРегистрации.СрезПоследних(, ДокументРегистрации В
	|		(ВЫБРАТЬ
	|			ВагоныНаПутяхРегистрации.ДокументРегистрации
	|		ИЗ
	|			ВагоныНаПутяхРегистрации КАК ВагоныНаПутяхРегистрации)) КАК СостоянияРегистрации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НастройкиНазначенияРазгрузки.Номенклатура КАК Номенклатура,
	|	НастройкиНазначенияРазгрузки.Силос КАК Силос,
	|	НастройкиНазначенияРазгрузки.ЯмаРазгрузки КАК ЯмаРазгрузки
	|ПОМЕСТИТЬ НастройкиНазначенияРазгрузкиОбщие
	|ИЗ
	|	РегистрСведений.гкс_ДополнительныеНастройкиНазначенияРазгрузки.СрезПоследних(, ТочкаМаршрута = &ТочкаМаршрута
	|	И ВидПеревозки = &ВидПеревозки) КАК НастройкиНазначенияРазгрузки
	|ГДЕ
	|	НастройкиНазначенияРазгрузки.Действует
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НастройкиНазначенияРазгрузки.Номенклатура,
	|	НастройкиНазначенияРазгрузки.Силос,
	|	НастройкиНазначенияРазгрузки.ЯмаРазгрузки
	|ИЗ
	|	РегистрСведений.гкс_НастройкиНазначенияРазгрузки.СрезПоследних(, ТочкаМаршрута = &ТочкаМаршрута
	|	И ВидПеревозки = &ВидПеревозки) КАК НастройкиНазначенияРазгрузки
	|ГДЕ
	|	НастройкиНазначенияРазгрузки.Действует
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	ЯмаРазгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НастройкиНазначенияРазгрузки.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(НастройкиНазначенияРазгрузки.Силос) КАК Силос,
	|	НастройкиНазначенияРазгрузки.ЯмаРазгрузки КАК ЯмаРазгрузки
	|ПОМЕСТИТЬ НастройкиНазначенияРазгрузки
	|ИЗ
	|	НастройкиНазначенияРазгрузкиОбщие КАК НастройкиНазначенияРазгрузки
	|ГДЕ
	|	(НастройкиНазначенияРазгрузки.Номенклатура, НастройкиНазначенияРазгрузки.ЯмаРазгрузки) В
	|		(ВЫБРАТЬ
	|			ВагоныНаПутяхРегистрации.Номенклатура,
	|			ВагоныНаПутяхРегистрации.ПутьТочкаМаршрута
	|		ИЗ
	|			ВагоныНаПутяхРегистрации)
	|СГРУППИРОВАТЬ ПО
	|	НастройкиНазначенияРазгрузки.Номенклатура,
	|	НастройкиНазначенияРазгрузки.ЯмаРазгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагоныНаПутяхРегистрации.Вагон КАК Вагон,
	|	ВагоныНаПутяхРегистрации.Путь КАК Путь,
	|	ВагоныНаПутяхРегистрации.WaggonIndexPark КАК WaggonIndexPark,
	|	ВагоныНаПутяхРегистрации.ДокументРегистрации КАК ДокументРегистрации,
	|	ВагоныНаПутяхРегистрации.Номенклатура КАК Номенклатура,
	|	ВагоныНаПутяхРегистрации.НоменклатураНаименование КАК НоменклатураНаименование,
	|	ЕСТЬNULL(СостоянияРегистрации.Состояние, &Неинициализировано) КАК Состояние,
	|	ЕСТЬNULL(НастройкиНазначенияРазгрузки.Силос, ЗНАЧЕНИЕ(Справочник.гкс_ТочкиМаршрута.ПустаяСсылка)) КАК Силос
	|ПОМЕСТИТЬ ВагоныНаПутяхДетальные
	|ИЗ
	|	ВагоныНаПутяхРегистрации КАК ВагоныНаПутяхРегистрации
	|		ЛЕВОЕ СОЕДИНЕНИЕ СостоянияРегистрации КАК СостоянияРегистрации
	|		ПО ВагоныНаПутяхРегистрации.ДокументРегистрации = СостоянияРегистрации.ДокументРегистрации
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиНазначенияРазгрузки КАК НастройкиНазначенияРазгрузки
	|		ПО ВагоныНаПутяхРегистрации.Номенклатура = НастройкиНазначенияРазгрузки.Номенклатура
	|		И ВагоныНаПутяхРегистрации.ПутьТочкаМаршрута = НастройкиНазначенияРазгрузки.ЯмаРазгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагоныНаПутяхДетальные.Вагон КАК Вагон,
	|	ВагоныНаПутяхДетальные.Путь КАК Путь,
	|	ВагоныНаПутяхДетальные.WaggonIndexPark КАК WaggonIndexPark,
	|	ВагоныНаПутяхДетальные.ДокументРегистрации КАК ДокументРегистрации,
	|	ВагоныНаПутяхДетальные.Номенклатура КАК Номенклатура,
	|	ВагоныНаПутяхДетальные.НоменклатураНаименование КАК НоменклатураНаименование,
	|	ВагоныНаПутяхДетальные.Состояние КАК Состояние,
	|	ВагоныНаПутяхДетальные.Силос КАК Силос
	|ИЗ
	|	ВагоныНаПутяхДетальные КАК ВагоныНаПутяхДетальные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Путь,
	|	WaggonIndexPark
	|ИТОГИ
	|	МАКСИМУМ(WaggonIndexPark)
	|ПО
	|	Путь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагоныНаПутяхДетальные.НоменклатураНаименование КАК Номенклатура,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВагоныНаПутяхДетальные.Вагон) КАК НоменклатураКоличество,
	|	НЕОПРЕДЕЛЕНО КАК Состояние,
	|	НЕОПРЕДЕЛЕНО КАК СостояниеКоличество
	|ИЗ
	|	ВагоныНаПутяхДетальные КАК ВагоныНаПутяхДетальные
	|СГРУППИРОВАТЬ ПО
	|	ВагоныНаПутяхДетальные.НоменклатураНаименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВагоныНаПутяхДетальные.Состояние КАК Состояние,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВагоныНаПутяхДетальные.Вагон) КАК СостояниеКоличество
	|ИЗ
	|	ВагоныНаПутяхДетальные КАК ВагоныНаПутяхДетальные
	|СГРУППИРОВАТЬ ПО
	|	ВагоныНаПутяхДетальные.Состояние";
		
КонецФункции

&НаСервере
Функция ОформлениеВагонаПоСостоянию(Состояние)
	
	ТолщинаЛинии = 3;
	Оформление = Новый Структура;
	Если Состояние = Перечисления.гкс_СостоянияРегистрации.Прибыл Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.Бежевый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.ГотовКОтборуПроб Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.СветлоЖелтый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.ВзятыПробы Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.ЗамшаСветлый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.ПринятыПробы Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.Персиковый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.РезультатыПробПолучены Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.Персиковый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Красный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.КачествоПринято Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.БледноЗеленый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.КачествоНеПринято Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.Лосось);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Коричневый);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.ВыгрузкаРазрешена Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.БледноЛиловый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.Выгружен Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.Золотой);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	ИначеЕсли Состояние = Перечисления.гкс_СостоянияРегистрации.Убыл Тогда 
		Оформление.Вставить("ЦветФона"	, WebЦвета.Голубой);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, ТолщинаЛинии));
	Иначе 
		Оформление.Вставить("ЦветФона"	, WebЦвета.СеребристоСерый);
		Оформление.Вставить("ЦветРамки"	, WebЦвета.Черный);
		Оформление.Вставить("Линия", Новый Линия(ТипЛинииРисункаТабличногоДокумента.ПунктирТочка, ТолщинаЛинии));
	КонецЕсли;
	
	Возврат Оформление;
	
