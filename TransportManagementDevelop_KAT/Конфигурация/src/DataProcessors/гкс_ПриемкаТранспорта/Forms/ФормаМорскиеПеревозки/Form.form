    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ТранспортныеДокументы.Ссылка КАК Коносамент,
	ТранспортныеДокументы.Организация КАК Организация,
	ТранспортныеДокументы.НомерДокумента КАК НомерДокумента,
	ТранспортныеДокументы.ДатаДокумента КАК ДатаДокумента
ИЗ
	Документ.гкс_ТранспортныйДокумент КАК ТранспортныеДокументы
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ТранспортныйДокумент.ТранспортныеСредства КАК ТранспортныеДокументыТранспортныеСредства
		ПО (ТранспортныеДокументыТранспортныеСредства.Ссылка = ТранспортныеДокументы.Ссылка)
ГДЕ
	ТранспортныеДокументы.Проведен
	И ТранспортныеДокументы.ВидПеревозки = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыТранспортныхСредствДоставки.Судно)
{ГДЕ
	ТранспортныеДокументы.ПунктРазгрузки.* КАК ОтборТочкаМаршрута,
	(ЕСТЬNULL(ТранспортныеДокументыТранспортныеСредства.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))).* КАК ОтборНоменклатура,
	(ЕСТЬNULL(ТранспортныеДокументыТранспортныеСредства.ТранспортноеСредство, ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка))).* КАК ОтборСудно}

СГРУППИРОВАТЬ ПО
	ТранспортныеДокументы.Ссылка,
	ТранспортныеДокументы.Организация,
	ТранспортныеДокументы.НомерДокумента,
	ТранспортныеДокументы.ДатаДокумента</queryText>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
