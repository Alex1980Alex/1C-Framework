        <presentationExpression>&quot;&quot; + ПрибытиеСуднаНаПЛК.Номер + &quot; от &quot; + ФОРМАТ(ПрибытиеСуднаНаПЛК.Дата, &quot;ДЛФ=D&quot;)</presentationExpression>
      </fields>
