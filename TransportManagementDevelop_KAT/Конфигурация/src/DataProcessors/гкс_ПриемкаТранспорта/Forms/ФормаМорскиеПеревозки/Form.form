    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВыработкаСмены.Фрахт КАК Фрахт,
	ВыработкаСмены.Трюм КАК Трюм,
	ВыработкаСмены.Силос КАК Силос,
	ВыработкаСмены.Номенклатура КАК Номенклатура,
	ВыработкаСмены.ПроизводственныеСутки КАК ПроизводственныеСутки,
	ВыработкаСмены.КоличествоОборот КАК Количество,
	ВыработкаСмены.Регистратор КАК Регистратор
{ВЫБРАТЬ
	Регистратор,
	Фрахт.*,
	Трюм,
	Силос.*,
	Номенклатура.*,
	ПроизводственныеСутки,
	Количество}
ИЗ
	РегистрНакопления.гкс_ВыработкаСмены.Обороты(,, Авто, {Фрахт} {Трюм}) КАК ВыработкаСмены</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
