            </content>
          </localValue>
        </title>
        <presentationExpression>&quot;&quot; + Коносамент.Номер + &quot; от &quot; + ФОРМАТ(Коносамент.Дата, &quot;ДЛФ=D&quot;)</presentationExpression>
      </fields>
