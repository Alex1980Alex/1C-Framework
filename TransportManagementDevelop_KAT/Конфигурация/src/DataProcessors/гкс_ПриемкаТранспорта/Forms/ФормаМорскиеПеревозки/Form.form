  <attributes>
    <name>СписокФрахтов</name>
    <title>
      <key>ru</key>
      <value>Список фрахтов</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокФрахтов.Фрахт</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СостоянияФрахта.Фрахт КАК Фрахт,
	СостоянияФрахта.Состояние КАК Состояние,
	СостоянияФрахта.Период КАК ДатаСостояния
ПОМЕСТИТЬ СостоянияФрахта
ИЗ
	РегистрСведений.гкс_СостоянияФрахта.СрезПоследних(, {Фрахт.ВидОперации КАК ОтборВидОперации} {Фрахт.ТочкаМаршрута КАК
		ОтборТочкаМаршрута} {Фрахт.Судно КАК ОтборСудно} {НАЧАЛОПЕРИОДА(Фрахт.ДатаПрибытияНачало, ДЕНЬ) КАК
		ОтборДатаПрибытия}) КАК СостоянияФрахта
ГДЕ
	НЕ СостоянияФрахта.Состояние = ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияТранспортныхСредств.Убыл)
{ГДЕ
	СостоянияФрахта.Состояние КАК ОтборСостояние}

ИНДЕКСИРОВАТЬ ПО
	Фрахт
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокументФрахт.Ссылка КАК Фрахт,
	ДокументФрахт.Судно КАК Судно,
	ДокументФрахт.Статус КАК Статус,
	ДокументФрахт.ДатаПрибытияНачало КАК ДатаПрибытияНачало
ПОМЕСТИТЬ ДокументФрахт
ИЗ
	Документ.гкс_Фрахт КАК ДокументФрахт
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_Фрахт.Грузы КАК ДокументФрахтГрузы
		ПО ДокументФрахт.Ссылка = ДокументФрахтГрузы.Ссылка
ГДЕ
	ДокументФрахт.Ссылка В
		(ВЫБРАТЬ
			СостоянияФрахта.Фрахт
		ИЗ
			СостоянияФрахта)
{ГДЕ
	ДокументФрахтГрузы.Номенклатура КАК ОтборНоменклатура}
СГРУППИРОВАТЬ ПО
	ДокументФрахт.Ссылка,
	ДокументФрахт.Судно,
	ДокументФрахт.Статус,
	ДокументФрахт.ДатаПрибытияНачало

ИНДЕКСИРОВАТЬ ПО
	Фрахт
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СостоянияФрахта.Фрахт КАК Фрахт,
	СостоянияФрахта.ДатаСостояния КАК ДатаСостояния,
	СостоянияФрахта.Состояние КАК Состояние,
	ДокументФрахт.Судно КАК Судно,
	ДокументФрахт.Статус КАК Статус,
	ДокументФрахт.ДатаПрибытияНачало КАК ДатаПрибытияНачало,
	ЕСТЬNULL(ДокументПрибытиеСуднаНаПЛК.Ссылка, ЗНАЧЕНИЕ(Документ.гкс_ПрибытиеСуднаНаПЛК.ПустаяСсылка)) КАК
		ПрибытиеСуднаНаПЛК
ИЗ
	СостоянияФрахта КАК СостоянияФрахта
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументФрахт КАК ДокументФрахт
		ПО СостоянияФрахта.Фрахт = ДокументФрахт.Фрахт
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ПрибытиеСуднаНаПЛК КАК ДокументПрибытиеСуднаНаПЛК
		ПО СостоянияФрахта.Фрахт = ДокументПрибытиеСуднаНаПЛК.Фрахт
		И ДокументПрибытиеСуднаНаПЛК.Проведен</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Фрахт</dataPath>
        <field>Фрахт</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Фрахт</value>
            </content>
          </localValue>
        </title>
        <presentationExpression>&quot;&quot; + Фрахт.Номер + &quot; от &quot; + ФОРМАТ(Фрахт.Дата, &quot;ДЛФ=D&quot;)</presentationExpression>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Состояние</dataPath>
        <field>Состояние</field>
