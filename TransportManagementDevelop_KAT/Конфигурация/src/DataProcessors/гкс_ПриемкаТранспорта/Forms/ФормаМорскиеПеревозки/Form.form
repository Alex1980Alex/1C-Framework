    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СостояниеОбработкиСудна.Фрахт</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ПланыРазгрузкиСудов.Фрахт КАК Фрахт,
	ПланыРазгрузкиСудов.Номенклатура КАК Номенклатура,
	ПланыРазгрузкиСудов.Трюм КАК Трюм,
	СУММА(ПланыРазгрузкиСудов.Количество) КАК Количество,
	ПланыРазгрузкиСудов.Порядок КАК Порядок
ПОМЕСТИТЬ ПланыРазгрузкиСудов
ИЗ
	РегистрСведений.гкс_ПланыРазгрузкиСудов КАК ПланыРазгрузкиСудов
{ГДЕ
	ПланыРазгрузкиСудов.Фрахт КАК Фрахт}
СГРУППИРОВАТЬ ПО
	ПланыРазгрузкиСудов.Фрахт,
	ПланыРазгрузкиСудов.Номенклатура,
	ПланыРазгрузкиСудов.Трюм,
	ПланыРазгрузкиСудов.Порядок

ИНДЕКСИРОВАТЬ ПО
	Фрахт
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СостоянияОбработкиСудов.Период КАК Период,
	СостоянияОбработкиСудов.Фрахт КАК Фрахт,
	СостоянияОбработкиСудов.Трюм КАК Трюм,
	СостоянияОбработкиСудов.Силос КАК Силос,
	СостоянияОбработкиСудов.Состояние КАК Состояние
ПОМЕСТИТЬ СостоянияОбработкиСудов
ИЗ
	РегистрСведений.гкс_СостоянияОбработкиСудов.СрезПоследних(, Фрахт В
		(ВЫБРАТЬ
			ПланыРазгрузкиСудов.Фрахт
		ИЗ
			ПланыРазгрузкиСудов)) КАК СостоянияОбработкиСудов

ИНДЕКСИРОВАТЬ ПО
	Фрахт,
	Трюм
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВыработкаСменыОбороты.Фрахт КАК Фрахт,
	ВыработкаСменыОбороты.Трюм КАК Трюм,
	ВыработкаСменыОбороты.КоличествоОборот КАК КоличествоВыгружено
ПОМЕСТИТЬ ОбработкаСудов
ИЗ
	РегистрНакопления.гкс_ВыработкаСмены.Обороты(,,, Фрахт В
		(ВЫБРАТЬ
			ПланыРазгрузкиСудов.Фрахт
		ИЗ
			ПланыРазгрузкиСудов)) КАК ВыработкаСменыОбороты

ИНДЕКСИРОВАТЬ ПО
	Фрахт,
	Трюм
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПланыРазгрузкиСудов.Фрахт КАК Фрахт,
	ПланыРазгрузкиСудов.Номенклатура КАК Номенклатура,
	ПланыРазгрузкиСудов.Трюм КАК Трюм,
	ПланыРазгрузкиСудов.Количество КАК Количество,
	ПланыРазгрузкиСудов.Порядок КАК Порядок,
	ЕСТЬNULL(СостоянияОбработкиСудов.Состояние, &amp;ПредставлениеПустогоСтатуса) КАК Состояние,
	ЕСТЬNULL(СостоянияОбработкиСудов.Силос, &amp;ПустойСилос) КАК Силос,
	ВЫБОР
		КОГДА СостоянияОбработкиСудов.Состояние = ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияОбработкиСудна.Выгружается)
			ТОГДА ЕСТЬNULL(СостоянияОбработкиСудов.Силос, &amp;ПустойСилос)
		ИНАЧЕ &amp;ПустойСилос
	КОНЕЦ КАК ТекущийСилос,
	ЕСТЬNULL(ОбработкаСудов.КоличествоВыгружено, 0) КАК КоличествоВыгружено
{ВЫБРАТЬ
	Фрахт.*,
	Номенклатура.*,
	Трюм,
	Количество,
	Порядок,
	Состояние.*,
	Силос.*,
	ТекущийСилос.*,
	КоличествоВыгружено}
ИЗ
	ПланыРазгрузкиСудов КАК ПланыРазгрузкиСудов
		ЛЕВОЕ СОЕДИНЕНИЕ СостоянияОбработкиСудов КАК СостоянияОбработкиСудов
		ПО ПланыРазгрузкиСудов.Фрахт = СостоянияОбработкиСудов.Фрахт
		И ПланыРазгрузкиСудов.Трюм = СостоянияОбработкиСудов.Трюм
		ЛЕВОЕ СОЕДИНЕНИЕ ОбработкаСудов КАК ОбработкаСудов
		ПО ПланыРазгрузкиСудов.Фрахт = ОбработкаСудов.Фрахт
		И ПланыРазгрузкиСудов.Трюм = ОбработкаСудов.Трюм</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
