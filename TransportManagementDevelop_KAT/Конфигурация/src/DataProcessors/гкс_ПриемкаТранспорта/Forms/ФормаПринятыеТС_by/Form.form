    </edit>
  </attributes>
  <attributes>
    <name>СписокДокументов</name>
    <title>
      <key>ru</key>
      <value>Список документов</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <functionalOptions>FunctionalOption.гкс_ФормироватьКомпозитныйЛабораторныйАнализАвто</functionalOptions>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.Брутто</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.ДокументРегистрации</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.ЕдиницаИзмеренияВеса</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.ЕдиничнаяПроба</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.ЛабораторныйАнализЕдиничный</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.ЛабораторныйАнализКомпозит</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.Нетто</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.РеестрНакладных</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.РеестрСформирован</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДокументов.Тара</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РегистрацияНаПЛК.Ссылка КАК ДокументРегистрации,
	РегистрацияНаПЛК.ЕдиницаИзмеренияВеса КАК ЕдиницаИзмеренияВеса,
	РегистрацияНаПЛК.ТипРегистрации КАК ТипРегистрации,
	РегистрацияНаПЛК.ТранспортноеСредство КАК ТранспортноеСредство
ПОМЕСТИТЬ ВТ_Регистрации
ИЗ
	Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СостоянияРегистрации.СрезПоследних(, ТипРегистрации = &amp;ТипРегистрации
		И ВидПеревозки = &amp;ВидПеревозки
		И Состояние = &amp;Состояние) КАК СостоянияРегистрацииСрезПоследних
		ПО СостоянияРегистрацииСрезПоследних.ДокументРегистрации = РегистрацияНаПЛК.Ссылка
ГДЕ
	РегистрацияНаПЛК.Проведен
	И РегистрацияНаПЛК.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И РегистрацияНаПЛК.ТипРегистрации = &amp;ТипРегистрации
	И РегистрацияНаПЛК.ВидПеревозки = &amp;ВидПеревозки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Регистрации.ДокументРегистрации КАК ДокументРегистрации,
	ФормированиеНомераПробыДокумент.Ссылка КАК ЕдиничнаяПроба,
	ЕСТЬNULL(СправочникНомераПроб.Код, &quot;&quot;) КАК НомерПробы,
	ФормированиеНомераПробыДокумент.ПроизводственныеСуткиРегистрации КАК ПроизводственныеСуткиРегистрации,
	РеестрНакладныхЗПП3Накладные.Ссылка КАК РеестрНакладных,
	СопоставлениеФНПЕдиничный.ЛабораторныйАнализ КАК ЛабораторныйАнализЕдиничный
ПОМЕСТИТЬ ВТ_ЕдиничныеПробы
ИЗ
	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФормированиеНомераПробыСписокРегистраций
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Регистрации КАК ВТ_Регистрации
		ПО ВТ_Регистрации.ДокументРегистрации = ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы КАК ФормированиеНомераПробыДокумент
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.гкс_НомерПробы КАК СправочникНомераПроб
			ПО ФормированиеНомераПробыДокумент.НомерПробы = СправочникНомераПроб.Ссылка
		ПО ФормированиеНомераПробыСписокРегистраций.Ссылка = ФормированиеНомераПробыДокумент.Ссылка
		И ФормированиеНомераПробыДокумент.Проведен
		И ФормированиеНомераПробыДокумент.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_РеестрНакладныхЗПП3.Накладные КАК РеестрНакладныхЗПП3Накладные
		ПО ВТ_Регистрации.ДокументРегистрации = РеестрНакладныхЗПП3Накладные.ДокументРегистрации
		И НЕ РеестрНакладныхЗПП3Накладные.Ссылка.ПометкаУдаления
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК СопоставлениеФНПЕдиничный
		ПО СопоставлениеФНПЕдиничный.ФормированиеНомераПробы = ФормированиеНомераПробыДокумент.Ссылка
		И
			СопоставлениеФНПЕдиничный.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.Приемка)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Регистрации.ДокументРегистрации КАК ДокументРегистрации,
	МАКСИМУМ(ФактическиеПоказателиКачества.Регистратор) КАК ЛабораторныйАнализКомпозит
ПОМЕСТИТЬ ВТ_КомпозитныеПробы
ИЗ
	ВТ_Регистрации КАК ВТ_Регистрации
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ФактическиеПоказателиКачества КАК ФактическиеПоказателиКачества
		ПО ВТ_Регистрации.ДокументРегистрации = ФактическиеПоказателиКачества.РегистрацияНаПЛК
		И
			ФактическиеПоказателиКачества.НазначениеИспользованияКачества = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПриемкаКомпозит)
СГРУППИРОВАТЬ ПО
	ВТ_Регистрации.ДокументРегистрации
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_Регистрации.ДокументРегистрации КАК ДокументРегистрации,
	ВТ_Регистрации.ЕдиницаИзмеренияВеса КАК ЕдиницаИзмеренияВеса,
	СУММА(ВЫБОР
		КОГДА ВТ_Регистрации.ТипРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Приемка)
		И ЕСТЬNULL(Взвешивание.ТипВзвешивания, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыВзвешивания.Въезд)
			ТОГДА ЕСТЬNULL(Взвешивание.Вес, 0)
		КОГДА ВТ_Регистрации.ТипРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Отгрузка)
		И ЕСТЬNULL(Взвешивание.ТипВзвешивания, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыВзвешивания.Выезд)
			ТОГДА ЕСТЬNULL(Взвешивание.Вес, 0)
		ИНАЧЕ 0
	КОНЕЦ) КАК Брутто,
	СУММА(ВЫБОР
		КОГДА ВТ_Регистрации.ТипРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Приемка)
		И ЕСТЬNULL(Взвешивание.ТипВзвешивания, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыВзвешивания.Выезд)
			ТОГДА ЕСТЬNULL(Взвешивание.Вес, 0)
		КОГДА ВТ_Регистрации.ТипРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Отгрузка)
		И ЕСТЬNULL(Взвешивание.ТипВзвешивания, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыВзвешивания.Въезд)
			ТОГДА ЕСТЬNULL(Взвешивание.Вес, 0)
		ИНАЧЕ 0
	КОНЕЦ) КАК Тара
ПОМЕСТИТЬ ВТ_Взвешивание
ИЗ
	ВТ_Регистрации КАК ВТ_Регистрации
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_Взвешивание КАК Взвешивание
		ПО Взвешивание.ДокументРегистрации = ВТ_Регистрации.ДокументРегистрации
		И Взвешивание.Проведен
СГРУППИРОВАТЬ ПО
	ВТ_Регистрации.ДокументРегистрации,
	ВТ_Регистрации.ЕдиницаИзмеренияВеса
;

////////////////////////////////////////////////////////////////////////////////

ВЫБРАТЬ
	// GKSTCPLK-2671. Обязательные показатели первичного анализа (влажность зерна,
	// сорная примесь, масличная примесь): сколько их фактически в качественных
	// показателях анализа и по скольким из них есть значение.
	КачПоказатели.Ссылка КАК ЛабораторныйАнализЕдиничный,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КачПоказатели.Показатель) КАК ТребуетсяОбязательных,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
			КОГДА КачПоказатели.Значение &lt;> 0
				ТОГДА КачПоказатели.Показатель
			ИНАЧЕ NULL
		КОНЕЦ) КАК ЗаполненоОбязательных
ПОМЕСТИТЬ ВТ_КонтрольКачества
ИЗ
	Документ.гкс_ЛабораторныйАнализ.КачественныеПоказатели КАК КачПоказатели
ГДЕ
	КачПоказатели.Показатель В (
			ЗНАЧЕНИЕ(Справочник.гкс_ПоказателиАнализовНоменклатуры.ВлажностьЗерна),
			ЗНАЧЕНИЕ(Справочник.гкс_ПоказателиАнализовНоменклатуры.СорнаяПримесь),
			ЗНАЧЕНИЕ(Справочник.гкс_ПоказателиАнализовНоменклатуры.МасличнаяПримесь))
	И КачПоказатели.Ссылка В
		(ВЫБРАТЬ
			ВТ_ЕдиничныеПробы.ЛабораторныйАнализЕдиничный
		ИЗ
			ВТ_ЕдиничныеПробы КАК ВТ_ЕдиничныеПробы)
СГРУППИРОВАТЬ ПО
	КачПоказатели.Ссылка
ИНДЕКСИРОВАТЬ ПО
	ЛабораторныйАнализЕдиничный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Регистрации.ДокументРегистрации КАК ДокументРегистрации,
	РегистрацияНаПЛК.Дата КАК ДатаРегистрации,
	РегистрацияНаПЛК.Номер КАК НомерРегистрации,
	ВТ_ЕдиничныеПробы.ЕдиничнаяПроба КАК ЕдиничнаяПроба,
	ВТ_ЕдиничныеПробы.НомерПробы КАК НомерПробы,
	ВТ_ЕдиничныеПробы.РеестрНакладных КАК РеестрНакладных,
	ВТ_ЕдиничныеПробы.ЛабораторныйАнализЕдиничный КАК ЛабораторныйАнализЕдиничный,
	ЕСТЬNULL(ВТ_КомпозитныеПробы.ЛабораторныйАнализКомпозит, ЗНАЧЕНИЕ(Документ.гкс_ЛабораторныйАнализ.ПустаяСсылка)) КАК
		ЛабораторныйАнализКомпозит,
	ВТ_ЕдиничныеПробы.ПроизводственныеСуткиРегистрации КАК ПроизводственныеСуткиРегистрации,
	ВТ_Регистрации.ЕдиницаИзмеренияВеса КАК ЕдиницаИзмеренияВеса,
	ЕСТЬNULL(ВТ_Взвешивание.Брутто, 0) КАК Брутто,
	ЕСТЬNULL(ВТ_Взвешивание.Тара, 0) КАК Тара,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_Взвешивание.Тара, 0) > 0
			ТОГДА ЕСТЬNULL(ВТ_Взвешивание.Брутто, 0) - ЕСТЬNULL(ВТ_Взвешивание.Тара, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК Нетто,
	НЕ ВТ_ЕдиничныеПробы.РеестрНакладных ЕСТЬ NULL КАК РеестрСформирован,
	ВТ_Регистрации.ТранспортноеСредство КАК ТранспортноеСредство,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_КонтрольКачества.ЗаполненоОбязательных, 0) &lt; ЕСТЬNULL(ВТ_КонтрольКачества.ТребуетсяОбязательных, 0)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьНеЗаполненныеОбязательныеПоказатели
ИЗ
	ВТ_Регистрации КАК ВТ_Регистрации
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕдиничныеПробы КАК ВТ_ЕдиничныеПробы
		ПО ВТ_Регистрации.ДокументРегистрации = ВТ_ЕдиничныеПробы.ДокументРегистрации
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КомпозитныеПробы КАК ВТ_КомпозитныеПробы
		ПО ВТ_Регистрации.ДокументРегистрации = ВТ_КомпозитныеПробы.ДокументРегистрации
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Взвешивание КАК ВТ_Взвешивание
		ПО ВТ_Регистрации.ДокументРегистрации = ВТ_Взвешивание.ДокументРегистрации
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		ПО ВТ_Регистрации.ДокументРегистрации = РегистрацияНаПЛК.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КонтрольКачества КАК ВТ_КонтрольКачества
		ПО ВТ_КонтрольКачества.ЛабораторныйАнализЕдиничный = ВТ_ЕдиничныеПробы.ЛабораторныйАнализЕдиничный
ГДЕ
	НЕ ВТ_ЕдиничныеПробы.ЛабораторныйАнализЕдиничный ЕСТЬ NULL</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
