        <field>ЕдиничнаяПроба</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Единичная проба</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>НомерПробы</dataPath>
        <field>НомерПробы</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Номер пробы</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ЛабораторныйАнализКомпозит</dataPath>
        <field>ЛабораторныйАнализКомпозит</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Лабораторный анализ композит</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ЛабораторныйАнализЕдиничный</dataPath>
        <field>ЛабораторныйАнализЕдиничный</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Лабораторный анализ единичный</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>РеестрНакладных</dataPath>
        <field>РеестрНакладных</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Реестр накладных</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ПроизводственныеСуткиРегистрации</dataPath>
        <field>ПроизводственныеСуткиРегистрации</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ЕдиницаИзмеренияВеса</dataPath>
        <field>ЕдиницаИзмеренияВеса</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Брутто</dataPath>
        <field>Брутто</field>
        <title>
          <localValue>
