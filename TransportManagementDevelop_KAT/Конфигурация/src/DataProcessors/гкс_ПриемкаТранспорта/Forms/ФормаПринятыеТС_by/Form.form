  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Объект</name>
    <id>1</id>
    <valueType>
      <types>DataProcessorObject.гкс_ПриемкаТранспорта</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
