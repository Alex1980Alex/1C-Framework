    </toolTip>
    <toolTip>
      <key>es</key>
      <value>introducir manualmente el peso</value>
    </toolTip>
    <use>
      <common>true</common>
      <for>
        <value>true</value>
        <role>Role.АдминистраторСистемы</role>
      </for>
      <for>
        <role>Role.Администрирование</role>
      </for>
      <for>
        <role>Role.БазовыеПраваБСП</role>
      </for>
      <for>
        <role>Role.БазовыеПраваВнешнихПользователейБСП</role>
      </for>
      <for>
        <role>Role.ВыводНаПринтерФайлБуферОбмена</role>
      </for>
      <for>
        <role>Role.ВыполнениеСинхронизацииДанных</role>
      </for>
      <for>
        <role>Role.гкс_БазовыаПраваИнтеграционныйАдаптер</role>
      </for>
      <for>
        <role>Role.гкс_БазовыеПраваАналитика</role>
      </for>
      <for>
        <role>Role.гкс_БазовыеПраваУправлениеТранспортомНаПЛК</role>
      </for>
      <for>
        <role>Role.гкс_ВзаимодействиеССервисомLIMs</role>
      </for>
      <for>
        <role>Role.гкс_ВзаимодействиеССервисомВесов</role>
      </for>
      <for>
        <role>Role.гкс_ВозможностьМенятьДопускПретензионныйВАРМеПриемкиНаПЛК</role>
      </for>
      <for>
        <role>Role.гкс_ВозможностьМенятьДопускФитосанитарныйВАРМеПриемкиНаПЛК</role>
      </for>
      <for>
        <role>Role.гкс_ВозможностьМенятьДопускФумигационныйВАРМеПриемкиНаПЛК</role>
      </for>
      <for>
        <role>Role.гкс_Документ_ЗаявкаНаОтгрузкуПродукции_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_Документ_ПриказНаОтпускПродукцииЭлеватораЗПП16_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_РегистрСведений_РегистрацииПоЭлектроннойОчереди_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_Документ_РеестрНакладныхЗПП3_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_Документ_Взвешивание_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_Документ_ЗаданияНаПроверкуКачества_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_Документ_ЛабораторныйАнализ_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_Документ_НаправлениеНаРазгрузку_ДобавлениеИзменение</role>
      </for>
      <for>
        <role>Role.гкс_Документ_НормативнаяСертификацияНоменклатуры_ДобавлениеИзменение</role>
      </for>
      <for>
