															"transport", 1, "ПКС_ТранспортноеСредство");
	
	гкс_ОбменДаннымиWarehouse.ДобавитьПКС(ПравилаКонвертации, "СтанцияОтправленияWarehouse", 
															"stationId", 1, "ПКС_СтанцияОтправленияWarehouse");
	
