#Область Проведение

// Описывает учетные механизмы используемые в документе для регистрации в механизме проведения.
//
// Параметры:
//  МеханизмыДокумента - Массив - список имен учетных механизмов, для которых будет выполнена
//              регистрация в механизме проведения.
//
Процедура ЗарегистрироватьУчетныеМеханизмы(МеханизмыДокумента) Экспорт
	
	МеханизмыДокумента.Добавить("РегистрацияВнешнихПроб");
	
КонецПроцедуры

// Возвращает таблицы для движений, необходимые для проведения документа по регистрам учетных механизмов.
//
// Параметры:
//  Документ - ДокументСсылка - ссылка на документ, по которому необходимо получить данные
//  Регистры - Структура - список имен регистров, для которых необходимо получить таблицы
//  ДопПараметры - Структура - дополнительные параметры для получения данных, определяющие контекст проведения.
//
// Возвращаемое значение:
//  Структура - коллекция элементов:
//     * Таблица<ИмяРегистра> - ТаблицаЗначений - таблица данных для отражения в регистр.
//
Функция ДанныеДокументаДляПроведения(Документ, Регистры, ДопПараметры = Неопределено) Экспорт
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = гкс_ПроведениеДокументов.ДопПараметрыИнициализироватьДанныеДокументаДляПроведения();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый СписокЗначений;
	
	Если Не ДопПараметры.ПолучитьТекстыЗапроса Тогда
		// Создадим запрос инициализации движений		
		ЗаполнитьПараметрыИнициализации(Запрос, Документ, ДопПараметры);
		// Сформируем текст запроса
		
		ТекстЗапросаТаблицаВнешниеПробы(ТекстыЗапроса, Регистры);
		ТекстЗапросаТаблицаВнешниеПробыПоЗаявкамНаПеревозку(ТекстыЗапроса, Регистры);
		ТекстЗапросаТаблицаКонтрольЗаполненияВнешнихПроб(ТекстыЗапроса, Регистры);
		
	КонецЕсли;
	
	// Получим таблицы для движений
	Возврат гкс_ПроведениеДокументов.ИнициализироватьДанныеДокументаДляПроведения(Запрос, ТекстыЗапроса, ДопПараметры);
	
КонецФункции

#КонецОбласти

// Выполняет пакет запросов к сервису Warehouse для обновления данных внешних проб.
//
// Параметры:
//   ДокументыВнешнейПробы - Массив из ДокументСсылка.гкс_ВнешняяПроба - массив ссылок для обновления
//
Процедура ОбновитьДаннымиИзWarehouse(ДокументыВнешнейПробы) Экспорт
	
	Для Каждого ДокументВнешнейПробы Из ДокументыВнешнейПробы Цикл
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("Ссылка", ДокументВнешнейПробы);
		
		ВыполнитьЗапросКWarehouse("ExternalSamples_GetById", ПараметрыЗапроса);
		
	КонецЦикла;	
	
КонецПроцедуры

// Выполняет запрос к сервису Warehouse для загрузки данных за период.
//
// Параметры:
//	ИмяМетода - Строка -  Имя метода Warehouse для получения данных по пробам 
// 	ПериодЗагрузки - Структура
//		*ДатаНачала		- Дата - дата начало периода внесения изменений
//      *ДатаОкончания  - Дата - дата окончания периода внесения изменений
//
Процедура ЗагрузитьВнешниеПробыЗаПериод(ИмяМетода, ПериодЗагрузки = Неопределено) Экспорт
	
	Если ПериодЗагрузки = Неопределено Тогда
		
		ДатаЗагрузки = ТекущаяУниверсальнаяДата();

		ПериодЗагрузки = Новый Структура;
		ПериодЗагрузки.Вставить("ДатаНачала",  НачалоДня(ДатаЗагрузки));
		ПериодЗагрузки.Вставить("ДатаОкончания",  КонецДня(ДатаЗагрузки));
	КонецЕсли;
	
	ДатаОбработки = ПериодЗагрузки.ДатаНачала;
	Пока ДатаОбработки <= ПериодЗагрузки.ДатаОкончания Цикл
		
		ПараметрыВЗапрос = Новый Структура;
		ПараметрыВЗапрос.Вставить("dateFrom", ЗаписатьДатуJSON(НачалоДня(ДатаОбработки), 
			ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
		
		ПараметрыВЗапрос.Вставить("dateTo", ЗаписатьДатуJSON(КонецДня(ДатаОбработки),
			ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
		
		ПараметрыЗапроса = Новый Структура("params", ПараметрыВЗапрос);	
		
		ВыполнитьЗапросКWarehouse(ИмяМетода, ПараметрыЗапроса);
		
		ДатаОбработки = ДатаОбработки + гкс_ОбщегоНазначенияКлиентСервер.ЧислоСекундВСутках();
	КонецЦикла;	
					
КонецПроцедуры

// Выполняет запрос к сервису Warehouse для указанного типа операции и обрабатывает полученный ответ.
//
// Параметры:
//   ТипЗапроса - Строка- тип выполняемого запроса
//   ПараметрыЗапроса - Структура - параметры для формирования запроса
//
Процедура ВыполнитьЗапросКWarehouse(ТипЗапроса, ПараметрыЗапроса) Экспорт
	
	РесурсыСервисов = Справочники.гкс_РесурсыВебСервисов;
	РесурсВебСервиса = РесурсыСервисов.ОписаниеПоИмениПредопределенного(ТипЗапроса);
	
	Если Не ЗначениеЗаполнено(РесурсВебСервиса) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РесурсВебСервиса = РесурсыСервисов.ExternalSamples_GetById Тогда	
		ПараметрыЗапроса.Вставить(ИмяКлючевогоСвойстваВWarehouse(), 
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗапроса.Ссылка, ИмяКлючевогоСвойства()));		
	КонецЕсли;
	
	ИменаСвойствСоЗначениямиДата = гкс_ОбменДаннымиWarehouse.ИменаСвойствСоЗначениямиДата();
	ИменаСвойствДляОбработкиВосстановления = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		ИменаСвойствСоЗначениямиДата, ",");
	
	ПараметрыПреобразованияJSON = Новый Структура;
	ПараметрыПреобразованияJSON.Вставить("ПрочитатьВСоответствие", Ложь);
	ПараметрыПреобразованияJSON.Вставить("ИмяФункцииВосстановления", "ДесериализацияСвойствВнешнихПроб");
	ПараметрыПреобразованияJSON.Вставить("МодульФункцииВосстановления", 
										ОбщегоНазначения.ОбщийМодуль("гкс_ОбменДаннымиWarehouse"));
	ПараметрыПреобразованияJSON.Вставить("ИменаСвойствДляОбработкиВосстановления",
										ИменаСвойствДляОбработкиВосстановления);
	
	ДанныеОтвета = гкс_ИнтеграцияWarehouse.ВыполнитьЗапросКWarehouse(
		РесурсВебСервиса, ПараметрыЗапроса, ПараметрыПреобразованияJSON);
		
	Если ТипЗнч(ДанныеОтвета) = Тип("Массив") Тогда
		Для Каждого ДанныеОтветаВСтруктуре Из ДанныеОтвета Цикл
			ДокументСсылка = ПустаяСсылка();	
			гкс_ОбменДаннымиWarehouse.ОбработатьПолученныеДанные(ДанныеОтветаВСтруктуре, ДокументСсылка);	
		КонецЦикла;	
	Иначе
		ДанныеОтветаВСтруктуре = ДанныеОтвета;
		ДокументСсылка = ПустаяСсылка();	
		гкс_ОбменДаннымиWarehouse.ОбработатьПолученныеДанные(ДанныеОтветаВСтруктуре, ДокументСсылка);	
	КонецЕсли;
	
КонецПроцедуры	

// Обновляет или создает документ "Внешняя проба" на основании данных из системы Warehouse. 
// Записывает документ при изменении контрольной суммы.
//
// Параметры:
//   ДанныеИсточника - Массив из Структура - Массив структур с данными пробы из Warehouse. 
//   Первая структура содержит основные данные, остальные — показатели качества.
//	
Процедура ОбновитьПоДаннымWarehouse(ДанныеИсточника) Экспорт
	
	МенеджерСоотвествияОбъектов = РегистрыСведений.гкс_СоответствиеОбъектовWarehouse;
	
	ПерваяСтрокаДанных = ДанныеИсточника[0];
	ДокументВнешнейПробы = ПолучитьСсылкуПоИдентификатору(ПерваяСтрокаДанных.ИДПробы);
	
	Если Не ЗначениеЗаполнено(ДокументВнешнейПробы) Тогда
		ВнешняяПроба = Документы.гкс_ВнешняяПроба.СоздатьДокумент();
	Иначе
		ВнешняяПроба = ДокументВнешнейПробы.ПолучитьОбъект(); 
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ВнешняяПроба, ПерваяСтрокаДанных);
	ВнешняяПроба.Дата = ПерваяСтрокаДанных.ДатаПробы;
	ВнешняяПроба.НоменклатураWarehouse = ПерваяСтрокаДанных.Продукция;
	ВнешняяПроба.Номенклатура = МенеджерСоотвествияОбъектов.
								СсылкаОбъектаПоСсылкеWarehouse(ПерваяСтрокаДанных.Продукция);
	
	ВнешняяПроба.КачественныеПоказатели.Очистить();
	
	Для Каждого ДанныеСтроки Из ДанныеИсточника Цикл
		НоваяСтрока = ВнешняяПроба.КачественныеПоказатели.Добавить();
		НоваяСтрока.ВидПробы = ДанныеСтроки.ВидПробы;
		НоваяСтрока.ПоказательВнешний = ДанныеСтроки.Показатель;
		НоваяСтрока.Показатель = МенеджерСоотвествияОбъектов.
								СсылкаОбъектаПоСсылкеWarehouse(ДанныеСтроки.Показатель);
								
		НоваяСтрока.Значение = ДанныеСтроки.ЗначениеПоказателя;
	КонецЦикла;
	
	КонтрольнаяСуммаДокументаНовая = ВнешняяПроба.КонтрольнаяСуммаДокумента();
	
	// записываем только если есть изменения ключевых данных
	Если ВнешняяПроба.КонтрольнаяСумма = КонтрольнаяСуммаДокументаНовая Тогда
		Возврат;
	КонецЕсли;	
	
	Попытка
		ВнешняяПроба.Записать(РежимЗаписиДокумента.Проведение);
	Исключение			
		ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Интеграция Warehouse.Формирование документов ""Внешняя проба""'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки);			
	КонецПопытки;	
	
КонецПроцедуры

// Возвращает ссылку на документ по идентификатору
//
// Параметры:
//  Идентификатор - Строка - идентификатор Warehouse.
// 
// Возвращаемое значение:
//  ДокументСсылка.гкс_ВнешняяПроба - ссылка на документ.
//
Функция ПолучитьСсылкуПоИдентификатору(Идентификатор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВнешняяПроба.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.гкс_ВнешняяПроба КАК ВнешняяПроба
	|ГДЕ
	|	ВнешняяПроба.ИДПробы = &Идентификатор";
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);	
	РезультатЗапроса = Запрос.Выполнить();	
		
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	Иначе	
		Результат = ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

// Вычисляет контрольную сумму по алгоритму MD5.
//
// Параметры:
//  КонтролируемыеДанные - Структура
// 
// Возвращаемое значение:
//  Строка - контрольная сумма строкой без пробелов (например 32 символа).
//
Функция КонтрольнаяСумма(КонтролируемыеДанные) Экспорт
	
	Возврат ОбщегоНазначения.КонтрольнаяСуммаСтрокой(КонтролируемыеДанные);
	
КонецФункции

