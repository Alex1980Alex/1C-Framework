// СтандартныеПодсистемы.УправлениеДоступом

// Параметры:
//   Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка, ДопПараметры)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
КонецПроцедуры

Процедура ТекстЗапросаТаблицаВнешниеПробы(ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "гкс_ВнешниеПробы";
	
	Если Не гкс_ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат;
	КонецЕсли; 
		
	ТекстЗапроса = 	
		"ВЫБРАТЬ
		|	ВнешняяПроба.Дата КАК Период,
		|	ВнешняяПроба.Ссылка КАК Регистратор,
		|	ВнешняяПробаКачественныеПоказатели.ВидПробы КАК ВидПробы,
		|	ВнешняяПроба.ДатаИзменения КАК ДатаИзменения,
		|	ВнешняяПроба.ДатаПогрузки КАК ДатаПогрузки,
		|	ВнешняяПроба.Дата КАК ДатаПробы,
		|	ВнешняяПроба.ИДКомпозитнойПробы КАК ИДКомпозитнойПробы,
		|	ВнешняяПроба.ИДПробы КАК ИДПробы,
		|	ВнешняяПроба.МестоИнспекции КАК МестоИнспекции,
		|	ВнешняяПроба.НомерДокумента КАК НомерДокумента,
		|	ВнешняяПроба.НомерЗаявки КАК НомерЗаявки,
		|	ВнешняяПроба.НомерТС КАК НомерТС,
		|	ВнешняяПроба.Организация КАК Организация,
		|	ВнешняяПробаКачественныеПоказатели.ПоказательВнешний КАК Показатель,
		|	ВнешняяПроба.НоменклатураWarehouse КАК Продукция,
		|	ВнешняяПроба.СтанцияНазначения КАК СтанцияНазначения,
		|	ВнешняяПроба.СтанцияОтправления КАК СтанцияОтправления,
		|	ВнешняяПроба.Сюрвейер КАК Сюрвейер,
		|	ВнешняяПроба.Элеватор КАК Элеватор,
		|	ВнешняяПроба.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВнешняяПроба.ВесБрутто КАК ВесБрутто,
		|	ВнешняяПроба.ВесТары КАК ВесТары,
		|	ВнешняяПроба.ВесНетто КАК ВесНетто,
		|	ВнешняяПробаКачественныеПоказатели.Значение КАК ЗначениеПоказателя,
		|	ВнешняяПробаКачественныеПоказатели.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.гкс_ВнешняяПроба КАК ВнешняяПроба
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ВнешняяПроба.КачественныеПоказатели КАК ВнешняяПробаКачественныеПоказатели
		|		ПО (ВнешняяПробаКачественныеПоказатели.Ссылка = ВнешняяПроба.Ссылка)
		|ГДЕ
		|	ВнешняяПроба.Ссылка = &Ссылка
		|	И ВнешняяПроба.Проведен
		|	И ВнешняяПробаКачественныеПоказатели.Значение <> 0";	
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
		
КонецПроцедуры

Процедура ТекстЗапросаТаблицаВнешниеПробыПоЗаявкамНаПеревозку(ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "гкс_ВнешниеПробыПоЗаявкамНаПеревозку";
	
	Если Не гкс_ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат;
	КонецЕсли; 
		
	ТекстЗапроса = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнешняяПроба.Ссылка КАК Регистратор,
		|	ВнешняяПроба.Ссылка КАК ВнешняяПроба,
		|	ВнешняяПроба.ВидПеревозки КАК ВидПеревозки,
		|	ВнешняяПроба.Номенклатура КАК Номенклатура,
		|	ВнешняяПроба.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВнешняяПроба.НомерТС КАК НомерТС,
		|	ВнешняяПроба.ДатаПогрузки КАК ДатаПогрузки,
		|	ВнешняяПроба.СтанцияОтправления КАК СтанцияОтправления,
		|	ВнешняяПроба.Сюрвейер КАК Сюрвейер,
		|	ВнешняяПробаЗаявкиНаПеревозку.НомерЗаявки КАК НомерЗаявки,
		|	ВнешняяПроба.ВесБрутто КАК ВесБрутто,
		|	ВнешняяПроба.ВесНетто КАК ВесНетто,
		|	ВнешняяПроба.ВесТары КАК ВесТары,
		|	ВнешняяПроба.НомерЗерновоза КАК НомерЗерновоза,
		|	ВнешняяПроба.НомерПрицепа КАК НомерПрицепа,
		|	КачественныеПоказателиАнализа.Показатель КАК Показатель,
		|	КачественныеПоказателиАнализа.Значение КАК ЗначениеПоказателя,
		|	КачественныеПоказателиАнализа.ВидПробы КАК НазначениеИспользованияКачества
		|ИЗ
		|	Документ.гкс_ВнешняяПроба КАК ВнешняяПроба
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ВнешняяПроба.ЗаявкиНаПеревозку КАК ВнешняяПробаЗаявкиНаПеревозку
		|		ПО (ВнешняяПробаЗаявкиНаПеревозку.Ссылка = ВнешняяПроба.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ВнешняяПроба.КачественныеПоказатели КАК КачественныеПоказателиАнализа
		|		ПО (КачественныеПоказателиАнализа.Ссылка = ВнешняяПроба.Ссылка)
		|			И (КачественныеПоказателиАнализа.Показатель <> ЗНАЧЕНИЕ(Справочник.гкс_ПоказателиАнализовНоменклатуры.ПустаяСсылка))
		|			И (КачественныеПоказателиАнализа.Значение <> 0)
		|ГДЕ
		|	ВнешняяПроба.Ссылка = &Ссылка
		|	И ВнешняяПроба.Проведен";	
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
		
КонецПроцедуры
 
Процедура ТекстЗапросаТаблицаКонтрольЗаполненияВнешнихПроб(ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "гкс_КонтрольЗаполненияВнешнихПроб";
	
	Если Не гкс_ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат;
	КонецЕсли; 
		
	ТекстЗапроса = 	
		"ВЫБРАТЬ
		|	ВнешняяПроба.Ссылка КАК ВнешняяПроба,
		|	ВЫБОР
		|		КОГДА НЕ ВнешняяПроба.ОрганизацияWarehouse = ЗНАЧЕНИЕ(Справочник.гкс_КонтрагентыWarehouse.ПустаяСсылка)
		|				И ВнешняяПроба.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СопоставитьОрганизацию,
		|	ВнешняяПроба.ОрганизацияWarehouse КАК ОрганизацияWarehouse,
		|	ВЫБОР
		|		КОГДА ВнешняяПроба.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СопоставитьНоменклатуру,
		|	ВнешняяПроба.НоменклатураWarehouse КАК НоменклатураWarehouse,
		|	ВЫБОР
		|		КОГДА НЕ ВнешняяПроба.СюрвейерWarehouse = ЗНАЧЕНИЕ(Справочник.гкс_КонтрагентыWarehouse.ПустаяСсылка)
		|				И ВнешняяПроба.Сюрвейер = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СопоставитьСюрвейер,
		|	ВнешняяПроба.СюрвейерWarehouse КАК СюрвейерWarehouse,
		|	ВЫБОР
		|		КОГДА НЕ ВнешняяПроба.ЭлеваторWarehouse = ЗНАЧЕНИЕ(Справочник.гкс_КонтрагентыWarehouse.ПустаяСсылка)
		|				И ВнешняяПроба.Элеватор = ЗНАЧЕНИЕ(Справочник.гкс_ТочкиМаршрута.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СопоставитьЭлеватор,
		|	ВнешняяПроба.ЭлеваторWarehouse КАК ЭлеваторWarehouse,
		|	ВЫБОР
		|		КОГДА НЕ ВнешняяПроба.СтанцияОтправленияWarehouse = ЗНАЧЕНИЕ(Справочник.гкс_СтанцииWarehouse.ПустаяСсылка)
		|				И ВнешняяПроба.СтанцияОтправления = ЗНАЧЕНИЕ(Справочник.гкс_КлассификаторСтанцийЖД.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СопоставитьСтанциюОтправления,
		|	ВЫБОР
		|		КОГДА НЕ ВнешняяПроба.СтанцияНазначенияWarehouse = ЗНАЧЕНИЕ(Справочник.гкс_СтанцииWarehouse.ПустаяСсылка)
		|				И ВнешняяПроба.СтанцияНазначения = ЗНАЧЕНИЕ(Справочник.гкс_КлассификаторСтанцийЖД.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СопоставитьСтанциюНазначения,
		|	ВнешняяПроба.СтанцияОтправленияWarehouse КАК СтанцияОтправленияWarehouse,
		|	ВнешняяПроба.СтанцияНазначенияWarehouse КАК СтанцияНазначенияWarehouse
		|ПОМЕСТИТЬ ВТ_ДанныеПроверки
		|ИЗ
		|	Документ.гкс_ВнешняяПроба КАК ВнешняяПроба
		|ГДЕ
		|	ВнешняяПроба.Ссылка = &Ссылка
		|	И ВнешняяПроба.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеПроверки.ВнешняяПроба КАК Регистратор,
		|	ВТ_ДанныеПроверки.ВнешняяПроба КАК ВнешняяПроба,
		|	ВТ_ДанныеПроверки.ОрганизацияWarehouse КАК ОбъектWarehouse,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_ТипыОбъектовWarehouse.Организация) КАК ТипОбъекта
		|ИЗ
		|	ВТ_ДанныеПроверки КАК ВТ_ДанныеПроверки
		|ГДЕ
		|	ВТ_ДанныеПроверки.СопоставитьОрганизацию
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.НоменклатураWarehouse,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_ТипыОбъектовWarehouse.Номенклатура)
		|ИЗ
		|	ВТ_ДанныеПроверки КАК ВТ_ДанныеПроверки
		|ГДЕ
		|	ВТ_ДанныеПроверки.СопоставитьНоменклатуру
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.СюрвейерWarehouse,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_ТипыОбъектовWarehouse.Сюрвейер)
		|ИЗ
		|	ВТ_ДанныеПроверки КАК ВТ_ДанныеПроверки
		|ГДЕ
		|	ВТ_ДанныеПроверки.СопоставитьСюрвейер
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.ЭлеваторWarehouse,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_ТипыОбъектовWarehouse.Элеватор)
		|ИЗ
		|	ВТ_ДанныеПроверки КАК ВТ_ДанныеПроверки
		|ГДЕ
		|	ВТ_ДанныеПроверки.СопоставитьЭлеватор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.СтанцияОтправленияWarehouse,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_ТипыОбъектовWarehouse.Станция)
		|ИЗ
		|	ВТ_ДанныеПроверки КАК ВТ_ДанныеПроверки
		|ГДЕ
		|	ВТ_ДанныеПроверки.СопоставитьСтанциюОтправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.ВнешняяПроба,
		|	ВТ_ДанныеПроверки.СтанцияНазначенияWarehouse,
		|	ЗНАЧЕНИЕ(Перечисление.гкс_ТипыОбъектовWarehouse.Станция)
		|ИЗ
		|	ВТ_ДанныеПроверки КАК ВТ_ДанныеПроверки
		|ГДЕ
		|	ВТ_ДанныеПроверки.СопоставитьСтанциюНазначения"; 
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
		
КонецПроцедуры		

#КонецОбласти

#КонецОбласти
	
#КонецЕсли
