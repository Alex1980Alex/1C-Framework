Процедура ПКС_НоменклатураWarehouse(ПравилоКонвертации, ПолученныеДанные, ДанныеЗаполнения) Экспорт
	
	Перем ПолученноеЗначение;	
	Если ПолученныеДанные.Свойство(ПравилоКонвертации.СвойствоИсточника, ПолученноеЗначение) Тогда
		
		ПолноеИмяОбъектаСвойства = "Справочник.гкс_ПродукцияWarehouse";
		ДанныеЗаполненияСвойства = Новый Структура;
		ДанныеЗаполненияСвойства.Вставить(Справочники.гкс_ПродукцияWarehouse.ИмяКлючевогоСвойства(), 
			ПолученноеЗначение); 
		ДанныеЗаполненияСвойства.Вставить("НаименованиеКороткое", ПолученныеДанные.goodShortName); 
		ДанныеЗаполненияСвойства.Вставить("Наименование", ПолученныеДанные.goodName); 
		
		ЗначениеЗаполнения = гкс_ОбменДаннымиWarehouse.ЭлементПоВнешнимДанным(ПолноеИмяОбъектаСвойства, 
			ПолученноеЗначение, ДанныеЗаполненияСвойства);
			
		Если ЗначениеЗаполнено(ЗначениеЗаполнения) Тогда
			ДанныеЗаполнения.Вставить(ПравилоКонвертации.СвойствоКонфигурации, ЗначениеЗаполнения);
			
			// Номенклатура
			ДанныеЗаполнения.Вставить("Номенклатура", РегистрыСведений.гкс_СоответствиеОбъектовWarehouse.
				СсылкаОбъектаПоСсылкеWarehouse(ЗначениеЗаполнения)); 	
