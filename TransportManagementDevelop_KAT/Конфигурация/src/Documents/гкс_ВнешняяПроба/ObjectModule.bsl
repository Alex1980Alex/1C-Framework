Процедура ПКС_ТранспортноеСредство(ПравилоКонвертации, ПолученныеДанные, ДанныеЗаполнения) Экспорт
	
	Перем ПолученноеЗначение;
	
	Если ПолученныеДанные.Свойство(ПравилоКонвертации.СвойствоИсточника, ПолученноеЗначение) Тогда
		
		ДанныеЗаполнения.Вставить("ВидПеревозки", гкс_ОбменДаннымиWarehouse.ВидПеревозки(ПолученноеЗначение));	
		ЗначениеЗаполнения = гкс_ОбменДаннымиWarehouse.ТранспортноеСредствоПоНомерИзWarehouse(ПолученноеЗначение);			
		ДанныеЗаполнения.Вставить(ПравилоКонвертации.СвойствоКонфигурации, ЗначениеЗаполнения);
					
	КонецЕсли;	
	
КонецПроцедуры

