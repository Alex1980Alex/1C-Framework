Процедура ПКС_НомерЗаявки(ПравилоКонвертации, ПолученныеДанные, ДанныеЗаполнения) Экспорт
	
	Перем ПолученноеЗначение;
	
	Если ПолученныеДанные.Свойство(ПравилоКонвертации.СвойствоИсточника, ПолученноеЗначение) Тогда
		
		ЗаявкиНаПеревозку.Очистить();
		ДанныеЗаполнения.Вставить(ПравилоКонвертации.СвойствоКонфигурации, ПолученноеЗначение);
			
		НомераЗаявок = гкс_ОбменДаннымиWarehouse.НомераЗаявокНаПеревозкуВМассив(ПолученноеЗначение);
		Для Каждого ЗаявкаНомер Из НомераЗаявок Цикл
			НоваяСтрока = ЗаявкиНаПеревозку.Добавить();
			НоваяСтрока.НомерЗаявки = ЗаявкаНомер;
		КонецЦикла;
		
		ДанныеЗаполнения.Вставить("КоличествоЗаявок", НомераЗаявок.Количество());

	КонецЕсли;	
	
КонецПроцедуры

