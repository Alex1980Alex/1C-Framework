  <attributes>
    <name>СписокКоносаментов</name>
    <title>
      <key>ru</key>
      <value>Список коносаментов</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ТранспортныеДокументы.Ссылка КАК Коносамент,
	ТранспортныеДокументы.Организация КАК Организация,
	ТранспортныеДокументы.НомерДокумента КАК НомерДокумента,
	ТранспортныеДокументы.ДатаДокумента КАК ДатаДокумента
{ВЫБРАТЬ
	Коносамент.*,
	Организация.*,
	НомерДокумента,
	ДатаДокумента}
ИЗ
	Документ.гкс_ТранспортныйДокумент КАК ТранспортныеДокументы
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ТранспортныйДокумент.ТранспортныеСредства КАК
			ТранспортныеДокументыТранспортныеСредства
		ПО ТранспортныеДокументыТранспортныеСредства.Ссылка = ТранспортныеДокументы.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ТранспортныеДокументыФрахта КАК ТранспортныеДокументыФрахта
		ПО ТранспортныеДокументыФрахта.Коносамент = ТранспортныеДокументы.Ссылка
ГДЕ
	ТранспортныеДокументы.Проведен
	И ТранспортныеДокументы.ВидПеревозки = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыТранспортныхСредствДоставки.Судно)
	И ТранспортныеДокументыФрахта.Фрахт ЕСТЬ NULL
{ГДЕ
	ТранспортныеДокументы.ПунктРазгрузки.* КАК ОтборТочкаМаршрута,
	(ЕСТЬNULL(ТранспортныеДокументыТранспортныеСредства.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))).*
		КАК ОтборНоменклатура,
	(ЕСТЬNULL(ТранспортныеДокументыТранспортныеСредства.ТранспортноеСредство,
		ЗНАЧЕНИЕ(Справочник.ТранспортныеСредства.ПустаяСсылка))).* КАК ОтборСудно}
СГРУППИРОВАТЬ ПО
	ТранспортныеДокументы.Ссылка,
	ТранспортныеДокументы.Организация,
	ТранспортныеДокументы.НомерДокумента,
	ТранспортныеДокументы.ДатаДокумента</queryText>
      <mainTable>Document.гкс_ТранспортныйДокумент</mainTable>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ОтборТочкаМаршрута</dataPath>
        <field>ОтборТочкаМаршрута</field>
