          <localValue>
            <content>
              <key>ru</key>
              <value>Отбор точка маршрута</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ОтборНоменклатура</dataPath>
        <field>ОтборНоменклатура</field>
        <title>
