    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Спецификация.Ссылка КАК Ссылка,
	Спецификация.ПометкаУдаления КАК ПометкаУдаления,
	Спецификация.Номер КАК Номер,
	Спецификация.Дата КАК Дата,
	Спецификация.Проведен КАК Проведен,
	Спецификация.Контрагент КАК Контрагент,
	Спецификация.Статус КАК Статус,
	Спецификация.УсловиеПоставки КАК УсловиеПоставки,
	Спецификация.Организация КАК Организация,
	СпецификацияКДоговоруКонтрагентаТовары.Номенклатура КАК Номенклатура,
	Спецификация.Договор КАК Договор
ИЗ
	Документ.гкс_СпецификацияКДоговоруКонтрагента КАК Спецификация
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_СпецификацияКДоговоруКонтрагента.Товары КАК СпецификацияКДоговоруКонтрагентаТовары
		ПО (СпецификацияКДоговоруКонтрагентаТовары.Ссылка = Спецификация.Ссылка)
			И (СпецификацияКДоговоруКонтрагентаТовары.НомерСтроки = 1)</queryText>
      <mainTable>Document.гкс_СпецификацияКДоговоруКонтрагента</mainTable>
