    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ТаблицаДокумента.Ссылка КАК Ссылка,
	ТаблицаДокумента.ПометкаУдаления КАК ПометкаУдаления,
	ТаблицаДокумента.Номер КАК Номер,
	ТаблицаДокумента.Дата КАК Дата,
	ТаблицаДокумента.Проведен КАК Проведен,
	ТаблицаДокумента.Организация КАК Организация,
	ТаблицаДокумента.ДатаДокумента КАК ДатаДокумента,
	ТаблицаДокумента.НомерДокумента КАК НомерДокумента,
	ТаблицаДокумента.ДатаПогрузки КАК ДатаПогрузки,
	ТаблицаДокумента.ДатаРазгрузки КАК ДатаРазгрузки,
	ТаблицаДокумента.ПунктПогрузки КАК ПунктПогрузки,
	ТаблицаДокумента.ПунктРазгрузки КАК ПунктРазгрузки,
	ТаблицаДокумента.Отправитель КАК Отправитель,
	ТаблицаДокумента.Получатель КАК Получатель,
	ТаблицаДокумента.Контрагент КАК Контрагент,
	ТаблицаДокумента.Владелец КАК Владелец,
	ТаблицаДокумента.ВидПеревозки КАК ВидПеревозки,
	ТаблицаДокумента.МоментВремени КАК МоментВремени,
	ТаблицаТранспортныхСредствДокумента.Номенклатура КАК Номенклатура,
	ТаблицаДокумента.Комментарий,
	ТаблицаДокумента.Ответственный
ИЗ
	Документ.гкс_ТранспортныйДокумент КАК ТаблицаДокумента
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ТранспортныйДокумент.ТранспортныеСредства КАК ТаблицаТранспортныхСредствДокумента
		ПО (ТаблицаТранспортныхСредствДокумента.Ссылка = ТаблицаДокумента.Ссылка)
		И (ТаблицаТранспортныхСредствДокумента.НомерСтроки = 1)</queryText>
