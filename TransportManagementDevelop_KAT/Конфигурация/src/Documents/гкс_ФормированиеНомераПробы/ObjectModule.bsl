#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗапретИзмененияДокументаПоРеестру(Отказ) Тогда		
       Возврат;
	КонецЕсли;
	
	гкс_ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);

	ДозаполнитьРеквизитыОбъекта();
	СформироватьНомерПробыПоНеобходимости();
	
	ЗарегистрироватьТранспортноеСредствоДляУсиленногоКонтроля(Отказ, РежимЗаписи);
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ДопПараметры = гкс_ПроведениеДокументов.ДопПараметрыИнициализироватьДанныеДокументаДляПроведения();
	ДопПараметры.ДополнительныеСвойства = Новый Структура;
	
	ЭтоУсиленныйКонтрольДляТС = Ложь;
	Если ДополнительныеСвойства.Свойство("ЭтоУсиленныйКонтрольДляТС") Тогда
		ЭтоУсиленныйКонтрольДляТС = ДополнительныеСвойства.ЭтоУсиленныйКонтрольДляТС;
	КонецЕсли;

	ЗаполнитьДопПараметры(ДопПараметры, "ЭтоУсиленныйКонтрольДляТС", ЭтоУсиленныйКонтрольДляТС);		
	ЗаполнитьДопПараметры(ДопПараметры,"ТипПробы", ТипПробы);
	
	гкс_ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ, ДопПараметры);
	
	ПараметрыСозданияАнализа = Неопределено;
	ДополнительныеСвойства.Свойство("ПараметрыСозданияАнализа", ПараметрыСозданияАнализа);
	 
	Если Не Отказ Тогда
		
		Если ПараметрыСозданияАнализа = Неопределено Тогда
			ПараметрыСозданияАнализа = Новый Структура;
		КонецЕсли;
				
		Документы.гкс_ФормированиеНомераПробы.СформироватьЛабораторныйАнализПоНеобходимости(Ссылка, ТипПробы, 
			ПараметрыСозданияАнализа);
			
		СозданныйЛабАнализ = Неопределено;
		ПараметрыСозданияАнализа.Свойство("СозданныйЛабораторныйАнализ", СозданныйЛабАнализ);
		ЗаписатьСопоставлениеФНПИЛабАнализа(СозданныйЛабАнализ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	гкс_ПроведениеДокументов.ОбработкаУдаленияПроведенияДокумента(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
		
		Если ДанныеЗаполнения.Свойство("ДокументРегистрации") Тогда
			
			СтрокаРегистрация = СписокРегистраций.Добавить();
			СтрокаРегистрация.ДокументРегистрации = ДанныеЗаполнения.ДокументРегистрации;
			
		ИначеЕсли ДанныеЗаполнения.Свойство("ТаблицаРегистраций") Тогда
			
			Для Каждого СтрокаТаблицы Из ДанныеЗаполнения.ТаблицаРегистраций Цикл
				СтрокаРегистрация = СписокРегистраций.Добавить();
				СтрокаРегистрация.ДокументРегистрации = СтрокаТаблицы.ДокументРегистрации;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Есть показатели усиленного контроля.
// 
// Параметры:
//  ДокументРегистрации Документ регистрации
// 
// Возвращаемое значение:
//  Булево - Есть показатели усиленного контроля
Функция ЕстьПоказателиУсиленногоКонтроля(ДокументРегистрации)
	
	// Проверяем заполненность документа регистрации
	Если НЕ ЗначениеЗаполнено(ДокументРегистрации) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат гкс_ВходнойКонтрольКачества.ПроверитьПоказателиУсиленногоКонтроляПоРегистрации(ДокументРегистрации);

КонецФункции

// ТСЗаблокировано для разгрузки.
// 
// Параметры: ТранспортноеСредство Транспортное средство
//  ДокументРегистрации - СправочникСсылка.ТранспортныеСредства - Документ регистрации
// 
// Возвращаемое значение:
//  Булево - ТСЗаблокировано для разгрузки
Функция ТСЗаблокированоДляРазгрузки(ДокументРегистрации)
	
	// Проверяем заполненность документа
	Если НЕ ЗначениеЗаполнено(ДокументРегистрации) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат гкс_ВходнойКонтрольКачества.ПроверитьБлокированиеТранспортногоСредстваДляРазгрузки(ДокументРегистрации);

КонецФункции

Процедура ЗаполнитьДопПараметры(ДопПараметры, ИмяДопРеквизита, ЗначениеДопРеквизита)
	
	ДопПараметры.ДополнительныеСвойства.Вставить(ИмяДопРеквизита, ЗначениеДопРеквизита);
	
КонецПроцедуры

Процедура ДозаполнитьРеквизитыОбъекта()
	
	ЗаполнитьОрганизациюВСпискеРегистраций();
	
	Если ЭтоНовый() Тогда
		Если ТипПробы = Перечисления.гкс_ТипыПроб.Композитная И СписокРегистраций.Количество() > 0 Тогда
			ЗаполнятьДатыПоРегистрацииПЛК();
		Иначе
			ЗаполнитьМестноеВремя();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОрганизациюВСпискеРегистраций()
	
	НужноЗаполнятьОрганизацию = Ложь;
	Для Каждого СтрокаРегистрации Из СписокРегистраций Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаРегистрации.Организация) Тогда
			НужноЗаполнятьОрганизацию = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ НужноЗаполнятьОрганизацию Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыРегистраций = 
	ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокРегистраций.ВыгрузитьКолонку("ДокументРегистрации"), "Организация");
		
	Для Каждого СтрокаРегистрации Из СписокРегистраций Цикл
		
		Если ЗначениеЗаполнено(СтрокаРегистрации.Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРегистрации.Организация = РеквизитыРегистраций[СтрокаРегистрации.ДокументРегистрации];		
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ЗаполнитьМестноеВремя()
	
	Если ЗначениеЗаполнено(МестнаяДата) Тогда
		Возврат;
	КонецЕсли;
	
	ЧасовойПоясТочки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТочкаМаршрута, "гкс_ЧасовойПоясТочкиМаршрута");
		
	Если ЗначениеЗаполнено(ЧасовойПоясТочки) Тогда
		МестнаяДата = МестноеВремя(ТекущаяУниверсальнаяДата(), ЧасовойПоясТочки);			
	Иначе
		МестнаяДата = Дата;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнятьДатыПоРегистрацииПЛК()

	РегистрацияПЛК = ПервыйДокументИзСпискаРегистраций();
	Если ЗначениеЗаполнено(РегистрацияПЛК) Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РегистрацияПЛК, "Дата, МестнаяДата");
	КонецЕсли;	

КонецПроцедуры

Функция ЗапретИзмененияДокументаПоРеестру(Отказ)
	
	Если гкс_ПриемкаТранспорта.ЗапретИзмененияДокументаПоРеестру(Ссылка) Тогда		
		Отказ = Истина;
		ИмяСобытия = НСтр("ru = 'Запрет изменения документа'");
		ТекстШаблона = НСтр("ru = 'Не удалось записать документ: %1 т.к. уже оформлен реестр ЗПП-3'");
				
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Предупреждение, Метаданные.Документы.гкс_ФормированиеНомераПробы, 
			Ссылка, СтрШаблон(ТекстШаблона, Ссылка));

		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
   
КонецФункции

#Область НомераПроб

Процедура СформироватьНомерПробыПоНеобходимости()
	
	Если ЗначениеЗаполнено(НомерПробы) Тогда
		Возврат;
	КонецЕсли;
	
	НомерПробыОбъект = Справочники.гкс_НомерПробы.СоздатьЭлемент();
	НомерПробыОбъект.Заполнить(ДанныеЗаполненияДляНомераПробы());
	
	Попытка 
		НомерПробыОбъект.Записать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	НомерПробы = НомерПробыОбъект.Ссылка;
	
КонецПроцедуры

Функция ДанныеЗаполненияДляНомераПробы()
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ТипПробы", ТипПробы);
	
	Если ТипПробы = Перечисления.гкс_ТипыПроб.Единичная И СписокРегистраций.Количество() > 0 Тогда
	
		Регистрация = ПервыйДокументИзСпискаРегистраций();
		ДанныеЗаполнения.Вставить("Регистрация", Регистрация);
	
	Иначе
		ДанныеЗаполнения.Вставить("Регистрация", СписокРегистраций.ВыгрузитьКолонку("ДокументРегистрации"));		
	КонецЕсли;
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

Функция ПервыйДокументИзСпискаРегистраций()
	
	Результат = Неопределено;
	
	Если СписокРегистраций.Количество() > 0 Тогда
		Результат = СписокРегистраций[0].ДокументРегистрации;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции	

#КонецОбласти 

Процедура ЗарегистрироватьТранспортноеСредствоДляУсиленногоКонтроля(Отказ, РежимЗаписи)
	
	Если Не (ПолучитьФункциональнуюОпцию("гкс_ИспользоватьУсиленныйКонтрольКачества")
		И РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
		Возврат;
	КонецЕсли;	
	
	ДокументРегистрации = ПолучитьДокументРегистрации();
		
	Если ТребуетсяРегистрацияДляУсиленногоКонтроля(ДокументРегистрации) Тогда
		
		гкс_ВходнойКонтрольКачества.
			ЗарегистрироватьТранспортноеСредствоДляУсиленногоКонтроля(ДокументРегистрации, МестнаяДата);			
	КонецЕсли;	
		
КонецПроцедуры            

Функция ПолучитьДокументРегистрации()
	
	Если СписокРегистраций.Количество() = 0 Тогда
		Регистрация = Документы.гкс_РегистрацияНаПЛК.ПустаяСсылка();
	Иначе
		Регистрация = СписокРегистраций[0].ДокументРегистрации;
	КонецЕсли;
	
	Возврат Регистрация;
	
КонецФункции	
	
Функция ТребуетсяРегистрацияДляУсиленногоКонтроля(ДокументРегистрации)

	Если Не ЗначениеЗаполнено(ДокументРегистрации) Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ТипРегистрации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументРегистрации, "ТипРегистрации");
	
	Возврат ТипПробы = Перечисления.гкс_ТипыПроб.Единичная
		И ТипРегистрации = Перечисления.гкс_ТипРегистрации.Приемка;
	
КонецФункции

// Записывает сопоставление текущего документа ФНП и связанных ЛабораторныхАнализов в регистр сведений.
// Вызывается из ОбработкаПроведения после создания ЛабораторногоАнализа.
// Процедура - Записывает сопоставление ФНП и ЛабАнализа в регистр сведений
//
// Параметры:
//  ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ, Неопределено - Ссылка на созданный документ
//
Процедура ЗаписатьСопоставлениеФНПИЛабАнализа(ЛабораторныйАнализ = Неопределено)

	Если Не ЗначениеЗаполнено(ЛабораторныйАнализ) Тогда
		Возврат;
	КонецЕсли;

	// Записываем сопоставление - все данные (ТипПробы, НазначениеИспользования, УсиленныйКонтроль)
	// получаются внутри функции ЗаписатьСопоставление из переданных документов
	РегистрыСведений.гкс_СопоставлениеФНПЛабАнализа.ЗаписатьСопоставление(
		Ссылка,
		ЛабораторныйАнализ);

КонецПроцедуры
	
#КонецОбласти

#КонецЕсли
