// Модуль формы записи регистра сведений гкс_НастройкиЗапретаВскрытияПоНоменклатуре.
// Заполнение дефолтов из параметров открытия и фиксация автора при записи.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЭтоНоваяЗапись() Тогда
		ТекущаяДатаСеанса = ТекущаяДатаСеанса();
		Запись.Активен = Истина;
		Если Не ЗначениеЗаполнено(Запись.ДатаНачала) Тогда
			Запись.ДатаНачала = НачалоДня(ТекущаяДатаСеанса);
		КонецЕсли;
		Если Параметры.Свойство("ВидПеревозки") И ЗначениеЗаполнено(Параметры.ВидПеревозки) Тогда
			Запись.ВидПеревозки = Параметры.ВидПеревозки;
		КонецЕсли;
		Запись.Пользователь = Пользователи.ТекущийПользователь();
		Запись.ДатаВремяИзменения = ТекущаяДатаСеанса;
	КонецЕсли;

	Элементы.Пользователь.ТолькоПросмотр = Истина;
	Элементы.ДатаВремяИзменения.ТолькоПросмотр = Истина;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ПериодНекорректен() Тогда
		ТекстСообщения = НСтр("ru = 'Дата окончания не может быть меньше даты начала'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	Если Не Отказ Тогда
		ТекущийОбъект.Пользователь = Пользователи.ТекущийПользователь();
		ТекущийОбъект.ДатаВремяИзменения = ТекущаяДатаСеанса();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЭтоНоваяЗапись()
	Возврат Не ЗначениеЗаполнено(Запись.Номенклатура) И Не ЗначениеЗаполнено(Запись.ДопускКВскрытию);
КонецФункции

// Возвращает Истина, если у записи дата окончания указана и меньше даты начала.
// 
// Возвращаемое значение:
//  Булево - Период некорректен
&НаСервере
Функция ПериодНекорректен()
	ПустаяДата = Дата(1, 1, 1);
	Возврат Запись.ДатаОкончания <> ПустаяДата
		И Запись.ДатаОкончания < Запись.ДатаНачала;
КонецФункции

#КонецОбласти
