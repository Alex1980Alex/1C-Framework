<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetUnion">
		<name>Основной</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипРегистрации</dataPath>
			<field>ТипРегистрации</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаписьВОчередь</dataPath>
			<field>ЗаписьВОчередь</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РегистрацияНаПЛК</dataPath>
			<field>РегистрацияНаПЛК</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТочкаМаршрута</dataPath>
			<field>ТочкаМаршрута</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерТранспортногоСредства</dataPath>
			<field>НомерТранспортногоСредства</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Транспортное средство</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УсловиеПроезда</dataPath>
			<field>УсловиеПроезда</field>
		</field>
		<item xsi:type="DataSetQuery">
			<name>ОчередьПриемкиПЛК</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>ТипРегистрации</dataPath>
				<field>ТипРегистрации</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ЗаписьВОчередь</dataPath>
				<field>ЗаписьВОчередь</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>РегистрацияНаПЛК</dataPath>
				<field>РегистрацияНаПЛК</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ТочкаМаршрута</dataPath>
				<field>ТочкаМаршрута</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Контрагент</dataPath>
				<field>Контрагент</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Номенклатура</dataPath>
				<field>Номенклатура</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>НомерТранспортногоСредства</dataPath>
				<field>НомерТранспортногоСредства</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>УсловиеПроезда</dataPath>
				<field>УсловиеПроезда</field>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Приемка) КАК ТипРегистрации,
	ОчередьПриемкиПЛК.Регистратор КАК ЗаписьВОчередь,
	ЕСТЬNULL(РегистрацииПоЭлектроннойОчереди.РегистрацияНаПЛК, ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)) КАК РегистрацияНаПЛК,
	ОчередьПриемкиПЛК.ТочкаМаршрута КАК ТочкаМаршрута,
	ОчередьПриемкиПЛК.Контрагент КАК Контрагент,
	ОчередьПриемкиПЛК.Номенклатура КАК Номенклатура,
	ОчередьПриемкиПЛК.НомерТранспортногоСредства КАК НомерТранспортногоСредства,
	ОчередьПриемкиПЛК.УсловиеПроезда КАК УсловиеПроезда
{ВЫБРАТЬ
	ТипРегистрации.*,
	ЗаписьВОчередь.*,
	РегистрацияНаПЛК.*,
	ТочкаМаршрута.*,
	Контрагент.*,
	Номенклатура.*,
	НомерТранспортногоСредства,
	УсловиеПроезда.*}
ИЗ
	РегистрСведений.гкс_ОчередьПриемкиПЛК КАК ОчередьПриемкиПЛК
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_РегистрацииПоЭлектроннойОчереди КАК РегистрацииПоЭлектроннойОчереди
		ПО ОчередьПриемкиПЛК.Регистратор = РегистрацииПоЭлектроннойОчереди.ЗаписьВОчередь
ГДЕ
	ОчередьПриемкиПЛК.НачалоПериода &gt;= &amp;НачалоПериода
	И ОчередьПриемкиПЛК.ОкончаниеПериода &lt;= &amp;ОкончаниеПериода
{ГДЕ
	ОчередьПриемкиПЛК.Регистратор.* КАК ЗаписьВОчередь,
	(ЕСТЬNULL(РегистрацииПоЭлектроннойОчереди.РегистрацияНаПЛК, ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка))).* КАК РегистрацияНаПЛК,
	ОчередьПриемкиПЛК.Контрагент.*,
	ОчередьПриемкиПЛК.Номенклатура.*,
	ОчередьПриемкиПЛК.НомерТранспортногоСредства,
	ОчередьПриемкиПЛК.УсловиеПроезда.*}</query>
			<autoFillFields>false</autoFillFields>
		</item>
		<item xsi:type="DataSetQuery">
			<name>РегистрацииБезЗаписи</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>ТипРегистрации</dataPath>
				<field>ТипРегистрации</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ЗаписьВОчередь</dataPath>
				<field>ЗаписьВОчередь</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>РегистрацияНаПЛК</dataPath>
				<field>РегистрацияНаПЛК</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ТочкаМаршрута</dataPath>
				<field>ТочкаМаршрута</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Контрагент</dataPath>
				<field>Контрагент</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Номенклатура</dataPath>
				<field>Номенклатура</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>НомерТранспортногоСредства</dataPath>
				<field>НомерТранспортногоСредства</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>УсловиеПроезда</dataPath>
				<field>УсловиеПроезда</field>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДокументРегистрацияНаПЛК.ТипРегистрации КАК ТипРегистрации,
	ЗНАЧЕНИЕ(Документ.гкс_ЗаписьВОчередьПриемкиПЛК.ПустаяСсылка) КАК ЗаписьВОчередь,
	ДокументРегистрацияНаПЛК.Ссылка КАК РегистрацияНаПЛК,
	ДокументРегистрацияНаПЛК.ТочкаМаршрута КАК ТочкаМаршрута,
	ДокументРегистрацияНаПЛК.Контрагент КАК Контрагент,
	ДокументРегистрацияНаПЛК.Номенклатура КАК Номенклатура,
	ДокументРегистрацияНаПЛК.ТранспортноеСредство.НомерТранспортногоСредства КАК НомерТранспортногоСредства,
	ДокументРегистрацияНаПЛК.УсловиеПроезда КАК УсловиеПроезда
{ВЫБРАТЬ
	ТипРегистрации.*,
	ЗаписьВОчередь.*,
	РегистрацияНаПЛК.*,
	ТочкаМаршрута.*,
	Контрагент.*,
	Номенклатура.*,
	НомерТранспортногоСредства,
	УсловиеПроезда.*}
ИЗ
	Документ.гкс_РегистрацияНаПЛК КАК ДокументРегистрацияНаПЛК
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_РегистрацииПоЭлектроннойОчереди КАК РегистрацииПоЭлектроннойОчереди
		ПО ДокументРегистрацияНаПЛК.Ссылка = РегистрацииПоЭлектроннойОчереди.РегистрацияНаПЛК
ГДЕ
	ДокументРегистрацияНаПЛК.Дата МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
	И ДокументРегистрацияНаПЛК.ТипРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_ТипРегистрации.Приемка)
	И НЕ ДокументРегистрацияНаПЛК.ПометкаУдаления
	И РегистрацииПоЭлектроннойОчереди.РегистрацияНаПЛК ЕСТЬ NULL
	И ДокументРегистрацияНаПЛК.ВидПеревозки = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыТранспортныхСредствДоставки.Автомобиль)
{ГДЕ
	(ЗНАЧЕНИЕ(Документ.гкс_ЗаписьВОчередьПриемкиПЛК.ПустаяСсылка)).* КАК ЗаписьВОчередь,
	ДокументРегистрацияНаПЛК.Ссылка.* КАК РегистрацияНаПЛК,
	ДокументРегистрацияНаПЛК.Контрагент.*,
	ДокументРегистрацияНаПЛК.Номенклатура.*,
	ДокументРегистрацияНаПЛК.ТранспортноеСредство.НомерТранспортногоСредства КАК НомерТранспортногоСредства,
	ДокументРегистрацияНаПЛК.УсловиеПроезда.*}</query>
			<autoFillFields>false</autoFillFields>
		</item>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>СостоянияРегистраций</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>РегистрацияНаПЛК</dataPath>
			<field>РегистрацияНаПЛК</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Регистрация на ПЛК</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СостояниеРегистрации</dataPath>
			<field>СостояниеРегистрации</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Состояние регистрации</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КомментарийСостояния</dataPath>
			<field>КомментарийСостояния</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Комментарий</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СостоянияРегистраций.ДокументРегистрации КАК РегистрацияНаПЛК,
	СостоянияРегистраций.Состояние КАК СостояниеРегистрации,
	СостоянияРегистраций.Комментарий КАК КомментарийСостояния
{ВЫБРАТЬ
	РегистрацияНаПЛК.*,
	СостояниеРегистрации.*,
	КомментарийСостояния}
ИЗ
	РегистрСведений.гкс_СостоянияРегистрации.СрезПоследних(, ДокументРегистрации В (&amp;РегистрацияНаПЛКСоединение)) КАК СостоянияРегистраций</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>Основной</sourceDataSet>
		<destinationDataSet>СостоянияРегистраций</destinationDataSet>
		<sourceExpression>РегистрацияНаПЛК</sourceExpression>
		<destinationExpression>РегистрацияНаПЛК</destinationExpression>
		<parameter>РегистрацияНаПЛКСоединение</parameter>
		<parameterListAllowed>true</parameterListAllowed>
	</dataSetLink>
	<calculatedField>
		<dataPath>Состояние</dataPath>
		<expression>ВЫБОР
    КОГДА
		СостояниеРегистрации = ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияРегистрации.НеПринято)
		ТОГДА "Возврат"
	КОГДА НЕ РегистрацияНаПЛК = ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)
        И НЕ ЗаписьВОчередь = ЗНАЧЕНИЕ(Документ.гкс_ЗаписьВОчередьПриемкиПЛК.ПустаяСсылка)
        ТОГДА "Прибыл"
    КОГДА РегистрацияНаПЛК = ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)
        И НЕ ЗаписьВОчередь = ЗНАЧЕНИЕ(Документ.гкс_ЗаписьВОчередьПриемкиПЛК.ПустаяСсылка)
        ТОГДА "Не прибыл"
    КОГДА НЕ РегистрацияНаПЛК = ЗНАЧЕНИЕ(Документ.гкс_РегистрацияНаПЛК.ПустаяСсылка)
        И ЗаписьВОчередь = ЗНАЧЕНИЕ(Документ.гкс_ЗаписьВОчередьПриемкиПЛК.ПустаяСсылка)
        ТОГДА "Прибыл без записи"
    ИНАЧЕ "Не учтен"
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Состояние</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Состояние</dataPath>
		<expression>(Состояние)</expression>
	</totalField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
		<denyIncompleteValues>true</denyIncompleteValues>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ОкончаниеПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Окончание периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>РегистрацияНаПЛКСоединение</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Регистрация на ПЛКСоединение</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.гкс_РегистрацияНаПЛК</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
		<valueListAllowed>true</valueListAllowed>
	</parameter>
	<settingsVariant>
		<dcsset:name>Анализ исполнения записей по электронной очереди</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Анализ исполнения записей по электронной очереди</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Контрагент</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ЗаписьВОчередь</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>РегистрацияНаПЛК</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Номенклатура</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>НомерТранспортногоСредства</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ТипРегистрации</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>УсловиеПроезда</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Состояние</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КомментарийСостояния</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Контрагент</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:userSettingID>5049feae-2cfa-4ccd-93d5-a1f6c29c2137</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
