			<dcsat:name>ВремяНаПЛК</dcsat:name>
			<dcsat:expression>Формат(ДобавитьКДате(ДАТАВРЕМЯ(1,1,1), "Минута", ВремяНаПЛК), "ДФ='ЧЧ:мм'")</dcsat:expression>
		</parameter>
