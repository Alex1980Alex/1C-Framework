				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВремяНахожденияТСНаПЛК.ДокументРегистрации КАК ДокументРегистрации,
	ВремяНахожденияТСНаПЛК.ВремяВзвешенБрутто КАК ВремяВзвешенБрутто,
	ВремяНахожденияТСНаПЛК.ВремяВзвешенТара КАК ВремяВзвешенТара,
	ВремяНахожденияТСНаПЛК.Комментарий КАК КомментарийОтклонение,
	РегистрацияНаПЛК.Контрагент КАК Контрагент,
	РегистрацияНаПЛК.Организация КАК Организация,
	РегистрацияНаПЛК.Комментарий КАК Комментарий,
	РегистрацияНаПЛК.ТранспортноеСредство КАК ТранспортноеСредство,
	РегистрацияНаПЛК.Номенклатура КАК Номенклатура,
	ВремяНахожденияТСНаПЛК.Отклонение КАК Отклонение,
	ВремяНахожденияТСНаПЛК.ВремяНаПЛК КАК ВремяНаПЛК,
	ЕСТЬNULL(ОснованиеДляДвиженияЗапасов.ВесНеттоФакт, 0) КАК ВесНеттоФакт
ИЗ
	РегистрСведений.гкс_ВремяНахожденияТСНаПЛК КАК ВремяНахожденияТСНаПЛК
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ОснованиеДляДвиженияЗапасов КАК ОснованиеДляДвиженияЗапасов
			ПО (ОснованиеДляДвиженияЗапасов.Регистрация = РегистрацияНаПЛК.Ссылка)
		ПО ВремяНахожденияТСНаПЛК.ДокументРегистрации = РегистрацияНаПЛК.Ссылка
ГДЕ
	РегистрацияНаПЛК.Организация = &amp;Организация
	И ВремяНахожденияТСНаПЛК.ВремяВзвешенБрутто МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
