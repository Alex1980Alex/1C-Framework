		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>ТранспортноеСредство</dcsat:name>
			<dcsat:expression>Представление(ТранспортноеСредство)</dcsat:expression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>ВремяНаПЛК</dcsat:name>
			<dcsat:expression>Формат(ДобавитьКДате(ДАТАВРЕМЯ(1,1,1), "Минута", ВремяНаПЛК), "ДФ='ЧЧ:мм'")</dcsat:expression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>Отклонение</dcsat:name>
			<dcsat:expression>Выбор Когда Отклонение &gt;= 0 Тогда Формат(ДобавитьКДате(ДАТАВРЕМЯ(1,1,1), "Минута", Отклонение), "ДФ='ЧЧ:мм'") Иначе "отклонение "+ Формат(ДобавитьКДате(ДАТАВРЕМЯ(1,1,1), "Минута", -Отклонение), "ДФ='ЧЧ:мм'") Конец</dcsat:expression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
			<dcsat:name>ВесНеттоФакт</dcsat:name>
			<dcsat:expression>ВесНеттоФакт</dcsat:expression>
		</parameter>
		<parameter xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:ExpressionAreaTemplateParameter">
