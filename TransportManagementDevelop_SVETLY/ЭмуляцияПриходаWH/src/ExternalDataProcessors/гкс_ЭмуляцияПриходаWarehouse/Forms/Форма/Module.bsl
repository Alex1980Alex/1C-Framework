&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Демо-прогон при открытии обработки: за сегодня, пометить пробу на удаление,
	// в транзакции с откатом (данные базы НЕ изменяются).
	//
	// Для произвольного дня / сценария вызывайте метод объекта из консоли кода:
	//   Обр = ВнешниеОбработки.Создать("<путь к .epf>");
	//   Сообщить(Обр.ЭмулироватьПриход(Дата(2026,6,25), Истина, Истина, "", 0));
	// Параметры: (День, ПометитьУдаление, ВТранзакции, ИдентификаторНовой, ИндексЭлемента).
	// ИдентификаторНовой заполнен => эмуляция НОВОЙ пробы (краевой случай непроведённого документа).

	Попытка
		Результат = Объект.ЭмулироватьПриход(НачалоДня(ТекущаяДата()), Истина, Истина, "", 0);
	Исключение
		Результат = "Ошибка запуска эмуляции: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры
