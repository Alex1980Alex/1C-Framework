#Область ПрограммныйИнтерфейс

// Эмулирует приход данных из системы Warehouse по документу "Внешняя проба".
// Клонирует реальный ответ сервиса ExternalSamples_GetBetweenDates и подставляет
// признак удаления isDeleted, затем прогоняет структуру через штатную точку входа
// обмена гкс_ОбменДаннымиWarehouse.ОбработатьПолученныеДанные.
//
// Параметры:
//  День               - Дата   - день, за который берётся реальный ответ Warehouse (эталон для клона).
//  ПометитьУдаление   - Булево - значение isDeleted (Истина = пометить пробу на удаление).
//  ВТранзакции        - Булево - Истина = прогон в транзакции с откатом (данные базы не изменяются).
//  ИдентификаторНовой - Строка - если заполнено, подставляется как id пробы (эмуляция НОВОЙ пробы,
//                                краевой случай непроведённого документа); пусто = клон реального элемента.
//  ИндексЭлемента     - Число  - индекс элемента ответа для клонирования (0 - первый).
//
// Возвращаемое значение:
//  Строка - текстовый отчёт о выполнении (состояние документа и движения ДО/ПОСЛЕ).
//
Функция ЭмулироватьПриход(День, ПометитьУдаление = Истина, ВТранзакции = Истина,
	ИдентификаторНовой = "", ИндексЭлемента = 0) Экспорт

	Лог = Новый Массив;

	Ответ = ПолучитьОтветWarehouse(День, Лог);
	Если ТипЗнч(Ответ) <> Тип("Массив") Или Ответ.Количество() = 0 Тогда
		Лог.Добавить("Ответ Warehouse пуст или недоступен за " + Формат(День, "ДЛФ=D") + ". Прогон не выполнен.");
		Возврат СтрСоединить(Лог, Символы.ПС);
	КонецЕсли;

	Индекс = ИндексЭлемента;
	Если Индекс > Ответ.ВГраница() Или Индекс < 0 Тогда
		Индекс = 0;
	КонецЕсли;

	Проба = ОбщегоНазначения.СкопироватьРекурсивно(Ответ[Индекс]);

	Если ЗначениеЗаполнено(ИдентификаторНовой) Тогда
		Проба.Вставить("id", ИдентификаторНовой);
		Проба.Вставить("orderNumber", "TEST-ЭМУЛЯЦИЯ");
		Лог.Добавить("Режим: НОВАЯ проба, id = " + ИдентификаторНовой);
	Иначе
		Лог.Добавить("Режим: клон реальной пробы, id = " + Строка(Проба.id));
	КонецЕсли;

	Проба.Вставить("isDeleted", ПометитьУдаление);
	Лог.Добавить("isDeleted = " + Строка(ПометитьУдаление)
		+ ?(ВТранзакции, "; прогон В ТРАНЗАКЦИИ С ОТКАТОМ", "; прогон С ФИКСАЦИЕЙ"));

	ИДПробы = Строка(Проба.id);

	Лог.Добавить("--- ДО ---");
	Лог.Добавить(СостояниеПробы(ИДПробы));

	Если ВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		гкс_ОбменДаннымиWarehouse.ОбработатьПолученныеДанные(Проба, Документы.гкс_ВнешняяПроба.ПустаяСсылка());
		Лог.Добавить("--- ПОСЛЕ (обработка выполнена) ---");
		Лог.Добавить(СостояниеПробы(ИДПробы));
	Исключение
		Лог.Добавить("ИСКЛЮЧЕНИЕ при обработке: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если ВТранзакции Тогда
		ОтменитьТранзакцию();
		Лог.Добавить("--- Транзакция отменена, состояние базы не изменено ---");
		Лог.Добавить(СостояниеПробы(ИДПробы));
	КонецЕсли;

	Возврат СтрСоединить(Лог, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает реальный ответ ExternalSamples_GetBetweenDates за указанный день (только чтение).
Функция ПолучитьОтветWarehouse(День, Лог)

	Попытка
		ПараметрыВЗапрос = Новый Структура;
		ПараметрыВЗапрос.Вставить("dateFrom", ЗаписатьДатуJSON(НачалоДня(День),
			ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
		ПараметрыВЗапрос.Вставить("dateTo", ЗаписатьДатуJSON(КонецДня(День),
			ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
		ПараметрыЗапроса = Новый Структура("params", ПараметрыВЗапрос);

		ПараметрыJSON = Новый Структура;
		ПараметрыJSON.Вставить("ПрочитатьВСоответствие", Ложь);
		ПараметрыJSON.Вставить("ИмяФункцииВосстановления", "ДесериализацияСвойствВнешнихПроб");
		ПараметрыJSON.Вставить("МодульФункцииВосстановления",
			ОбщегоНазначения.ОбщийМодуль("гкс_ОбменДаннымиWarehouse"));
		ПараметрыJSON.Вставить("ИменаСвойствДляОбработкиВосстановления",
			СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
				гкс_ОбменДаннымиWarehouse.ИменаСвойствСоЗначениямиДата(), ","));

		Возврат гкс_ИнтеграцияWarehouse.ВыполнитьЗапросКWarehouse(
			Справочники.гкс_РесурсыВебСервисов.ExternalSamples_GetBetweenDates,
			ПараметрыЗапроса, ПараметрыJSON);
	Исключение
		Лог.Добавить("Ошибка запроса к Warehouse: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Строка со состоянием документа "Внешняя проба" и числом движений по трём регистрам.
Функция СостояниеПробы(ИДПробы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИД", ИДПробы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Номер КАК Номер,
	|	П.Проведен КАК Проведен,
	|	П.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.гкс_ВнешняяПроба КАК П
	|ГДЕ
	|	П.ИДПробы = &ИД";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "  документ с ИДПробы " + ИДПробы + " не найден";
	КонецЕсли;

	Р1 = ДвиженийПоРегистру("РегистрСведений.гкс_ВнешниеПробы", Выборка.Ссылка);
	Р2 = ДвиженийПоРегистру("РегистрСведений.гкс_ВнешниеПробыПоЗаявкамНаПеревозку", Выборка.Ссылка);
	Р3 = ДвиженийПоРегистру("РегистрСведений.гкс_КонтрольЗаполненияВнешнихПроб", Выборка.Ссылка);

	Возврат СтрШаблон(
		"  Документ %1: Проведен=%2, ПометкаУдаления=%3; движения [ВнешниеПробы=%4, ПоЗаявкам=%5, Контроль=%6]",
		Выборка.Номер, Выборка.Проведен, Выборка.ПометкаУдаления, Р1, Р2, Р3);

КонецФункции

// Число записей регистра сведений по регистратору.
Функция ДвиженийПоРегистру(ИмяРегистра, Регистратор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Р", Регистратор);
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ %1 КАК Т ГДЕ Т.Регистратор = &Р", ИмяРегистра);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.К;

КонецФункции

#КонецОбласти
