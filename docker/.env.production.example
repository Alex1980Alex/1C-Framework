# PDF Vector & Graph Framework — Production Environment
# Copy to .env and fill in real values before deployment

# === API Keys (REQUIRED) ===
ANTHROPIC_API_KEY=sk-ant-...
# JINA_API_KEY=jnai_...

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=pdf_rag
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=  # Set if Qdrant auth is enabled

# === Redis ===
REDIS_URL=redis://redis:6379

# === Neo4j (optional) ===
# GRAPH_STORE__PROVIDER=neo4j
# GRAPH_STORE__NEO4J_URI=bolt://neo4j:7687
# GRAPH_STORE__NEO4J_USER=neo4j
# GRAPH_STORE__NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# === Vector Store ===
VECTOR_STORE__PROVIDER=qdrant
VECTOR_STORE__QDRANT_URL=http://qdrant:6333

# === Auth ===
AUTH__ENABLED=true
AUTH__JWT_SECRET=CHANGE_ME_random_64_char_secret
AUTH__TOKEN_EXPIRE_HOURS=24

# === Guardrails ===
GUARDRAILS__PII_MODE=redact
GUARDRAILS__INJECTION_MODE=block
GUARDRAILS__INJECTION_THRESHOLD=0.7

# === Model Routing ===
# AGENT__COST_BUDGET_PER_QUERY=0.10
# AGENT__COST_BUDGET_DAILY=50.0

# === Logging ===
LOG_LEVEL=INFO

# === Grafana ===
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_password
