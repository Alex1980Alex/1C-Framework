# Dockerfile.gpu — CUDA-enabled build for GPU inference
# Use with: docker compose -f docker-compose.gpu.yml up -d

# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y \
    build-essential curl git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: CUDA Runtime
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# Install Python 3.11
RUN apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3-pip \
    libgomp1 tesseract-ocr tesseract-ocr-rus tesseract-ocr-eng \
    poppler-utils curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_VISIBLE_DEVICES=0

# Create non-root user
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/data /app/.cache && \
    chown -R appuser:appuser /app

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

# Install GPU-specific packages
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cu121 \
    && pip install --no-cache-dir \
    onnxruntime-gpu

WORKDIR /app
COPY --chown=appuser:appuser . .

USER appuser

EXPOSE 8000 7860

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
