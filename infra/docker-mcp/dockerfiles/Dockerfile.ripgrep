# Dockerfile for ripgrep MCP server
FROM node:18-alpine

# Install MCP server globally
RUN npm install -g mcp-ripgrep

# Add global node modules to PATH
ENV PATH=/usr/local/bin:/usr/local/sbin/:$PATH

# Set working directory
WORKDIR /workspace

# Use npx to run globally installed package
CMD ["npx", "-y", "mcp-ripgrep"]

# Labels
LABEL mcp.server="ripgrep"
LABEL mcp.description="Advanced file search"
