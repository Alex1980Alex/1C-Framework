# Dockerfile for sequential-thinking MCP server
FROM node:18-alpine

# Install MCP server globally
RUN npm install -g @modelcontextprotocol/server-sequential-thinking

# Add global node modules to PATH
ENV PATH=/usr/local/bin:/usr/local/sbin/:$PATH

# Use npx to run globally installed package
CMD ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]

# Labels
LABEL mcp.server="sequential-thinking"
LABEL mcp.description="Step-by-step reasoning"
