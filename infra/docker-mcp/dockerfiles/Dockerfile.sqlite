# Dockerfile for sqlite MCP server
FROM node:18-alpine

# Install MCP server globally
RUN npm install -g mcp-sqlite

# Add global node modules to PATH
ENV PATH=/usr/local/bin:/usr/local/sbin/:$PATH

# Set working directory
WORKDIR /data

# Use npx to run globally installed package
CMD ["npx", "-y", "mcp-sqlite", "--db-path", "/data/claude.db"]

# Labels
LABEL mcp.server="sqlite"
LABEL mcp.description="SQLite database operations"
