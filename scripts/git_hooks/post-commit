#!/bin/sh
# post-commit: 1) git-lfs delegate (preserve existing behavior),
#              2) framework_search auto-reindex (detached, non-blocking).

# --- 1. Git-LFS pass-through ---
if command -v git-lfs >/dev/null 2>&1; then
    git lfs post-commit "$@"
fi

# --- 2. Framework-search incremental reindex ---
# Runs in detached background; commit completes immediately.
# Resolve repo root from git itself (works regardless of CWD).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

PYTHON="$REPO_ROOT/.venv/Scripts/python.exe"
HELPER="$REPO_ROOT/scripts/git_post_commit_reindex.py"

if [ -x "$PYTHON" ] && [ -f "$HELPER" ]; then
    "$PYTHON" "$HELPER" --since-ref HEAD~1 >/dev/null 2>&1 || true
fi

exit 0
