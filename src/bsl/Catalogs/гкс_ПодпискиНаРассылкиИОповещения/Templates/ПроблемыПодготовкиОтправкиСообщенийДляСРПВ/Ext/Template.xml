		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдентификаторСообщения</dataPath>
			<field>ИдентификаторСообщения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОписаниеОшибки</dataPath>
			<field>ОписаниеОшибки</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ДокументНаправлениеНаРазгрузку.Ссылка КАК НаправлениеНаРазгрузку,
	ЕСТЬNULL(ПодтвержденияДоставкиСообщений.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК Период,
	ЕСТЬNULL(ПодтвержденияДоставкиСообщений.Состояние, "") КАК Состояние,
	ЕСТЬNULL(ПодтвержденияДоставкиСообщений.ИдентификаторСобытия, "") КАК ИдентификаторСобытия,
	ЕСТЬNULL(ПодтвержденияДоставкиСообщений.ИдентификаторСообщения, "") КАК ИдентификаторСообщения,
	ЕСТЬNULL(ПодтвержденияДоставкиСообщений.ОписаниеОшибки, "") КАК ОписаниеОшибки
{ВЫБРАТЬ
	НаправлениеНаРазгрузку.*,
	Период,
	Состояние,
	ИдентификаторСобытия,
	ИдентификаторСообщения,
	ОписаниеОшибки}
ИЗ
	Документ.гкс_НаправлениеНаРазгрузку КАК ДокументНаправлениеНаРазгрузку
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПодтвержденияДоставкиСообщений.СрезПоследних КАК ПодтвержденияДоставкиСообщений
		ПО ПодтвержденияДоставкиСообщений.Источник = ДокументНаправлениеНаРазгрузку.Ссылка
ГДЕ
	ДокументНаправлениеНаРазгрузку.Ссылка = &amp;гкс_НаправлениеНаРазгрузку	</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<parameter>
