// Возвращает локализованное имя события журнала регистрации для интеграции.
//
// Параметры:
//   СобытиеВторогоУровня - Строка - имя события, добавляемое через точку к имени события по умолчанию.
//
// Возвращаемое значение:
//   Строка - Интеграция с Warehouse
//        или Интеграция с Warehouse.<ИмяСобытияВторогоУровня>.
//
Функция ИмяСобытияЖурналаРегистрации(СобытиеВторогоУровня = "")

	Если СобытиеВторогоУровня = "" Тогда
		Возврат НСтр("ru = 'Интеграция с Warehouse'",
			ОбщегоНазначения.КодОсновногоЯзыка());
	Иначе
		Возврат СтрШаблон("%1.%2",
			НСтр("ru = 'Интеграция с Warehouse'",
				ОбщегоНазначения.КодОсновногоЯзыка()), СобытиеВторогоУровня);
	КонецЕсли;

КонецФункции

