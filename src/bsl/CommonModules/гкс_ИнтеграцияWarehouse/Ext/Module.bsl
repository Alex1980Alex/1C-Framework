КонецФункции

#КонецОбласти

#Область ОбработкаВоходящихДанных

Процедура ОбработатьВходящиеДанные(ПараметрОбработки)

	МенеджерВходящиеДанные = Справочники.гкс_ВходящиеДанныеWarehouse;
	МенеджерОчередиОбработки = РегистрыСведений.гкс_ОчередьОбработкиВходящихДанныхWarehouse;
	ОчередьОбработкиВходящихДанных = МенеджерОчередиОбработки.ВыборкаИзОчереди(ПараметрОбработки);

	Пока ОчередьОбработкиВходящихДанных.Следующий() Цикл

		// Проверка на битую ссылку.
		Если ОчередьОбработкиВходящихДанных.ВходящиеДанные.ПолучитьОбъект() = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Отказ = Ложь;
		ДанныеОбработки = МенеджерОчередиОбработки.СтруктураЗаписи();
		ЗаполнитьЗначенияСвойств(ДанныеОбработки, ОчередьОбработкиВходящихДанных);

		НачатьТранзакцию();

		Попытка

			ВыполнитьОбработкуЭлементаОчереди(ОчередьОбработкиВходящихДанных, ДанныеОбработки, Отказ);

			Если Не Отказ Тогда

				МенеджерОчередиОбработки.УдалитьОбработкуВходящихДанныхВОчереди(
					ОчередьОбработкиВходящихДанных.ВходящиеДанные, ОчередьОбработкиВходящихДанных.Порядок);

				МенеджерВходящиеДанные.ЗаблокироватьДанныеПоСсылке(ОчередьОбработкиВходящихДанных.ВходящиеДанные);
				МенеджерВходящиеДанные.УстановитьПризнакОбработан(ОчередьОбработкиВходящихДанных.ВходящиеДанные);

			КонецЕсли;

			ЗафиксироватьТранзакцию();

		Исключение

			ОтменитьТранзакцию();

			ТекОшибкаИнформация = ИнформацияОбОшибке();
			ОписаниеОшибки 		= ОбработкаОшибок.ПодробноеПредставлениеОшибки(ТекОшибкаИнформация);

			ЗапистьОшибкуОбработки(ДанныеОбработки, ОписаниеОшибки);
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ЗапистьОшибкуОбработки(ДанныеОбработки, ОписаниеОшибки)

	МенеджерОчередиОбработки = РегистрыСведений.гкс_ОчередьОбработкиВходящихДанныхWarehouse;

	Если ПустаяСтрока(ДанныеОбработки.СообщениеОбОшибкеОбработки) Тогда
		Разделитель = "";
	Иначе
		Разделитель = Символы.ПС;
	КонецЕсли;

	СообщениеОбОшибкеОбработки = Новый Массив;
	СообщениеОбОшибкеОбработки.Добавить(ДанныеОбработки.СообщениеОбОшибкеОбработки);
	Если ЗначениеЗаполнено(ДанныеОбработки.СообщениеОбОшибкеОбработки) Тогда
		СообщениеОбОшибкеОбработки.Добавить(Символы.ПС);
	КонецЕсли;
	СообщениеОбОшибкеОбработки.Добавить(ТекущаяДатаСеанса());
	СообщениеОбОшибкеОбработки.Добавить(ОписаниеОшибки);

	ДанныеОбработки.СообщениеОбОшибкеОбработки = СтрСоединить(СообщениеОбОшибкеОбработки, Разделитель);
	ДанныеОбработки.КоличествоНеудачныхОбработок = ДанныеОбработки.КоличествоНеудачныхОбработок + 1;

	МенеджерОчередиОбработки.ЗафиксироватьИзмененияВходящихДанныхВОчереди(ДанныеОбработки);

КонецПроцедуры

Процедура ВыполнитьОбработкуЭлементаОчереди(ЭлементОчередиВходящихДанных, ДанныеОбработки, Отказ)

	РезультатЗапроса = гкс_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
						ЭлементОчередиВходящихДанных.ВходящиеДанные, "ТекстыСообщения");
	ДанныеWarehouse = РезультатЗапроса.Выгрузить();

	МенеджерВнешниеПробы = РегистрыСведений.гкс_ВнешниеПробы;
	ДанныеВнешнейПробы = МенеджерВнешниеПробы.СтруктураЗаписи();

	ЗаполнитьПростыеЗначенияВСтрокуВнешняяПроба(ЭлементОчередиВходящихДанных.ВходящиеДанные,
												ДанныеWarehouse, ДанныеВнешнейПробы);

	ЗаполнитьОрганизацияВСтрокуВнешняяПроба(ДанныеWarehouse, 		ДанныеВнешнейПробы);
	ЗаполнитьПродукциюВСтрокуВнешняяПроба(ДанныеWarehouse, 			ДанныеВнешнейПробы);
	ЗаполнитьСюрвейерВСтрокуВнешняяПроба(ДанныеWarehouse, 			ДанныеВнешнейПробы);
	ЗаполнитьЭлеваторВСтрокуВнешняяПроба(ДанныеWarehouse, 			ДанныеВнешнейПробы);
	ЗаполнитьСтанцииЖДВСтрокуВнешняяПроба(ДанныеWarehouse, 			ДанныеВнешнейПробы);
	ЗаполнитьТранспортныеСредстваВСтрокуВнешняяПроба(ДанныеWarehouse, ДанныеВнешнейПробы);

	Если Не РеквизитыВнешнейПробыЗаполнены(РеквизитыДляПроверки(),
		ДанныеВнешнейПробы, ДанныеОбработки) Тогда

		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ТаблицаВнешняяПроба = МенеджерВнешниеПробы.ИнициализироватьТаблицуВнешнейПробы();
	МассивТаблицПоказателей = ТаблицыПоказателейКачества(ДанныеWarehouse);

	// заполнение таблицы показателей анализа
	Для Каждого ТекущаяТаблица Из МассивТаблицПоказателей Цикл

		ПрочитатьЗаполнитьПоТаблицеПоказателейКачества(
			ТекущаяТаблица, ТаблицаВнешняяПроба,
			ДанныеВнешнейПробы, ДанныеОбработки,
			Отказ);
	КонецЦикла;

	Если ТаблицаВнешняяПроба.Количество() = 0 Тогда
		ШаблоныСообщения 	= ШаблоныСообщенияПроверкиЗаполнения();
		ОписаниеОшибки 		= ШаблоныСообщения.НулевоеЗначение;
		ЗапистьОшибкуОбработки(ДанныеОбработки, ОписаниеОшибки);

		Отказ = Истина;

	Иначе

		Для Каждого ТекСтрока Из ТаблицаВнешняяПроба Цикл
			СтруктураЗаписи	= МенеджерВнешниеПробы.СтруктураЗаписи();
			ЗаполнитьЗначенияСвойств(СтруктураЗаписи, ТекСтрока);
			МенеджерВнешниеПробы.ДобавитьЗапись(СтруктураЗаписи);
		КонецЦикла;

		// заполнение  документа
        Документы.гкс_ВнешняяПроба.ОбновитьПоДаннымWarehouse(ТаблицаВнешняяПроба);

	КонецЕсли;

КонецПроцедуры

#Область ПодборИЗаполнение

Процедура ЗаполнитьПростыеЗначенияВСтрокуВнешняяПроба(ВходящиеДанные, ДанныеWarehouse, ДанныеВнешнейПробы)

	ЗаполнитьЗначенияСвойств(ДанныеВнешнейПробы, ВходящиеДанные);

	ДанныеВнешнейПробы.Период = ВходящиеДанные.ДатаСоздания;
	ДанныеВнешнейПробы.ВходящиеДанные = ВходящиеДанные;

	ЗаполнитьПоКлючуВСтрокуВнешняяПроба(ДанныеWarehouse, ДанныеВнешнейПробы, "weightGross", "ВесБрутто");
	ЗаполнитьПоКлючуВСтрокуВнешняяПроба(ДанныеWarehouse, ДанныеВнешнейПробы, "weightTare", 	"ВесТары");
	ЗаполнитьПоКлючуВСтрокуВнешняяПроба(ДанныеWarehouse, ДанныеВнешнейПробы, "weightNet", 	"ВесНетто");

