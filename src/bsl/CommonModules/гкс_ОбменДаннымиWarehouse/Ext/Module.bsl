// Выгружает все данные из таблицы справочника по указанному полному имени объекта метаданных.
//
// Параметры:
//   ПолноеИмяОбъекта - Строка - Полное имя объекта метаданного (например, "Справочник.Номенклатура")
//
// Возвращаемое значение:
//   ТаблицаЗначений - Таблица с данными справочника
//
Функция ТаблицаЭлементовСправочника(ПолноеИмяОбъекта)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ * ИЗ %1", ПолноеИмяОбъекта);

	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

// Ищет элемент в текущих данных информационной базы по заданным параметрам отбора.
//
// Параметры:
//   ТекущиеДанныеИБ - ТаблицаЗначений - таблица с данными для поиска
//   ПараметрыОтбора - Структура - параметры для поиска строк
//
// Возвращаемое значение:
//   СправочникСсылка - ссылка на найденный элемент
//   Неопределено - элемент не найден
//
Функция НайтиСуществующийЭлемент(ТекущиеДанныеИБ, ПараметрыОтбора)

	ИндексПервой = 0;

	НайденыеЗаписи = ТекущиеДанныеИБ.НайтиСтроки(ПараметрыОтбора);
	Если НайденыеЗаписи.Количество() > 0 Тогда
		Результат = НайденыеЗаписи[ИндексПервой].Ссылка;
	Иначе
		Результат = Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
