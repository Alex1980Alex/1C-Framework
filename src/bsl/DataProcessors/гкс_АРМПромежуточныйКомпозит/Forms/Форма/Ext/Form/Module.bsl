#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокУсиленныйКонтроль

&НаКлиенте
Процедура СписокСписокУсиленныйКонтрольВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элемент.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ИмяФормыДокументаНомераПробы = "Документ.гкс_ФормированиеНомераПробы.Форма.ФормаДокумента";
	ИмяФормыДокументаРегистрацияНаПЛК = "Документ.гкс_РегистрацияНаПЛК.Форма.ФормаДокумента";

	Если Поле = Элементы.СписокСписокУсиленныйКонтрольПометка Тогда
		НовоеЗначениеПометки = НЕ ТекущиеДанные.Пометка;
		УстановитьГрупповуюПометкуУсиленныйКонтроль(ТекущиеДанные.ГруппаТС, НовоеЗначениеПометки);

	ИначеЕсли Поле.Имя = "СписокСписокУсиленныйКонтрольНомерПробы" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ФормированиеПробы) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ФормированиеПробы,
				ИмяФормыДокументаНомераПробы, Истина);
		КонецЕсли;

	ИначеЕсли Поле.Имя = "СписокУсиленныйКонтрольНомерКомпозитнойПробы" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументКомпозитнаяПроба) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ДокументКомпозитнаяПроба,
				ИмяФормыДокументаНомераПробы, Истина);
		КонецЕсли;

	ИначеЕсли Поле.Имя = "СписокУсиленныйКонтрольНомерРегистрации" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ДокументРегистрации,
				ИмяФормыДокументаРегистрацияНаПЛК, Истина);
		КонецЕсли;

	ИначеЕсли Поле.Имя = "СписокУсиленныйКонтрольГруппаТС" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ГруппаТС) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ГруппаТС,
				"Справочник.гкс_ГруппыТС.Форма.ФормаЭлемента", Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокУсиленныйКонтрольДляТС
&НаКлиенте
Процедура СписокУсиленныйКонтрольДляТСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элемент.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ИмяФормыДокументаНомераПробы = "Документ.гкс_ФормированиеНомераПробы.Форма.ФормаДокумента";
	ИмяФормыДокументаРегистрацияНаПЛК = "Документ.гкс_РегистрацияНаПЛК.Форма.ФормаДокумента";

	Если Поле = Элементы.СписокУсиленныйКонтрольДляТСПометка Тогда

		НовоеЗначениеПометки = НЕ ТекущиеДанные.Пометка;

		Для Каждого СтрокаСписка Из СписокУсиленныйКонтрольДляТС Цикл
			СтрокаСписка.Пометка = Ложь;
		КонецЦикла;

		Если НовоеЗначениеПометки Тогда
			Отбор = Новый Структура("ДокументРегистрации", ТекущиеДанные.ДокументРегистрации);
			НайденныеСтроки = СписокУсиленныйКонтрольДляТС.НайтиСтроки(Отбор);
			Для Каждого СтрокаСписка Из НайденныеСтроки Цикл
				СтрокаСписка.Пометка = Истина;
			КонецЦикла;
		КонецЕсли;

	ИначеЕсли Поле.Имя = "СписокУсиленныйКонтрольДляТСНомерПробы" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ФормированиеПробы) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ФормированиеПробы,
				ИмяФормыДокументаНомераПробы, Истина);
		КонецЕсли;

	ИначеЕсли Поле.Имя = "СписокУсиленныйКонтрольДляТСНомерРегистрации" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ДокументРегистрации,
				ИмяФормыДокументаРегистрацияНаПЛК, Истина);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "СписокУсиленныйКонтрольДляТСНомерБлокирующейРегистрации" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.БлокирующаяРегистрация) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.БлокирующаяРегистрация,
				ИмяФормыДокументаРегистрацияНаПЛК, Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокПроизвольныйКомпозит

&НаКлиенте
Процедура СписокПроизвольныйКомпозитВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элемент.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ИмяФормыДокументаНомераПробы = "Документ.гкс_ФормированиеНомераПробы.Форма.ФормаДокумента";
	ИмяФормыДокументаРегистрацияНаПЛК = "Документ.гкс_РегистрацияНаПЛК.Форма.ФормаДокумента";

	Если Поле = Элементы.СписокПроизвольныйКомпозитПометка Тогда

		// Проверка совпадения номенклатуры и контрагента при активации пометки
		Если НЕ ТекущиеДанные.Пометка Тогда
			ПерваяОтмеченнаяСтрока = НайтиПервуюОтмеченнуюСтроку();

			Если ПерваяОтмеченнаяСтрока <> Неопределено Тогда
				МожноПродолжить = ПроверитьСовпадениеДанныхСПервойСтрокой(ТекущиеДанные, ПерваяОтмеченнаяСтрока);
				Если НЕ МожноПродолжить Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ТекущиеДанные.Пометка = НЕ ТекущиеДанные.Пометка;

	ИначеЕсли Поле.Имя = "СписокПроизвольныйКомпозитНомерПробы" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ФормированиеПробы) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ФормированиеПробы,
				ИмяФормыДокументаНомераПробы, Истина);
		КонецЕсли;

	ИначеЕсли Поле.Имя = "СписокПроизвольныйКомпозитНомерПромежуточногоКомпозита" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументКомпозитнаяПроба) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ДокументКомпозитнаяПроба,
				ИмяФормыДокументаНомераПробы, Истина);
		КонецЕсли;

	ИначеЕсли Поле.Имя = "СписокПроизвольныйКомпозитНомерРегистрации" Тогда

		Если ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации) Тогда
			гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ДокументРегистрации,
				ИмяФормыДокументаРегистрацияНаПЛК, Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокПромежуточныеПробы

&НаКлиенте
Процедура СписокПромежуточныеПробыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.СписокПромежуточныеПробы.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ДокументОткрытия = Неопределено;
	ИмяФормыДокумента = Неопределено;

	// Определяем документ и форму в зависимости от поля
	Если Поле.Имя = "СписокПромежуточныеПробыЛабораторныйАнализНомер" Тогда
		ДокументОткрытия = ТекущиеДанные.ПромежуточныйКомпозит;
		ИмяФормыДокумента = "Документ.гкс_ЛабораторныйАнализ.Форма.ФормаДокумента";
	ИначеЕсли Поле.Имя = "СписокПромежуточныеПробыНомерПробы" Тогда
		ДокументОткрытия = ТекущиеДанные.ДокументКомпозитнаяПроба;
		ИмяФормыДокумента = "Документ.гкс_ФормированиеНомераПробы.Форма.ФормаДокумента";
	КонецЕсли;

	// Открываем документ, если он заполнен
	Если ЗначениеЗаполнено(ДокументОткрытия) И ЗначениеЗаполнено(ИмяФормыДокумента) Тогда
		гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ДокументОткрытия, ИмяФормыДокумента, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокПромежуточныеПробыПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.СписокПромежуточныеПробы.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ДокументФормированиеНомераПробы", ТекущиеДанные.ДокументКомпозитнаяПроба);

	СписокРегистрацииПромежуточныхПроб(ПараметрыЗапроса);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокРегистрацииПромежуточныхПроб
&НаКлиенте
Процедура СписокРегистрацииПромежуточныхПробВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элемент.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Если ЗначениеЗаполнено(ТекущиеДанные.ДокументРегистрации) Тогда
		гкс_ПриемкаНаПЛККлиент.ОткрытьДокумент(ЭтотОбъект, ТекущиеДанные.ДокументРегистрации,
			"Документ.гкс_РегистрацияНаПЛК.Форма.ФормаДокумента", Истина);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаУбавитьСутки(Команда)

	ДобавитьСутки(-1);

КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьСутки(Команда)

	ДобавитьСутки(1);

КонецПроцедуры


&НаКлиенте
Процедура КомандаСформироватьПробыУсиленныйКонтроль(Команда)

	Если НеВсеПромежуточныеКомпозитыЗаДатуСформированы(Сутки - гкс_ОбщегоНазначенияКлиентСервер.СекундВДне()) Тогда
		ТекстСообщения = НСтр("ru = 'Не все промежуточные композитные анализы сформированы за предыдущие сутки!.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

	КомандаСформироватьПробы("УсиленныйКонтроль");

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьУсиленныйКонтроль(Команда)
	ОбновитьПериодИФорму();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьПроизвольныйКомпозит(Команда)
	ОбновитьПериодИФорму();
КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьЭтикетки(Команда)

	ТекущиеДанные = Неопределено;

	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "СтраницаПроизвольныйКомпозит" Тогда
		ТекущиеДанные = Элементы.СписокПроизвольныйКомпозит.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "СтраницаПромежуточныеПробы" Тогда
		ТекущиеДанные = Элементы.СписокПромежуточныеПробы.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "СтраницаУсиленныйКонтроль" Тогда
		ТекущиеДанные = Элементы.СписокУсиленныйКонтроль.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "СтраницаУсиленныйКонтрольДляТС" Тогда
		ТекущиеДанные = Элементы.СписокУсиленныйКонтроль.ТекущиеДанные;
	КонецЕсли;

	Если ТекущиеДанные = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Не отмечена проба'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	КомпозитнаяПроба = ТекущиеДанные.ДокументКомпозитнаяПроба;
	Если НЕ ЗначениеЗаполнено(КомпозитнаяПроба) Тогда
		ТекстСообщения = НСтр("ru='Не заполнена композитная проба'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(КомпозитнаяПроба);

	АвтоматическаяПечатьЭтикеток = гкс_ОбщегоНазначенияВызовСервера.ЗначениеКонстанты(
			"гкс_АвтоматическаяПечатьЭтикеток");

	Если АвтоматическаяПечатьЭтикеток Тогда
		ПараметрыПечати = Новый Структура;
		ПараметрыПечати.Вставить("АвтоматическаяПечатьЭтикеток", АвтоматическаяПечатьЭтикеток);

		гкс_УправлениеПечатьюКлиент.ПечатьЭтикеткаНаПринтер(
			"Документ.гкс_ФормированиеНомераПробы", "ПФ_MXL_Этикетка", МассивОбъектов, ПараметрыПечати);
	Иначе
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.гкс_ФормированиеНомераПробы",
			"ПФ_MXL_Этикетка", МассивОбъектов, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСформироватьПробыПроизвольныйКомпозит(Команда)
	КомандаСформироватьПробы("ПроизвольныйКомпозит");
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформироватьЛабораторныйАнализ(Команда)

	ТекущиеДанные = Элементы.СписокПромежуточныеПробы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяКлючевойОперации = "АРМКомпозитныеПробы.ДокументЛабораторныйАнализ.ОткрытиеФормы";

	Оповещение = Новый ОписаниеОповещения("ОбработчикОжиданияСписок", ЭтотОбъект);
	ПараметрыОткрытия = Новый Структура;

	Если ЗначениеЗаполнено(ТекущиеДанные.ПромежуточныйКомпозит) Тогда

		ПараметрыОткрытия.Вставить("Ключ", ТекущиеДанные.ПромежуточныйКомпозит);

		ОткрытьФорму("Документ.гкс_ЛабораторныйАнализ.ФормаОбъекта", ПараметрыОткрытия, ЭтотОбъект, ЭтотОбъект, , ,
			Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьПромежуточныеПробы(Команда)
	ОбновитьПериодИФорму();
КонецПроцедуры

&НаКлиенте
Процедура АнализыНаКаждоеТС(Команда)

	ВыделенныеСтроки = Элементы.СписокУсиленныйКонтроль.ВыделенныеСтроки;

	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны показатели для обработки'"));
		Возврат;
	КонецЕсли;

	ДанныеДляОбработки = Новый Массив;

	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = СписокУсиленныйКонтроль.НайтиПоИдентификатору(ИдентификаторСтроки);

		Если СтрокаТаблицы <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.ГруппаТС) Тогда
			ДанныеСтроки = Новый Структура;
			ДанныеСтроки.Вставить("ГруппаТС", СтрокаТаблицы.ГруппаТС );
			ДанныеСтроки.Вставить("Показатель", СтрокаТаблицы.Показатель);
			ДанныеДляОбработки.Добавить(ДанныеСтроки);
		КонецЕсли;
	КонецЦикла;

	Результат = СформироватьАнализыНаКаждоеТССервер(ДанныеДляОбработки);

	Если Результат.ЕстьДубликаты Тогда
		ПоказатьПредупреждение(, Результат.СообщениеОДубликатах);
	ИначеЕсли Результат.СозданоЗаписей > 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Данные заполнены. Могут быть сформированы единичные анализы для ТС.
			|Создано записей: %1'"),
				Результат.СозданоЗаписей));
		ОбновитьПериодИФорму();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Данные не заполнены. Создано записей: %1'"),
				Результат.СозданоЗаписей));
		ОбновитьПериодИФорму();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьУсиленныйКонтрольДляТС(Команда)
	ОбновитьПериодИФорму();
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформироватьПробыУсиленныйКонтрольДляТС(Команда)
	КомандаСформироватьПробы("УсиленныйКонтрольДляТС");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает параметры открытия формы и имя формы документа
//
// Параметры:
//  ДокументКомпозитнаяПроба - ДокументСсылка - Существующий документ
//  ОтмеченныеСтроки - Массив - Отмеченные строки
//  ТипСписка - Строка - Тип списка
//
// Возвращаемое значение:
//  Структура - Структура с ключами:
//   * ПараметрыОткрытия - Структура
//   * ИмяФормыДокумента - Строка
//
&НаКлиенте
Функция ПолучитьПараметрыОткрытияФормы(ДокументКомпозитнаяПроба, ОтмеченныеСтроки, ТипСписка)

	Результат = Новый Структура;

	Если ЗначениеЗаполнено(ДокументКомпозитнаяПроба) Тогда
		// Открываем существующий документ
		Результат.Вставить("ПараметрыОткрытия", Новый Структура("Ключ", ДокументКомпозитнаяПроба));
		Результат.Вставить("ИмяФормыДокумента", "Документ.гкс_ФормированиеНомераПробы.Форма.ФормаДокумента");
	Иначе
		// Создаем новый документ
		Результат.Вставить("ПараметрыОткрытия", ПодготовитьПараметрыДляНовогоДокумента(ОтмеченныеСтроки, ТипСписка));
		Результат.Вставить("ИмяФормыДокумента",
			"Обработка.гкс_АРМПромежуточныйКомпозит.Форма.ФормаФормированиеКомпозитнойФормы");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выполняет проверки для усиленного контроля
//
// Параметры:
//  НайденныеСтроки - Массив - Массив отмеченных строк
//
// Возвращаемое значение:
//  Булево - Истина, если все проверки пройдены
//
&НаКлиенте
Функция ВыполнитьПроверкиУсиленногоКонтроля(НайденныеСтроки)

	МассивНесовпадений = Новый Массив;

	Результат = ПроверитьСостояниеКачестваУсиленныйКонтроль(НайденныеСтроки, МассивНесовпадений);
	Если НЕ Результат Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Получает список данных в зависимости от типа
//
// Параметры:
//  ТипСписка - Строка - Тип списка
//
// Возвращаемое значение:
//  ТаблицаЗначений - Список данных
//
&НаКлиенте
Функция ПолучитьСписокДанныхПоТипу(ТипСписка)

	Если ТипСписка = "УсиленныйКонтроль" Тогда
		Возврат СписокУсиленныйКонтроль;
	ИначеЕсли ТипСписка = "УсиленныйКонтрольДляТС" Тогда
		Возврат СписокУсиленныйКонтрольДляТС;
	Иначе
		Возврат СписокПроизвольныйКомпозит;
	КонецЕсли;

КонецФункции

// Получает и проверяет отмеченные строки списка
//
// Параметры:
//  СписокДанных - ТаблицаЗначений - Список для анализа
//
// Возвращаемое значение:
//  Массив - Массив отмеченных строк или Неопределено при отсутствии отмеченных строк
//
&НаКлиенте
Функция ПолучитьОтмеченныеСтроки(СписокДанных)

	ОтборПоПометке = Новый Структура("Пометка", Истина);
	НайденныеСтроки = СписокДанных.НайтиСтроки(ОтборПоПометке);

	Если НайденныеСтроки.Количество() = 0 Тогда
		гкс_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не выбрано ни одной строки для формирования проб'"));
		Возврат Неопределено;
	КонецЕсли;

	Возврат НайденныеСтроки;

КонецФункции

// Анализирует отмеченные строки и находит существующий документ композитной пробы
//
// Параметры:
//  НайденныеСтроки - Массив - Массив отмеченных строк
//
// Возвращаемое значение:
//  Структура - Структура с ключами:
//   * ОтмеченныеСтроки - Массив - Строки без существующего документа
//   * ДокументКомпозитнаяПроба - ДокументСсылка, Неопределено - Найденный документ
//
&НаКлиенте
Функция АнализироватьОтмеченныеСтроки(НайденныеСтроки)

	Результат = Новый Структура;
	ОтмеченныеСтроки = Новый Массив;
	ДокументКомпозитнаяПроба = Неопределено;

	Для Каждого СтрокаСписка Из НайденныеСтроки Цикл
		Если ЗначениеЗаполнено(СтрокаСписка.ДокументКомпозитнаяПроба) Тогда
			ДокументКомпозитнаяПроба = СтрокаСписка.ДокументКомпозитнаяПроба;
			Прервать;
		Иначе
			ОтмеченныеСтроки.Добавить(СтрокаСписка);
		КонецЕсли;
	КонецЦикла;

	Результат.Вставить("ОтмеченныеСтроки", ОтмеченныеСтроки);
	Результат.Вставить("ДокументКомпозитнаяПроба", ДокументКомпозитнаяПроба);

	Возврат Результат;

КонецФункции

// Подготавливает параметры открытия формы для нового документа композитной пробы
//
// Параметры:
//  ОтмеченныеСтроки - Массив - Массив отмеченных строк
//  ТипСписка - Строка - Тип списка ("ПроизвольныйКомпозит" или "УсиленныйКонтроль")
//
// Возвращаемое значение:
//  Структура - Параметры открытия формы
//
&НаКлиенте
Функция ПодготовитьПараметрыДляНовогоДокумента(ОтмеченныеСтроки, ТипСписка)

	ПараметрыОткрытия = Новый Структура;
	ДопПараметры = Новый Структура;

	Если ТипСписка = "УсиленныйКонтрольДляТС" Тогда
		// Для СтраницаУсиленныйКонтрольДляТС вкладки - ЕДИНИЧНЫЕ пробы (одно ТС = один анализ)
		ТипПробы = ПредопределенноеЗначение("Перечисление.гкс_ТипыПроб.Единичная");
	Иначе
		// Для остальных вкладок - композитные пробы
		ТипПробы = ПредопределенноеЗначение("Перечисление.гкс_ТипыПроб.Композитная");
	КонецЕсли;

	// Формируем массив структур из всех отмеченных строк
	МассивСтрокДанных = Новый Массив;
	МассивДокументРегистрации = Новый Массив;
	Для Каждого СтрокаДанных Из ОтмеченныеСтроки Цикл
		Если МассивДокументРегистрации.Найти(СтрокаДанных.ДокументРегистрации) = Неопределено Тогда
			МассивДокументРегистрации.Добавить(СтрокаДанных.ДокументРегистрации);
			СтруктураСтроки = Новый Структура;
			СтруктураСтроки.Вставить("ДокументРегистрации", СтрокаДанных.ДокументРегистрации);
			МассивСтрокДанных.Добавить(СтруктураСтроки);
		КонецЕсли;
	КонецЦикла;


	// Общие параметры
	ДопПараметры.Вставить("Номенклатура", ОтмеченныеСтроки[0].Номенклатура);
	ДопПараметры.Вставить("Контрагент", ОтмеченныеСтроки[0].Контрагент);
	ДопПараметры.Вставить("Организация", ОтмеченныеСтроки[0].Организация);
	ДопПараметры.Вставить("ТочкаМаршрута", Объект.ТочкаМаршрута);
	ДопПараметры.Вставить("ВидПеревозки", Объект.ВидПеревозки);
	ДопПараметры.Вставить("МассивСтрокДанных", МассивСтрокДанных);
	ДопПараметры.Вставить("НачалоПериода", НачалоПериода);
	ДопПараметры.Вставить("КонецПериода", КонецПериода);
	ДопПараметры.Вставить("ПроизводственныеСуткиРегистрации", Сутки);

	ДопПараметры.Вставить("ТипПробы", ТипПробы);

	// Общие для обоих типов - данные о погрузке и станции
	ДопПараметры.Вставить("ПунктПогрузки", ОтмеченныеСтроки[0].ПунктПогрузки);
	ДопПараметры.Вставить("СтанцияОтправления", ОтмеченныеСтроки[0].СтанцияОтправления);
	ДопПараметры.Вставить("СтанцияОтправленияПредставление", ОтмеченныеСтроки[0].СтанцияОтправленияПредставление);

	// Специфичные параметры для усиленного контроля
	Если ТипСписка = "УсиленныйКонтроль" ИЛИ ТипСписка = "УсиленныйКонтрольДляТС" Тогда
		МассивПоказателей = Новый Массив;
		Для Каждого СтрокаДанных Из ОтмеченныеСтроки Цикл
			Если МассивПоказателей.Найти(СтрокаДанных.Показатель) = Неопределено Тогда
				МассивПоказателей.Добавить(СтрокаДанных.Показатель);
			КонецЕсли;
		КонецЦикла;
		ДопПараметры.Вставить("МассивПоказателей", МассивПоказателей);
	КонецЕсли;



	ПараметрыОткрытия.Вставить("ДопПараметры", ДопПараметры);

	// Параметры страницы в зависимости от типа
	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;

	Если ТипСписка = "УсиленныйКонтроль" Тогда
		ПараметрыОткрытия.Вставить("СтраницаУсиленныйКонтроль",
			ТекущаяСтраница.Имя = "СтраницаУсиленныйКонтроль");
	ИначеЕсли ТипСписка = "УсиленныйКонтрольДляТС" Тогда
		// СтраницаУсиленныйКонтрольДляТС: единичные пробы для конкретного ТС
		ПараметрыОткрытия.Вставить("СтраницаУсиленныйКонтрольДляТС",
			ТекущаяСтраница.Имя = "СтраницаУсиленныйКонтрольДляТС");
	Иначе
		ПараметрыОткрытия.Вставить("СтраницаПроизвольныйКомпозит",
			ТекущаяСтраница.Имя = "СтраницаПроизвольныйКомпозит");
		ПараметрыОткрытия.Вставить("СтраницаПромежуточныеПробы",
			ТекущаяСтраница.Имя = "СтраницаПромежуточныеПробы");
	КонецЕсли;


	Возврат ПараметрыОткрытия;

КонецФункции

&НаКлиенте
Процедура КомандаСформироватьПробы(ТипСписка = "ПроизвольныйКомпозит")

	// Получаем список данных
	СписокДанных = ПолучитьСписокДанныхПоТипу(ТипСписка);

	// Получаем и проверяем отмеченные строки
	НайденныеСтроки = ПолучитьОтмеченныеСтроки(СписокДанных);
	Если НайденныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Проверки для усиленного контроля (включая УК для ТС)
	Если (ТипСписка = "УсиленныйКонтроль" ИЛИ ТипСписка = "УсиленныйКонтрольДляТС")
		И НЕ ВыполнитьПроверкиУсиленногоКонтроля(НайденныеСтроки) Тогда
		Возврат;
	КонецЕсли;

	// Проверка дублей единичных проб для закладки "УК для ТС"
	Если ТипСписка = "УсиленныйКонтрольДляТС" Тогда
		МассивРегистраций = Новый Массив;
		Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
			МассивРегистраций.Добавить(СтрокаДанных.ДокументРегистрации);
		КонецЦикла;
		Если ЕстьДубликатыЕдиничныхПроб(МассивРегистраций) Тогда
			ПоказатьПредупреждение(,
				НСтр("ru = 'Для выбранных регистраций уже существуют единичные пробы
				|с назначением использования ПромежуточныйКомпозит. Повторное создание невозможно.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;


	// Анализируем отмеченные строки
	РезультатАнализа = АнализироватьОтмеченныеСтроки(НайденныеСтроки);
	ОтмеченныеСтроки = РезультатАнализа.ОтмеченныеСтроки;
	ДокументКомпозитнаяПроба = РезультатАнализа.ДокументКомпозитнаяПроба;

	// Подготовка параметров открытия формы
	ПараметрыФормы = ПолучитьПараметрыОткрытияФормы(ДокументКомпозитнаяПроба, ОтмеченныеСтроки, ТипСписка);
	Оповещение = Новый ОписаниеОповещения("ОбработчикОжиданияСписок", ЭтотОбъект);

	ОткрытьФорму(ПараметрыФормы.ИмяФормыДокумента, ПараметрыФормы.ПараметрыОткрытия, ЭтотОбъект, ЭтотОбъект, , ,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Функция НайтиПервуюОтмеченнуюСтроку()

	Для Каждого СтрокаСписка Из СписокПроизвольныйКомпозит Цикл
		Если СтрокаСписка.Пометка Тогда
			Возврат СтрокаСписка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ПроверитьСовпадениеДанныхСПервойСтрокой(ТекущиеДанные, ПерваяОтмеченнаяСтрока)

	МассивНесовпадений = Новый Массив;

	// Проверяем номенклатуру
	Если ТекущиеДанные.Номенклатура <> ПерваяОтмеченнаяСтрока.Номенклатура Тогда
		// Формируем текст сообщения по аналогии с контрагентом
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Выбранная строка имеет отличающиеся данные от первой отмеченной строки:%1- Номенклатура'"),
			Символы.ПС);
		ПоказатьПредупреждение( , ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;

	// Проверяем контрагента
	Если ТекущиеДанные.Контрагент <> ПерваяОтмеченнаяСтрока.Контрагент Тогда
		МассивНесовпадений.Добавить("Контрагент");
	КонецЕсли;

	Если ТекущиеДанные.Организация <> ПерваяОтмеченнаяСтрока.Организация Тогда
		МассивНесовпадений.Добавить("Организация");
	КонецЕсли;

	// Выводим сообщение при наличии несовпадений
	Если МассивНесовпадений.Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru = 'Выбранная строка имеет отличающиеся данные от первой отмеченной строки:'");

		Для Каждого Несовпадение Из МассивНесовпадений Цикл
			ТекстСообщения = СтрШаблон("%1%2- %3", ТекстСообщения, Символы.ПС, Несовпадение);
		КонецЦикла;

		ТекстСообщения = СтрШаблон("%1%2%3", ТекстСообщения, Символы.ПС, НСтр("ru = 'Продолжить?'"));

		ДополнительныеПараметры = Новый Структура("ТекущиеДанные", ТекущиеДанные);
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса", ЭтотОбъект,
			ДополнительныеПараметры);
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, Режим, 0, , "Несовпадение данных");

		Возврат Ложь;

	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ТекущиеДанные.Пометка = НЕ ТекущиеДанные.Пометка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПериодИФорму()
	УстановитьПериод();
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормой()

	Видимость = ПроверитьОсновныеОтборы();

	Элементы.ГруппаСтраницы.Видимость = Видимость;
	Элементы.ГруппаОбщиеОтборы.Видимость = Видимость;

	ОбработчикОжидания(Видимость);
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжидания(Подключить)
	Если Подключить Тогда
		ИнтервалОбработки = 0.5;
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСписок", ИнтервалОбработки, Истина);
	Иначе
		ОтключитьОбработчикОжидания("Подключаемый_ОбновитьСписок");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьОсновныеОтборы()
	Возврат ЗначениеЗаполнено(Объект.ТочкаМаршрута)
		И ЗначениеЗаполнено(Объект.ВидПеревозки)
		И ЗначениеЗаполнено(Сутки)
		И ЗначениеЗаполнено(НачалоПериода)
		И ЗначениеЗаполнено(КонецПериода);
КонецФункции

&НаСервере
Процедура ИнициализироватьРеквизитыФормы()

	Сутки = НачалоДня(НачалоДня(ТекущаяДатаСеанса()) - 1);

	СписокСостояний = Объект.СписокСостояний;
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.Прибыл);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.ГотовКОтборуПроб);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.КачествоНеПринято);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.НеПринято);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.ПринятыПробы);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.КачествоПринято);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.ВыгрузкаРазрешена);
	СписокСостояний.Добавить(Перечисления.гкс_СостоянияРегистрации.РезультатыПробПолучены);

	УстановитьПериод();

	ИнициализироватьОтборТочкаМаршрута();

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступность()
	ИспользоватьУсиленныйКонтроль = ПолучитьФункциональнуюОпцию("гкс_ИспользоватьУсиленныйКонтрольКачества");
	Элементы.СтраницаУсиленныйКонтроль.Видимость = ИспользоватьУсиленныйКонтроль;
	Элементы.СтраницаУсиленныйКонтрольДляТС.Видимость = ИспользоватьУсиленныйКонтроль;
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОтборТочкаМаршрута()

	ИспользоватьНесколькоАЛЦ = ПолучитьФункциональнуюОпцию("гкс_ИспользоватьНесколькоАЛЦ");

	Элементы.ОтборТочкаМаршрута.Доступность = ИспользоватьНесколькоАЛЦ;
	Элементы.ОтборТочкаМаршрута.РежимВыбораИзСписка = ИспользоватьНесколькоАЛЦ;

	АЛЦПользователя = Новый Массив;
	Объект.ТочкаМаршрута =
		гкс_ПриемкаТранспорта.ПЛКизНастроекБазыПользователя(ИспользоватьНесколькоАЛЦ, АЛЦПользователя);
	Если ИспользоватьНесколькоАЛЦ
		И ЗначениеЗаполнено(АЛЦПользователя) Тогда
		СписокВыбора = Элементы.ОтборТочкаМаршрута.СписокВыбора;
		СписокВыбора.ЗагрузитьЗначения(АЛЦПользователя);
	КонецЕсли;

КонецПроцедуры

