&НаКлиенте
Функция ПроверитьСостояниеКачестваУсиленныйКонтроль(НайденныеСтроки, МассивНесовпадений)

	// Создаем массив допустимых состояний
	ДопустимыеСостояния = Новый СписокЗначений;
	ДопустимыеСостояния.Добавить(ПредопределенноеЗначение("Перечисление.гкс_СостоянияКачества.ПустаяСсылка"));
	ДопустимыеСостояния.Добавить(ПредопределенноеЗначение("Перечисление.гкс_СостоянияКачества.ОтборПроб"));

	Для Каждого СтрокаСписка Из НайденныеСтроки Цикл
		// Если состояние НЕ в списке допустимых
		Если ДопустимыеСостояния.НайтиПоЗначению(СтрокаСписка.СостояниеКачества) = Неопределено Тогда

			ШаблонСообщения = НСтр("ru = 'Для регистрации %1 анализы на показатель %2 уже выполнены (состояние: %3).
			|Повторно анализы не могут быть сформированы.'");

			ТекстСообщения = СтрШаблон(ШаблонСообщения,
					СтрокаСписка.ДокументРегистрации,
					СтрокаСписка.Показатель,
					СтрокаСписка.СостояниеКачества);
			гкс_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Создать анализы на каждое ТССервер.
//
// Параметры:
//  ДанныеДляОбработки - Массив - Данные для обработки
//
// Возвращаемое значение:
//  Структура - Создать анализы на каждое ТССервер:
// * ЕстьДубликаты - Булево -
// * СообщениеОДубликатах - Строка -
// * СозданоЗаписей - Число -
&НаСервере
Функция СформироватьАнализыНаКаждоеТССервер(ДанныеДляОбработки)

	Результат = Новый Структура("ЕстьДубликаты, СообщениеОДубликатах, СозданоЗаписей", Ложь, "", 0);

	// Формируем таблицу входных данных с типами
	ТаблицаВходныхДанных = Новый ТаблицаЗначений;
	ТаблицаВходныхДанных.Колонки.Добавить("ГруппаТС",
		Новый ОписаниеТипов("СправочникСсылка.гкс_ГруппыТС"));
	ТаблицаВходныхДанных.Колонки.Добавить("Показатель",
		Новый ОписаниеТипов("СправочникСсылка.гкс_ПоказателиАнализовНоменклатуры"));

	Для Каждого Данные Из ДанныеДляОбработки Цикл
		НоваяСтрока = ТаблицаВходныхДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Данные);
	КонецЦикла;

	// Запрос: получение состава групп + проверка дубликатов
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПолучениеСоставаГруппПроверкаДубликатов();
	Запрос.УстановитьПараметр("ТаблицаВходныхДанных", ТаблицаВходныхДанных);
	ТаблицаРезультатов = Запрос.Выполнить().Выгрузить();

	// Проверяем есть ли дубликаты
	СтрокиДубликатов = ТаблицаРезультатов.НайтиСтроки(Новый Структура("ЕстьДубликат", Истина));
	Если СтрокиДубликатов.Количество() > 0 Тогда
		Результат.ЕстьДубликаты = Истина;
		Результат.СообщениеОДубликатах = НСтр("ru = 'Обнаружены существующие записи с такими параметрами.
			|Создание дублирующих записей невозможно.'");
		Возврат Результат;
	КонецЕсли;

	НазначениеИспользования = Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит;
	ТипПробы = Перечисления.гкс_ТипыПроб.Единичная;

    ДополнительныеДанныеЗаполнения = Новый Структура;
	ДополнительныеДанныеЗаполнения.Вставить("НазначениеИспользования", НазначениеИспользования);
	ДополнительныеДанныеЗаполнения.Вставить("ТипПробы", ТипПробы);
	ДополнительныеДанныеЗаполнения.Вставить("ТочкаМаршрута", Объект.ТочкаМаршрута);

	НачатьТранзакцию();
	Попытка
		Для Каждого СтрокаДанных Из ТаблицаРезультатов Цикл
			РегистрыСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации.ЗаписатьПоказательУКПоРегистрации(
				СтрокаДанных, ДополнительныеДанныеЗаполнения, Сутки);
			Результат.СозданоЗаписей = Результат.СозданоЗаписей + 1;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка при создании записей анализов: %1.'"), ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ТекстЗапросаПолучениеСоставаГруппПроверкаДубликатов()
	Возврат
	"ВЫБРАТЬ
	|	Входные.ГруппаТС КАК ГруппаТС,
	|	Входные.Показатель КАК Показатель
	|ПОМЕСТИТЬ ВТ_ВходныеДанные
	|ИЗ
	|	&ТаблицаВходныхДанных КАК Входные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Входные.ГруппаТС КАК ГруппаТС,
	|	Входные.Показатель КАК Показатель,
	|	ИсходныеЗаписи.ЗначениеПоказателяМин КАК ЗначениеПоказателяМин,
	|	ИсходныеЗаписи.ЗначениеПоказателяМакс КАК ЗначениеПоказателяМакс,
	|	ИсходныеЗаписи.Базис КАК Базис,
	|	ИсходныеЗаписи.ДокументРегистрации КАК ДокументРегистрации
	|ПОМЕСТИТЬ ВТ_ПоказателиУсиленногоКонтроляГруппы
	|ИЗ
	|	ВТ_ВходныеДанные КАК Входные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СоставГруппТранспорта КАК СоставГруппы
	|		ПО Входные.ГруппаТС = СоставГруппы.ГруппаТС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК ИсходныеЗаписи
	|		ПО СоставГруппы.РегистрацияТранспорта = ИсходныеЗаписи.ДокументРегистрации
	|		И Входные.Показатель = ИсходныеЗаписи.Показатель
	|		И ИсходныеЗаписи.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Композитная)
	|		И
	|			ИсходныеЗаписи.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
	|ГДЕ
	|	ИсходныеЗаписи.СостояниеКачества <> ЗНАЧЕНИЕ(Перечисление.гкс_СостоянияКачества.ПробыНеТребуются)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоказателиУсиленногоКонтроляГруппы.ГруппаТС КАК ГруппаТС,
	|	ВТ_ПоказателиУсиленногоКонтроляГруппы.Показатель КАК Показатель,
	|	МАКСИМУМ(ВТ_ПоказателиУсиленногоКонтроляГруппы.ЗначениеПоказателяМин) КАК ЗначениеПоказателяМин,
	|	МАКСИМУМ(ВТ_ПоказателиУсиленногоКонтроляГруппы.ЗначениеПоказателяМакс) КАК ЗначениеПоказателяМакс,
	|	МАКСИМУМ(ВТ_ПоказателиУсиленногоКонтроляГруппы.Базис) КАК Базис
	|ПОМЕСТИТЬ ВТ_ИсходныеДанныеГруппы
	|ИЗ
	|	ВТ_ПоказателиУсиленногоКонтроляГруппы КАК ВТ_ПоказателиУсиленногоКонтроляГруппы
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоказателиУсиленногоКонтроляГруппы.ГруппаТС,
	|	ВТ_ПоказателиУсиленногоКонтроляГруппы.Показатель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Состав.РегистрацияТранспорта КАК ДокументРегистрации,
	|	Входные.Показатель КАК Показатель,
	|	ЕСТЬNULL(ИсходныеДанные.ЗначениеПоказателяМин, 0) КАК ЗначениеПоказателяМин,
	|	ЕСТЬNULL(ИсходныеДанные.ЗначениеПоказателяМакс, 0) КАК ЗначениеПоказателяМакс,
	|	ЕСТЬNULL(ИсходныеДанные.Базис, 0) КАК Базис,
	|	ВЫБОР
	|		КОГДА Регистр.ДокументРегистрации ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьДубликат
	|ИЗ
	|	ВТ_ВходныеДанные КАК Входные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СоставГруппТранспорта КАК Состав
	|		ПО Входные.ГруппаТС = Состав.ГруппаТС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсходныеДанныеГруппы КАК ИсходныеДанные
	|		ПО Входные.ГруппаТС = ИсходныеДанные.ГруппаТС
	|		И Входные.Показатель = ИсходныеДанные.Показатель
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.гкс_ПоказателиУсиленногоКонтроляПоРегистрации КАК Регистр
	|		ПО Состав.РегистрацияТранспорта = Регистр.ДокументРегистрации
	|		И Входные.Показатель = Регистр.Показатель
	|		И Регистр.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная)
	|		И Регистр.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПоказателиУсиленногоКонтроляГруппы КАК ПоказателиУсиленногоКонтроляГруппы
	|		ПО Состав.РегистрацияТранспорта = ПоказателиУсиленногоКонтроляГруппы.ДокументРегистрации";

КонецФункции

&НаСервереБезКонтекста
Функция НеВсеПромежуточныеКомпозитыЗаДатуСформированы(ПроизводственныеСутки)

	РегистрацииБезКомпозита = гкс_ВходнойКонтрольКачества.
		РегистрацииБезПромежуточногоКомпозитаЗаДату(ПроизводственныеСутки);

	Возврат ЗначениеЗаполнено(РегистрацииБезКомпозита);

КонецФункции

// Проверяет наличие существующих единичных проб для регистраций
// с назначением использования ПромежуточныйКомпозит.
// Используется для исключения дублей при формировании проб с закладки "УК для ТС".
//
// Параметры:
//  МассивРегистраций - Массив - массив ссылок на документы регистрации
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы для одной регистрации уже существует единичная проба
//
&НаСервереБезКонтекста
Функция ЕстьДубликатыЕдиничныхПроб(МассивРегистраций)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФНПСписокРегистраций.ДокументРегистрации КАК ДокументРегистрации
	|ИЗ
	|	Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК ФНПСписокРегистраций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы КАК ФНП
	|		ПО ФНПСписокРегистраций.Ссылка = ФНП.Ссылка
	|		И ФНП.Проведен
	|		И ФНП.ТипПробы = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыПроб.Единичная)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.гкс_СопоставлениеФНПЛабАнализа КАК СопоставлениеФНПЛА
	|		ПО ФНП.Ссылка = СопоставлениеФНПЛА.ФормированиеНомераПробы
	|		И
	|			СопоставлениеФНПЛА.НазначениеИспользования = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит)
	|ГДЕ
	|	ФНПСписокРегистраций.ДокументРегистрации В (&МассивРегистраций)";

	Запрос.УстановитьПараметр("МассивРегистраций", МассивРегистраций);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
