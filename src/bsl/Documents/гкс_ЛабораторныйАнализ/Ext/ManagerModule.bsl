#КонецОбласти

Функция ЗаблокироватьКонкурентноеСозданиеЛабораторногоАнализа(ДокументОснованиеОграничитель) Экспорт

	Результат = Ложь;

	Если НЕ ТранзакцияАктивна() Тогда
		Возврат Ложь;
	КонецЕсли;

	БлокировкаДанных = Новый БлокировкаДанных();

	ЭлементБлокировки = БлокировкаДанных.Добавить("Документ.гкс_ЛабораторныйАнализ");
	ЭлементБлокировки.УстановитьЗначение("гкс_ДокументРегистрации", ДокументОснованиеОграничитель);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	Попытка
		БлокировкаДанных.Заблокировать();
		Результат = Истина;
	Исключение
		Результат = Ложь;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Расчитывает средневзвешенные показатели по входным лаботаторным анализам
//
// Параметры:
//   ЛабораторныйАнализ - ДокументСсылка.гкс_ЛабораторныйАнализ - композитный лаб.анализ
//
// Возвращаемое значение:
//  Соответствие - средневзвешенные значения показателей
//
Функция СредневзвешенныеПоказателиКомпозитногоАнализа(ЛабораторныйАнализ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЛабораторныйАнализ.гкс_ДокументРегистрации КАК ДокументНомерПробы
	|ПОМЕСТИТЬ ВТ_ФормированиеПробы
	|ИЗ
	|	Документ.гкс_ЛабораторныйАнализ КАК ЛабораторныйАнализ
	|ГДЕ
	|	ЛабораторныйАнализ.Ссылка = &Ссылка
	|	И
	|		ЛабораторныйАнализ.гкс_НазначениеИспользованияКачества = ЗНАЧЕНИЕ(Перечисление.гкс_НазначенияИспользованияКачества.ПриемкаКомпозит)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ФормированиеНомераПробыСписокРегистраций.ДокументРегистрации КАК ДокументРегистрации
	|ПОМЕСТИТЬ ВТ_ДокументыРегистрации
	|ИЗ
	|	ВТ_ФормированиеПробы КАК ВТ_ФормированиеПробы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ФормированиеНомераПробы.СписокРегистраций КАК
	|			ФормированиеНомераПробыСписокРегистраций
	|		ПО ФормированиеНомераПробыСписокРегистраций.Ссылка = ВТ_ФормированиеПробы.ДокументНомерПробы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛабораторныйАнализ.Ссылка КАК Ссылка,
	|	ВТ_ДокументыРегистрации.ДокументРегистрации КАК ДокументРегистрации
	|ПОМЕСТИТЬ ВТ_ВходныеЛабАнализы
	|ИЗ
	|	ВТ_ДокументыРегистрации КАК ВТ_ДокументыРегистрации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ КАК ЛабораторныйАнализ
	|		ПО ВТ_ДокументыРегистрации.ДокументРегистрации = ЛабораторныйАнализ.гкс_ДокументРегистрации
	|ГДЕ
	|	ЛабораторныйАнализ.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КачественныеПоказатели.Показатель КАК Показатель,
	|	КачественныеПоказатели.Значение КАК Значение,
	|	КачественныеПоказатели.СоответствуетНормативу КАК СоответствуетНормативу,
	|	КачественныеПоказатели.НомерПробы КАК НомерПробы,
	|	ВТ_ВходныеЛабАнализы.Ссылка КАК Ссылка,
	|	ВТ_ВходныеЛабАнализы.ДокументРегистрации КАК ДокументРегистрации,
	|	ТИПЗНАЧЕНИЯ(КачественныеПоказатели.Значение) = ТИП(ЧИСЛО) КАК ЗначениеЧисло
	|ИЗ
	|	ВТ_ВходныеЛабАнализы КАК ВТ_ВходныеЛабАнализы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ЛабораторныйАнализ.КачественныеПоказатели КАК КачественныеПоказатели
	|		ПО ВТ_ВходныеЛабАнализы.Ссылка = КачественныеПоказатели.Ссылка";

	Запрос.УстановитьПараметр("Ссылка", ЛабораторныйАнализ);

	РезультатЗапроса = Запрос.Выполнить();

	ТаблицаДанных = РезультатЗапроса.Выгрузить();

	ТаблицаРегистраций = РезультатЗапроса.Выгрузить();
	ТаблицаРегистраций.Свернуть("ДокументРегистрации");
	ТаблицаРегистраций.Колонки.Добавить("Вес");

	Для Каждого СтрокаДанных Из ТаблицаРегистраций Цикл
        // определяем вес по накладной
		ДанныеПоВесу = гкс_ПриемкаНаПЛКСервер.ПоказанияВесовПоРегистрации(СтрокаДанных.ДокументРегистрации);
		СтрокаДанных.Вес = ДанныеПоВесу.НеттоФакт;
	КонецЦикла;

	ОбщийВес = ТаблицаРегистраций.Итог("Вес");

	// расчет коэффициентов
	ТаблицаДанных.Колонки.Добавить("ЗначениеКоэф");

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		Если СтрокаДанных.ЗначениеЧисло Тогда
			НайденнаяСтрока = ТаблицаРегистраций.Найти(СтрокаДанных.ДокументРегистрации, "ДокументРегистрации");
			СтрокаДанных.ЗначениеКоэф = СтрокаДанных.Значение * НайденнаяСтрока.Вес;
		Иначе
			СтрокаДанных.ЗначениеКоэф = 0;
		КонецЕсли;

	КонецЦикла;

	ТаблицаДанных.Свернуть("Показатель", "ЗначениеКоэф");

	Если ОбщийВес = 0 Тогда
		ТранспортноеСредствоИмяРеквизита = "ТранспортноеСредство";
		ТранспортноеСредство = Неопределено;

		Если ТаблицаРегистраций.Количество() > 0 Тогда
			ТранспортноеСредство = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ТаблицаРегистраций[0].ДокументРегистрации, ТранспортноеСредствоИмяРеквизита);
		КонецЕсли;

		ОбщаяЧастьСообщения = НСтр(
			"ru = 'Отсутствует вес тары и вес нетто. Средневзвешенные показатели не могут быть рассчитаны.'");

		Если ЗначениеЗаполнено(ТранспортноеСредство) Тогда

			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
            	НСтр("ru = 'Для ТС: %1. %2'"), ТранспортноеСредство, ОбщаяЧастьСообщения);

		Иначе
			ТекстОшибки = ОбщаяЧастьСообщения;
		КонецЕсли;

		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Соответствие;
	Для  Каждого СтрокаДанных Из ТаблицаДанных Цикл
		Результат.Вставить(СтрокаДанных.Показатель, Окр(СтрокаДанных.ЗначениеКоэф/ОбщийВес, 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Производит поиск внешней пробы
//
// Параметры:
//	ДокументРегистрации - ДокументСсылка.гкс_РегистрацияНаПЛК - документ регистрации на ПЛК
//	НазначениеИспользованияКачества - ПеречислениеСсылка.гкс_НазначенияИспользованияКачества - назначение
//																								качества лаб анализа
//
// Возвращаемое значение:
//  Неопределено, Структура:
//		- ВнешняяПроба - ДокументСсылка.гкс_ВнешняяПроба - Документ внешней пробы
//      - КачественныеПоказатели - Массив Из Структур - массив структур со значениями показателей внешней пробы
//
Функция ПоискДокументаВнешнейПробы(ДокументРегистрации, НазначениеИспользованияКачества) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ТранспортныйДокументТабЧасть.Ссылка КАК Ссылка,
		|	ТранспортныйДокументТабЧасть.ДатаПогрузки КАК ДатаПогрузки,
		|	ТранспортныйДокументТабЧасть.Номенклатура КАК Номенклатура,
		|	ТранспортныйДокументТабЧасть.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ЖДНакладная.ВидПеревозки КАК ВидПеревозки,
		|	ТранспортныйДокументТабЧасть.Заявка КАК Заявка,
		|	ЕСТЬNULL(ЗаявкаНаПеревозку.Номер, """") КАК НомерЗаявки,
		|	РегистрацияНаПЛК.Дата КАК Дата,
		|	РегистрацияНаПЛК.ТочкаМаршрута КАК ТочкаМаршрута
		|ИЗ
		|	РегистрСведений.гкс_СвязьРегистрацииИТранспортногоДокумента КАК СвязьРегистрацииИТранспортногоДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ТранспортныйДокумент.ТранспортныеСредства КАК ТранспортныйДокументТабЧасть
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.гкс_ЗаявкаНаПеревозку КАК ЗаявкаНаПеревозку
		|			ПО ТранспортныйДокументТабЧасть.Заявка = ЗаявкаНаПеревозку.Ссылка
		|		ПО СвязьРегистрацииИТранспортногоДокумента.ТранспортныйДокумент = ТранспортныйДокументТабЧасть.Ссылка
		|			И СвязьРегистрацииИТранспортногоДокумента.ТранспортноеСредство = ТранспортныйДокументТабЧасть.ТранспортноеСредство
		|			И (СвязьРегистрацииИТранспортногоДокумента.ДокументРегистрации = &ДокументРегистрации)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ТранспортныйДокумент КАК ЖДНакладная
		|		ПО (ТранспортныйДокументТабЧасть.Ссылка = ЖДНакладная.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_РегистрацияНаПЛК КАК РегистрацияНаПЛК
		|		ПО СвязьРегистрацииИТранспортногоДокумента.ДокументРегистрации = РегистрацияНаПЛК.Ссылка";

	Запрос.УстановитьПараметр("ДокументРегистрации", ДокументРегистрации);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеЗапроса = РезультатЗапроса.Выгрузить();
	ИндексПервойСтроки = 0;
	ПараметрыПоиска = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеЗапроса[ИндексПервойСтроки]);
	ПараметрыПоиска.Вставить("НазначениеИспользованияКачества", НазначениеИспользованияКачества);

	// для различных видов перевозки - различные алгоритмы поиска внешней пробы
	Если ПараметрыПоиска.ВидПеревозки = Перечисления.гкс_ТипыТранспортныхСредствДоставки.ЖДТранспорт Тогда
		Результат = ПоискВнешнейПробыЖД(ПараметрыПоиска);
	Иначе
		Результат = Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоискВнешнейПробыЖД(ПараметрыПоиска)

	Если Не (ЗначениеЗаполнено(ПараметрыПоиска.НомерЗаявки)
		И ЗначениеЗаполнено(ПараметрыПоиска.Номенклатура)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВнешняяПроба.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ВнешняяПроба
		|ИЗ
		|	Документ.гкс_ВнешняяПроба КАК ВнешняяПроба
		|ГДЕ
		|	ВнешняяПроба.ТранспортноеСредство = &ТранспортноеСредство
		|	И ВнешняяПроба.НомерЗаявки = &НомерЗаявки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НормативнаяСертификация.ПоказательАнализа КАК Показатель
		|ПОМЕСТИТЬ ВТ_ПоказателиСпецификации
		|ИЗ
		|	РегистрСведений.гкс_РезультатыНормативнойСертификацииНоменклатуры.СрезПоследних(
		|			&Дата,
		|			Номенклатура = &Номенклатура
		|				И ТочкаМаршрута = &ТочкаМаршрута
		|				И ВидПеревозки = ЗНАЧЕНИЕ(Перечисление.гкс_ТипыТранспортныхСредствДоставки.ЖДТранспорт)
		|				И НазначениеИспользованияКачества = &НазначениеИспользованияКачества) КАК НормативнаяСертификация
		|ГДЕ
		|	НормативнаяСертификация.ПериодС <= &Дата
		|	И НормативнаяСертификация.ПериодПо >= НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|	И НормативнаяСертификация.ИскатьВнешниеПробы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВнешняяПробаКачественныеПоказатели.Ссылка КАК Ссылка,
		|	ВнешняяПробаКачественныеПоказатели.Показатель КАК Показатель,
		|	ВнешняяПробаКачественныеПоказатели.Значение КАК ЗначениеПоказателя
		|ПОМЕСТИТЬ ВТ_ПоказателиВнешнейПробы
		|ИЗ
		|	ВТ_ВнешняяПроба КАК ВТ_ВнешняяПроба
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.гкс_ВнешняяПроба.КачественныеПоказатели КАК ВнешняяПробаКачественныеПоказатели
		|		ПО ВТ_ВнешняяПроба.Ссылка = ВнешняяПробаКачественныеПоказатели.Ссылка
		|ГДЕ
		|	ВнешняяПробаКачественныеПоказатели.ВидПробы = &ВидВнешнейПробы
		|	И ВнешняяПробаКачественныеПоказатели.Показатель <> ЗНАЧЕНИЕ(Справочник.гкс_ПоказателиАнализовНоменклатуры.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПоказателиСпецификации.Показатель КАК Показатель,
		|	ЕСТЬNULL(ВТ_ПоказателиВнешнейПробы.ЗначениеПоказателя, 0) КАК ЗначениеПоказателя,
		|	НЕ ВТ_ПоказателиВнешнейПробы.Показатель ЕСТЬ NULL КАК ЕстьВнешний,
		|	ЕСТЬNULL(ВТ_ПоказателиВнешнейПробы.Ссылка, ЗНАЧЕНИЕ(Документ.гкс_ВнешняяПроба.ПустаяСсылка)) КАК Ссылка
		|ИЗ
		|	ВТ_ПоказателиСпецификации КАК ВТ_ПоказателиСпецификации
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказателиВнешнейПробы КАК ВТ_ПоказателиВнешнейПробы
		|		ПО ВТ_ПоказателиСпецификации.Показатель = ВТ_ПоказателиВнешнейПробы.Показатель
		|ИТОГИ
		|	МИНИМУМ(ЕстьВнешний)
		|ПО
		|	Ссылка";

	Запрос.УстановитьПараметр("НомерЗаявки", ПараметрыПоиска.НомерЗаявки);
	Запрос.УстановитьПараметр("ТранспортноеСредство", ПараметрыПоиска.ТранспортноеСредство);
	Запрос.УстановитьПараметр("ВидВнешнейПробы",
		Перечисления.гкс_НазначенияИспользованияКачества.КомпозитВнешниеПробыНаТысячуТон);

	Запрос.УстановитьПараметр("ТочкаМаршрута", ПараметрыПоиска.ТочкаМаршрута);
	Запрос.УстановитьПараметр("Номенклатура", ПараметрыПоиска.Номенклатура);
	Запрос.УстановитьПараметр("НазначениеИспользованияКачества", ПараметрыПоиска.НазначениеИспользованияКачества);
	Запрос.УстановитьПараметр("Дата", ПараметрыПоиска.Дата);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;

	ВыборкаИтоги = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаИтоги.Следующий();

	// внешняя проба принимается, если есть значения всех показателей ожидаемых из внешней пробы
	Если ВыборкаИтоги.ЕстьВнешний Тогда

		Результат.Вставить("ВнешняяПроба", ВыборкаИтоги.Ссылка);
		Результат.Вставить("КачественныеПоказатели", Новый Массив);

		ВыборкаДетальныеЗаписи = ВыборкаИтоги.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

			ЗначенияВнешнихПроб = Новый Структура;
			ЗначенияВнешнихПроб.Вставить("Показатель", ВыборкаДетальныеЗаписи.Показатель);
			ЗначенияВнешнихПроб.Вставить("Значение", ВыборкаДетальныеЗаписи.ЗначениеПоказателя);
			ЗначенияВнешнихПроб.Вставить("ЭтоЗначениеВнешнейПробы", Истина);

			Результат.КачественныеПоказатели.Добавить(ЗначенияВнешнихПроб);
		КонецЦикла;
	Иначе
		Результат.Вставить("ВнешняяПроба", Документы.гкс_ВнешняяПроба.ПустаяСсылка());
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ОтражатьСостояниеРегистрации(Параметры)
	СписокНазначениеИспользования = Новый СписокЗначений;
	СписокНазначениеИспользования.Добавить(Перечисления.гкс_НазначенияИспользованияКачества.Приемка);
    СписокНазначениеИспользования.Добавить(Перечисления.гкс_НазначенияИспользованияКачества.ПромежуточныйКомпозит);

	Возврат
		ЗначениеЗаполнено(Параметры.ДокументРегистрации)
		И ТипЗнч(Параметры.ДокументРегистрации) = Тип("ДокументСсылка.гкс_РегистрацияНаПЛК")
		И Параметры.Статус = Перечисления.гкс_СтатусыЛабораторногоАнализа.Выполнен
		И СписокНазначениеИспользования.НайтиПоЗначению(Параметры.НазначениеИспользованияКачества) <> Неопределено;

КонецФункции

Функция СоздатьДокументНаОсновании(ПараметрыСоздания) Экспорт

	Результат = Неопределено;
	НовыйДокумент = СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДатаСеанса();

	Если ПараметрыСоздания.Свойство("ДанныеЗаполнения") Тогда
		НовыйДокумент.Заполнить(ПараметрыСоздания.ДанныеЗаполнения);
	КонецЕсли;

	Если ПараметрыСоздания.Свойство("ДополнительныеСвойства") Тогда
		Для Каждого Свойство Из ПараметрыСоздания.ДополнительныеСвойства Цикл
			НовыйДокумент.ДополнительныеСвойства.Вставить(Свойство.Ключ, Свойство.Значение);
		КонецЦикла;
	КонецЕсли;

	Если НовыйДокумент.КачественныеПоказатели.Количество() = 0
		ИЛИ ЗначениеЗаполнено(НовыйДокумент.ВнешняяПроба) Тогда
		НовыйДокумент.ЗаполнитьПоказателиДляИсследования();
	КонецЕсли;

	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
		Результат = НовыйДокумент.Ссылка;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ЛабораторныйАнализ.Проведение'"),
								УровеньЖурналаРегистрации.Ошибка,
								Метаданные.Документы.гкс_ЛабораторныйАнализ, ,
								ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Процедура измененяет статус "Выполнен" лабораторного анализа на "Отбор проб"
//
// Параметры:
//  МассивЛабАнализов	 - Массив из ДокументСсылка.гкс_ЛабораторныйАнализ - Коллекция ссылок на документ лабораторный анализ:
//	АдресРезультата		 - Строка - Адрес хранилища результата метода
//
Процедура ВыполнитьИзменениеСтатусаЛабораторногоАнализаНаОтборПроб(МассивЛабАнализов, АдресРезультата) Экспорт

	НачатьТранзакцию();

	Для Каждого ЛабАнализ Из МассивЛабАнализов Цикл

		ЛабАнализСтатус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛабАнализ, "Статус");

		Если Не ЛабАнализСтатус = Перечисления.гкс_СтатусыЛабораторногоАнализа.Выполнен Тогда
			Продолжить;
		КонецЕсли;

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.гкс_ЛабораторныйАнализ");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ЛабАнализ);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Попытка

			Блокировка.Заблокировать();
			ИзмененитьСтатусЛабораторногоАнализаНаОтборПроб(ЛабАнализ);

		Исключение

			ОтменитьТранзакцию();
			//@skip-warning
			ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИмяСобытияЖурналРегистрации = НСтр("ru = 'Документ Лабораторный анализ заблокирован'");
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурналРегистрации, УровеньЖурналаРегистрации.Ошибка, , ,
				ПодробноеПредставлениеОшибки);

			ВызватьИсключение ПодробноеПредставлениеОшибки;

		КонецПопытки;

	КонецЦикла;

	ЗафиксироватьТранзакцию();

КонецПроцедуры

Процедура ИзмененитьСтатусЛабораторногоАнализаНаОтборПроб(ЛабАнализ)

	ДокументОбъект = ЛабАнализ.ПолучитьОбъект();

	Попытка
		ДокументОбъект.Статус = Перечисления.гкс_СтатусыЛабораторногоАнализа.ОтборПробы;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		//@skip-warning
		ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытияЖурналРегистрации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка проведения документа Основание для движение запасов: %1.'"),
			ЛабАнализ);
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналРегистрации, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки);

		ВызватьИсключение ПодробноеПредставлениеОшибки;

	КонецПопытки;

КонецПроцедуры

#Область Проведение

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка, ДопПараметры, ДополнительныеСвойства)

	МенеджерВременныхТаблиц = Неопределено;

	Если ДопПараметры <> Неопределено
		И ДопПараметры.Свойство("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц) Тогда

		МенеджерВременныхТаблиц = ?(МенеджерВременныхТаблиц = Неопределено,
									Новый МенеджерВременныхТаблиц,
									МенеджерВременныхТаблиц);

	Иначе
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;

	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	СформироватьЗапросИнициализации(Запрос);

	ДанныеШапки = Запрос.Выполнить().Выгрузить()[0];
	ШапкаДокумента = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеШапки);
	ЗаполнитьПараметрыЗапросаПоКлючу(ШапкаДокумента, Запрос);

	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("РегистрацииЛабАнализа",
		гкс_ВходнойКонтрольКачества.ДокументыРегистрацииЛабАнализа(ДокументСсылка));
	Запрос.УстановитьПараметр("ИспользоватьЗаблокированныеТС",
		ПолучитьФункциональнуюОпцию("гкс_ИспользоватьЗаблокированныеТС"));

КонецПроцедуры

Процедура ЗаполнитьПараметрыЗапросаПоКлючу(ПараметрыСтруктура, Запрос)

	Для Каждого КлючИЗначение Из ПараметрыСтруктура Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

Процедура РассчитатьСостояниеЛабАнализа(Запрос)

	Если Запрос.Параметры.ИспользоватьЗаблокированныеТС Тогда
		ДанныеУКПредыдущейГруппы =
			гкс_ВходнойКонтрольКачества.КачествоУсиленногоКонтроляПредыдущейГруппы(
				Запрос.Параметры.ДокументРегистрации);
		Запрос.Параметры.Вставить("ПоказателиПредыдущейГруппы", ДанныеУКПредыдущейГруппы.КачествоПоказателей);

		Запрос.Текст = ТекстЗапросаРасчетаСостоянияЛабАнализаЗаблокированныеТС();
	Иначе
		Запрос.Текст = ТекстЗапросаРасчетаСостоянияЛабАнализа();
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда

		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();

		Запрос.УстановитьПараметр("Состояние", Выборка.Состояние);
		Запрос.УстановитьПараметр("НазначатьНаСклады", Выборка.НазначатьНаСклады);
		Запрос.УстановитьПараметр("ПоказателиНеСоответствуютНормативу", Выборка.НеСоответствуетНормативам);

	Иначе
		Запрос.УстановитьПараметр("Состояние", Неопределено);
		Запрос.УстановитьПараметр("ПоказателиНеСоответствуютНормативу", Ложь);
	КонецЕсли;

КонецПроцедуры

Функция ДополнительныеИсточникиДанныхДляДвижений(ИмяРегистра) Экспорт

	ИсточникиДанных = Новый Соответствие;
	Возврат ИсточникиДанных;

