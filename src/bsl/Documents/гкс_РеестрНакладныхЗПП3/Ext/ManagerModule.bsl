// Настройки печати по умолчанию.
//
// Возвращаемое значение:
//  Структура - Настройки печати по умолчанию:
// * РуководительЛаборатории - Строка -
// * РеестрСоставил - СправочникСсылка.гкс_ОтветственныеЛица -
// * МОЛ - СправочникСсылка.гкс_ОтветственныеЛица -
// * Проверил - СправочникСсылка.гкс_ОтветственныеЛица -
// * РезультатПроверки - Строка -
Функция НастройкиПечатиПоУмолчанию() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("РуководительЛаборатории", "");
	Результат.Вставить("РеестрСоставил", Справочники.гкс_ОтветственныеЛица.ПустаяСсылка());
	Результат.Вставить("МОЛ", Справочники.гкс_ОтветственныеЛица.ПустаяСсылка());
	Результат.Вставить("Проверил", Справочники.гкс_ОтветственныеЛица.ПустаяСсылка());
	Результат.Вставить("РезультатПроверки", "");

	Возврат Результат;

КонецФункции

#Область ПечатьЗПП3

Функция СформироватьПечатнуюФормуЗПП3(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)

	Макет =	ПолучитьМакет("ПФ_MXL_ЗПП3");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати 	= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗПП3";
	ТабличныйДокумент.ДвусторонняяПечать 	= ТипДвустороннейПечати.ПереворотВлево;
	ТабличныйДокумент.АвтоМасштаб 			= Истина;

	РезультатыЗапросов 	= ИнициализироватьДанныеПечатиЗПП3(МассивОбъектов);
	Шапка 		= 11;
	Накладные	= 12;
	Услуги		= 13;
	УслугиИтоги	= 14;
	Показатели	= 15;

	ВыборкаШапка 		= РезультатыЗапросов[Шапка]			.Выбрать();
	ВыборкаНакладные	= РезультатыЗапросов[Накладные]		.Выбрать();
	ВыборкаУслуги       = РезультатыЗапросов[Услуги]		.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаУслугиИтоги 	= РезультатыЗапросов[УслугиИтоги]	.Выбрать();
	ВыборкаПоказатели 	= РезультатыЗапросов[Показатели]	.Выбрать();

	Пока ВыборкаШапка.Следующий() Цикл

		ОбластьЛицеваяСторонаШапка 					= Макет.ПолучитьОбласть("ЛицеваяСторонаШапка");
		ОбластьЛицеваяСторонаПодвал 				= Макет.ПолучитьОбласть("ЛицеваяСторонаПодвал");
		ОбластьЛицеваяСторонаСтрока					= Макет.ПолучитьОбласть("ЛицеваяСторонаСтрока");
		ОбластьОборотнаяСторонаАнализы 				= Макет.ПолучитьОбласть("ОборотнаяСторонаАнализы");
		ОбластьОборотнаяСторонаДенежныйРасчетШапка 	= Макет.ПолучитьОбласть("ОборотнаяСторонаДенежныйРасчетШапка");
		ОбластьОборотнаяСторонаДенежныйРасчетСтрока = Макет.ПолучитьОбласть("ОборотнаяСторонаДенежныйРасчетСтрока");
		ОбластьОборотнаяСторонаДенежныйРасчетИтог 	= Макет.ПолучитьОбласть("ОборотнаяСторонаДенежныйРасчетИтог");
		ОбластьОборотнаяСторонаПодвал 				= Макет.ПолучитьОбласть("ОборотнаяСторонаПодвал");

		НомерСтрокиНачало 	= ТабличныйДокумент.ВысотаТаблицы + 1;
		Отбор 				= Новый Структура("Ссылка", ВыборкаШапка.Ссылка);
		ВыборкаНакладные	.Сбросить();
		ВыборкаПоказатели	.Сбросить();
		ВыборкаУслуги		.Сбросить();
		ВыборкаУслугиИтоги	.Сбросить();

		////////////////////////////////////////////////////////////////////////////////
		// Шапка
		ВывестиОбластьЛицеваяСторонаШапка(ВыборкаШапка, ОбластьЛицеваяСторонаШапка, ТабличныйДокумент);

		////////////////////////////////////////////////////////////////////////////////
		// РАЗДЕЛ I. Накладные
		ВывестиОбластьЛицеваяСторонаСтрока_Подвал(
			ВыборкаНакладные, ВыборкаШапка, ОбластьЛицеваяСторонаПодвал, ОбластьЛицеваяСторонаСтрока,
			Отбор, ПараметрыПечати, ТабличныйДокумент);

		////////////////////////////////////////////////////////////////////////////////
		// РАЗДЕЛ II. Лабораторный анализ среднесуточной пробы
		ВывестиОбластьОборотнаяСторонаАнализы(
			ВыборкаПоказатели, ВыборкаШапка, ОбластьОборотнаяСторонаАнализы,
			Отбор, ПараметрыПечати, ТабличныйДокумент);

		////////////////////////////////////////////////////////////////////////////////
		// РАЗДЕЛ III. Денежный расчет
		ВывестиОбластьОборотнаяСторонаДенежныйРасчетШапка(
			ВыборкаУслугиИтоги, ВыборкаШапка, ОбластьОборотнаяСторонаДенежныйРасчетШапка,
			Отбор, ТабличныйДокумент);

		ВывестиОбластьОборотнаяСторонаДенежныйРасчетСтрокаИтог(
			ВыборкаУслуги, ОбластьОборотнаяСторонаДенежныйРасчетИтог,
			ОбластьОборотнаяСторонаДенежныйРасчетСтрока, Отбор, ТабличныйДокумент);

		////////////////////////////////////////////////////////////////////////////////
		// Подвал
		ВывестиОбластьОборотнаяСторонаПодвал(ОбластьОборотнаяСторонаПодвал, ПараметрыПечати, ТабличныйДокумент);

		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);

	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

Процедура ВывестиОбластьЛицеваяСторонаШапка(ВыборкаШапка, ОбластьЛицеваяСторонаШапка, ТабличныйДокумент)

	ОбластьЛицеваяСторонаШапка.Параметры.Заполнить(ВыборкаШапка);
	ОбластьЛицеваяСторонаШапка.Параметры["Дата"] =
		Формат(ВыборкаШапка.Дата, "ДЛФ=DD");
	ОбластьЛицеваяСторонаШапка.Параметры["Происхождение"] =
		ОбластьВАдресеКонтрагента(ВыборкаШапка.ГрузоотправительАдрес);
	ТабличныйДокумент.Вывести(ОбластьЛицеваяСторонаШапка);

КонецПроцедуры

Процедура ВывестиОбластьЛицеваяСторонаСтрока_Подвал(
		ВыборкаНакладные,
		ВыборкаШапка,
		ОбластьЛицеваяСторонаПодвал,
		ОбластьЛицеваяСторонаСтрока,
		Отбор,
		ПараметрыПечати,
		ТабличныйДокумент)

	КоличествоДополнительныхСтрок = КоличествоДополнительныхСтрокДляВыводаНакладных(ВыборкаШапка);
	ПараметрСлева				= Истина;
	ИндексСтроки				= 1;
	КлючиПараметровОбласти		= СтрРазделить(
		"ДатаНакладной,НомерНакладной,Масса,НомерТранспорта", ",", Ложь);
	ПунктРазгрузкиСклад 		= "";
	Пока ВыборкаНакладные.НайтиСледующий(Отбор) Цикл

		ПунктРазгрузкиСклад = ВыборкаНакладные.ПунктРазгрузкиСклад;
		Если КоличествоДополнительныхСтрок > 0 Тогда

			// Заполняем параметры
			Для Каждого КлючЗначение Из КлючиПараметровОбласти Цикл
				ИмяПараметра = СтрШаблон("%1%2", КлючЗначение, ?(ПараметрСлева, "Лево", "Право"));
				ОбластьЛицеваяСторонаСтрока.Параметры[ИмяПараметра] = ВыборкаНакладные[КлючЗначение];
			КонецЦикла;

			ПараметрСлева =	Не ПараметрСлева; // Следующий заполняется параметр Справа
			Если ПараметрСлева Тогда
				КоличествоДополнительныхСтрок	= КоличествоДополнительныхСтрок - 1;	// Уменьшаем кол-во доп. строк
				ТабличныйДокумент.Вывести(ОбластьЛицеваяСторонаСтрока);
			КонецЕсли;

		Иначе

			Для Каждого КлючЗначение Из КлючиПараметровОбласти Цикл
				ОбластьЛицеваяСторонаПодвал.Параметры[СтрШаблон("%1Лево%2", КлючЗначение, ИндексСтроки)]
					= ВыборкаНакладные[КлючЗначение];
			КонецЦикла;

			ИндексСтроки = ИндексСтроки + 1;

		КонецЕсли;

	КонецЦикла;

	Если Не ПараметрСлева Тогда
		ТабличныйДокумент.Вывести(ОбластьЛицеваяСторонаСтрока);
	КонецЕсли;

	ОбластьЛицеваяСторонаПодвал.Параметры.Заполнить(ВыборкаШапка);

	ЗаполнитьМассуНакладныхВПодвале(ВыборкаШапка, ОбластьЛицеваяСторонаПодвал);
    ОбластьЛицеваяСторонаПодвал.Параметры["Склад"] 						= ПунктРазгрузкиСклад;
	ОбластьЛицеваяСторонаПодвал.Параметры["ДолжностьМОЛ"] 				= ПараметрыПечати.МОЛ;

	ТабличныйДокумент.Вывести(ОбластьЛицеваяСторонаПодвал);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();

КонецПроцедуры

Процедура ЗаполнитьМассуНакладныхВПодвале(ВыборкаШапка, ОбластьЛицеваяСторонаПодвал)

	КгВТонне 		= 1000;
	ЦелаяЧасть 		= Цел(ВыборкаШапка.ФизическийВес);
	ДробнаяЧасть 	= (ВыборкаШапка.ФизическийВес - Цел(ВыборкаШапка.ФизическийВес)) * КгВТонне;

	ОбластьЛицеваяСторонаПодвал.Параметры["МассаНакладныхПрописью"]
		= ЧислоПрописью(ЦелаяЧасть,"Л = ru_RU; НД=Ложь; ДП = Ложь", "т, т, т, ж, т, т, т, ж, 0");
	ОбластьЛицеваяСторонаПодвал.Параметры["МассаНакладныхДробнаяЧасть"]
		= ДробнаяЧасть;

КонецПроцедуры

Функция КоличествоДополнительныхСтрокДляВыводаНакладных(ВыборкаШапка)

	МаксКолНакладныхВМакете			= 11;
	КоличествоСторон				= 2;
	КоличествоДополнительныхСтрок	= ?(ВыборкаШапка.КоличествоНакладных > МаксКолНакладныхВМакете,
		Окр((ВыборкаШапка.КоличествоНакладных - МаксКолНакладныхВМакете) / КоличествоСторон), 1);
	Возврат КоличествоДополнительныхСтрок;

КонецФункции

Процедура ВывестиОбластьОборотнаяСторонаАнализы(
	ВыборкаПоказатели,
	ВыборкаШапка,
	ОбластьОборотнаяСторонаАнализы,
	Отбор,
	ПараметрыПечати,
	ТабличныйДокумент)

	МенеджерПоказатели = Справочники.гкс_ПоказателиАнализовНоменклатуры;

	ОбластьОборотнаяСторонаАнализы.Параметры.Заполнить(ВыборкаШапка);
	ОбластьОборотнаяСторонаАнализы.Параметры["ДатаОбразца"]
		= Формат(ВыборкаШапка.ДатаОбразца, "ДЛФ=DD");
	ОбластьОборотнаяСторонаАнализы.Параметры["РуководительЛаборатории"]
		= ПараметрыПечати.РуководительЛаборатории;

	РезультатыАнализов	= Новый Структура;
	РезультатыАнализов.Вставить("НатуральнаяСкидка"	, ВыборкаШапка.НатуральнаяСкидкаНадбавка);
	РезультатыАнализов.Вставить("ДенежнаяСкидка"	, ВыборкаШапка.ДенежнаяСкидкаНадбавка);
	ПрефиксСкидкиНадбавки = "_Процент";
	Пока ВыборкаПоказатели.НайтиСледующий(Отбор) Цикл

		ДобавитьПоказательВРезультатыАнализов(
			ВыборкаПоказатели, МенеджерПоказатели, РезультатыАнализов);
        ДобавитьДенежнуюСкидкуНадбавкуВРезультатыАнализов(
			ВыборкаПоказатели, МенеджерПоказатели, ПрефиксСкидкиНадбавки, РезультатыАнализов);
        ДобавитьНатуральнуюСкидкуНадбавкуВРезультатыАнализов(
			ВыборкаПоказатели, МенеджерПоказатели, ПрефиксСкидкиНадбавки, РезультатыАнализов);

	КонецЦикла;

	ОбластьОборотнаяСторонаАнализы.Параметры.Заполнить(РезультатыАнализов);
	ТабличныйДокумент.Вывести(ОбластьОборотнаяСторонаАнализы);

КонецПроцедуры

Процедура ДобавитьНатуральнуюСкидкуНадбавкуВРезультатыАнализов(
		ВыборкаПоказатели,
		МенеджерПоказатели,
		ПрефиксСкидкиНадбавки,
		РезультатыАнализов)

	Если ВыборкаПоказатели.Натуральная Тогда

		Если ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.ЗерноваяПримесь Тогда

			РезультатыАнализов.Вставить(
				СтрШаблон("%1Натуральная%2", ВыборкаПоказатели.ИмяПоказателя, ПрефиксСкидкиНадбавки),
				ВыборкаПоказатели.СкидкаНадбавка);
			РезультатыАнализов.Вставить(
				СтрШаблон("%1Натуральная", ВыборкаПоказатели.ИмяПоказателя),
				ВыборкаПоказатели.Значение);

		ИначеЕсли ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.ВлажностьЗерна
			Или ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.СорнаяПримесь
			Или ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.МасличнаяПримесь Тогда

			РезультатыАнализов.Вставить(
				СтрШаблон("%1%2", ВыборкаПоказатели.ИмяПоказателя, ПрефиксСкидкиНадбавки),
				ВыборкаПоказатели.СкидкаНадбавка);

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьДенежнуюСкидкуНадбавкуВРезультатыАнализов(
	ВыборкаПоказатели,
	МенеджерПоказатели,
	ПрефиксСкидкиНадбавки,
	РезультатыАнализов)

	Если ВыборкаПоказатели.Денежная Тогда

		Если ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.ЗерноваяПримесь Тогда

			РезультатыАнализов.Вставить(
				СтрШаблон("%1Денежная%2", ВыборкаПоказатели.ИмяПоказателя, ПрефиксСкидкиНадбавки),
				ВыборкаПоказатели.СкидкаНадбавка);
			РезультатыАнализов.Вставить(
				СтрШаблон("%1Денежная", ВыборкаПоказатели.ИмяПоказателя),
				ВыборкаПоказатели.Значение);

		ИначеЕсли ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.Натура
			Или ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.Протеин
			Или ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.МассоваяДоляМасла
			Или ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.МассоваяДоляМаслаАСВ Тогда

			РезультатыАнализов.Вставить(
				СтрШаблон("%1%2", ВыборкаПоказатели.ИмяПоказателя, ПрефиксСкидкиНадбавки),
				ВыборкаПоказатели.СкидкаНадбавка);

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоказательВРезультатыАнализов(ВыборкаПоказатели, МенеджерПоказатели, РезультатыАнализов)

	Если ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.Цвет
		Или ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.Запах Тогда

		ЗначениеПоказателя = ?(ЗначениеЗаполнено(ВыборкаПоказатели.Значение),
			ВыборкаПоказатели.Значение, "соответствует");
	Иначе
		ЗначениеПоказателя = ВыборкаПоказатели.Значение;
	КонецЕсли;

	Если ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.МассоваяДоляМасла
		И Не РезультатыАнализов.Свойство("Масличность") Тогда

		РезультатыАнализов.Вставить("Масличность", ЗначениеПоказателя);

	ИначеЕсли ВыборкаПоказатели.КоммерческийПоказатель = МенеджерПоказатели.МассоваяДоляМаслаАСВ Тогда
		РезультатыАнализов.Вставить("Масличность", ЗначениеПоказателя);
	Иначе
		РезультатыАнализов.Вставить(ВыборкаПоказатели.ИмяПоказателя, ЗначениеПоказателя);
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиОбластьОборотнаяСторонаДенежныйРасчетШапка(
	ВыборкаУслугиИтоги,
	ВыборкаШапка,
	ОбластьОборотнаяСторонаДенежныйРасчетШапка,
	Отбор,
	ТабличныйДокумент)

	ОбластьОборотнаяСторонаДенежныйРасчетШапка.Параметры.Заполнить(ВыборкаШапка);

	// Денежная скидка (по проценту)
	ЗнаменательСкидки 	= 100;
	ДенежнаяСкидкаВсего = ВыборкаШапка.СуммаВсего * ВыборкаШапка.ДенежнаяСкидкаНадбавка / ЗнаменательСкидки;
	Если ВыборкаУслугиИтоги.НайтиСледующий(Отбор) Тогда
		ДенежнаяСкидкаВсего = ДенежнаяСкидкаВсего + ВыборкаУслугиИтоги.СуммаСкидкиНадбавки;
	КонецЕсли;

	ОбластьОборотнаяСторонаДенежныйРасчетШапка.Параметры["ДенежнаяСкидкаВсего"]	= ДенежнаяСкидкаВсего;
	ТабличныйДокумент.Вывести(ОбластьОборотнаяСторонаДенежныйРасчетШапка);

КонецПроцедуры

Процедура ВывестиОбластьОборотнаяСторонаДенежныйРасчетСтрокаИтог(
	ВыборкаУслуги,
	ОбластьОборотнаяСторонаДенежныйРасчетИтог,
	ОбластьОборотнаяСторонаДенежныйРасчетСтрока,
	Отбор,
	ТабличныйДокумент)

	Пока ВыборкаУслуги.НайтиСледующий(Отбор) Цикл

		Выборка	= ВыборкаУслуги.Выбрать();
		Пока Выборка.Следующий() Цикл

			ОбластьОборотнаяСторонаДенежныйРасчетСтрока.Параметры.Заполнить(Выборка);
			ОбластьОборотнаяСторонаДенежныйРасчетСтрока.Параметры["Всего"]
				= гкс_ФормированиеПечатныхФорм.ФорматСумм(Выборка.Всего);
			ТабличныйДокумент.Вывести(ОбластьОборотнаяСторонаДенежныйРасчетСтрока);

		КонецЦикла;

		ОбластьОборотнаяСторонаДенежныйРасчетИтог.Параметры.Заполнить(ВыборкаУслуги);
		ОбластьОборотнаяСторонаДенежныйРасчетИтог.Параметры["Всего"]
			= гкс_ФормированиеПечатныхФорм.ФорматСумм(ВыборкаУслуги.Всего);
		ТабличныйДокумент.Вывести(ОбластьОборотнаяСторонаДенежныйРасчетИтог);

	КонецЦикла;

КонецПроцедуры

Процедура ВывестиОбластьОборотнаяСторонаПодвал(ОбластьОборотнаяСторонаПодвал, ПараметрыПечати, ТабличныйДокумент)

	ОбластьОборотнаяСторонаПодвал.Параметры["ДолжностьСоставил"] = ПараметрыПечати.РеестрСоставил;
	ОбластьОборотнаяСторонаПодвал.Параметры["ДолжностьПроверил"] = ПараметрыПечати.Проверил;
	ТабличныйДокумент.Вывести(ОбластьОборотнаяСторонаПодвал);

КонецПроцедуры

Функция ИнициализироватьДанныеПечатиЗПП3(МассивОбъектов)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов"		, МассивОбъектов);
	Запрос.УстановитьПараметр("ФондСобственный"		, "Собственное");
	Запрос.УстановитьПараметр("ФондХранение"		, "Хранение");
	Запрос.УстановитьПараметр("БезНДС"				, "без НДС");
	Запрос.УстановитьПараметр("СУчетомНДС"			, "с учетом НДС");
	Запрос.УстановитьПараметр("РазделительЗапятая"	, ", ");
	Запрос.Текст = ТекстЗапросаДанныеПечатиЗПП3();

	Возврат Запрос.ВыполнитьПакет();

КонецФункции

Функция ТекстЗапросаДанныеПечатиЗПП3()

	Возврат
	"ВЫБРАТЬ
	|	РеестрНакладных.Ссылка КАК Ссылка,
	|	РеестрНакладных.Номер КАК Номер,
	|	РеестрНакладных.Дата КАК Дата,
	|	РеестрНакладных.Организация КАК Организация,
	|	РеестрНакладных.Контрагент КАК Контрагент,
	|	РеестрНакладных.Грузоотправитель КАК Грузоотправитель,
	|	РеестрНакладных.Собственник КАК Собственник,
	|	РеестрНакладных.Анализ КАК Анализ,
	|	РеестрНакладных.ТочкаМаршрута КАК ТочкаМаршрута,
	|	РеестрНакладных.Номенклатура КАК Номенклатура,
	|	РеестрНакладных.ФизическийВес КАК ФизическийВес,
	|	РеестрНакладных.ЗачетныйВес КАК ЗачетныйВес,
	|	РеестрНакладных.Цена КАК Цена,
	|	РеестрНакладных.Сумма КАК Сумма,
	|	РеестрНакладных.СуммаНДС КАК СуммаНДС,
	|	РеестрНакладных.СтавкаНДС КАК СтавкаНДС,
	|	РеестрНакладных.ЦенаВключаетНДС КАК ЦенаВключаетНДС
	|ПОМЕСТИТЬ РеестрыШапка
	|ИЗ
	|	Документ.гкс_РеестрНакладныхЗПП3 КАК РеестрНакладных
	|ГДЕ
	|	РеестрНакладных.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеестрНакладные.Ссылка КАК Ссылка,
	|	РеестрНакладные.НомерСтроки КАК НомерСтроки,
