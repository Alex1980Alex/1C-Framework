Функция ОбластьВАдресеКонтрагента(Адрес)

	Результат = "";

	УровниАдреса = СтрРазделить(Адрес, ",", Ложь);
	Для Каждого Уровень Из УровниАдреса Цикл
		Если СтрНайти(Уровень, " обл") > 0 Тогда
			Результат = Уровень;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецЕсли
