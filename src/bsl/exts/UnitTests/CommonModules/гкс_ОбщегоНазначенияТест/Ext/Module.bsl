#Область СлужебныйПрограммныйИнтерфейс

// Точка входа регистрации тестов YAxUnit.
// Unit-покрытие гкс_ОбщегоНазначения.ТаблицаЗначенийВМассив
// (ТаблицаЗначений -> Массив из Структура, ключи = имена колонок).
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьСерверныйТест("ТаблицаЗначенийВМассив_ТриКолонкиДвеСтроки_МассивСтруктур",
		"ТЗ из 3 колонок и 2 строк даёт массив из 2 структур с точным маппингом значений и типов");
	ЮТТесты.ДобавитьСерверныйТест("ТаблицаЗначенийВМассив_ПустаяТаблица_ПустойМассив",
		"ТЗ с колонками, но без строк даёт пустой массив");
	ЮТТесты.ДобавитьСерверныйТест("ТаблицаЗначенийВМассив_ОднаКолонкаОднаСтрока_ОднаСтруктура",
		"ТЗ из одной колонки и одной строки даёт массив из одной структуры с одним свойством");

КонецПроцедуры

#КонецОбласти

#Область Тесты

// Позитивный: 3 колонки x 2 строки. Проверяет число элементов, точный маппинг
// каждого свойства обеих строк, сохранение типов (Строка/Число) и количество
// свойств структуры (ветка формирования строки колонок с запятыми).
Процедура ТаблицаЗначенийВМассив_ТриКолонкиДвеСтроки_МассивСтруктур() Экспорт

	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Код");
	ТаблицаДанных.Колонки.Добавить("Наименование");
	ТаблицаДанных.Колонки.Добавить("Сумма");

	Строка1 = ТаблицаДанных.Добавить();
	Строка1.Код = "К-001";
	Строка1.Наименование = "Первый";
	Строка1.Сумма = 100;

	Строка2 = ТаблицаДанных.Добавить();
	Строка2.Код = "К-002";
	Строка2.Наименование = "Второй";
	Строка2.Сумма = 250;

	Результат = гкс_ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДанных);

	ЮТест.ОжидаетЧто(Результат.Количество(), "Массив должен содержать по элементу на строку ТЗ")
		.Равно(2);

	ЮТест.ОжидаетЧто(Результат[0].Количество(), "Структура строки должна содержать все 3 колонки")
		.Равно(3);
	ЮТест.ОжидаетЧто(Результат[0].Код, "Код первой строки").Равно("К-001");
	ЮТест.ОжидаетЧто(Результат[0].Наименование, "Наименование первой строки").Равно("Первый");
	ЮТест.ОжидаетЧто(Результат[0].Сумма, "Сумма первой строки (тип Число сохранён)").Равно(100);

	ЮТест.ОжидаетЧто(Результат[1].Код, "Код второй строки").Равно("К-002");
	ЮТест.ОжидаетЧто(Результат[1].Наименование, "Наименование второй строки").Равно("Второй");
	ЮТест.ОжидаетЧто(Результат[1].Сумма, "Сумма второй строки").Равно(250);

КонецПроцедуры

// Граничный: ТЗ с колонками, но без строк -> пустой массив (цикл по строкам не выполняется).
Процедура ТаблицаЗначенийВМассив_ПустаяТаблица_ПустойМассив() Экспорт

	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Код");
	ТаблицаДанных.Колонки.Добавить("Наименование");

	Результат = гкс_ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДанных);

	ЮТест.ОжидаетЧто(Результат.Количество(), "Пустая ТЗ должна давать пустой массив")
		.Равно(0);

КонецПроцедуры

// Граничный: одна колонка x одна строка (ветка формирования строки колонок БЕЗ запятой).
Процедура ТаблицаЗначенийВМассив_ОднаКолонкаОднаСтрока_ОднаСтруктура() Экспорт

	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Значение");

	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.Значение = "Единственное";

	Результат = гкс_ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДанных);

	ЮТест.ОжидаетЧто(Результат.Количество(), "Массив из одной структуры").Равно(1);
	ЮТест.ОжидаетЧто(Результат[0].Количество(), "Структура с одним свойством").Равно(1);
	ЮТест.ОжидаетЧто(Результат[0].Значение, "Значение единственной колонки").Равно("Единственное");

КонецПроцедуры

#КонецОбласти
