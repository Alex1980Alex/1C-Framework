#Область Тесты

// Позитивный: строковый e-mail из ТЧ шаблона попадает в письмо.
Процедура ДобавитьПолучателейИзШаблона_СтрокаЕмейл_Добавлен() Экспорт
	
	Получатели = Новый Массив;
	Получатели.Добавить(НоваяСтрокаПолучателя("string-only@test.local", Ложь));
	Шаблон = СоздатьШаблонФикстуру(Получатели);
	
	Попытка
		ПолучателиПисьма = НовыйСписокПолучателейПисьма();
		гкс_РассылкиИОповещения.ДобавитьПолучателейИзШаблона(Шаблон, ПолучателиПисьма);
		
		ЮТест.ОжидаетЧто(СодержитАдрес(ПолучателиПисьма, "string-only@test.local"),
			"Строковый получатель шаблона должен быть добавлен").Равно(Истина);
		ЮТест.ОжидаетЧто(ПолучателиПисьма.Количество(),
			"Ожидается ровно один получатель").Равно(1);
	Исключение
		УдалитьШаблонФикстуру(Шаблон);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьШаблонФикстуру(Шаблон);
	
КонецПроцедуры

// Позитивный: ссылка Справочник.Пользователи резолвится в EmailПользователя.
Процедура ДобавитьПолучателейИзШаблона_СсылкаПользователя_РезолвитЕмейл() Экспорт
	
	ДанныеПользователя = НайтиПользователяСЕмейлом();
	Если ДанныеПользователя = Неопределено Тогда
		// В базе нет пользователя с заполненным EmailПользователя — кейс не воспроизводим.
		ЮТест.ОжидаетЧто(Истина,
			"Пропущено: в базе нет пользователя с заполненным EmailПользователя").Равно(Истина);
		Возврат;
	КонецЕсли;
	
	Получатели = Новый Массив;
	Получатели.Добавить(НоваяСтрокаПолучателя(ДанныеПользователя.Пользователь, Ложь));
	Шаблон = СоздатьШаблонФикстуру(Получатели);
	
	Попытка
		ПолучателиПисьма = НовыйСписокПолучателейПисьма();
		гкс_РассылкиИОповещения.ДобавитьПолучателейИзШаблона(Шаблон, ПолучателиПисьма);
		
		ЮТест.ОжидаетЧто(СодержитАдрес(ПолучателиПисьма, ДанныеПользователя.Емейл),
			"Email пользователя должен резолвиться и добавляться в получатели").Равно(Истина);
	Исключение
		УдалитьШаблонФикстуру(Шаблон);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьШаблонФикстуру(Шаблон);
	
КонецПроцедуры

// Граничный: строка с Исключен = Истина игнорируется, неисключённая — добавляется.
Процедура ДобавитьПолучателейИзШаблона_ИсключенныйПолучатель_Пропущен() Экспорт
	
	Получатели = Новый Массив;
	Получатели.Добавить(НоваяСтрокаПолучателя("keep@test.local", Ложь));
	Получатели.Добавить(НоваяСтрокаПолучателя("skip@test.local", Истина));
	Шаблон = СоздатьШаблонФикстуру(Получатели);
	
	Попытка
		ПолучателиПисьма = НовыйСписокПолучателейПисьма();
		гкс_РассылкиИОповещения.ДобавитьПолучателейИзШаблона(Шаблон, ПолучателиПисьма);
		
		ЮТест.ОжидаетЧто(СодержитАдрес(ПолучателиПисьма, "keep@test.local"),
			"Неисключённый получатель должен быть добавлен").Равно(Истина);
		ЮТест.ОжидаетЧто(СодержитАдрес(ПолучателиПисьма, "skip@test.local"),
			"Исключённый получатель НЕ должен быть добавлен").Равно(Ложь);
		ЮТест.ОжидаетЧто(ПолучателиПисьма.Количество(),
			"Ожидается ровно один (неисключённый) получатель").Равно(1);
	Исключение
		УдалитьШаблонФикстуру(Шаблон);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьШаблонФикстуру(Шаблон);
	
КонецПроцедуры

// Дедуп: адрес, уже присутствующий у получателей подписки, не дублируется.
Процедура ДобавитьПолучателейИзШаблона_ДублирующийАдрес_НеДублируется() Экспорт
	
	Получатели = Новый Массив;
	Получатели.Добавить(НоваяСтрокаПолучателя("dup@test.local", Ложь));
	Шаблон = СоздатьШаблонФикстуру(Получатели);
	
	Попытка
		ПолучателиПисьма = НовыйСписокПолучателейПисьма();
		СтрокаПодписки = ПолучателиПисьма.Добавить();
		СтрокаПодписки.Адрес = "dup@test.local";
		СтрокаПодписки.Представление = "Из подписки";
		
		гкс_РассылкиИОповещения.ДобавитьПолучателейИзШаблона(Шаблон, ПолучателиПисьма);
		
		ЮТест.ОжидаетЧто(КоличествоАдреса(ПолучателиПисьма, "dup@test.local"),
			"Дублирующий адрес не должен добавляться повторно").Равно(1);
		ЮТест.ОжидаетЧто(ПолучателиПисьма.Количество(),
			"Итоговое количество не изменилось (дедуп сработал)").Равно(1);
	Исключение
		УдалитьШаблонФикстуру(Шаблон);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьШаблонФикстуру(Шаблон);
	
КонецПроцедуры

// Негативный/граничный: пустая ссылка шаблона — no-op (guard ЗначениеЗаполнено).
Процедура ДобавитьПолучателейИзШаблона_ПустаяСсылкаШаблона_БезИзменений() Экспорт
	
	ПолучателиПисьма = НовыйСписокПолучателейПисьма();
	СтрокаПодписки = ПолучателиПисьма.Добавить();
	СтрокаПодписки.Адрес = "only@test.local";
	СтрокаПодписки.Представление = "Из подписки";
	
	гкс_РассылкиИОповещения.ДобавитьПолучателейИзШаблона(
		Справочники.ШаблоныСообщений.ПустаяСсылка(), ПолучателиПисьма);
	
	ЮТест.ОжидаетЧто(ПолучателиПисьма.Количество(),
		"Пустая ссылка шаблона не должна менять список получателей").Равно(1);
	ЮТест.ОжидаетЧто(СодержитАдрес(ПолучателиПисьма, "only@test.local"),
		"Исходный получатель подписки должен сохраниться").Равно(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт временный шаблон сообщений с заданными строками ТЧ Получатели.
//
// Параметры:
//   Получатели - Массив из Структура - {Подписчик (Строка|СправочникСсылка.Пользователи), Исключен (Булево)}.
//
// Возвращаемое значение:
//   СправочникСсылка.ШаблоныСообщений - ссылка на созданный шаблон-фикстуру.
//
Функция СоздатьШаблонФикстуру(Получатели)
	
	Объект = Справочники.ШаблоныСообщений.СоздатьЭлемент();
	Объект.Наименование = "__ЮТ REQ-2 " + Строка(Новый УникальныйИдентификатор()) + "__";
	
	Для Каждого СтрокаДанных Из Получатели Цикл
		НоваяСтрока = Объект.Получатели.Добавить();
		НоваяСтрока.Подписчик = СтрокаДанных.Подписчик;
		НоваяСтрока.Исключен = СтрокаДанных.Исключен;
	КонецЦикла;
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
	Возврат Объект.Ссылка;
	
КонецФункции

// Удаляет временный шаблон-фикстуру (жёсткое удаление, ссылок на фикстуру нет).
Процедура УдалитьШаблонФикстуру(Шаблон)
	
	Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Шаблон.ПолучитьОбъект();
	Если Объект <> Неопределено Тогда
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЕсли;
	
КонецПроцедуры

// Создаёт строку описания получателя ТЧ шаблона.
Функция НоваяСтрокаПолучателя(Подписчик, Исключен)
	Возврат Новый Структура("Подписчик, Исключен", Подписчик, Исключен);
КонецФункции

// Возвращает ТаблицуЗначений «получатели письма» с обязательными колонками Адрес/Представление
// (контракт ПолучателиПисьма из ЗаполнитьПолучателейСообщенияПодписки).
Функция НовыйСписокПолучателейПисьма()
	ПолучателиПисьма = Новый ТаблицаЗначений;
	ПолучателиПисьма.Колонки.Добавить("Адрес");
	ПолучателиПисьма.Колонки.Добавить("Представление");
	Возврат ПолучателиПисьма;
КонецФункции

// Истина, если адрес присутствует в списке получателей письма.
Функция СодержитАдрес(ПолучателиПисьма, Адрес)
	Возврат ПолучателиПисьма.НайтиСтроки(Новый Структура("Адрес", Адрес)).Количество() > 0;
КонецФункции

// Число вхождений адреса в список получателей письма.
Функция КоличествоАдреса(ПолучателиПисьма, Адрес)
	Возврат ПолучателиПисьма.НайтиСтроки(Новый Структура("Адрес", Адрес)).Количество();
КонецФункции

// Ищет действующего пользователя с заполненным EmailПользователя.
//
// Возвращаемое значение:
//   Структура {Пользователь (СправочникСсылка.Пользователи), Емейл (Строка)} или Неопределено.
//
Функция НайтиПользователяСЕмейлом()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.Недействителен";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Емейл = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Выборка.Ссылка, Справочники.ВидыКонтактнойИнформации.EmailПользователя);
		Если НЕ ПустаяСтрока(Емейл) Тогда
			Возврат Новый Структура("Пользователь, Емейл", Выборка.Ссылка, Емейл);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти