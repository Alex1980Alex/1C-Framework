  "posttooluse-delegation-tracker": {
    "description": "Tests PostToolUse delegation tracker — MCP content-block unwrapping, field extraction, quality scoring",
    "expected_pass_rate": 1.0,
    "timeout_seconds": 10,
    "tests": [
      {
        "id": "ptu-dt-001",
        "name": "MCP content-block unwrapping",
        "stdin": {
          "tool_name": "mcp__llm-rotation__llm_complete",
          "tool_input": {"prompt": "test", "max_tokens": 100},
          "tool_response": [{"type": "text", "text": "{\"provider\":\"zai-glm5\",\"model\":\"glm-5\",\"text\":\"Hello world\",\"response_time\":1.5,\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":5},\"attempt\":1}"}],
          "session_id": "test-session-001"
        },
        "expected": {
          "exit_code": 0,
          "jsonl_has": {"provider": "zai-glm5", "model": "glm-5", "source": "posttooluse"},
          "jsonl_not_has": {}
        }
      },
      {
        "id": "ptu-dt-002",
        "name": "Empty response triggers feedback",
        "stdin": {
          "tool_name": "mcp__llm-rotation__llm_complete",
          "tool_input": {"prompt": "test"},
          "tool_response": [{"type": "text", "text": "{\"provider\":\"zai-glm5\",\"text\":\"\",\"response_time\":0.5}"}],
          "session_id": "test-session-002"
        },
        "expected": {
          "exit_code": 0,
          "stdout_contains": "hookSpecificOutput",
          "jsonl_has": {"content_type": "empty"}
        }
      },
      {
        "id": "ptu-dt-003",
        "name": "Non-MCP tool ignored",
        "stdin": {
          "tool_name": "Read",
          "tool_input": {"file_path": "test.py"},
          "tool_response": "file contents",
          "session_id": "test-session-003"
        },
        "expected": {
          "exit_code": 0,
          "stdout_empty": true
        }
      }
    ],
    "reference": "docs/roadmap/260329_ROADMAP_POSTTOOLUSE_HOOKS.md Phase 1.4"
  },
  "posttooluse-quality-feedback": {
    "description": "Tests PostToolUse quality feedback — ruff check on Python files",
    "expected_pass_rate": 1.0,
    "timeout_seconds": 10,
    "tests": [
      {
        "id": "ptu-qf-001",
        "name": "Python file with issues triggers feedback",
        "stdin": {
          "tool_name": "Write",
          "tool_input": {"file_path": "src/test_quality.py", "content": "import os\nimport sys\nx: int = \"string\""},
          "tool_response": "ok",
          "session_id": "test-session-001"
        },
        "expected": {
          "exit_code": 0,
          "stdout_contains": "quality-feedback"
        },
        "setup": "echo 'import os\\nimport sys\\nx: int = \"string\"' > src/test_quality.py",
        "teardown": "rm -f src/test_quality.py"
      },
      {
        "id": "ptu-qf-002",
        "name": "Non-Python file skipped",
        "stdin": {
          "tool_name": "Write",
          "tool_input": {"file_path": "docs/test.md", "content": "# Test"},
          "tool_response": "ok",
          "session_id": "test-session-002"
        },
        "expected": {
          "exit_code": 0,
          "stdout_empty": true
        }
      },
      {
        "id": "ptu-qf-003",
        "name": "Cache directory skipped",
        "stdin": {
          "tool_name": "Write",
          "tool_input": {"file_path": ".claude/cache/test.py", "content": "x=1"},
          "tool_response": "ok",
          "session_id": "test-session-003"
        },
        "expected": {
          "exit_code": 0,
          "stdout_empty": true
        }
      }
    ],
    "reference": "docs/roadmap/260329_ROADMAP_POSTTOOLUSE_HOOKS.md Phase 2.1"
  },
  "posttooluse-bash-errors": {
    "description": "Tests PostToolUse bash error detector — pattern matching on command output",
    "expected_pass_rate": 1.0,
    "timeout_seconds": 5,
    "tests": [
      {
        "id": "ptu-be-001",
        "name": "pytest failure detected",
        "stdin": {
          "tool_name": "Bash",
          "tool_input": {"command": "pytest tests/"},
          "tool_response": "FAILED test_example.py::test_add - AssertionError: assert 1+1==3\n1 failed in 0.5s",
          "session_id": "test-session-001"
        },
        "expected": {
          "exit_code": 0,
          "stdout_contains": "bash-errors",
          "stdout_contains_also": "pytest_failure"
        }
      },
      {
        "id": "ptu-be-002",
        "name": "Git conflict detected",
        "stdin": {
          "tool_name": "Bash",
          "tool_input": {"command": "git merge feature"},
          "tool_response": "CONFLICT (content): Merge conflict in src/main.py",
          "session_id": "test-session-002"
        },
        "expected": {
          "exit_code": 0,
          "stdout_contains": "git_conflict"
        }
      },
      {
        "id": "ptu-be-003",
        "name": "Clean output no feedback",
        "stdin": {
          "tool_name": "Bash",
          "tool_input": {"command": "ls -la"},
          "tool_response": "file1.py file2.py README.md",
          "session_id": "test-session-003"
        },
        "expected": {
          "exit_code": 0,
          "stdout_empty": true
        }
      },
      {
        "id": "ptu-be-004",
        "name": "Echo command skipped",
        "stdin": {
          "tool_name": "Bash",
          "tool_input": {"command": "echo 'FAILED test'"},
          "tool_response": "FAILED test something",
          "session_id": "test-session-004"
        },
        "expected": {
          "exit_code": 0,
          "stdout_empty": true
        }
      }
    ],
    "reference": "docs/roadmap/260329_ROADMAP_POSTTOOLUSE_HOOKS.md Phase 2.2"
  },
