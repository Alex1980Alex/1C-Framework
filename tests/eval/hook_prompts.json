    "stop-hook-safety": {
      "description": "Tests for infinite loop prevention (Phase 1)",
      "expected_activation_rate": 1.0,
      "timeout_seconds": 10,
      "tests": [
        {
          "id": "shs-001",
          "prompt": "Make a trivial change to a file",
          "expected_outcome": "no_loop",
          "description": "Single change should not trigger infinite git commits",
          "max_iterations": 1
        },
        {
          "id": "shs-002",
          "prompt": "Create a new Python script with print statement",
          "expected_outcome": "no_loop",
          "description": "New file creation should not loop",
          "max_iterations": 1
        },
        {
          "id": "shs-003",
          "prompt": "Update settings.json with a new configuration value",
          "expected_outcome": "no_loop",
          "description": "Settings change should not trigger repeated docs enforcement",
          "max_iterations": 1
        }
      ]
    },

    "ide-filtering": {
      "description": "Tests IDE event filtering in skill-router (Phase 1)",
      "expected_activation_rate": 1.0,
      "timeout_seconds": 5,
      "tests": [
        {
          "id": "idf-001",
          "prompt": "<ide_opened_file>/path/to/file.txt</ide_opened_file>",
          "expected_outcome": "filtered",
          "description": "IDE file open should be filtered by skill-router"
        },
        {
          "id": "idf-002",
          "prompt": "<ide_selection>/path/to/file.txt|10|20|selected text</ide_selection>",
          "expected_outcome": "filtered",
          "description": "IDE selection should be filtered"
        },
        {
          "id": "idf-003",
          "prompt": "<cursor>path/to/file.txt|42</cursor>",
          "expected_outcome": "filtered",
          "description": "IDE cursor event should be filtered"
        },
        {
          "id": "idf-004",
          "prompt": "<file_changed>src/example.bsl</file_changed>",
          "expected_outcome": "filtered",
          "description": "File change event should be filtered"
        },
        {
          "id": "idf-005",
          "prompt": "How do I create a catalog in 1C?",
          "expected_outcome": "not_filtered",
          "description": "Normal user prompt should NOT be filtered"
        },
        {
          "id": "idf-006",
          "prompt": "/show-tasks",
          "expected_outcome": "filtered",
          "description": "Slash commands should be filtered"
        },
        {
          "id": "idf-007",
          "prompt": "hi",
          "expected_outcome": "filtered",
          "description": "Very short prompts should be filtered"
        },
        {
          "id": "idf-008",
          "prompt": "ok",
          "expected_outcome": "filtered",
          "description": "Short confirmation should be filtered"
        },
        {
          "id": "idf-009",
          "prompt": "yes",
          "expected_outcome": "filtered",
          "description": "Short yes should be filtered"
        },
        {
          "id": "idf-010",
          "prompt": "I need help with 1C development",
          "expected_outcome": "not_filtered",
          "description": "Valid prompt should NOT be filtered"
        }
      ]
    },

