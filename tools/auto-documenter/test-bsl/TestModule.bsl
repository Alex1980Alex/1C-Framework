// Тестовый модуль для проверки MCP инструментов autodocument

#Область ПрограммныйИнтерфейс

// Возвращает сумму двух чисел.
//
// Параметры:
//   Число1 - Число - Первое слагаемое.
//   Число2 - Число - Второе слагаемое.
//
// Возвращаемое значение:
//   Число - Сумма Число1 и Число2.
Функция ПолучитьСуммуЧисел(Число1, Число2) Экспорт
	Возврат Число1 + Число2;
КонецФункции

// Выводит переданный текст сообщения в окно сообщений 1С.
//
// Параметры:
//   Текст - Строка - Текст, который необходимо вывести в окно сообщений.
Процедура ВывестиСообщение(Текст) Экспорт
	Сообщить(Текст);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, не является ли переданное значение Неопределено.
//
// Параметры:
//   Значение - Любой - Значение для проверки.
//
// Возвращаемое значение:
//   Булево - Истина, если значение не Неопределено, Ложь в противном случае.
Функция ВнутренняяПроверка(Значение)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
КонецФункции

#КонецОбласти
