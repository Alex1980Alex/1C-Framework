{
  "name": "1c-framework-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js MCP tools for 1C-Framework",
  "workspaces": [
    "auto-documenter",
    "bsl-debugger",
    "ast-grep-mcp",
    "deep-code-reasoning"
  ],
  "scripts": {
    "build:all": "npm run build --workspaces",
    "build:autodoc": "cd auto-documenter && npm run build",
    "build:debugger": "cd bsl-debugger && npm run build",
    "build:ast-grep": "cd ast-grep-mcp && npm run build",
    "install:all": "npm install && npm install --workspaces",
    "clean": "npm run clean --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "1c",
    "bsl",
    "claude",
    "documentation",
    "debugger"
  ],
  "author": "1C-Framework Team",
  "license": "MIT"
}
