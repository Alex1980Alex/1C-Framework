// Диагностика TestDB для GKSTCPLK-2182
// Подбор тестовых регистраций + проверка правил УК

Попытка
    Коннектор = Новый COMОбъект("V83.COMConnector");
    Соединение = Коннектор.Connect("Srvr=""localhost"";Ref=""TestDB"";Usr=""a.novozhenin.da@sodrugestvo.local"";Pwd=""Alex1980Alex""");
Исключение
    Сообщить("ОШИБКА подключения: " + ОписаниеОшибки());
    ЗавершитьРаботу(1);
КонецПопытки;

Сообщить("=== ПОДКЛЮЧЕНО К TestDB ===");
Сообщить("");

// 1. ФО
Сообщить("--- 1. Функциональные опции ---");
Попытка
    ЗаблокТС = Соединение.Константы.гкс_ИспользоватьЗаблокированныеТС.Получить();
    Сообщить("  гкс_ИспользоватьЗаблокированныеТС = " + Строка(ЗаблокТС));
Исключение
    Сообщить("  Ошибка ФО ЗаблокТС: " + ОписаниеОшибки());
КонецПопытки;
Попытка
    УК = Соединение.Константы.гкс_ИспользоватьУсиленныйКонтрольКачества.Получить();
    Сообщить("  гкс_ИспользоватьУсиленныйКонтрольКачества = " + Строка(УК));
Исключение
    Сообщить("  Ошибка ФО УК: " + ОписаниеОшибки());
КонецПопытки;
Сообщить("");

// 2. Правила УК
Сообщить("--- 2. Правила УК (гкс_НастройкиУсиленногоКонтроляКачества) ---");
Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = "ВЫБРАТЬ
|   Н.ВидПеревозки,
|   Н.ТочкаМаршрута,
|   Н.Номенклатура,
|   Н.Показатель,
|   Н.Поставщик,
|   Н.ТранспортноеСредство,
|   Н.Активен,
|   Н.ТипВходногоКонтроля,
|   Н.КоличествоТС,
|   Н.ДатаНачала,
|   Н.ДатаОкончания,
|   Н.ЗначениеПоказателяМин,
|   Н.ЗначениеПоказателяМакс,
|   Н.Базис
|ИЗ
|   РегистрСведений.гкс_НастройкиУсиленногоКонтроляКачества КАК Н";
Результат = Запрос.Выполнить();
Выборка = Результат.Выбрать();
Счетчик = 0;
Пока Выборка.Следующий() Цикл
    Счетчик = Счетчик + 1;
    Сообщить("  [" + Строка(Счетчик) + "] Вид=" + Строка(Выборка.ВидПеревозки)
        + " | Точка=" + Строка(Выборка.ТочкаМаршрута)
        + " | Номенкл=" + Строка(Выборка.Номенклатура)
        + " | Показатель=" + Строка(Выборка.Показатель)
        + " | Поставщик=" + Строка(Выборка.Поставщик)
        + " | ТС=" + Строка(Выборка.ТранспортноеСредство)
        + " | Активен=" + Строка(Выборка.Активен)
        + " | ТипКонтр=" + Строка(Выборка.ТипВходногоКонтроля)
        + " | КолТС=" + Строка(Выборка.КоличествоТС)
        + " | С=" + Строка(Выборка.ДатаНачала)
        + " | По=" + Строка(Выборка.ДатаОкончания)
        + " | Мин=" + Строка(Выборка.ЗначениеПоказателяМин)
        + " | Макс=" + Строка(Выборка.ЗначениеПоказателяМакс)
        + " | Базис=" + Строка(Выборка.Базис));
КонецЦикла;
Сообщить("  Всего правил: " + Строка(Счетчик));
Сообщить("");

// 3. РС блокировок
Сообщить("--- 3. РС гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль ---");
Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол
|ИЗ РегистрСведений.гкс_ЗаблокированныеРегистрацииУсиленныйКонтроль КАК Б";
Результат = Запрос.Выполнить();
Выборка = Результат.Выбрать();
Выборка.Следующий();
Сообщить("  Записей в РС блокировок: " + Строка(Выборка.Кол));
Сообщить("");

// 4. Последние РегистрацияНаПЛК
Сообщить("--- 4. Последние 15 РегистрацияНаПЛК (проведённые) ---");
Попытка
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 15
    |   Р.Ссылка КАК Ссылка,
    |   Р.Номер,
    |   Р.Дата,
    |   Р.Организация
    |ИЗ Документ.гкс_РегистрацияНаПЛК КАК Р
    |ГДЕ Р.Проведен = ИСТИНА
    |УПОРЯДОЧИТЬ ПО Р.Дата УБЫВ";
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Сообщить("  №" + Строка(Выборка.Номер)
            + " | " + Строка(Выборка.Дата)
            + " | Орг=" + Строка(Выборка.Организация));
    КонецЦикла;
Исключение
    Сообщить("  Ошибка: " + ОписаниеОшибки());
КонецПопытки;
Сообщить("");

// 5. Перечисления
Сообщить("--- 5. Перечисление гкс_ТипыУсиленногоКонтроляКачества ---");
Попытка
    Запрос.Текст = "ВЫБРАТЬ Т.Ссылка, Т.Порядок
    |ИЗ Перечисление.гкс_ТипыУсиленногоКонтроляКачества КАК Т";
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Сообщить("  " + Строка(Выборка.Ссылка) + " (порядок: " + Строка(Выборка.Порядок) + ")");
    КонецЦикла;
Исключение
    Сообщить("  Ошибка: " + ОписаниеОшибки());
КонецПопытки;
Сообщить("");

Сообщить("--- 6. Перечисление гкс_СостоянияКачества ---");
Попытка
    Запрос.Текст = "ВЫБРАТЬ Т.Ссылка, Т.Порядок
    |ИЗ Перечисление.гкс_СостоянияКачества КАК Т";
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Сообщить("  " + Строка(Выборка.Ссылка) + " (порядок: " + Строка(Выборка.Порядок) + ")");
    КонецЦикла;
Исключение
    Сообщить("  Ошибка: " + ОписаниеОшибки());
КонецПопытки;
Сообщить("");

Сообщить("--- 7. Виды ЛА ---");
Попытка
    Запрос.Текст = "ВЫБРАТЬ Т.Ссылка, Т.Порядок
    |ИЗ Перечисление.гкс_ВидыЛабораторногоАнализа КАК Т";
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Сообщить("  " + Строка(Выборка.Ссылка) + " (порядок: " + Строка(Выборка.Порядок) + ")");
    КонецЦикла;
Исключение
    Сообщить("  Ошибка: " + ОписаниеОшибки());
КонецПопытки;
Сообщить("");

// 8. Последние НаправлениеНаРазгрузку
Сообщить("--- 8. Последние 5 НаправлениеНаРазгрузку ---");
Попытка
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5
    |   НР.Номер, НР.Дата, НР.Организация, НР.ДокументРегистрации, НР.Проведен
    |ИЗ Документ.гкс_НаправлениеНаРазгрузку КАК НР
    |УПОРЯДОЧИТЬ ПО НР.Дата УБЫВ";
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Сообщить("  №" + Строка(Выборка.Номер)
            + " | " + Строка(Выборка.Дата)
            + " | Орг=" + Строка(Выборка.Организация)
            + " | Рег=" + Строка(Выборка.ДокументРегистрации)
            + " | Пров=" + Строка(Выборка.Проведен));
    КонецЦикла;
Исключение
    Сообщить("  Ошибка: " + ОписаниеОшибки());
КонецПопытки;

// 9. Группы ТС
Сообщить("");
Сообщить("--- 9. Справочник гкс_ГруппыТС (первые 10) ---");
Попытка
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 10 Г.Ссылка, Г.Наименование
    |ИЗ Справочник.гкс_ГруппыТС КАК Г
    |ГДЕ НЕ Г.ЭтоГруппа";
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    Пока Выборка.Следующий() Цикл
        Сообщить("  " + Строка(Выборка.Наименование));
    КонецЦикла;
Исключение
    Сообщить("  Ошибка: " + ОписаниеОшибки());
КонецПопытки;

Сообщить("");
Сообщить("=== ДИАГНОСТИКА ЗАВЕРШЕНА ===");
